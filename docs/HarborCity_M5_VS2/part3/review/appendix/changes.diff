+    FText CarViewText() const
+    { return FText::FromString(Controller.IsValid() && Controller->GetDrivingPerspective() == EHCM4R2Perspective::FirstPerson ? TEXT("驾驶视角：第一人称") : TEXT("驾驶视角：第三人称")); }
+    FReply FootViewClicked()
