+                : TEXT("WASD  移动    鼠标  镜头\nShift  跑步    Space  跳跃\nE  上车／照明开关"));
+        Text += TEXT("\nV  第一／第三人称");
+        if (PC && !PC->GetSceneControlHint().IsEmpty()) Text += TEXT("\n") + PC->GetSceneControlHint();
+        return FText::FromString(Text);
+    }
