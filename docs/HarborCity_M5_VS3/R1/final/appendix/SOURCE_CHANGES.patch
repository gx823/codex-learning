+FString UHCM5VS3R1PolishEditor::ExtractFallRoot(UAnimSequence* Sequence,FName Pelvis){
+#if WITH_EDITOR
+    if(!Sequence||!Sequence->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS3/R1/NPCMocap/")))return TEXT("FAIL: NPC mocap copy required");
+    const auto* Data=Sequence->GetDataModel();const auto& Ref=Sequence->GetSkeleton()->GetReferenceSkeleton();const int32 Hip=Ref.FindBoneIndex(Pelvis);
