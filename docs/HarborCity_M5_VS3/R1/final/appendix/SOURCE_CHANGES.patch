+    TMap<FName,TArray<FTransform>> Tracks;for(FName Name:Names)if(Ref.FindBoneIndex(Name)<0)return TEXT("FAIL: leg schema");
+    for(int32 Frame=0;Frame<Data->GetNumberOfKeys();++Frame){
+        TArray<FTransform> Local=Ref.GetRefBonePose(),CS;CS.SetNum(Local.Num());
+        for(int32 B=0;B<Local.Num();++B){FName Name=Ref.GetBoneName(B);if(Data->IsValidBoneTrackName(Name))Local[B]=Data->GetBoneTrackTransform(Name,FFrameNumber(Frame));int32 Parent=Ref.GetParentIndex(B);CS[B]=Parent<0?Local[B]:Local[B]*CS[Parent];}
