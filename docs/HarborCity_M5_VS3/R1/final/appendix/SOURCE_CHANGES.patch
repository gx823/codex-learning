+        CS[Hips]=Lifted;Local[Hips]=Ref.GetParentIndex(Hips)<0?Lifted:Lifted.GetRelativeTransform(CS[Ref.GetParentIndex(Hips)]);
+        for(int32 Side=0;Side<2;++Side){const int32 U=Ref.FindBoneIndex(Names[Side*3]),K=Ref.FindBoneIndex(Names[Side*3+1]),F=Ref.FindBoneIndex(Names[Side*3+2]);
+            FTransform Upper=CS[U],Knee=CS[K],Foot=CS[F];const FQuat FootRotation=Foot.GetRotation();
+            FVector TargetPoint=Foot.GetLocation();TargetPoint.X=OriginalHips.X+(TargetPoint.X-OriginalHips.X)*WidthScale;TargetPoint.Y=OriginalHips.Y+(TargetPoint.Y-OriginalHips.Y)*WidthScale;
+            Upper.AddToTranslation(FVector(0,0,PelvisLift));Knee.AddToTranslation(FVector(0,0,PelvisLift));Foot.AddToTranslation(FVector(0,0,PelvisLift));
+            AnimationCore::SolveTwoBoneIK(Upper,Knee,Foot,Knee.GetLocation(),TargetPoint,false,1,1);Foot.SetRotation(FootRotation);
+            Local[U]=Upper.GetRelativeTransform(CS[Ref.GetParentIndex(U)]);Local[K]=Knee.GetRelativeTransform(Upper);Local[F]=Foot.GetRelativeTransform(Knee);
+        }
