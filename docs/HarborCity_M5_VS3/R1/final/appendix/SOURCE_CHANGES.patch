+        for(int32 B=0;B<Ref.GetNum();++B){FTransform L;A->GetBoneTransform(L,FSkeletonPoseBoneIndex(B),FAnimExtractContext(T,false),true);int32 P=Ref.GetParentIndex(B);CS[B]=P<0?L:L*CS[P];}
