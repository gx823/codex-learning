+        auto* Base=Node<UAnimGraphNode_UseCachedPose>(G,TEXT("R1_FreeArmLocomotion"));Base->SaveCachedPoseNode=Cache;Base->AllocateDefaultPins();
+        auto* Blend=Node<UAnimGraphNode_LayeredBoneBlend>(G,TEXT("R1_FreeLeftArm"));
+        FBranchFilter Filter;Filter.BoneName=TEXT("Shoulder_L");Filter.BlendDepth=1;Blend->Node.LayerSetup[0].BranchFilters.Add(Filter);
+        Blend->Node.bMeshSpaceRotationBlend=true;Blend->AllocateDefaultPins();
