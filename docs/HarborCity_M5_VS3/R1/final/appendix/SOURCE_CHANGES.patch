+        bool OK=Link(Out,Blend->FindPin(TEXT("BasePose")))&&Link(Output(Base),Blend->FindPin(TEXT("BlendPoses_0")))&&Link(Output(Var),Blend->FindPin(TEXT("BlendWeights_0")));
+        for(auto* D:Destinations)OK&=Link(Output(Blend),D);
