+    }
+}
+void UHCM5VS3TargetVisual::SetSelected(bool Selected){for(UMeshComponent* M:Outlines)if(M)M->SetVisibility(Selected);}
+void UHCM5VS3TargetVisual::Flash(){if(!FlashMaterial)return;FlashRemaining=.12f;for(UMeshComponent* M:Sources)if(M)M->SetOverlayMaterial(FlashMaterial);SetComponentTickEnabled(true);}
+void UHCM5VS3TargetVisual::TickComponent(float Dt,ELevelTick T,FActorComponentTickFunction* F){Super::TickComponent(Dt,T,F);FlashRemaining-=Dt;if(FlashRemaining<=0){for(int32 I=0;I<Sources.Num();++I)if(Sources[I])Sources[I]->SetOverlayMaterial(SavedOverlays[I]);SetComponentTickEnabled(false);}}
+void UHCM5VS3TargetVisual::EndPlay(const EEndPlayReason::Type Reason){for(int32 I=0;I<Sources.Num();++I)if(IsValid(Sources[I]))Sources[I]->SetOverlayMaterial(SavedOverlays[I]);for(UMeshComponent* M:Outlines)if(IsValid(M))M->DestroyComponent();Super::EndPlay(Reason);}
