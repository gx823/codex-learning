+/** Four original vector emblems. The cooldown arc and number read the same runtime timer. */
+class SHCM5VS3SpellBar : public SLeafWidget
+{
+public:
+    SLATE_BEGIN_ARGS(SHCM5VS3SpellBar) {} SLATE_ARGUMENT(TFunction<UHCM5VS3Abilities*()>, Abilities) SLATE_ARGUMENT(FSlateFontInfo, Font) SLATE_END_ARGS()
+    void Construct(const FArguments& A){Read=A._Abilities;Font=A._Font;SetCanTick(false);}
+    virtual FVector2D ComputeDesiredSize(float) const override{return FVector2D(320,88);}
+    virtual int32 OnPaint(const FPaintArgs&,const FGeometry& G,const FSlateRect&,FSlateWindowElementList& Out,int32 Layer,const FWidgetStyle&,bool) const override
+    {
+        auto* A=Read?Read():nullptr;if(!A)return Layer;
+        const float Costs[]={15,35,30,25},Durations[]={1,6,10,12};
+        const FLinearColor Colors[]={FLinearColor(.3,.75,1),FLinearColor(1,.35,.6),FLinearColor(.35,1,.6),FLinearColor(1,.78,.35)};
+        for(int32 K=0;K<4;++K){
+            const FVector2D C(39+K*80,35);const float CD=A->GetCooldown(K);const bool Enough=A->GetMP()>=Costs[K];
+            const auto Ink=Enough?Colors[K]:FLinearColor(.32,.35,.4);const auto Glyph=CD>0?Ink*.4f:Ink;
+            auto Lines=[&](TArray<FVector2D> P,FLinearColor Col,float W=1.5f){FSlateDrawElement::MakeLines(Out,Layer+1,G.ToPaintGeometry(),P,ESlateDrawEffect::None,Col,true,W);};
+            auto Ring=[&](float R,float Fraction,FLinearColor Col,float W){TArray<FVector2D>P;int32 N=FMath::Max(1,FMath::CeilToInt(64*Fraction));for(int32 I=0;I<=N;++I){float T=-PI/2+2*PI*Fraction*I/N;P.Add(C+FVector2D(FMath::Cos(T),FMath::Sin(T))*R);}Lines(P,Col,W);};
+            Ring(29,1,FLinearColor(.15,.22,.3,.9),2);Ring(25,1,Glyph*.6f,1);
+            TArray<FVector2D> Hex;for(int32 I=0;I<=6;++I){float T=PI/6+I*PI/3;Hex.Add(C+FVector2D(FMath::Cos(T),FMath::Sin(T))*20);}Lines(Hex,Glyph,1.2f);
+            if(K==0){Lines({C+FVector2D(3,-18),C+FVector2D(-9,1),C+FVector2D(0,1),C+FVector2D(-3,18),C+FVector2D(11,-4),C+FVector2D(2,-4),C+FVector2D(3,-18)},Glyph,2);}
+            if(K==1){for(int32 I=0;I<8;++I){float T=I*PI/4;auto V=FVector2D(FMath::Cos(T),FMath::Sin(T));Lines({C+V*6,C+V*17},Glyph,2);}Ring(8,1,Glyph,1.5f);}
+            if(K==2){Lines({C+FVector2D(-5,-16),C+FVector2D(5,-16),C+FVector2D(5,-5),C+FVector2D(16,-5),C+FVector2D(16,5),C+FVector2D(5,5),C+FVector2D(5,16),C+FVector2D(-5,16),C+FVector2D(-5,5),C+FVector2D(-16,5),C+FVector2D(-16,-5),C+FVector2D(-5,-5),C+FVector2D(-5,-16)},Glyph,2);}
+            if(K==3){Lines({C+FVector2D(0,-17),C+FVector2D(14,-10),C+FVector2D(11,7),C+FVector2D(0,18),C+FVector2D(-11,7),C+FVector2D(-14,-10),C+FVector2D(0,-17)},Glyph,2);Lines({C+FVector2D(0,-9),C+FVector2D(0,10)},Glyph,1);}
+            if(CD>0){Ring(30,FMath::Clamp(CD/Durations[K],0.f,1.f),Ink,3);FSlateDrawElement::MakeText(Out,Layer+2,G.ToPaintGeometry(FVector2D(55,22),FSlateLayoutTransform(C+FVector2D(-18,-11))),FText::FromString(FString::Printf(TEXT("%.1f"),CD)),Font,ESlateDrawEffect::None,FLinearColor::White);}
+            const TCHAR* Names[]={TEXT("1 弹"),TEXT("2 冲击"),TEXT("3 治疗"),TEXT("4 护盾")};
+            FSlateDrawElement::MakeText(Out,Layer+2,G.ToPaintGeometry(FVector2D(80,22),FSlateLayoutTransform(FVector2D(K*80+5,65))),FText::FromString(Names[K]),Font,ESlateDrawEffect::None,Ink);
+        }
+        return Layer+2;
+    }
+private:TFunction<UHCM5VS3Abilities*()> Read;FSlateFontInfo Font;
+};
