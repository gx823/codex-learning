+FString UHCM5VS3R1PolishEditor::CorrectStance(UAnimSequence* Source,UAnimSequence* Target,float WidthScale,float PelvisLift){
+#if WITH_EDITOR
+    if(!Source||!Target||Source==Target||!Target->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS3/R1/Animations_Final/"))||WidthScale<.6f||WidthScale>1||PelvisLift<0||PelvisLift>15)return TEXT("FAIL: corrective layer bounds");
