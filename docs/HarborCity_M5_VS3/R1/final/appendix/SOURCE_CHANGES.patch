+        for(const auto& Pair:TArray<TPair<FName,float>>{{TEXT("Damping"),.55f},{TEXT("Stiffness"),.18f},{TEXT("WorldDampingLocation"),.9f},{TEXT("WorldDampingRotation"),.96f},{TEXT("LimitAngle"),22.f}}){
