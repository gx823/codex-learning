+    bool OK=true;for(FName Name:Names){TArray<FVector3f> P,S;TArray<FQuat4f> Q;for(const auto& T:Tracks[Name]){P.Add(FVector3f(T.GetLocation()));Q.Add(FQuat4f(T.GetRotation()));S.Add(FVector3f(T.GetScale3D()));}if(!Target->GetDataModel()->IsValidBoneTrackName(Name))C.AddBoneCurve(Name,false);OK&=C.SetBoneTrackKeys(Name,P,Q,S,false);}
+    C.CloseBracket(false);Target->PostEditChange();Target->MarkPackageDirty();return OK?TEXT("PASS: mocap leg correction only; other raw bone tracks retained"):TEXT("FAIL: animation controller");
+#else
+    return TEXT("NOT_RUN: editor only");
+#endif
+}
