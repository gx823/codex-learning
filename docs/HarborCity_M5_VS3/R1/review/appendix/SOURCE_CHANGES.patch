+#include "HCM5VS3R1Authoring.h"
+#include "NiagaraSystem.h"
+#include "NiagaraSpriteRendererProperties.h"
+#include "NiagaraEmitterBase.h"
+#include "UObject/UnrealType.h"
+#if WITH_EDITOR
+#include "Stateless/NiagaraStatelessDistribution.h"
+namespace {
+template<class T>bool Put(UObject* O,const TCHAR* Name,const T& Value){auto* P=FindFProperty<FStructProperty>(O->GetClass(),Name);if(!P||P->Struct!=T::StaticStruct())return false;P->CopyCompleteValue(P->ContainerPtrToValuePtr<void>(O),&Value);return true;}
+TArray<UObject*> Objects(UObject* O,const TCHAR* Name){TArray<UObject*> Out;auto* P=FindFProperty<FArrayProperty>(O->GetClass(),Name);if(!P)return Out;auto* Inner=CastField<FObjectPropertyBase>(P->Inner);if(!Inner)return Out;FScriptArrayHelper A(P,P->ContainerPtrToValuePtr<void>(O));for(int32 I=0;I<A.Num();++I)Out.Add(Inner->GetObjectPropertyValue(A.GetRawPtr(I)));return Out;}
+}
+#endif
+
+FString UHCM5VS3R1Authoring::ConfigureParticles(UNiagaraSystem* System, UMaterialInterface* Material, int32 Style)
+{
+#if WITH_EDITOR
+    if(!System || !Material || !System->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS3/R1/FX/")) || Style<0 || Style>4)
+        return TEXT("FAIL: project copy and style required");
+    System->Modify(); int32 Emitters=0,Renderers=0;
+    for(auto& Handle:System->GetEmitterHandles()){
+        auto* E=Handle.GetEmitterBase(); if(!E || Handle.GetEmitterMode()!=ENiagaraEmitterMode::Stateless)return TEXT("FAIL: requires native lightweight template");
+        E->Modify(); ++Emitters;
+        UObject* Init=nullptr;UObject* Velocity=nullptr;UObject* Shape=nullptr;
+        for(auto* M:Objects(E,TEXT("Modules"))){
+            const FString N=M->GetClass()->GetName();
+            if(N==TEXT("NiagaraStatelessModule_InitializeParticle"))Init=M;
+            if(N==TEXT("NiagaraStatelessModule_AddVelocity"))Velocity=M;
+            if(N==TEXT("NiagaraStatelessModule_ShapeLocation"))Shape=M;
+            if(N==TEXT("NiagaraStatelessModule_GravityForce"))if(auto* P=FindFProperty<FBoolProperty>(M->GetClass(),TEXT("bModuleEnabled")))P->SetPropertyValue_InContainer(M,false);
+        }
+        if(!Init)return TEXT("FAIL: InitializeParticle absent");
+        const bool Heal=Style==3,Trail=Style==2,Charge=Style==1;
+        if(Shape){
+            if(auto* P=FindFProperty<FEnumProperty>(Shape->GetClass(),TEXT("ShapePrimitive")))P->GetUnderlyingProperty()->SetIntPropertyValue(P->ContainerPtrToValuePtr<void>(Shape),uint64(4));
+            Put(Shape,TEXT("SphereRadius"),FNiagaraDistributionRangeFloat(Charge?65.f:Heal?50.f:Trail?3.f:6.f));
+        }
+        bool OK=Put(Init,TEXT("LifetimeDistribution"),FNiagaraDistributionRangeFloat(Trail?.18f:Heal?1.25f:.7f));
+        auto* Size=FindFProperty<FStructProperty>(Init->GetClass(),TEXT("SpriteSizeDistribution"));
+        if(!Size||Size->Struct!=FNiagaraDistributionRangeVector2::StaticStruct())return TEXT("FAIL: sprite size type");
+        Size->ContainerPtrToValuePtr<FNiagaraDistributionRangeVector2>(Init)->InitConstant(FVector2f(Trail?7.f:Heal?10.f:6.f));
+        OK&=Put(Init,TEXT("ColorDistribution"),FNiagaraDistributionColor(FLinearColor::White));
+        auto* Spawns=FindFProperty<FArrayProperty>(E->GetClass(),TEXT("SpawnInfos"));auto* SpawnType=Spawns?CastField<FStructProperty>(Spawns->Inner):nullptr;
+        if(!SpawnType)return TEXT("FAIL: native spawn definitions absent");FScriptArrayHelper Arr(Spawns,Spawns->ContainerPtrToValuePtr<void>(E));
+        for(int32 I=0;I<Arr.Num();++I){
+            auto* Count=FindFProperty<FStructProperty>(SpawnType->Struct,TEXT("Amount"));auto* Rate=FindFProperty<FStructProperty>(SpawnType->Struct,TEXT("Rate"));
+            if(!Count||!Rate)return TEXT("FAIL: native spawn parameter mismatch");
+            FNiagaraDistributionRangeInt C(Style==4?48:24);FNiagaraDistributionRangeFloat R(Trail?90.f:30.f);
+            Count->CopyCompleteValue(Count->ContainerPtrToValuePtr<void>(Arr.GetRawPtr(I)),&C);Rate->CopyCompleteValue(Rate->ContainerPtrToValuePtr<void>(Arr.GetRawPtr(I)),&R);
+        }
+        if(Velocity){
+            if(auto* Mode=FindFProperty<FEnumProperty>(Velocity->GetClass(),TEXT("VelocityType")))Mode->GetUnderlyingProperty()->SetIntPropertyValue(Mode->ContainerPtrToValuePtr<void>(Velocity),uint64(Heal||Trail?0:1));
+            Put(Velocity,TEXT("PointVelocityDistribution"),FNiagaraDistributionRangeFloat(Charge?-90.f:180.f));
+            auto* V=FindFProperty<FStructProperty>(Velocity->GetClass(),TEXT("LinearVelocityDistribution"));
+            if(!V||V->Struct!=FNiagaraDistributionRangeVector3::StaticStruct())return TEXT("FAIL: velocity type");
+            V->ContainerPtrToValuePtr<FNiagaraDistributionRangeVector3>(Velocity)->InitConstant(FVector3f(0,0,Heal?65.f:Trail?0.f:90.f));
+        }
+        if(!OK)return TEXT("FAIL: typed particle parameter mismatch");
+        for(auto* R:Objects(E,TEXT("RendererProperties")))if(auto* Sprite=Cast<UNiagaraSpriteRendererProperties>(R)){Sprite->Material=Material;++Renderers;}
+        E->PostEditChange();
+    }
+    System->PostEditChange();System->RequestCompile(false);System->WaitForCompilationComplete();System->MarkPackageDirty();
+    return FString::Printf(TEXT("PASS: emitters=%d renderers=%d style=%d"),Emitters,Renderers,Style);
+#else
+    return TEXT("NOT_RUN: editor only");
+#endif
+}
