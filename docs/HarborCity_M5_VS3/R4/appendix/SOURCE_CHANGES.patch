+            clock+=ms/1000; dist=abs(world-c['first_capture_world_seconds'])
+            if dist<nearest[0]: nearest=(dist,clock)
+        scenes.append(dict(name=s['scene'],start=start,end=clock))
+    for s in scenes: s['start']-=nearest[1]; s['end']-=nearest[1]
+    return dict(method='Native per-step wall frame times aligned to capture first world time',alignment_error_world_seconds=nearest[0],scenes=scenes)
+
+def cue(rows,name,offset=0,occ=0,end=False):
