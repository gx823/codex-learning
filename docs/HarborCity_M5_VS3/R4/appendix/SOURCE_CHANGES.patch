+ $state.status='RUNNING';$state.current=$job.name;Save-State
+ Write-Output ('R4 JOB START '+$job.name)
+ $params=@{Executable=$exe};foreach($key in $job.Keys){if($key -ne 'name'){$params[$key]=$job[$key]}}
