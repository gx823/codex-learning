+ m=bpy.data.materials.new(name);m.diffuse_color=(*color,1);m.use_nodes=True;p=m.node_tree.nodes.get('Principled BSDF');p.inputs['Base Color'].default_value=(*color,1);p.inputs['Metallic'].default_value=metal;p.inputs['Roughness'].default_value=.3;p.inputs['Emission Color'].default_value=(*color,1);p.inputs['Emission Strength'].default_value=emit;return m
+def mesh(name,vs,fs,m):
+ d=bpy.data.meshes.new(name);d.from_pydata(vs,[],fs);d.update();o=bpy.data.objects.new(name,d);bpy.context.collection.objects.link(o);o.data.materials.append(m);return o
+def tube(name,pts,r,m,cyclic=False):
+ d=bpy.data.curves.new(name,'CURVE');d.dimensions='3D';d.resolution_u=4;d.bevel_depth=r;d.bevel_resolution=2;s=d.splines.new('POLY');s.points.add(len(pts)-1)
+ for p,v in zip(s.points,pts):p.co=(*v,1)
+ s.use_cyclic_u=cyclic;o=bpy.data.objects.new(name,d);bpy.context.collection.objects.link(o);d.materials.append(m);return o
+def crystal(name,center,radii,m):
+ vs=[]
+ for x,r in [(-1,0),(-.12,1),(.12,1),(1,0)]:
+  for i in range(6):
+   a=i*math.tau/6;vs.append((center[0]+x*radii[0],center[1]+math.cos(a)*r*radii[1],center[2]+math.sin(a)*r*radii[2]))
+ fs=[(j*6+i,j*6+(i+1)%6,(j+1)*6+(i+1)%6,(j+1)*6+i) for j in range(3) for i in range(6)]
+ o=mesh(name,vs,fs,m);b=o.modifiers.new('Facet edge bevel','BEVEL');b.width=.0008;b.segments=2;return o
+def export(name):
+ bpy.ops.object.select_all(action='DESELECT')
+ for o in bpy.context.scene.objects:
+  if o.type in ('MESH','CURVE'):o.select_set(True)
+ bpy.context.view_layer.objects.active=next(o for o in bpy.context.selected_objects if o.type=='MESH');bpy.ops.object.convert(target='MESH');bpy.ops.object.join();o=bpy.context.object;o.name='SM_'+name
+ bpy.ops.object.transform_apply(location=True,rotation=True,scale=True);bpy.ops.wm.save_as_mainfile(filepath=str(O/(name+'.blend')))
+ bpy.ops.export_scene.fbx(filepath=str(O/(name+'.fbx')),use_selection=True,object_types={'MESH'},apply_unit_scale=True,add_leaf_bones=False,axis_forward='-Y',axis_up='Z',bake_anim=False)
+ R[name]={'vertices':len(o.data.vertices),'polygons':len(o.data.polygons),'materials':[m.name for m in o.data.materials if m]}
+ return o
+bpy.ops.wm.open_mainfile(filepath='E:/GameDev/Assets/HarborCity/M5_VS3_R2/Purchased/Steampunk/R3_inspection.blend')
+removed=[]
+for suffix in ['', '.005','.013','.014','.015','.018']:
+ o=bpy.data.objects.get('SM_Steampunk_Pistol'+suffix)
+ if o:removed.append(o.name);bpy.data.objects.remove(o,do_unlink=True)
+# Neutral ivory studio material retains the source UV grain as bump; runtime colour uses the UE material.
+for material in list(bpy.data.materials):
+ if material.use_nodes:
+  shader=material.node_tree.nodes.get('Principled BSDF')
+  if shader:
+   shader.inputs['Base Color'].default_value=(.753,.680,.546,1);shader.inputs['Metallic'].default_value=.25;shader.inputs['Roughness'].default_value=.4
+   texture=material.node_tree.nodes.new('ShaderNodeTexImage');texture.image=bpy.data.images.load('E:/GameDev/Assets/HarborCity/M5_VS3_R2/Purchased/Steampunk/steampunk_pistol_ue_texture/T_Steampunk_Pistol_Color_2.png',check_existing=True)
+   bump=material.node_tree.nodes.new('ShaderNodeBump');bump.inputs['Strength'].default_value=.15;bump.inputs['Distance'].default_value=.0006;material.node_tree.links.new(texture.outputs['Color'],bump.inputs['Height']);material.node_tree.links.new(bump.outputs['Normal'],shader.inputs['Normal'])
+gold=mat('R3_PaleGold' ,(.82,.68,.42),.55);blue=mat('R3_Crystal',(.025,.45,1),.25,.45)
+crystal('AzureCore',(-.056,.002,.221),(.09,.043,.052),blue)
+for k,x in enumerate([-.19,-.138,-.09]):
+ # Solid 10 mm band with bevelled edges; glyphs sit proud of the outer surface.
+ vs=[];fs=[]
+ for xx,rr in [(x-.005,.044),(x-.005,.050),(x+.005,.050),(x+.005,.044)]:
+  for i in range(64):a=i*math.tau/64;vs.append((xx,math.cos(a)*rr,.232+math.sin(a)*rr))
+ for j in range(4):
+  for i in range(64):fs.append((j*64+i,j*64+(i+1)%64,((j+1)%4)*64+(i+1)%64,((j+1)%4)*64+i))
+ band=mesh('RuneBand'+str(k),vs,fs,gold);bevel=band.modifiers.new('Soft manufactured edges','BEVEL');bevel.width=.001;bevel.segments=3
+ for i in range(10):
+  a=i*math.tau/10
+  for strokes in [[(-.003,-.15),(0,.14),(.003,-.15)],[(-.002,0),(.002,0)]]:
+   pts=[(x+dx,math.cos(a+da)*.051,.232+math.sin(a+da)*.051) for dx,da in strokes];tube('Emissive engraved glyph',pts,.0011,blue)
+export('ArcaneCrystal');R['removed_original_parts']=removed
+
+# Bevel only the newly added crystal; original author UVs and body topology remain intact.
+(O/'geometry_report.json').write_text(json.dumps(R,indent=2),'utf-8')
