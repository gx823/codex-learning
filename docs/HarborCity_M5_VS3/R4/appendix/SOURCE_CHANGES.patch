+def export(n):
+ bpy.ops.object.select_all(action='SELECT');bpy.context.view_layer.objects.active=next(o for o in bpy.context.selected_objects if o.type=='MESH');bpy.ops.object.join();bpy.ops.object.transform_apply(location=True,rotation=True,scale=True);bpy.ops.wm.save_as_mainfile(filepath=str(O/(n+'.blend')));bpy.ops.export_scene.fbx(filepath=str(O/(n+'.fbx')),use_selection=True,object_types={'MESH'},axis_forward='-Y',axis_up='Z',bake_anim=False)
+reset();iron=material('R4_Iron',(.12,.13,.15));brass=material('R4_Brass',(.4,.27,.1))
+profile=[(.30,.02),(.30,.09),(.16,.13),(.09,.19),(.075,.7),(.16,.77),(.31,.89),(.34,.99),(.34,1.025),(.30,1.025),(.28,.94),(.14,.84),(.02,.83)]
+vs=[(r*math.cos(i*math.tau/48),r*math.sin(i*math.tau/48),z) for r,z in profile for i in range(48)];fs=[(j*48+i,j*48+(i+1)%48,(j+1)*48+(i+1)%48,(j+1)*48+i) for j in range(len(profile)-1) for i in range(48)]
+d=bpy.data.meshes.new('Brazier');d.from_pydata(vs,[],fs);o=bpy.data.objects.new('StandingBrazier',d);bpy.context.collection.objects.link(o);o.data.materials.append(iron);o.select_set(True);bevel(o,.005)
+for i in range(4):
+ a=i*math.tau/4;box('BowlStrap',(.28*math.cos(a),.28*math.sin(a),.88),(.04,.04,.25),brass)
+export('StandingBrazier')
