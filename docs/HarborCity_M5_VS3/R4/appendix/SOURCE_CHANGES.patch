+def run():
+    docs = json.loads((OUT / 'docs_publication.json').read_text('utf-8'))
+    assert docs['status'] == 'PUSHED_VERIFIED'
+    commit = docs['commit']
+    assert git('rev-parse', 'HEAD^{tree}') == docs['tree']
+    STATE['commit'] = commit
+    credential = subprocess.run(
