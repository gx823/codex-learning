+ d=bpy.data.cameras.new('Matched camera');o=bpy.data.objects.new('Matched camera',d);scene.collection.objects.link(o);o.location=(.55,-.9,.57);o.rotation_euler=(Vector((-.03,0,.18))-o.location).to_track_quat('-Z','Y').to_euler();d.type='ORTHO';d.ortho_scale=.65;scene.camera=o
