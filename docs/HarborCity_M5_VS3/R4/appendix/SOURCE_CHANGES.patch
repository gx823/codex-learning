+        part=R/f'work_hair_part_{i}.mp4'; assert not part.exists()
+        graph='[0:v]crop=960:1080:600:0,setsar=1,setpts=PTS-STARTPTS[a];[1:v]crop=960:1080:600:0,setsar=1,setpts=PTS-STARTPTS[b];[a][b]hstack=inputs=2:shortest=1[v];[v][2:v]overlay=0:0:shortest=1[out]'
+        ff(['-v','error','-ss',sa,'-i',a.with_name('capture.mp4'),'-ss',sb,'-i',b.with_name('capture.mp4'),'-loop','1','-i',label,'-filter_complex',graph,'-map','[out]','-map','1:a:0','-t',duration,'-fps_mode:v','vfr','-c:v','libx264','-threads','2','-crf','20','-c:a','aac','-ar','48000',part]);parts.append(part)
+    raw=R/'work_hair_raw.mp4'
+    ff(['-v','error','-i',parts[0],'-i',parts[1],'-filter_complex','[0:v][0:a][1:v][1:a]concat=n=2:v=1:a=1[v][a]','-map','[v]','-map','[a]','-fps_mode:v','vfr','-c:v','libx264','-threads','2','-crf','20','-c:a','aac','-ar','48000',raw])
+    dest=R/'M5_VS3_R4_HAIR_COMPARE.mp4'; M.normalize(raw,dest)
+    write(R/'appendix/HAIR_COMPARISON.json',dict(status='USER_REVIEW',before_run=str(before),after_run=str(after),before_executable=rd(before/'launch.json')['executable'],after_executable=rd(after/'launch.json')['executable'],output=str(dest),speed=1,interpolation=False,physics_disabled=False,intervals=intervals,scope='Matching idle and spell camera positions; ADS dynamics and front/side penetration use the separate new Shipping hair run. Older side retains its original lower capture cadence.'))
+    M.frame(dest,.8,OUT/'09_hair_compare.jpg',1440)
