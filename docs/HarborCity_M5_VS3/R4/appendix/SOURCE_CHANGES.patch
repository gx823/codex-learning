+"""Export complete R4 textual changes against the preserved session-start snapshot."""
+from pathlib import Path
+import difflib,hashlib,json,re
+W=Path('D:/科研学习/codex学习');O=W/'docs/HarborCity_M5_VS3/R4';B=O/'private_source_baseline'
+rows=json.loads((O/'BASELINE_SOURCE_MANIFEST.json').read_text('utf-8-sig'));baseline={r['path']:r for r in rows}
+paths=set(baseline)
+for folder in ['HarborCity/Source','HarborCity/Config']:
+ for p in (W/folder).rglob('*'):
+  if p.is_file() and p.suffix.lower() in ['.h','.cpp','.cs','.ini']:paths.add(p.relative_to(W).as_posix())
+for p in (W/'tools').glob('*'):
+ if p.is_file() and ('m5_vs3_r4' in p.name or p.name.startswith('hc_r4_')):paths.add(p.relative_to(W).as_posix())
+def read(p):
+ if not p.exists():return ''
+ raw=p.read_bytes()
+ try:return raw.decode('utf-8-sig').replace('\r\n','\n')
+ except UnicodeDecodeError:return raw.decode('gbk').replace('\r\n','\n')
+parts=[];changed=[]
+for name in sorted(paths):
+ old=B/name;new=W/name
+ if old.exists() and new.exists() and old.read_bytes()==new.read_bytes():continue
+ if any(x in name.lower() for x in ['crypto','encryption','secret']):
+  if read(old)!=read(new):raise RuntimeError('Sensitive configuration changed; review before exporting')
+  continue
+ a=read(old);b=read(new)
