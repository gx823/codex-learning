+box('StonePlinth',(0,0,.08),(.82,.60,.16),stone);box('LeftPier',(0,-.25,.48),(.58,.14,.64),stone);box('RightPier',(0,.25,.48),(.58,.14,.64),stone);box('BackWall',(.24,0,.46),(.14,.48,.62),stone);box('StoneLintel',(0,0,.84),(.76,.62,.18),stone)
+for i in range(6):box('HearthBar',(-.04,-.2+i*.08,.23),(.43,.012,.018),dark)
