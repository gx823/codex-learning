+"""Raw same-camera PNG differences; no registration, retiming, or removal of changed pixels."""
+import sys,json
+from pathlib import Path
+import numpy as np
+from PIL import Image
+sys.stdout.reconfigure(encoding='utf-8')
+root=Path(sys.argv[1]);out=Path(sys.argv[2]);out.mkdir(parents=True,exist_ok=True);rows=[]
+for p in sorted(root.glob('*_with.png')):
+ name=p.name[:-9];q=root/(name+'_without.png');c=root/(name+'_control.png')
+ if not q.exists() or not c.exists():continue
+ a=np.asarray(Image.open(p).convert('RGB'),dtype=np.int16);b=np.asarray(Image.open(q).convert('RGB'),dtype=np.int16);z=np.asarray(Image.open(c).convert('RGB'),dtype=np.int16)
+ assert a.shape==b.shape==z.shape
+ d=np.max(np.abs(a-b),axis=2);noise=np.max(np.abs(b-z),axis=2);mask=d>=32
+ ratio=float(mask.mean());control=float((noise>=32).mean());limit=.125 if name.startswith('Bolt_release') else .25
+ rows.append(dict(effect=name,changed_percent=round(ratio*100,4),limit_percent=limit*100,control_percent=round(control*100,4),status=('NOT_RUN' if int(mask.sum())<100 else 'PASS') if ratio<=limit and control<=.005 else 'FAIL',pixels=int(mask.sum()),resolution=[a.shape[1],a.shape[0]],with_file=str(p),without_file=str(q)))
+ heat=np.zeros_like(a,dtype=np.uint8);heat[:,:,0]=np.minimum(255,d*3).astype(np.uint8);Image.fromarray(heat).resize((960,540)).save(out/(name+'_difference.jpg'),quality=88)
+report=dict(method='Absolute sRGB channel difference: max(|R|,|G|,|B|) >=32 of 255, whole 1920x1080 frame. No crop, alignment, noise subtraction, or image masking. Control is second no-effect capture. PASS needs both limit and control <=0.5%. Fixed world dilation 0.0001; QA steps use real time.',scope='Actual sampled effect moments, not exhaustive temporal maximum; missing effects or absent effect spawns are NOT_RUN regardless of numerical ratio.',rows=rows)
+(out/'FP_OCCLUSION.json').write_text(json.dumps(report,ensure_ascii=False,indent=2),'utf-8')
+lines=['# 第一人称成对截图遮挡率','',report['method'],'',report['scope'],'','|效果|变化像素 %|上限 %|无效果对照噪声 %|结果|','|---|---:|---:|---:|---|']
+for r in rows:lines.append('|{effect}|{changed_percent}|{limit_percent}|{control_percent}|{status}|'.format(**r))
