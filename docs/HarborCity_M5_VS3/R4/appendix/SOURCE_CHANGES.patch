+  git('commit','-m','Document M5-VS3 R4 effects and styling, Shipping evidence and remaining gaps')
+ local=git('rev-parse','HEAD').decode().strip();tree=git('rev-parse','HEAD^{tree}').decode().strip();base=git('rev-parse','HEAD^').decode().strip();assert base==P['base_commit']
+ state.update(local_commit=local,tree=tree,parent=base);save()
+ c=subprocess.run(['git','credential','fill'],cwd=W,input=f"protocol=https\nhost=github.com\npath={P['repository']}.git\n\n",capture_output=True,text=True,env=dict(os.environ,GIT_TERMINAL_PROMPT='0',GCM_INTERACTIVE='Never'));assert c.returncode==0
+ fields=dict(v.split('=',1) for v in c.stdout.splitlines() if '=' in v);token=fields['password']
+ session=requests.Session();session.headers.update({'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28','User-Agent':'HarborCity-Authorized-Upload'});del c,fields,token
+ root='https://api.github.com/repos/'+P['repository']
+ def api(method,path,**kw):
+  r=session.request(method,root+path,timeout=(25,120),allow_redirects=False,**kw)
+  if not 200<=r.status_code<300:raise RuntimeError(f'GitHub {method} {path} HTTP {r.status_code}')
+  return r.json()
+ ref=api('GET','/git/ref/heads/main');assert ref['object']['sha']==base,'Remote changed: stop, never force'
