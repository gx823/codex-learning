+FString UHCM5VS3R2FXAuthoring::InspectBindings(UNiagaraSystem* S)
+{
+#if WITH_EDITOR
+    if(!S)return TEXT("FAIL: missing system");
+    FString Out;
+    for(auto& H:S->GetEmitterHandles()){
+        auto* E=H.GetStatelessEmitter();if(!E)continue;
+        Out+=TEXT("\n")+H.GetName().ToString();
+        if(auto D=E->GetEmitterData();D&&D->ParticleDataSetCompiledData){
+            for(const auto& V:D->ParticleDataSetCompiledData->Variables)Out+=TEXT(" ")+V.GetName().ToString();
+        }
+        for(auto* P:E->GetRenderers())if(auto* R=Cast<UNiagaraMeshRendererProperties>(P)){
+            Out+=TEXT(" age=")+R->NormalizedAgeBinding.GetDataSetBindableVariable().GetName().ToString();
+            Out+=FString::Printf(TEXT(" ageSource=%d sourceMode=%d"),int32(R->NormalizedAgeBinding.GetBindingSourceMode()),int32(R->SourceMode));
+        }
+    }
+    return Out;
+#else
+    return TEXT("NOT_RUN: editor only");
+#endif
+}
+FString UHCM5VS3R2FXAuthoring::BuildSlash(UNiagaraSystem* S,UStaticMesh* Crescent,UStaticMesh* Filaments,UMaterialInterface* Edge,UMaterialInterface* Glint)
+{
+#if WITH_EDITOR
+    if(!Crescent||!Filaments||!Edge||!Glint||!Begin(S))return TEXT("FAIL: slash inputs");
+    auto* Main=Layer(S,TEXT("Crescent_WhiteCore_BlueEdge"),1,.21f);
+    auto* Fine=Layer(S,TEXT("Two_Leading_Filaments"),1,.16f);
+    auto* Dust=Layer(S,TEXT("Twelve_Falling_Star_Fragment"),12,.32f);
+    if(!Main||!Fine||!Dust)return TEXT("FAIL: native module schema");
+    Mesh(Main,Crescent,Edge);Mesh(Fine,Filaments,Edge);Sprites(Dust,Glint,3.2f);RadialSparks(Dust,100,-160);
+    return Finish(S,TEXT("slash: tapered mesh + two filaments + 12 glints; 0.21s tail dissolve; 14 particles"));
+#else
+    return TEXT("NOT_RUN: editor only");
+#endif
+}
+FString UHCM5VS3R2FXAuthoring::BuildImpact(UNiagaraSystem* S,UStaticMesh* Star,UStaticMesh* Rays,UMaterialInterface* Flash,UMaterialInterface* SpeedLines,UMaterialInterface* Spark)
+{
+#if WITH_EDITOR
+    if(!Star||!Rays||!Flash||!SpeedLines||!Spark||!Begin(S))return TEXT("FAIL: impact inputs");
+    auto* Core=Layer(S,TEXT("Three_Frame_White_Star"),1,.075f);
+    auto* Lines=Layer(S,TEXT("Twelve_Radial_Speed_Lines"),1,.18f);
+    auto* Sparks=Layer(S,TEXT("Gravity_Sparks"),18,.42f);
+    if(!Core||!Lines||!Sparks)return TEXT("FAIL: native module schema");
+    Mesh(Core,Star,Flash,true);Mesh(Lines,Rays,SpeedLines,true);Sprites(Sparks,Spark,4.f);RadialSparks(Sparks,230,-580);
+    return Finish(S,TEXT("impact: sharp white star + radial streak mesh + 18 ballistic sparks; 20 particles"));
+#else
+    return TEXT("NOT_RUN: editor only");
+#endif
+}
