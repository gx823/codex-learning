+    auto* G=Cast<UNiagaraStatelessModule_GravityForce>(E->GetModule(UNiagaraStatelessModule_GravityForce::StaticClass()));if(G){G->SetIsModuleEnabled(true);G->GravityDistribution.InitConstant(FVector3f(0,0,Gravity));}
