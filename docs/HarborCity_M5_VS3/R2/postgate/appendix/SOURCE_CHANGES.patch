+void UHCM5VS3Armory::BeginPlay(){Super::BeginPlay();PC=Cast<AHCM1PlayerController>(GetOwner());if(!PC||!GetWorld()->GetOutermost()->GetName().Contains(TEXT("/M5VS3/")))return;
+    Catalog=LoadObject<UHCM5VS3ArmoryCatalog>(nullptr,TEXT("/Game/HarborCity/M5VS3/R2/Armory/DA_Armory.DA_Armory"));if(!Catalog)return;
+    SwordId=Catalog->DefaultSword;GunId=Catalog->DefaultGun;
