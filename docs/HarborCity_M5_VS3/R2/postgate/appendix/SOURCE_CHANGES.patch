+    if(!Texture){Texture=NewObject<UTextureRenderTarget2D>(this);Texture->ClearColor=FLinearColor(.012,.023,.038,1);Texture->RenderTargetFormat=RTF_RGBA8;Texture->InitCustomFormat(768,768,PF_B8G8R8A8,false);Capture->TextureTarget=Texture;}
