+        if(Find(W->WeaponId)){UE_LOG(LogTemp,Error,TEXT("R2_ARMORY duplicate id %s"),*W->WeaponId.ToString());continue;}
+        Weapons.Add(W);ResidentAssets.Add(W->Mesh.LoadSynchronous());ResidentAssets.Add(W->Icon.LoadSynchronous());
+        for(const auto& P:W->Paints)for(const auto& M:P.Materials)ResidentAssets.Add(M.LoadSynchronous());
+        for(const auto& E:W->Effects)ResidentAssets.Add(E.Value.LoadSynchronous());for(const auto& E:W->Sounds)ResidentAssets.Add(E.Value.LoadSynchronous());
