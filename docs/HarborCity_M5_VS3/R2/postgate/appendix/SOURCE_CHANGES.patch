+FString UHCM5VS3R2FXAuthoring::PrepareStandard(UNiagaraSystem* S){
+#if WITH_EDITOR
+    if(!S||!S->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS3/R2/FX/Postgate/")))return TEXT("FAIL: scope");
+    TSet<FGuid> Old;for(const auto& H:S->GetEmitterHandles())Old.Add(H.GetId());S->RemoveEmitterHandlesById(Old);
+    auto& P=S->GetExposedParameters();
+    P.SetParameterValue(FLinearColor(.08f,.48f,1.f),FNiagaraVariable(FNiagaraTypeDefinition::GetColorDef(),TEXT("User.Color")),true);
+    P.SetParameterValue(FVector3f(0,0,1),FNiagaraVariable(FNiagaraTypeDefinition::GetVec3Def(),TEXT("User.BladeDirection")),true);
+    P.SetParameterValue(80.f,FNiagaraVariable(FNiagaraTypeDefinition::GetFloatDef(),TEXT("User.Width")),true);
+    S->MarkPackageDirty();return TEXT("PASS");
+#else
+    return TEXT("NOT_RUN");
+#endif
+}
+FString UHCM5VS3R2FXAuthoring::InspectStandard(UNiagaraSystem* S){
+#if WITH_EDITOR
+    if(!S)return TEXT("FAIL: missing");S->RequestCompile(false);S->WaitForCompilationComplete();
+    auto R=MakeShared<FJsonObject>();int32 Stateful=0,Lightweight=0,Renderers=0;bool ScriptsValid=true;
+    for(const auto& H:S->GetEmitterHandles()){
+        if(H.GetStatelessEmitter()){++Lightweight;continue;}
+        auto E=H.GetInstance();if(auto* D=E.GetEmitterData()){++Stateful;Renderers+=D->GetRenderers().Num();
+            for(auto* Script:{D->SpawnScriptProps.Script.Get(),D->UpdateScriptProps.Script.Get()})if(!Script||!Script->IsScriptCompilationPending(false)&&Script->GetLastCompileStatus()==ENiagaraScriptCompileStatus::NCS_Error)ScriptsValid=false;}
+    }
+    R->SetNumberField(TEXT("stateful_emitters"),Stateful);R->SetNumberField(TEXT("lightweight_emitters"),Lightweight);R->SetNumberField(TEXT("renderers"),Renderers);
+    R->SetBoolField(TEXT("scripts_valid"),ScriptsValid);R->SetBoolField(TEXT("ready"),S->IsReadyToRun());
+    ScriptsValid&=S->GetSystemSpawnScript()&&S->GetSystemUpdateScript()&&S->GetSystemSpawnScript()->GetLastCompileStatus()!=ENiagaraScriptCompileStatus::NCS_Error&&S->GetSystemUpdateScript()->GetLastCompileStatus()!=ENiagaraScriptCompileStatus::NCS_Error;
+    R->SetBoolField(TEXT("can_render"),FApp::CanEverRender());R->SetStringField(TEXT("runtime"),TEXT("NOT_RUN: asset compile only"));
+    R->SetStringField(TEXT("status"),Stateful>0&&Lightweight==0&&ScriptsValid?TEXT("PASS"):TEXT("FAIL"));
+    FString Out;FJsonSerializer::Serialize(R,TJsonWriterFactory<>::Create(&Out));return Out;
+#else
+    return TEXT("NOT_RUN");
+#endif
+}
