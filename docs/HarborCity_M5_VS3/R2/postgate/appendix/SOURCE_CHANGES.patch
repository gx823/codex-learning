+bool AHCM3NPC::PrepareR2SwordTestStand(const FVector& Location)
+{
+    FString Mode, Slot;
+    if(!FParse::Value(FCommandLine::Get(),TEXT("M5Test="),Mode) ||
+       !(Mode==TEXT("m5_vs3_r2_armory") || Mode==TEXT("m5_vs3_r2_matrix") || Mode==TEXT("m5_vs3_r2_showcase")) ||
+       !FParse::Value(FCommandLine::Get(),TEXT("HCM1SaveSlot="),Slot) ||
+       !Slot.StartsWith(TEXT("HarborCity_M5_VS1_Test_VS3_")) || Location.ContainsNaN()) return false;
+    // Explicit QA fixture only: restore standing/health, without inflicting damage.
+    // Attacks still enter the real Enhanced Input and collision paths.
+    EndConversation();StopNavigation();ResetCombatForRestore();bR2StandingFixture=Mode==TEXT("m5_vs3_r2_matrix");
+    SetActorLocation(Location,false,nullptr,ETeleportType::TeleportPhysics);
+    SetActorRotation(FRotator(0,180,0));bStationary=true;PatrolPoints.Reset();
+    GetCharacterMovement()->StopMovementImmediately();return true;
 }
 
