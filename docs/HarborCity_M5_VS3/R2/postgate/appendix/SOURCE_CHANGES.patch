+bool UHCM5VS3Armory::Open(){
+    auto* H=PC?PC->GetControlledCharacter():nullptr;auto* C=PC?PC->GetCombatComponent():nullptr;
+    if(!IsAvailable()||!H||!C)return false;
+    if(PC->IsFlying()||PC->GetPlayerMode()!=EHCPlayerMode::OnFoot||H->GetAbilities()->IsBusy()||C->IsAttacking()||C->IsReloading()||C->GetPlayerHealth()<=0||PC->IsDialogueOpen()){
+        PC->ShowStatusMessage(TEXT("站稳并结束当前动作后，才能打开武器库。"));return false;}
+    if(!PC->IsPauseMenuOpen())PC->TogglePauseMenu();if(!PC->IsPauseMenuOpen())return false;
+    bOpen=true;FActorSpawnParameters Params;Params.ObjectFlags|=RF_Transient;
+    Preview=GetWorld()->SpawnActor<AHCM5VS3ArmoryPreview>(FVector(0,0,-200000),FRotator::ZeroRotator,Params);
+    if(!Preview){Close();PC->ShowStatusMessage(TEXT("武器预览暂时无法打开。"));return false;}
+    Select(SwordId);return true;
+}
+void UHCM5VS3Armory::Close(){bOpen=false;if(Preview){Preview->Destroy();Preview=nullptr;}if(PC&&PC->IsPauseMenuOpen())PC->TogglePauseMenu();}
+void UHCM5VS3Armory::Select(FName Id){if(!Find(Id))return;SelectedId=Id;PreviewPaint=GetPaintIndex(Id);if(Preview)Preview->ShowWeapon(Selected(),PreviewPaint);}
+void UHCM5VS3Armory::SelectPaint(int32 I){auto* W=Selected();if(!W||!W->Paints.IsValidIndex(I))return;PreviewPaint=I;if(Preview)Preview->ShowWeapon(W,I);}
+bool UHCM5VS3Armory::Equip(FName Id,int32 Paint){
+    auto* W=Find(Id);if(!bOpen||!W||!W->bEquippable||!W->Paints.IsValidIndex(Paint))return false;
+    (W->WeaponClass==EHCM5WeaponClass::Sword?SwordId:GunId)=Id;PaintIndices.Add(Id,Paint);
+    if(auto* H=PC->GetControlledCharacter())H->GetAbilities()->RefreshArmoryWeapons();return true;
+}
+void UHCM5VS3Armory::FillSave(UHCM1SaveGame* S) const{if(!S||!IsAvailable())return;S->ArmoryVersion=1;S->EquippedSwordId=SwordId;S->EquippedGunId=GunId;S->WeaponPaintIndices=PaintIndices;}
+void UHCM5VS3Armory::RestoreSave(const UHCM1SaveGame* S){
+    if(!Catalog||!S)return;SwordId=Catalog->DefaultSword;GunId=Catalog->DefaultGun;PaintIndices.Reset();
+    if(S->ArmoryVersion>=1){
+        auto Valid=[this](FName Id,EHCM5WeaponClass K){auto* W=Find(Id);return W&&W->bEquippable&&W->WeaponClass==K;};
+        if(Valid(S->EquippedSwordId,EHCM5WeaponClass::Sword))SwordId=S->EquippedSwordId;if(Valid(S->EquippedGunId,EHCM5WeaponClass::Gun))GunId=S->EquippedGunId;
+        for(const auto& P:S->WeaponPaintIndices)if(auto* W=Find(P.Key);W&&W->Paints.IsValidIndex(P.Value))PaintIndices.Add(P.Key,P.Value);
+    }
+    if(auto* H=PC->GetControlledCharacter())H->GetAbilities()->RefreshArmoryWeapons();
+}
