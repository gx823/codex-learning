+pairs=[('HarborCity/Source/'+rel,before/rel,source/rel) for rel in files]
+pairs.extend(('tools/'+p.name,Path('__r6_new_file__'),p) for p in sorted((W/'tools').glob('*r6*')) if p.is_file() and p.suffix in ('.py','.ps1'))
+for rel,old,new in pairs:
+    a=old.read_text('utf-8-sig').splitlines(keepends=True) if old.exists() else []
