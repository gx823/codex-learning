+    AddStep(TEXT("R6 normal charged light-arrow release"),.95,[this]{Hold(TEXT("Attack"),FInputActionValue(true));},[this]{Release(TEXT("Attack"));});AddStep(TEXT("R6 charged light-arrow real collision"),1.5,[]{});
