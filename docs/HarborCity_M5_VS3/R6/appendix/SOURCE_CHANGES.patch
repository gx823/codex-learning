+                    S->Path=Path?Path->PathPoints:TArray<FVector>();S->Point=1;S->Goal=(S->Goal+1)%Goals.Num();
+                }
+                if(S->Path.IsValidIndex(S->Point)){
+                    const FVector D=S->Path[S->Point]-P;
+                    if(D.Size2D()<90){++S->Point;if(!S->Path.IsValidIndex(S->Point))++S->Visited;}
+                    else {const FRotator View=PC->GetControlRotation();const auto Gain=PC->GetOnFootLookDegreesPerActionUnit();const float Turn=FMath::Clamp(FMath::FindDeltaAngleDegrees(View.Yaw,D.Rotation().Yaw),-100.f*Dt,100.f*Dt);Hold(TEXT("Look"),FInputActionValue(FVector2D(Turn/Gain.X,0)));Hold(TEXT("Move"),FInputActionValue(FVector2D(0,1)));}
+                }else Release(TEXT("Move"));
+                if(Character->GetVelocity().Size2D()<10)S->Stuck+=Dt;else S->Stuck=0;
+                if(S->Stuck>8){S->Path.Reset();S->Stuck=0;}
