+def run():
+ for r in rows:
+  p=WT/r['path'];assert hashlib.sha256(p.read_bytes()).hexdigest()==r['sha256']
+  assert p.suffix.lower() not in ('.png','.jpg','.jpeg','.mp4','.wav','.uasset','.fbx','.exe','.sav','.zip')
+ if git('status','--porcelain').strip():
+  git('add','--',*[r['path'] for r in rows])
+  staged=git('diff','--cached','--name-only','-z').decode('utf-8').split('\x00');assert set(x for x in staged if x)==set(r['path'] for r in rows)
+  git('commit','-m','Document M5-VS3 R6 persistent sprint, purchased bow and partial Shipping verification')
+ local=git('rev-parse','HEAD').decode().strip();tree=git('rev-parse','HEAD^{tree}').decode().strip();base=git('rev-parse','HEAD^').decode().strip();assert base==P['base_commit']
+ state.update(local_commit=local,tree=tree,parent=base);save()
