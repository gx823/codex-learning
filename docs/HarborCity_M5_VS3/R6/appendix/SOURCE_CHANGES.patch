+        struct FExplore {TArray<FVector> Path;int32 Goal=0,Point=0,Visited=0;double Start=0,Last=0;float Stuck=0,Sample=0;FVector Before;FString CSV=TEXT("wall_seconds,x,y,z,speed,goals,stuck_seconds\n");};
