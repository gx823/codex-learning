+            fields=dict(re.findall(r'(min|recovery|sprint|hits|shots|frames|charge_min)=([-\d.]+)',check.get('actual','')))
+            item=dict(run=launch.parent.name,case=f.stem.rsplit('_',1)[0],repeat=int(f.stem.rsplit('_',1)[1]),minimum=min(action) if action else None,mean=statistics.mean(action) if action else None,sprint_all=all(x['sprint']=='1' for x in data),hits=int(last['hits']),shots=int(last['shots']),hit_window_recovery_s=recovery,action_recovery_s=float(fields['recovery']) if 'recovery' in fields else None,check_status=check.get('status'),file=f.relative_to(R).as_posix())
+            (fresh_sprint if '-R4Case=r6apilot' in args else sprint).append(item)
+    if '-R4Case=r6bow' in args:bow.extend(c for c in checks if c['name'].startswith('R6'))
+    if '-R4Case=r5fppeaks' in args:
+        for c in checks:
+            if 'full-lifetime sampled peak' in c['name']:
+                fields=dict(re.findall(r'(peak|control|frames|simulation_seconds|wall_seconds)=([\d.]+)',c['actual']))
+                peaks.append(dict(name=c['name'].replace(' full-lifetime sampled peak',''),status=c['status'],**{k:float(v) for k,v in fields.items()}))
+    if j.get('mode')=='m5_full':
