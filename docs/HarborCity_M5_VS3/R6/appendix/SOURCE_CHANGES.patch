+ created_tree=api('POST','/git/trees',json={'base_tree':parent['tree']['sha'],'tree':entries});assert created_tree['sha']==tree,'Tree differs from reviewed local commit'
+ raw=git('cat-file','commit',local).decode('utf-8');headers,message=raw.split('\n\n',1)
+ def identity(prefix):
+  import re,datetime
+  row=next(x for x in headers.splitlines() if x.startswith(prefix+' '))
+  m=re.fullmatch(prefix+r' (.*) <([^>]+)> (\d+) ([+-]\d{4})',row);assert m
+  zone=m[4];minutes=(int(zone[1:3])*60+int(zone[3:]))*(1 if zone[0]=='+' else -1)
+  dt=datetime.datetime.fromtimestamp(int(m[3]),datetime.timezone(datetime.timedelta(minutes=minutes)))
+  return dict(name=m[1],email=m[2],date=dt.isoformat())
