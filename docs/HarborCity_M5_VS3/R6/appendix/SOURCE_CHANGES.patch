+        items=[x for x in trials if x['case']==name];recover=[v for x in items for v in x['hit_window_recovery_s'] if v is not None]
+        minima=[x['minimum'] for x in items if x['minimum'] is not None];action_recovery=[x['action_recovery_s'] for x in items if x['action_recovery_s'] is not None and x['action_recovery_s']>=0]
