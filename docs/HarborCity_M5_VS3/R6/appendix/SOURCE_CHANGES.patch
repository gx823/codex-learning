diff --git a/tools/ue_m5_vs3_r6_bow_retarget.py b/tools/ue_m5_vs3_r6_bow_retarget.py
--- /dev/null
+++ b/tools/ue_m5_vs3_r6_bow_retarget.py
@@ -0,0 +1,64 @@
+"""Native UE5.8 pelvis/FK retarget, independent purchased FP and Mixamo TP clips."""
+from pathlib import Path
+import json,re,traceback
+import unreal as U
+ROOT='/Game/HarborCity/M5VS3/R6/Bow'
+A=U.EditorAssetLibrary;AT=U.AssetToolsHelpers.get_asset_tools()
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line())
+O=Path(m[1] or m[2]);R={'status':'RUNNING','outputs':[]}
+
+def load(p):
+    a=A.load_asset(p);assert a,p;return a
+
+def save(a):assert A.save_loaded_asset(a,False)
+
+def create(name,cls,factory):
+    return load(ROOT+'/Rigs/'+name) if A.does_asset_exist(ROOT+'/Rigs/'+name) else AT.create_asset(name,ROOT+'/Rigs',cls,factory)
+
+def batch(seqs,src,target,rt,dest,suffix=''):
+    pending=[a for a in seqs if not A.does_asset_exist(dest+'/'+a.get_name()+suffix)]
+    if pending:
+        bi=U.IKRetargetBatchOperationInputs()
+        for k,v in dict(assets_to_retarget=[A.find_asset_data(a.get_path_name()) for a in pending],source_mesh=src,target_mesh=target,ik_retarget_asset=rt,target_path=dest,suffix=suffix,use_source_path=False,include_referenced_assets=False,overwrite_existing_files=False,retain_additive_flags=True).items():bi.set_editor_property(k,v)
+        output=[d.get_asset() for d in U.IKRetargetBatchOperation.run_batch_retarget(bi)]
+        assert len(output)==len(pending),(len(output),len(pending))
+        for a in output:a.set_editor_property('enable_root_motion',False);a.set_editor_property('force_root_lock',True);save(a)
+    for a in seqs:
+        out=load(dest+'/'+a.get_name()+suffix)
+        R['outputs'].append({'asset':out.get_path_name(),'source':a.get_path_name(),'seconds':out.get_play_length()})
+
+try:
+    src=load(ROOT+'/Native/Exouch/SK_Exouch');target=load('/Game/HarborCity/M5VS1/HeroSelestia/SKM_Selestia')
+    rig=create('IK_Exouch',U.IKRigDefinition,U.IKRigDefinitionFactory())
+    c=U.IKRigController.get_controller(rig);assert c.set_skeletal_mesh(src)
+    for old in list(c.get_retarget_chains()):c.remove_retarget_chain(old.chain_name)
+    assert c.set_retarget_root('pelvis')
+    chains=[('Spine','spine_01','spine_03'),('Neck','neck_01','neck_01'),('Head','head','head')]
+    for side,suf in [('Left','l'),('Right','r')]:
+        chains.extend([(side+'Clavicle','clavicle_'+suf,'clavicle_'+suf),(side+'Arm','upperarm_'+suf,'hand_'+suf),(side+'Leg','thigh_'+suf,'foot_'+suf),(side+'Toe','ball_'+suf,'ball_'+suf)])
+        for label,bone in [('Thumb','thumb'),('Index','index'),('Middle','middle'),('Ring','ring'),('Pinky','pinky')]:chains.append((side+label,bone+'_01_'+suf,bone+'_03_'+suf))
+    for name,start,end in chains:assert str(c.add_retarget_chain(name,start,end,'None')).lower()==name.lower()
+    save(rig)
+    targetrig=load('/Game/HarborCity/M5VS3/R1/Rigs/IK_Selestia')
+    rt=create('RTG_Exouch_Selestia',U.IKRetargeter,U.IKRetargetFactory())
+    rc=U.IKRetargeterController.get_controller(rt);rc.remove_all_ops()
+    s,t=U.RetargetSourceOrTarget.SOURCE,U.RetargetSourceOrTarget.TARGET
+    rc.set_ik_rig(s,rig);rc.set_ik_rig(t,targetrig);rc.set_preview_mesh(s,src);rc.set_preview_mesh(t,target)
+    pi=rc.add_retarget_op('/Script/IKRig.IKRetargetPelvisMotionOp');fi=rc.add_retarget_op('/Script/IKRig.IKRetargetFKChainsOp')
+    for index in (pi,fi):assert index>=0;rc.run_op_initial_setup(index)
+    pc=rc.get_op_controller(pi);pc.set_source_pelvis_bone('pelvis');pc.set_target_pelvis_bone('Hips')
+    for name,_,_ in chains:assert rc.set_source_chain(name,name,rc.get_op_name(fi))
+    fc=rc.get_op_controller(fi);settings=fc.get_settings();items=list(settings.get_editor_property('chains_to_retarget'))
+    for item in items:
+        item.set_editor_property('enable_fk',True);item.set_editor_property('rotation_mode',U.FKChainRotationMode.INTERPOLATED);item.set_editor_property('translation_mode',U.FKChainTranslationMode.NONE)
+    settings.set_editor_property('chains_to_retarget',items);fc.set_settings(settings)
+    rc.create_retarget_pose('R6_Exouch',t);assert rc.set_current_retarget_pose('R6_Exouch',t);rc.auto_align_all_bones(t,U.RetargetAutoAlignMethod.CHAIN_TO_CHAIN);save(rt)
+    fp=[a for p in A.list_assets(ROOT+'/Native/Exouch/Animations') if isinstance(a:=A.load_asset(p),U.AnimSequence)]
+    assert len(fp)>=27
+    batch(fp,src,target,rt,ROOT+'/FP')
+    mixamo=load('/Game/HarborCity/M5VS3/R1/MotionSource/SKM_Mixamo_XBot_Persisted')
+    tp=[load('/Game/HarborCity/M5VS3/R3/MotionSource/'+name) for name in ('A_BowIdle','A_BowDraw','A_BowAim','A_BowRelease','A_BowWalk','A_BowEquip')]
+    batch(tp,mixamo,target,load('/Game/HarborCity/M5VS3/R1/Rigs/RTG_Mixamo_Selestia_Pelvis'),ROOT+'/TP')
+    R.update(status='PASS',visual='NOT_RUN',method='R1 native pelvis and FK chain retarget; FP uses Exouch, TP uses user-downloaded Mixamo Pro Longbow')
+except Exception:R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+finally:(O/'author_result.json').write_text(json.dumps(R,indent=2),encoding='utf-8')
diff --git a/tools/ue_m5_vs3_r6_ivory.py b/tools/ue_m5_vs3_r6_ivory.py
--- /dev/null
+++ b/tools/ue_m5_vs3_r6_ivory.py
@@ -0,0 +1,49 @@
+"""R6-only ivory material with source detail, normal and roughness retained."""
+from pathlib import Path
+import unreal as U,json,re,traceback
+A=U.EditorAssetLibrary;AT=U.AssetToolsHelpers.get_asset_tools();ME=U.MaterialEditingLibrary
+ROOT='/Game/HarborCity/M5VS3/R6/Weapons'
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line());O=Path(m[1] or m[2]);R={'status':'RUNNING','visual':'NOT_RUN'}
+def load(p):
+    a=A.load_asset(p);assert a,p;return a
+def save(a):assert A.save_loaded_asset(a,False)
+def copy(src,dst):return load(dst) if A.does_asset_exist(dst) else A.duplicate_asset(src,dst)
+def node(m,c,**props):
+    n=ME.create_material_expression(m,c)
+    for k,v in props.items():n.set_editor_property(k,v)
+    return n
+def link(a,b,pin):assert ME.connect_material_expressions(a,'',b,pin)
+def prop(a,p):assert ME.connect_material_property(a,'',p)
