+#include "Animation/AnimSequence.h"
+#include "Animation/Skeleton.h"
+#include "Components/PoseableMeshComponent.h"
+#include "Engine/SkeletalMesh.h"
+
+namespace HCR6BowPose
+{
+inline void Sample(UPoseableMeshComponent* Mesh,UAnimSequence* Sequence,float Time)
+{
+    if(!Mesh||!Sequence||!Cast<USkeletalMesh>(Mesh->GetSkinnedAsset()))return;
+    const auto& Ref=CastChecked<USkeletalMesh>(Mesh->GetSkinnedAsset())->GetRefSkeleton();
+    const auto& Skeleton=Sequence->GetSkeleton()->GetReferenceSkeleton();
+    Mesh->BoneSpaceTransforms=Ref.GetRefBonePose();
+    for(int32 I=0;I<Ref.GetNum();++I)
+    {
+        const int32 S=Skeleton.FindBoneIndex(Ref.GetBoneName(I));
+        if(S!=INDEX_NONE)Sequence->GetBoneTransform(Mesh->BoneSpaceTransforms[I],FSkeletonPoseBoneIndex(S),FAnimExtractContext(double(Time)),false);
+    }
+    Mesh->RefreshBoneTransforms();
+}
+inline FTransform ReferenceCS(const USkeletalMesh* Mesh,FName Bone)
+{
+    const auto& Ref=Mesh->GetRefSkeleton();int32 I=Ref.FindBoneIndex(Bone);FTransform Result=FTransform::Identity;
+    while(I!=INDEX_NONE){Result=Result*Ref.GetRefBonePose()[I];I=Ref.GetParentIndex(I);}
+    return Result;
+}
+}
