+import bpy,json,math
+from pathlib import Path
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath='E:/GameDev/Assets/HarborCity/M5_VS3_R6/Derived/SM_R6_Arrow.fbx')
+result=[]
+for o in bpy.data.objects:
+    if o.type!='MESH':continue
+    vs=[o.matrix_world@v.co for v in o.data.vertices]
+    low=[min(v[k] for v in vs) for k in range(3)];high=[max(v[k] for v in vs) for k in range(3)]
+    axis=max(range(3),key=lambda k:high[k]-low[k]);other=[k for k in range(3) if k!=axis];bins=[]
+    for i in range(10):
+        sub=[v for v in vs if i/10<=(v[axis]-low[axis])/(high[axis]-low[axis])<=((i+1)/10)]
+        bins.append({'bin':i,'vertices':len(sub),'widths':[max((v[k] for v in sub),default=0)-min((v[k] for v in sub),default=0) for k in other]})
+    result.append({'name':o.name,'min':low,'max':high,'axis':axis,'bins':bins})
+Path('D:/科研学习/codex学习/docs/HarborCity_M5_VS3/R6/appendix/ARROW_AXES.json').write_text(json.dumps(result,indent=2),'utf-8')
