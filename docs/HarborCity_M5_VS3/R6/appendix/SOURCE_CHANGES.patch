+        AddStep(TEXT("R6 continuous30-minute normal-input navigation"),1800,[this,S]{
+            S->Start=FPlatformTime::Seconds();S->Before=Character->GetActorLocation();FrameTimes.Reset();
+            R5FrameSample=[this,S](float Dt){
+                const TArray<FVector> Goals={FVector(0,-6300,110),FVector(6500,-5800,110),FVector(5800,-5000,110),FVector(0,-3600,110),FVector(-4200,-5600,110),FVector(0,-8500,110)};
