+++ b/tools/ue_m5_vs3_r6_bow_import.py
@@ -0,0 +1,92 @@
+"""Import licensed originals into private R6 assets; no runtime binding yet."""
+from pathlib import Path
+import json, re, traceback
+import unreal as U
+
+ROOT='/Game/HarborCity/M5VS3/R6/Bow/Native'
+SRC=Path('E:/GameDev/Assets/HarborCity/M5_VS3_R6/Purchased')
+A=U.EditorAssetLibrary
+AT=U.AssetToolsHelpers.get_asset_tools()
+ME=U.MaterialEditingLibrary
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line())
+O=Path(m[1] or m[2]);R={'status':'RUNNING','assets':[]}
+
+def load(path):
+    a=A.load_asset(path);assert a,path;return a
+
+def save(asset):
+    assert A.save_loaded_asset(asset,False),asset.get_path_name()
+
+def import_asset(file,directory,name,options=None):
+    path=directory+'/'+name
+    if A.does_asset_exist(path):
+        old=load(path)
+        if isinstance(old,U.SkeletalMesh) and (old.get_editor_property('skeleton') is None or '/Animations/' in path):
+            assert A.delete_asset(path),path
+        else:return old
+    task=U.AssetImportTask()
+    for k,v in dict(filename=str(file),destination_path=directory,destination_name=name,automated=True,save=True,replace_existing=False).items():task.set_editor_property(k,v)
+    if options:
+        task.set_editor_property('options',options);task.set_editor_property('factory',U.FbxFactory())
+    AT.import_asset_tasks([task])
+    for p in task.get_editor_property('imported_object_paths'):
+        item=load(p)
+        if isinstance(item,U.SkeletalMesh):
+            sk=item.get_editor_property('skeleton');assert sk,p;save(sk)
+        save(item)
+    assert A.save_directory(directory,False,True)
+    R['assets'].extend(list(task.get_editor_property('imported_object_paths')))
+    return load(path)
+
+def skeletal_options(skeleton=None,animations=True):
+    op=U.FbxImportUI()
+    for k,v in dict(automated_import_should_detect_type=False,import_as_skeletal=True,import_mesh=skeleton is None,import_animations=animations,import_materials=False,import_textures=False,create_physics_asset=False,mesh_type_to_import=U.FBXImportType.FBXIT_ANIMATION if skeleton else U.FBXImportType.FBXIT_SKELETAL_MESH,original_import_type=U.FBXImportType.FBXIT_SKELETAL_MESH).items():op.set_editor_property(k,v)
+    if skeleton:op.set_editor_property('skeleton',skeleton)
+    op.anim_sequence_import_data.set_editor_property('animation_length',U.FBXAnimationLengthImportType.FBXALIT_EXPORTED_TIME)
+    op.anim_sequence_import_data.set_editor_property('use_default_sample_rate',False)
+    op.anim_sequence_import_data.set_editor_property('custom_sample_rate',0)
+    return op
+
+try:
+    bow=import_asset(SRC/'Ventyra/ventyra_animated.fbx',ROOT+'/Ventyra','SK_Ventyra',skeletal_options())
+    source=import_asset(SRC/'Exouch_FPBow/Extracted/Default_Character.fbx',ROOT+'/Exouch','SK_Exouch',skeletal_options(animations=False))
+    skeleton=source.get_editor_property('skeleton')
+    for file in sorted((SRC/'Exouch_FPBow/Extracted').glob('*.fbx')):
+        stem=file.stem.removesuffix('_Character')
+        if stem=='Default':continue
+        name='A_FP_'+re.sub('[^a-zA-Z0-9_]','_',stem)
+        seq=import_asset(file,ROOT+'/Exouch/Animations',name,skeletal_options(skeleton))
+        seq.set_editor_property('enable_root_motion',False);seq.set_editor_property('force_root_lock',True);save(seq)
+    textures={}
+    for key in ('BaseColor','Metallic','Roughness','Emissive','Normal'):
+        tex=import_asset(SRC/('Ventyra/Extracted/Ventyra/Textures/Compressed/Ventyra_'+key+'.png'),ROOT+'/Ventyra/Textures','T_Ventyra_'+key)
+        if key in ('Metallic','Roughness'):tex.set_editor_property('srgb',False)
+        if key=='Normal':tex.set_editor_property('compression_settings',U.TextureCompressionSettings.TC_NORMALMAP);tex.set_editor_property('srgb',False)
+        save(tex);textures[key]=tex
+    import_asset(SRC/'Ventyra/Extracted/Ventyra/Textures/Compressed/Mesh maps/Ventyra_ID.png',ROOT+'/Ventyra/Textures','T_Ventyra_ID')
+    path=ROOT+'/Ventyra/M_Ventyra'
+    mat=load(path) if A.does_asset_exist(path) else AT.create_asset('M_Ventyra',ROOT+'/Ventyra',U.Material,U.MaterialFactoryNew())
+    ME.delete_all_material_expressions(mat)
+    for key,prop in {'BaseColor':U.MaterialProperty.MP_BASE_COLOR,'Metallic':U.MaterialProperty.MP_METALLIC,'Roughness':U.MaterialProperty.MP_ROUGHNESS,'Emissive':U.MaterialProperty.MP_EMISSIVE_COLOR,'Normal':U.MaterialProperty.MP_NORMAL}.items():
+        node=ME.create_material_expression(mat,U.MaterialExpressionTextureSample);node.set_editor_property('texture',textures[key])
+        if key=='Normal':node.set_editor_property('sampler_type',U.MaterialSamplerType.SAMPLERTYPE_NORMAL)
+        elif key in ('Metallic','Roughness'):node.set_editor_property('sampler_type',U.MaterialSamplerType.SAMPLERTYPE_LINEAR_COLOR)
+        assert ME.connect_material_property(node,'RGB' if key in ('BaseColor','Emissive','Normal') else 'R',prop)
+    mat.set_editor_property('used_with_skeletal_mesh',True);ME.recompile_material(mat);save(mat)
+    slots=list(bow.get_editor_property('materials'))
+    for slot in slots:slot.set_editor_property('material_interface',mat)
+    bow.set_editor_property('materials',slots)
+    save(bow)
+    op=U.FbxImportUI()
+    for k,v in dict(automated_import_should_detect_type=False,import_mesh=True,import_as_skeletal=False,import_materials=False,import_textures=False,mesh_type_to_import=U.FBXImportType.FBXIT_STATIC_MESH,original_import_type=U.FBXImportType.FBXIT_STATIC_MESH).items():op.set_editor_property(k,v)
+    for name in ('SM_R6_Ventyra','SM_R6_Arrow'):
+        mesh=import_asset(Path('E:/GameDev/Assets/HarborCity/M5_VS3_R6/Derived')/(name+'.fbx'),ROOT+'/Preview',name,op)
+        mesh.set_material(0,mat);save(mesh)
+    for label,mesh in [('ventyra',bow),('exouch',source)]:
+        R[label]={'mesh':mesh.get_path_name(),'skeleton':json.loads(U.HCM4AnimationEditor.inspect_animation_asset(mesh.get_editor_property('skeleton')))}
+    R['sequences']=[{'path':p,'duration':a.get_play_length()} for p in A.list_assets(ROOT,True,False) if isinstance(a:=A.load_asset(p),U.AnimSequence)]
+    R.update(status='PASS',visual='NOT_RUN',runtime_binding='NOT_RUN')
+except Exception:
+    R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+finally:
+    (O/'author_result.json').write_text(json.dumps(R,indent=2),encoding='utf-8')
