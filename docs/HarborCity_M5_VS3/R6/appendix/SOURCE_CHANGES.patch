+"""Publish the reviewed text-only commit via GitHub Git Data API."""
+from pathlib import Path
+import json,subprocess,os,hashlib
+import requests
+W=Path('D:/科研学习/codex学习');G=W/'docs/HarborCity_M5_VS3/R6/github';P=json.loads((G/'upload_plan.json').read_text('utf-8'));WT=Path(P['worktree']);rows=json.loads((G/'PUBLICATION_FILES.json').read_text('utf-8'))
