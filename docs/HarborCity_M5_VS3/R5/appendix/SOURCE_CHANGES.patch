@@ -0,0 +1,44 @@
+"""Read-only original FBX mesh dimensions. Export numbers, never paid geometry."""
+from pathlib import Path
+import bpy, json, math
+
+W=Path('D:/科研学习/codex学习')
+source=W/'assets/M5_VS1/hero/Selestia/Source_v1_02_b9d138dabe3d/SELESTIA.fbx'
+out=W/'docs/HarborCity_M5_VS3/R5/appendix/ARM_MESH_MEASUREMENTS.json'
+bpy.ops.wm.read_factory_settings(use_empty=True)
+bpy.ops.import_scene.fbx(filepath=str(source))
+rigs=[o for o in bpy.context.scene.objects if o.type=='ARMATURE']
+assert len(rigs)==1
+rig=rigs[0]
+rows=[]
+for part in ('UpperArm','LowerArm','Hand'):
+    for side in ('L','R'):
+        name=part+'_'+side
+        bone=rig.data.bones.get(name) or rig.data.bones.get(part+'.'+side)
+        assert bone, name
+        start=rig.matrix_world@bone.head_local;end=rig.matrix_world@bone.tail_local
+        direction=(end-start).normalized();length=(end-start).length
+        radii=[];axial=[];objects=[]
+        for mesh in [o for o in bpy.context.scene.objects if o.type=='MESH']:
+            group=mesh.vertex_groups.get(bone.name)
+            if not group:continue
+            count=0
+            for v in mesh.data.vertices:
+                weight=next((g.weight for g in v.groups if g.group==group.index),0)
+                if weight<.5:continue
+                delta=(mesh.matrix_world@v.co)-start;t=delta.dot(direction)
+                radii.append((delta-direction*t).length);axial.append(t);count+=1
+            if count:objects.append({'name':mesh.name,'vertices':count})
+        assert radii
+        radii.sort();axial.sort()
+        factor=100*1.25
+        rows.append({'bone':name,'weighted_vertex_threshold':.5,'weighted_vertices':len(radii),'objects':objects,
+                     'joint_length_cm_at_scale_1_25':length*factor,'radial_95_cm':radii[int(.95*(len(radii)-1))]*factor,'radial_max_cm':radii[-1]*factor,
+                     'axial_min_max_cm':[axial[0]*factor,axial[-1]*factor],
+                     'source_head_m':list(start),'source_tail_m':list(end)})
+allpoints=[o.matrix_world@v.co for o in bpy.context.scene.objects if o.type=='MESH' for v in o.data.vertices]
+height=max(v.z for v in allpoints)-min(v.z for v in allpoints)
+report={'status':'MEASURED_NOT_RUNTIME_ACCEPTANCE','blender_version':bpy.app.version_string,'source':str(source),'world_mesh_height_m':height,
+        'unit_assumption':'FBX imported world metres; validate full mesh height before use. Multiply 100cm/m and actor1.25. Includes authored sleeves weighted >=0.5; excludes weak skin influences.', 'arms':rows}
+out.write_text(json.dumps(report,ensure_ascii=False,indent=2),'utf-8')
+print(json.dumps({'status':report['status'],'height_m':height,'radii_95_cm':{r['bone']:r['radial_95_cm'] for r in rows}}))
