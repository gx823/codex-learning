+chunks=[];rows=[]
+for rel in sorted(set(known)):
+    f=W/rel;old=B/rel
+    if not f.is_file():raise RuntimeError(rel)
+    before=old.read_text('utf-8-sig').splitlines(keepends=True) if old.exists() else []
+    after=f.read_text('utf-8-sig').splitlines(keepends=True)
+    if before==after:continue
+    chunks.append('diff --git a/'+rel+' b/'+rel+'\n')
