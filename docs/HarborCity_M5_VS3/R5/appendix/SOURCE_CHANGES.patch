+"""R5 ivory/gold material author. Prepared offline; enable only at task D."""
+from pathlib import Path
+import unreal as U,json,re,traceback,hashlib
+APPLY=True
+W=Path('D:/科研学习/codex学习');R5=W/'docs/HarborCity_M5_VS3/R5';ROOT='/Game/HarborCity/M5VS3/R5/Weapons/Materials'
+A=U.EditorAssetLibrary;AT=U.AssetToolsHelpers.get_asset_tools();ME=U.MaterialEditingLibrary
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line());O=Path(m[1] or m[2]);R={'status':'PREPARED_NOT_APPLIED','apply':APPLY,'visual':'NOT_RUN','assets':[]}
+def load(p):
+ a=A.load_asset(p);assert a,p;return a
+def save(a):assert A.save_loaded_asset(a,False)
+def node(m,c,**props):
+ n=ME.create_material_expression(m,c)
+ for k,v in props.items():n.set_editor_property(k,v)
+ return n
+def link(a,b,pin):assert ME.connect_material_expressions(a,'',b,pin)
+def prop(a,p):assert ME.connect_material_property(a,'',p)
+def constant(m,v):return node(m,U.MaterialExpressionConstant,r=v)
+def custom(m,code,inputs,vector=False):
+ n=node(m,U.MaterialExpressionCustom,code=code,output_type=U.CustomMaterialOutputType.CMOT_FLOAT3 if vector else U.CustomMaterialOutputType.CMOT_FLOAT1);pins=[]
+ for k in inputs:p=U.CustomInput();p.set_editor_property('input_name',k);pins.append(p)
+ n.set_editor_property('inputs',pins)
+ for k,v in inputs.items():link(v,n,k)
+ return n
+def material(name):
+ p=ROOT+'/'+name;a=load(p) if A.does_asset_exist(p) else AT.create_asset(name,ROOT,U.Material,U.MaterialFactoryNew());ME.delete_all_material_expressions(a);return a
+def linear(byte):
+ x=byte/255.;return x/12.92 if x<=.04045 else ((x+.055)/1.055)**2.4
+def backup(p):
+ f=W/'HarborCity/Content'/Path(p.removeprefix('/Game/')+'.uasset');b=R5/'private_asset_backup'/f.name
+ b.parent.mkdir(exist_ok=True)
+ if not b.exists():b.write_bytes(f.read_bytes())
+ R.setdefault('prior_assets',[]).append({'asset':p,'sha256':hashlib.sha256(f.read_bytes()).hexdigest()})
+try:
+ if APPLY:
+  assert isinstance(json.loads((R5/'WORK_CHECKPOINT.json').read_text('utf-8'))['intermediate_shipping'],dict),'A intermediate Shipping must exist'
+  ivory=tuple(linear(x) for x in (225,215,195));gold=tuple(linear(x) for x in (215,190,130));src='/Game/Purchased/HarborCityR2/Steampunk/Textures/'
+  textures={k:load(src+'T_Steampunk_Pistol_'+v) for k,v in {'color':'Color_2','metal':'Metallic','normal':'Normal','rough':'Roughness'}.items()}
+  mat=material('M_R5_ArcaneIvory');samples={k:node(mat,U.MaterialExpressionTextureSample,texture=t) for k,t in textures.items()};samples['normal'].set_editor_property('sampler_type',U.MaterialSamplerType.SAMPLERTYPE_NORMAL)
+  code='float l=dot(C.rgb,float3(.2126,.7152,.0722));float mask=saturate(M.r);float mean=lerp(.02916817,.21900968,mask);float detail=clamp(lerp(1.,l/max(mean,.0001),.5),.45,1.55);return lerp(float3(%s),float3(%s),mask)*detail;'%(','.join(map(str,ivory)),','.join(map(str,gold)))
+  prop(custom(mat,code,{'C':samples['color'],'M':samples['metal']},True),U.MaterialProperty.MP_BASE_COLOR)
+  prop(custom(mat,'return lerp(.03,.9,saturate(M.r));',{'M':samples['metal']}),U.MaterialProperty.MP_METALLIC)
+  prop(custom(mat,'return lerp(clamp(R.r,.2,.85),clamp(R.r,.3,.45),saturate(M.r));',{'R':samples['rough'],'M':samples['metal']}),U.MaterialProperty.MP_ROUGHNESS)
+  prop(samples['normal'],U.MaterialProperty.MP_NORMAL);prop(constant(mat,0),U.MaterialProperty.MP_EMISSIVE_COLOR);ME.recompile_material(mat);save(mat)
+  goldmat=material('M_R5_PaleGold');prop(node(goldmat,U.MaterialExpressionConstant3Vector,constant=U.LinearColor(*gold,1)),U.MaterialProperty.MP_BASE_COLOR);prop(constant(goldmat,.9),U.MaterialProperty.MP_METALLIC);prop(constant(goldmat,.36),U.MaterialProperty.MP_ROUGHNESS);ME.recompile_material(goldmat);save(goldmat)
+  meshpath='/Game/HarborCity/M5VS3/R4/Weapons/Meshes/SM_Arcane';datapath='/Game/HarborCity/M5VS3/R4/Armory/DA_Arcane';backup(meshpath);backup(datapath)
+  mesh=load(meshpath);b=mesh.get_bounding_box();bounds=[b.min.x,b.min.y,b.min.z,b.max.x,b.max.y,b.max.z];blue=load('/Game/HarborCity/M5VS3/R4/Weapons/Materials/M_R4_Crystal');materials=[]
+  for i,slot in enumerate(mesh.get_editor_property('static_materials')):
+   name=str(slot.material_slot_name);chosen=blue if 'Crystal' in name else goldmat if 'Gold' in name else mat;mesh.set_material(i,chosen);materials.append(chosen)
+  b=mesh.get_bounding_box();after_bounds=[b.min.x,b.min.y,b.min.z,b.max.x,b.max.y,b.max.z];assert max(abs(x-y) for x,y in zip(bounds,after_bounds))<.001;R['mesh_bounds_before']=bounds;R['mesh_bounds_after']=after_bounds;save(mesh)
+  data=load(datapath);paints=list(data.get_editor_property('paints'));paints[0].set_editor_property('materials',materials);data.set_editor_property('paints',paints);save(data)
+  R.update(status='PASS',geometry='unchanged; material slots only',ivory_srgb=[225,215,195],gold_srgb=[215,190,130],detail_strength=.5,metallic=.9,metal_roughness=[.3,.45],body_emission=0,source_normal_connected=True,source_roughness_connected=True,assets=[mat.get_path_name(),goldmat.get_path_name()])
+except Exception:R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+finally:(O/'author_result.json').write_text(json.dumps(R,ensure_ascii=False,indent=2),'utf-8')
