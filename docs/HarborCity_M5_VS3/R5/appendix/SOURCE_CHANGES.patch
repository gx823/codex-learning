diff --git a/tools/hc_r5_a_regression_queue.ps1 b/tools/hc_r5_a_regression_queue.ps1
--- /dev/null
+++ b/tools/hc_r5_a_regression_queue.ps1
@@ -0,0 +1,30 @@
+#requires -Version 7.0
+$ErrorActionPreference='Stop'
+$workspace=Split-Path $PSScriptRoot -Parent
+$doc=Join-Path $workspace 'docs/HarborCity_M5_VS3/R5'
+$batch=Join-Path $doc ('a_regressions_'+(Get-Date -Format 'yyyyMMdd_HHmmss'))
+New-Item -ItemType Directory -Path $batch | Out-Null
+$jobs=@(
+ @{name='extra2';Mode='m5_vs3_r3_b';R4Case='r5aextra2'},
+ @{name='fp10';Mode='m5_vs3_r3_b';R4Case='r5afp'},
+ @{name='near_fist';Mode='m5_vs3_r3_b';R4Case='r5afist'},
+ @{name='sword_matrix';Mode='m5_vs3_r2_matrix';MatrixCaps='20,30,60'},
+ @{name='old_melee';Mode='m4_melee'},
+ @{name='old_r2_combat';Mode='m4_r2_combat'}
+)
+$rows=[Collections.Generic.List[object]]::new()
+foreach($job in $jobs){
+ $params=@{};foreach($key in $job.Keys){if($key -ne 'name'){$params[$key]=$job[$key]}}
+ & (Join-Path $PSScriptRoot 'run_m5_vs3_r5.ps1') @params *> (Join-Path $batch ($job.name+'.log'))
+ $active=Get-Content -LiteralPath (Join-Path $doc 'ACTIVE_RUN.json') -Raw | ConvertFrom-Json
+ if($active.status -ne 'EXITED' -or $active.exit_code -ne 0){throw ('Stop queue after '+$job.name+': '+$active.status)}
+ $resultFiles=@(Get-ChildItem -LiteralPath (Join-Path $active.run 'User/Saved') -Recurse -File -Filter results.json)
+ if($resultFiles.Count -ne 1){throw 'Expected exactly one result file in the exact completed run'}
+ $result=Get-Content -LiteralPath $resultFiles[0].FullName -Raw | ConvertFrom-Json
+ $rows.Add([ordered]@{job=$job.name;run=$active.run;results=$resultFiles[0].FullName;status=$result.status;checks=@($result.checks).Count;failures=$result.failures})
+ $rows|ConvertTo-Json -Depth 5|Set-Content -LiteralPath (Join-Path $batch 'results.json') -Encoding utf8
+ # Functional failures remain in each original result and never become current:false.
+ # Only host/stop/abnormal exit stops these independent regression jobs.
+ if($result.status -ne 'COMPLETE'){throw ('Incomplete '+$job.name)}
+}
+Write-Output $batch
