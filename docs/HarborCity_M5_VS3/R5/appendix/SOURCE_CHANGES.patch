+"""R5 measured long-hair capsule author; dry-run until baseline/intermediate gate."""
+from pathlib import Path
+import unreal as U
+import json, re, hashlib, shutil, traceback
+
+APPLY=True
+W=Path('D:/科研学习/codex学习');R5=W/'docs/HarborCity_M5_VS3/R5'
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line());O=Path(m[1] or m[2]);R={'status':'RUNNING','apply':APPLY,'runtime':'NOT_RUN'}
+path='/Game/HarborCity/M5VS2/HeroSelestia/Animation/GASMotion/Batch_7a9c9d9d2395/ABP_TownFlight'
+disk=W/'HarborCity/Content'/Path(path.removeprefix('/Game/')+'.uasset')
+try:
+    bp=U.EditorAssetLibrary.load_asset(path);assert bp
+    before=disk.read_bytes();R['before_sha256']=hashlib.sha256(before).hexdigest()
+    prior=json.loads(U.HCM5VS2PhysicsEditor.read_physics_setup(bp));assert prior['status']=='READBACK_COMPLETE'
+    if APPLY:
+        cp=json.loads((R5/'WORK_CHECKPOINT.json').read_text('utf-8'));assert isinstance(cp['intermediate_shipping'],dict) and cp['b_baseline']['status']=='COMPLETE', 'Intermediate Shipping and actual hair baseline required'
+        backup=R5/'private_asset_backup/ABP_TownFlight_before_R5_hair.uasset';backup.parent.mkdir(exist_ok=True)
+        if not backup.exists():backup.write_bytes(before)
+    config=(R5/'appendix/HAIR_COLLISION_PROPOSAL.json').read_text('utf-8')
+    R['native']=json.loads(U.HCM5VS3R5Editor.configure_hair_capsules(bp,config,APPLY));assert R['native']['status']=='PASS'
+    after=json.loads(U.HCM5VS2PhysicsEditor.read_physics_setup(bp));assert after['status']=='READBACK_COMPLETE'
+    targets={'M5VS2_Physics_LongHair','M5VS2_Physics_SideLong'}
+    untouched=lambda data:{n['name']:n['node_properties'] for n in data['nodes'] if n['name'] not in targets}
+    assert untouched(prior)==untouched(after),'Other cloth nodes changed'
+    R['other_cloth_nodes_unchanged']=True
+    if APPLY:
+        expected={'UpperArm_L','UpperArm_R','LowerArm_L','LowerArm_R','Hand_L','Hand_R'}
+        for n in after['nodes']:
+            if n['name'] not in targets:continue
+            names=[c['drivingBone']['boneName'] for c in n['node_properties']['CapsuleLimits']]
+            assert all(names.count(b)==1 for b in expected),names
+        assert U.EditorAssetLibrary.save_loaded_asset(bp,False)
+    else:assert disk.read_bytes()==before,'Dry run touched asset on disk'
+    R['after_sha256']=hashlib.sha256(disk.read_bytes()).hexdigest();R['status']='PASS';R['readback']=after
+except Exception:
+    R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+finally:(O/'author_result.json').write_text(json.dumps(R,ensure_ascii=False,indent=2),'utf-8')
