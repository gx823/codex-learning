+"""Read original Unity archive; export only numeric tables, keep YAML private."""
+from pathlib import Path
+import hashlib, json, re, tarfile
+import yaml
+
+ROOT = Path('D:/科研学习/codex学习')
+SOURCE = ROOT / 'assets/M5_VS1/hero/Selestia/Source_v1_02_b9d138dabe3d/SELESTIA_SDK3.unitypackage'
+PRIVATE = SOURCE.parent / 'R5_private_physics'
+OUT = ROOT / 'docs/HarborCity_M5_VS3/R5/appendix'
+PRIVATE.mkdir(exist_ok=True)
+OUT.mkdir(exist_ok=True)
+reports = []
+with tarfile.open(SOURCE) as archive:
+    paths = {m.name.rsplit('/', 1)[0]: archive.extractfile(m).read().decode('utf-8-sig').strip()
+             for m in archive.getmembers() if m.name.endswith('/pathname')}
+    for guid, path in paths.items():
+        if not path.endswith(('SELESTIA_lilToon.prefab', 'SELESTIA_UTS.prefab')):
+            continue
+        raw = archive.extractfile(guid + '/asset').read()
+        (PRIVATE / Path(path).name).write_bytes(raw)
+        docs = {}
+        for match in re.finditer(r'^--- !u!(\d+) &(\d+)[^\n]*\n(.*?)(?=^--- |\Z)', raw.decode('utf-8-sig'), re.M | re.S):
+            kind, ident, body = match.groups()
+            docs[int(ident)] = (int(kind), next(iter(yaml.safe_load(body).values())))
+        transforms = {key: value for key, (kind, value) in docs.items() if kind == 4}
+        by_go = {v['m_GameObject']['fileID']: key for key, v in transforms.items()}
+        def bone(ident):
+            if not ident or ident not in transforms: return ''
+            tr = transforms[ident]
+            name = docs[tr['m_GameObject']['fileID']][1]['m_Name']
+            parent = bone(tr['m_Father']['fileID'])
+            return parent + '/' + name if parent else name
+        def transform_info(ident):
+            chain = []; scale = [1., 1., 1.]
+            while ident and ident in transforms:
+                tr = transforms[ident]
+                for i, axis in enumerate('xyz'): scale[i] *= tr['m_LocalScale'][axis]
+                chain.append({'bone': bone(ident), 'position': tr['m_LocalPosition'], 'rotation': tr['m_LocalRotation'], 'scale': tr['m_LocalScale']})
+                ident = tr['m_Father']['fileID']
+            return scale, chain
+        chains, colliders = [], []
+        for ident, (kind, obj) in docs.items():
+            if kind != 114: continue
+            root = obj.get('rootTransform', {}).get('fileID', 0) or by_go.get(obj.get('m_GameObject', {}).get('fileID'), 0)
+            scale, hierarchy = transform_info(root)
+            common = {'component_id': ident, 'root_bone': bone(root), 'enabled': obj.get('m_Enabled'), 'cumulative_scale': scale}
+            if all(k in obj for k in ('pull', 'spring', 'stiffness', 'immobile', 'radius')):
+                fields = ('integrationType', 'pull', 'spring', 'stiffness', 'gravity', 'gravityFalloff', 'immobileType', 'immobile', 'limitType', 'maxAngleX', 'maxAngleZ', 'limitRotation', 'radius', 'allowCollision')
+                curves = {k: [{'time': p['time'], 'value': p['value']} for p in obj.get(k, {}).get('m_Curve', [])]
+                          for k in (f + 'Curve' for f in fields) if obj.get(k, {}).get('m_Curve')}
+                chains.append(common | {k: obj.get(k) for k in fields} | {'curves': curves, 'collider_ids': [v['fileID'] for v in obj.get('colliders', [])]})
+            elif all(k in obj for k in ('radius', 'height', 'shapeType', 'position')):
+                colliders.append(common | {k: obj.get(k) for k in ('shapeType', 'radius', 'height', 'position', 'rotation', 'insideBounds')} | {'transform_hierarchy': hierarchy})
+        reports.append({'prefab': Path(path).name, 'prefab_sha256': hashlib.sha256(raw).hexdigest(), 'physbones': chains, 'colliders': colliders})
+report = {'status': 'FOUND', 'source_sha256': hashlib.file_digest(SOURCE.open('rb'), 'sha256').hexdigest(), 'source_bytes': SOURCE.stat().st_size,
+          'units': 'Original Unity local units, dimensionless settings and authored degrees; cm conversion requires ancestor scale and UE axis conversion. Not an official PhysBone to Kawaii conversion.', 'prefabs': reports}
+(OUT / 'SELESTIA_PHYSBONE_VALUES.json').write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding='utf-8')
+lines = ['# Selestia 原作物理数值（只读提取）', '', 'FOUND。原始 YAML 仅保存在本机 assets 下，不属于公开交付。JSON 为所需的数值、曲线采样与骨骼映射。', '',
+         '半径、高度、偏移保留 Unity 局部单位；不得未经祖先缩放、模型尺寸、坐标轴核验直接套入 UE。Spring 字段按原名保留，未假定与所有 PhysBone 版本的 Momentum 完全相同。', '']
+for r in reports:
+    lines += [f"## {r['prefab']}", '', f"PhysBone {len(r['physbones'])} 条；Collider {len(r['colliders'])} 个。", '', '|碰撞骨骼|形状编号|半径|高度|偏移 xyz|祖先累计缩放|', '|---|---:|---:|---:|---|---|']
+    for c in r['colliders']:
+        lines.append(f"|{c['root_bone']}|{c['shapeType']}|{c['radius']}|{c['height']}|{c['position']}|{c['cumulative_scale']}|")
+    lines += ['', '|头发根骨骼|Pull|Spring|Stiffness|Gravity|Immobile|限角 X/Z|半径|', '|---|---:|---:|---:|---:|---:|---|---:|']
+    for c in r['physbones']:
+        if 'hair' in c['root_bone'].lower():
+            lines.append(f"|{c['root_bone']}|{c['pull']}|{c['spring']}|{c['stiffness']}|{c['gravity']}|{c['immobile']}|{c['maxAngleX']}/{c['maxAngleZ']}|{c['radius']}|")
+lines += ['', '## Kawaii 对应关系（本轮建议，非官方换算）', '', '|原参数|Kawaii 参考项|限制|', '|---|---|---|',
+          '|Pull / Stiffness|Stiffness 与 Rest 骨架回复|综合拟合，不能直接相等|', '|Spring / Momentum|Damping|用实际摆动衰减时间拟合，不按 1−Spring 直接替代|',
+          '|Gravity / Falloff|Gravity 与链深度分布|先核验方向与单位|', '|Immobile|WorldDamping / LocationDamping|控制角色运动惯性，非相同求解模型|',
+          '|Limit X/Z / rotation|LimitAngle 与骨骼参考朝向|Kawaii 单角锥不能精确表达原二维限制|', '|Radius / Collider|PhysicsSettings.Radius / CapsuleLimits|按骨骼空间和实际比例转换；运行时逐帧验证|', '',
+          '本表只确认原作数据存在，尚未表示 UE 映射或防穿验收通过。']
