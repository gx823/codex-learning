+$desktop=[HCR5HostDesktop]::OpenInputDesktop(0,$false,1)
+$desktopError=[Runtime.InteropServices.Marshal]::GetLastWin32Error()
+$name=[Text.StringBuilder]::new(256);$needed=[uint32]0;$named=$false
+if($desktop -ne [IntPtr]::Zero){try{$named=[HCR5HostDesktop]::GetUserObjectInformation($desktop,2,$name,512,[ref]$needed)}finally{[void][HCR5HostDesktop]::CloseDesktop($desktop)}}
+$session=(Get-Process -Id $PID).SessionId;$buffer=[IntPtr]::Zero;$bytes=0
