+from pathlib import Path
+import csv,json,re,sys,statistics
+p=Path(sys.argv[1]);data=json.loads((p/'results.json').read_text('utf-8-sig'))
+if data['status']!='COMPLETE':raise SystemExit('Only completed runs can be summarized')
+rows=[]
+for f in sorted(p.glob('*_observation.txt')):
+    name=f.stem.removesuffix('_observation');s=f.read_text('utf-8-sig');m={k:float(v) for k,v in re.findall(r'(\w+)=(-?\d+(?:\.\d+)?)',s)}
+    c=p/(name+'.csv')
+    if c.exists():
+        frames=list(csv.DictReader(c.open(encoding='utf-8-sig',newline='')))
+        first=next((i for i,r in enumerate(frames) if r['falling']=='1'),None)
+        landed=next((i for i,r in enumerate(frames) if first is not None and i>first and r['falling']=='0'),None)
+        if first is not None and landed is not None:
