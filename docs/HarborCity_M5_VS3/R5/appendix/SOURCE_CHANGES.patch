+from pathlib import Path
+from PIL import Image
+import numpy as np, json, hashlib
+
+W=Path('D:/科研学习/codex学习')
+P=Path('E:/GameDev/Assets/HarborCity/M5_VS3_R2/Purchased/Steampunk/steampunk_pistol_ue_texture')
+files={k:P/('T_Steampunk_Pistol_'+v+'.png') for k,v in [('color','Color_2'),('metallic','Metallic'),('normal','Normal'),('roughness','Roughness')]}
+im=np.asarray(Image.open(files['color']).convert('RGBA'),dtype=np.float32)/255
+rgb=im[:,:,:3];linear=np.where(rgb<=.04045,rgb/12.92,((rgb+.055)/1.055)**2.4)
+lum=linear@np.array([.2126,.7152,.0722],dtype=np.float32)
+metal=np.asarray(Image.open(files['metallic']).convert('L'),dtype=np.float32)/255
+valid=(im[:,:,3]>.5)&(lum>.003)
+stats={}
+for name,mask in [('all_valid',valid),('nonmetal',valid&(metal<.5)),('metal',valid&(metal>=.5))]:
+    assert np.count_nonzero(mask)>0
+    stats[name]={'pixels':int(np.count_nonzero(mask)),'linear_luminance_mean':float(lum[mask].mean()),'linear_luminance_p05_p95':np.percentile(lum[mask],[5,95]).tolist()}
+report={'status':'SOURCE_MEASURED_SHADER_CAUSE_CONFIRMED_NOT_VISUAL_ACCEPTANCE',
+        'method':'sRGB to linear, alpha>0.5 and linear luminance>0.003; source metallic mask splits; texture-space statistic, not UV area-weighted surface statistic',
+        'source_files':{k:{'file':str(v),'sha256':hashlib.sha256(v.read_bytes()).hexdigest(),'bytes':v.stat().st_size} for k,v in files.items()},'statistics':stats,
+        'R4_code_causes':['M_ArcaneIvory log2 contrast strength 0.09 and clamp 0.70..1.07 suppress texture contrast',
+                          'Normal source texture never connected; roughness replaced by constant0.4',
+                          'Metallic is only source mask*0.38',
+                          'BaseColor multiplied1.1 feeds Emissive, washing out view-dependent lighting',
+                          'Only material slot names containing Gold get gold; original spiral shares original body material and loses its original material-mask gold'],
+        'proposal':{'detail_strength':.5,'ivory_srgb':[225,215,195],'gold_srgb':[215,190,130],'metallic':.9,'gold_roughness':.38,'original_normal':True,'original_roughness':True,'body_emission':0},
+        'limitations':'Three in-game color samples and same-camera R4/R5 comparison NOT_RUN. Source equation confirmed; no unsupported blame on global toon lighting.'}
+out=W/'docs/HarborCity_M5_VS3/R5/appendix/GUN_MATERIAL_AUDIT.json'
+out.write_text(json.dumps(report,ensure_ascii=False,indent=2),'utf-8')
+print(json.dumps(stats))
