 void AHCM1Character::Tick(float DeltaSeconds)
 {
     Super::Tick(DeltaSeconds);
+    const bool MobileCombat=IsMobileCombatActive();
+    if(MobileCombat&&!bMobileFacingOverride){bMobilePreviousOrient=bFacingBody?bPreviousOrientToMovement:GetCharacterMovement()->bOrientRotationToMovement;bMobileFacingOverride=true;GetCharacterMovement()->bOrientRotationToMovement=false;}
+    else if(!MobileCombat&&bMobileFacingOverride){bMobileFacingOverride=false;StopBodyFacing();GetCharacterMovement()->bOrientRotationToMovement=bMobilePreviousOrient;}
+    if(CombatJumpDeadline>0){
+        const bool InWindow=Combat->IsHitWindowOpen()||Abilities->IsSwordWindowOpen();
+        if(GetWorld()->GetTimeSeconds()>CombatJumpDeadline||!Combat->CanUseCombat())CombatJumpDeadline=0;
+        else if(!InWindow){CombatJumpDeadline=0;RequestMeleeJump();}
+    }
+    if(IsMobileCombatActive()&&FMath::Abs(FMath::FindDeltaAngleDegrees(GetActorRotation().Yaw,GetControlRotation().Yaw))>60.f&&!bFacingBody)
+        FaceBodyYawOnce(GetControlRotation().Yaw,.1f);
     const AHCM1PlayerController* LocalPC = Cast<AHCM1PlayerController>(GetController());
     if ((!Flight || !Flight->IsFlying()) && LocalPC && LocalPC->GetPlayerMode() == EHCPlayerMode::OnFoot && LocalPC->IsFirstPersonPerspective()
         && !LocalPC->IsPauseMenuOpen() && !LocalPC->IsDialogueOpen() && Combat && Combat->GetPlayerHealth() > 0)
-        FaceBodyYawOnce(LocalPC->GetControlRotation().Yaw, .2f);
+        FaceBodyYawOnce(LocalPC->GetControlRotation().Yaw, IsMobileCombatActive()?.1f:.2f);
     if (bFacingBody)
     {
-        const float Next = HCM4Facing::StepYaw(GetActorRotation().Yaw, BodyTargetYaw, DeltaSeconds, 360.f);
+        const float Next = HCM4Facing::StepYaw(GetActorRotation().Yaw, BodyTargetYaw, DeltaSeconds, CombatBodyTurnRate);
         SetActorRotation(FRotator(0,Next,0));
         if (FMath::Abs(FMath::FindDeltaAngleDegrees(Next, BodyTargetYaw)) < 1.f || GetWorld()->GetTimeSeconds() >= BodyFacingUntil)
             StopBodyFacing();
     }
 }
 
+bool AHCM1Character::NeedsMobileCombatPose() const
+{return GetCharacterMovement()->IsFalling()||GetVelocity().Size2D()>=10.f;}
+bool AHCM1Character::IsMobileCombatActive() const
+{return Abilities&&Abilities->IsEnabled()&&((Abilities->UsesMobileAttackPose())||(Combat&&Combat->UsesMobileAttackPose()));}
+bool AHCM1Character::ConsumeAirMelee()
+{
+    if(!GetCharacterMovement()->IsFalling())return true;
+    if(AirMeleeCount>=2)return false;
+    ++AirMeleeCount;return true;
+}
+void AHCM1Character::Landed(const FHitResult& Hit)
+{Super::Landed(Hit);AirMeleeCount=0;}
+void AHCM1Character::RequestMeleeJump()
+{
+    if(!Abilities||!Abilities->IsEnabled()){DoJumpStart();return;}
+    if(!Combat||!Combat->CanUseCombat()||Abilities->IsSpellPoseActive())return;
+    if(Abilities->IsSwordWindowOpen()||Combat->IsHitWindowOpen()){
+        if(CombatJumpDeadline<=0)CombatJumpDeadline=GetWorld()->GetTimeSeconds()+.2;
+        return;
+    }
+    Abilities->CancelMeleeRecovery();Combat->CancelPunchRecovery();
+    if(auto* Anim=GetMesh()->GetAnimInstance())Anim->SetRootMotionMode(ERootMotionMode::IgnoreRootMotion);
+    DoJumpStart();
+}
+
 void AHCM1Character::SetSeated(bool bSeated)
 {
+    CombatJumpDeadline=0;AirMeleeCount=0;
+    if(bMobileFacingOverride){bMobileFacingOverride=false;GetCharacterMovement()->bOrientRotationToMovement=bMobilePreviousOrient;}
     if (Flight) Flight->ResetForGroundTransition();
     StopBodyFacing();
     StopJumping();
