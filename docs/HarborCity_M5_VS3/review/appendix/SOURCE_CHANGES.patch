+void UHCM5VS3Abilities::WeaponChanged(){if(!bEnabled)return;ResetTransient();PlayPose(Combat->GetWeaponMode()==EHCM4WeaponMode::Sword?TEXT("A_SwordDraw"):TEXT("A_SwordSheath"),.55f);}
+bool UHCM5VS3Abilities::PressSword(){
