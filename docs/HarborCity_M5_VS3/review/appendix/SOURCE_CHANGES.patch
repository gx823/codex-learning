+    bHeld=true;HoldTime=0;IdleMP=0;Hero->SetCombatMovementScale(.4f);Hero->FaceBodyYawOnce(Hero->GetControlRotation().Yaw,1.5f);PlayPose(TEXT("A_SwordCharge"),1.f);return true;
