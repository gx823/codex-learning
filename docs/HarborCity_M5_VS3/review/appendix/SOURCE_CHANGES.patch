+    if(Arms){FTransform FM=FTransform(FRotator(70,0,0))*Arms->GetSocketTransform(Arms->DoesSocketExist(TEXT("HandGrip_R"))?FName(TEXT("HandGrip_R")):Hand(Arms));FM.SetScale3D(FVector(1));FirstSword->SetWorldTransform(FM);}
