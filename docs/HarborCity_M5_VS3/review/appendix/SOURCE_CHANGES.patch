+void UHCM5VS3Abilities::ResetTransient(){bHeld=false;SwingTime=0;CastKind=-1;RuneKind=-1;bBladeSample=false;if(Hero)Hero->SetCombatMovementScale(1);for(const auto& M:RuneLayers)if(M)M->SetVisibility(false);}
