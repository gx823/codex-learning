+"""Summarize explicit final-candidate runs; never merge retries or infer missing passes."""
+import argparse
+import csv
+import hashlib
+import json
+from pathlib import Path
+
+DOC = Path('D:/科研学习/codex学习/docs/HarborCity_M5_VS4/R2')
+ap = argparse.ArgumentParser()
+ap.add_argument('--ledger', action='append', type=Path, required=True)
+ap.add_argument('--regression-run', type=Path)
+a = ap.parse_args()
+
+def read(p):
+    return json.loads(p.read_text('utf-8-sig'))
+
+def digest(p):
+    with p.open('rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+def relative(p):
+    return p.resolve().relative_to(DOC.resolve()).as_posix()
+
+plan = read(DOC/'final/FINAL_TEST_PLAN.json')
+assert digest(Path(plan['executable'])).upper() == plan['sha256']
+summary = dict(status='EVIDENCE_SUMMARY_NOT_OVERALL_ACCEPTANCE',
+               executable=plan['executable'], sha256=plan['sha256'], jobs=[],
+               full_regression=dict(status='NOT_RUN'),
+               art='USER_REVIEW', sprint_ten_sessions='NOT_RUN_NOT_REQUIRED_R2')
+seen = set()
+
+def collect(run, identity):
+    run = run.resolve()
+    assert run.parent == DOC.resolve()
+    launch, end = read(run/'launch.json'), read(run/'exit.json')
+    assert launch['kind'] == 'STANDALONE_PACKAGE'
+    assert launch['executable_sha256'] == plan['sha256']
+    assert end['status'] == 'EXITED' and end['exit_code'] == 0
+    native = sorted((run/'User/Saved/M5Tests').rglob('results.json'))
+    assert native
+    row = dict(id=identity, run=relative(run), launch_sha256=digest(run/'launch.json'),
+               actual_maps=end['actual_maps'], ac=launch['host']['ac_line'],
+               unlocked=launch['host']['input_desktop']['available'], reports=[])
+    for p in native:
+        r = read(p)
+        assert r['status'] == 'COMPLETE'
+        row['reports'].append(dict(file=relative(p), sha256=digest(p), map=r['map'],
+                                   checks=len(r['checks']), failures=r['failures'],
+                                   check_results=r['checks']))
+    row['status'] = 'FAIL' if any(r['failures'] for r in row['reports']) else 'PASS'
+    extras = {}
+    for name in ('R2_EXPLORATION_SUMMARY.txt', 'R6_FULL_VFX_USAGE.json'):
+        files = list(native[0].parent.glob(name))
+        if files:
+            extras[name] = read(files[0]) if name.endswith('.json') else files[0].read_text('utf-8-sig')
+    if (run/'performance_summary.json').exists():
+        extras['performance'] = read(run/'performance_summary.json')['views']
+    if (run/'bow_diagnostic_summary.json').exists():
+        extras['bow'] = read(run/'bow_diagnostic_summary.json')
+    attempts = native[0].parent/'R2_C1_ATTEMPTS.csv'
+    if attempts.exists():
+        with attempts.open(encoding='utf-8-sig', newline='') as f:
+            values = list(csv.DictReader(f))
+        extras['C1'] = []
+        for case in sorted({r['case'] for r in values}):
+            rows = [r for r in values if r['case'] == case]
+            extras['C1'].append(dict(case=case, attempts=len(rows),
+                hits=sum(r['hit']=='1' for r in rows), invalid=sum(r['valid']=='0' for r in rows),
+                min_release_cm=min(float(r['release_cm']) for r in rows),
+                max_release_cm=max(float(r['release_cm']) for r in rows)))
+    row['measurements'] = extras
+    return row
+
+for ledger in a.ledger:
+    ledger = ledger.resolve()
+    assert ledger.parent == (DOC/'final').resolve()
+    batch = read(ledger)
+    assert batch['status'] == 'COMPLETE_SEE_INDIVIDUAL_RESULTS' and batch['sha256'] == plan['sha256']
+    for job in batch['jobs']:
+        assert job['id'] not in seen, 'Repeated job would mix runs'
+        seen.add(job['id'])
+        row = collect(Path(job['run']), job['id'])
+        row['batch'] = relative(ledger)
+        summary['jobs'].append(row)
+
+if a.regression_run:
+    row = collect(a.regression_run, 'unique_full_regression')
+    assert '-M5Test=m5_full' in read(a.regression_run/'launch.json')['arguments']
+    usage = row['measurements'].get('R6_FULL_VFX_USAGE.json', {})
+    row['coverage'] = {kind: dict(used=sum(v > 0 for v in usage.get(kind, {}).values()),
+                                total=len(usage.get(kind, {}))) for kind in ('systems', 'sounds')}
+    row['minimum_235_checks'] = sum(r['checks'] for r in row['reports']) >= 235
+    summary['full_regression'] = row
+
+thermal = read(DOC/'thermal_20261004_144243_506/thermal_summary.json')
+assert thermal['sha256'] == plan['sha256']
+summary['D'] = thermal
+summary['source_policy'] = 'Exact individual final runs, including FAILs. No editor or prior-candidate substitution.'
+out = DOC/'appendix/FINAL_RUNTIME_EVIDENCE.json'
+out.write_text(json.dumps(summary, ensure_ascii=False, indent=2)+'\n', 'utf-8')
+ground_path = DOC/'editor/20261002_202135_434_B2_full_ground_04_infill/author_result.json'
+ground = read(ground_path)
+ground_review = dict(status=ground['building_ground'], source=relative(ground_path),
+    source_sha256=digest(ground_path), map=ground['map'], method=ground['method'],
+    scope='Native editor four-corner audit of620 building placements. Later detail/paint pass leaves these buildings and landscape height unchanged; not runtime whole-scene collision proof.',
+    count=len(ground['buildings']), max_abs_gap_cm=ground['max_abs_gap_cm'],
+    buildings=[{k:r[k] for k in ('id','gaps_cm','max_abs_gap_cm','ground')} for r in ground['buildings']])
+(DOC/'appendix/FINAL_GROUND_CHECKS.json').write_text(json.dumps(ground_review, indent=2)+'\n', 'utf-8')
+print(json.dumps(dict(file=str(out), jobs=[dict(id=r['id'], status=r['status']) for r in summary['jobs']],
+                      full_regression=summary['full_regression'].get('status'), D=thermal['status'])))

