+
+void UHCM5VS4GraphicsSettings::Initialize(FSubsystemCollectionBase& Collection)
+{
+    Super::Initialize(Collection);
+    // Core ticker continues while the world is paused. Never save temporary caps.
+    TickHandle = FTSTicker::GetCoreTicker().AddTicker(
+        FTickerDelegate::CreateUObject(this, &ThisClass::UpdateLimit), .1f);
+    ThermalProbeHandle=StartHCM5VS4ThermalProbe(this);
+}
+
+void UHCM5VS4GraphicsSettings::Deinitialize()
+{
+    FTSTicker::GetCoreTicker().RemoveTicker(TickHandle);
+    FTSTicker::GetCoreTicker().RemoveTicker(ThermalProbeHandle);
+    if (bTemporaryOverride && GEngine)
+        if (auto* Settings = UGameUserSettings::GetGameUserSettings())
+            GEngine->SetMaxFPS(Settings->GetFrameRateLimit());
+    Super::Deinitialize();
+}
+
+float UHCM5VS4GraphicsSettings::ResolveLimit(float UserLimit, bool Paused, bool Background)
+{
+    const float Temporary = Background ? 10.f : Paused ? 30.f : 0.f;
+    if (Temporary <= 0) return UserLimit;
+    return UserLimit > 0 ? FMath::Min(UserLimit, Temporary) : Temporary;
+}
+
+int32 UHCM5VS4GraphicsSettings::QualityPreset(const UGameUserSettings* Settings)
+{
+    if(!Settings)return -1;
+    // Resolution percentage is independent of the eleven visual-quality groups.
+    const int32 Value=Settings->GetViewDistanceQuality();
+    for(const int32 Group:{Settings->GetShadowQuality(),Settings->GetGlobalIlluminationQuality(),Settings->GetReflectionQuality(),
+        Settings->GetAntiAliasingQuality(),Settings->GetTextureQuality(),Settings->GetVisualEffectQuality(),Settings->GetPostProcessingQuality(),
+        Settings->GetFoliageQuality(),Settings->GetShadingQuality(),Settings->GetLandscapeQuality()})
+        if(Group!=Value)return -1;
+    return Value>=0&&Value<=3?Value:-1;
+}
+
+bool UHCM5VS4GraphicsSettings::UpdateLimit(float DeltaSeconds)
+{
+    UWorld* World = GetWorld();
+    auto* Settings = UGameUserSettings::GetGameUserSettings();
+    if (!GEngine || !Settings || !World || !World->IsGameWorld()) return true;
+    TickHCM5VS4RuntimeAssetAudit(World);
+    bool Bypass = HCM5VS3LocalQA() || GIsAutomationTesting;
+    for (TActorIterator<AHCM3Recording> It(World); !Bypass && It; ++It)
+        Bypass = It->HasRecordingRequest();
+    if (Bypass)
+    {
+        if (bTemporaryOverride) GEngine->SetMaxFPS(Settings->GetFrameRateLimit());
+        bTemporaryOverride = false; LastApplied = -1.f;
+        return true;
+    }
+    const auto* PC = Cast<AHCM1PlayerController>(GetGameInstance()->GetFirstLocalPlayerController());
+    const auto Window = World->GetGameViewport() ? World->GetGameViewport()->GetWindow() : nullptr;
+    const bool Background = (FSlateApplication::IsInitialized() && !FSlateApplication::Get().IsActive())
+        || (Window.IsValid() && Window->IsWindowMinimized());
+    const bool Paused = World->IsPaused() || (PC && (PC->IsPauseMenuOpen() || PC->IsDialogueOpen()));
+    const float Requested = Settings->GetFrameRateLimit();
+    const float Desired = ResolveLimit(Requested, Paused, Background);
+    if (!FMath::IsNearlyEqual(LastApplied, Desired) || !FMath::IsNearlyEqual(GEngine->GetMaxFPS(), Desired))
+    {
+        GEngine->SetMaxFPS(Desired);
+        LastApplied = Desired;
+    }
+    bTemporaryOverride = !FMath::IsNearlyEqual(Desired, Requested);
+    return true;
+}
+
+void UHCM5VS4GraphicsSettings::ApplyUserSelection(int32 Quality, float FrameLimit, bool VSync)
+{
+    auto* Settings = UGameUserSettings::GetGameUserSettings();
+    if (!Settings) return;
+    if (Quality >= 0 && Quality <= 3)
+    {
+        float Normalized, Current, Minimum, Maximum;
+        Settings->GetResolutionScaleInformationEx(Normalized, Current, Minimum, Maximum);
+        Settings->SetOverallScalabilityLevel(Quality);
+        Settings->SetResolutionScaleValueEx(Current);
+    }
+    if (FrameLimit == 0 || FrameLimit == 30 || FrameLimit == 60 || FrameLimit == 90 || FrameLimit == 120)
+        Settings->SetFrameRateLimit(FrameLimit);
+    Settings->SetVSyncEnabled(VSync);
+    Settings->ApplyNonResolutionSettings();
+    Settings->SaveSettings();
+    UpdateLimit(0);
+}

