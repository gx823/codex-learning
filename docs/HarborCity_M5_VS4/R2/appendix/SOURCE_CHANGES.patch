+    if(!Out.Contains(TEXT("/docs/HarborCity_M5_VS4/R2/thermal_"))||User!=Out/TEXT("User")||!Expected.StartsWith(TEXT("/Game/HarborCity/"))||HCM5VS3LocalQA())return {};
