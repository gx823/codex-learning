+"""Prepare an explicit text/JPEG review bundle, never the game or source assets."""
+import argparse
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+import zipfile
+from pathlib import Path
+
+W = Path('D:/科研学习/codex学习')
+D = W/'docs/HarborCity_M5_VS4/R2'
+WT = W/'.publish/harborcity-m5-vs3-r1-gate-20260926'
+ap = argparse.ArgumentParser()
+ap.add_argument('--tag', default='harborcity-m5-vs4-r2-20261004')
+ap.add_argument('--refresh-prepared',action='store_true')
+a = ap.parse_args()
+assert re.fullmatch(r'harborcity-m5-vs4-r2-\d{8}', a.tag)
+
+def read(p):
+    return json.loads(p.read_text('utf-8-sig'))
+
+def sha(p):
+    with p.open('rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+def git(*args):
+    return subprocess.check_output(['git', *args], cwd=WT).decode('utf-8').strip()
+
+if a.refresh_prepared:
+    previous=read(D/'github/final_upload_plan.json')
+    assert git('rev-parse','HEAD')==previous['base_commit']
+    for row in previous['public_files']:
+        assert sha(WT/row['path'])==row['sha256'], 'Prepared file changed outside this refresh'
+else:
+    assert not git('status','--porcelain'), 'Inspect existing publish worktree changes before preparing'
+base = git('rev-parse','HEAD')
+branch=git('branch','--show-current')
+assert re.fullmatch(r'codex/[a-zA-Z0-9_./-]+',branch)
+evidence = read(D/'appendix/FINAL_RUNTIME_EVIDENCE.json')
+assert evidence['full_regression'].get('run'), 'Unique final run not recorded'
+required = {j['id'] for j in read(D/'final/FINAL_TEST_PLAN.json')['jobs']}
+assert {j['id'] for j in evidence['jobs']} == required
+images = read(D/'appendix/FINAL_IMAGES.json')['images']
+media = read(D/'appendix/FINAL_PUBLIC_MEDIA.json')
+assert len(media) == 3
+names = ['STATUS.md','TEST_REPORT.md','LAYOUT.md','ASSETS.md','CONTROLS.md','WORK_CHECKPOINT.json',
+         'final/README.md','appendix/FINAL_RUNTIME_EVIDENCE.json','appendix/FINAL_IMAGES.json',
+         'appendix/FINAL_PUBLIC_MEDIA.json','appendix/FINAL_MEDIA_REVIEW.md',
+         'appendix/FINAL_C_OS.json','appendix/FINAL_GROUND_CHECKS.json',
+         'appendix/FAILURE_HISTORY.md','appendix/SOURCE_CHANGES.patch','appendix/SOURCE_CHANGES.json',
+         'appendix/FULL_ROOF_COVERAGE_05.json','appendix/BUILDING_PLACEMENT_11.json']
+files = [D/n for n in names] + [D/r['file'] for r in images] + [W/'docs/PROGRESS.md']
+assert len(files) == len(set(files))
+rows = []
+# Validate the complete allowlist before touching the publication worktree.
+for src in files:
+    src = src.resolve()
+    assert src.is_file() and (src.is_relative_to(D.resolve()) or src == (W/'docs/PROGRESS.md').resolve())
+    assert src.suffix in ('.md','.json','.patch','.txt','.csv','.jpg')
+    if src.suffix == '.jpg':
+        assert src.stat().st_size <= 500000
+    else:
+        assert not re.search(r'(?:signingprivateexponent|encryptionkey)\s*=\s*["\']?[a-z0-9+/]{32,}', src.read_text('utf-8-sig').lower())
+for src in files:
+    src = src.resolve()
+    rel = src.relative_to(W)
+    target = WT/rel
+    target.parent.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(src, target)
+    rows.append(dict(path=rel.as_posix(), sha256=sha(target)))
+
+archive = D/'final/VS4_R2_REVIEW.zip'
+assert not archive.exists()
+members = []
+with zipfile.ZipFile(archive, 'x', zipfile.ZIP_DEFLATED, compresslevel=6) as z:
+    for p in files:
+        member = p.relative_to(D).as_posix() if p.is_relative_to(D) else 'PROGRESS.md'
+        members.append(member)
+        z.write(p, member)
+with zipfile.ZipFile(archive) as z:
+    assert z.testzip() is None and set(z.namelist()) == set(members)
+assets = [Path(r['video']) for r in media] + [archive]
+for p in assets:
+    assert p.parent.resolve() == (D/'final').resolve()
+    if p.suffix == '.mp4':
+        assert p.stat().st_size <= 200000000
+checksum = D/'final/VS4_R2_CHECKSUMS.txt'
+assert not checksum.exists()
+checksum.write_text('Public review files only; game and purchased assets are not included.\n'
+                    +'\n'.join(f'{sha(p)}  {p.name}' for p in assets)
+                    +'\n\nLocal candidate SHA-256: '+evidence['sha256']+'\n', 'utf-8')
+assets.append(checksum)
+body = ('R2 final-candidate review, not full acceptance. New capital is the default map. '
+        'Known failures and pending art review are documented, including D GPU power reduction below35percent. '
+        'Only review documents/JPEGs/source text diff and compressed native-game videos are uploaded. '
+        'No game build, purchased assets, private music, or saves. '
