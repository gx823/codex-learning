+        C->bCameraCutThisFrame=true;C->CaptureScene();RT->GameThread_GetRenderTargetResource()->ReadFloat16Pixels(HeroOnly);
+        C->PrimitiveRenderMode=ESceneCapturePrimitiveRenderMode::PRM_RenderScenePrimitives;C->ShowOnlyComponents.Reset();
