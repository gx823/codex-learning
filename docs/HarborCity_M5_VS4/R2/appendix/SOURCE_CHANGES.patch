+"""UE-only private material usage copies; originals remain untouched."""
+import unreal as U,hashlib
+A=U.EditorAssetLibrary;ME=U.MaterialEditingLibrary
+def instancing_material(source,root,cache,report):
+    key=source.get_path_name()
+    if key in cache:return cache[key]
+    usage=U.MaterialUsage.MATUSAGE_INSTANCED_STATIC_MESHES
+    if ME.has_material_usage(source,usage):cache[key]=source;return source
+    path=root+'/Materials/ISM_'+source.get_name()+'_'+hashlib.sha256(key.encode()).hexdigest()[:8]
+    result=A.load_asset(path) if A.does_asset_exist(path) else A.duplicate_asset(key.split('.')[0],path)
+    assert result,key
+    cache[key]=result
+    if isinstance(result,U.MaterialInstanceConstant):
+        parent=instancing_material(source.get_editor_property('parent'),root,cache,report)
+        ME.set_material_instance_parent(result,parent)
+        ME.set_material_usage_override(result,usage,True,True)
+        ME.update_material_instance(result)
+    else:
+        assert isinstance(result,U.Material)
+        ME.set_base_material_usage(result,usage,True);ME.recompile_material(result)
+    assert ME.has_material_usage(result,usage);assert A.save_loaded_asset(result,False)
+    report.append(dict(source=key,derived=result.get_path_name(),usage='InstancedStaticMeshes',render_validation='NOT_RUN'))
+    return result

