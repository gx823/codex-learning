+import base64,datetime,hashlib,json,mimetypes,os,re,subprocess
+import requests
+W=Path('D:/科研学习/codex学习');D=W/'docs/HarborCity_M5_VS4/R2';G=D/'github'
+P=json.loads((G/'upload_plan.json').read_text('utf-8'));WT=Path(P['worktree']);REPO='gx823/codex-learning'
+assert P['repository']==REPO
+ROWS=json.loads((G/'PUBLICATION_FILES.json').read_text('utf-8'))
+STATE={'status':'PREPARED','repository':REPO,'assets':[]}
+def save():(G/'gate_publication.json').write_text(json.dumps(STATE,ensure_ascii=False,indent=2)+'\n','utf-8')
+def git(*args):return subprocess.check_output(['git','-c','gc.auto=0','-c','maintenance.auto=false',*args],cwd=WT)
+def run():
+    for row in ROWS:
+        path=WT/row['path'];assert row['path'].startswith('docs/HarborCity_M5_VS4/R2/') or row['path']=='docs/PROGRESS.md'
+        assert path.suffix.lower() in ('.md','.json','.patch','.jpg','.txt','.csv')
+        assert hashlib.sha256(path.read_bytes()).hexdigest()==row['sha256']
+        if path.suffix.lower()=='.jpg':assert path.stat().st_size<=500000
+    credential=subprocess.run(['git','credential','fill'],cwd=W,input=f'protocol=https\nhost=github.com\npath={REPO}.git\n\n',capture_output=True,text=True,env=dict(os.environ,GIT_TERMINAL_PROMPT='0',GCM_INTERACTIVE='Never'))
+    if credential.returncode:raise RuntimeError('Existing credential unavailable; no login attempted')
+    fields=dict(x.split('=',1) for x in credential.stdout.splitlines() if '=' in x);token=fields.get('password');assert token
+    session=requests.Session();session.headers.update({'Authorization':'Bearer '+token,'Accept':'application/vnd.github+json','X-GitHub-Api-Version':'2022-11-28','User-Agent':'HarborCity-Authorized-Gate'});del credential,fields,token
+    api_root='https://api.github.com/repos/'+REPO
+    def api(method,path,allow404=False,**kwargs):
+        url=path if path.startswith('https://') else api_root+path
+        parsed=urlsplit(url);assert parsed.scheme=='https' and parsed.hostname in ('api.github.com','uploads.github.com')
+        response=session.request(method,url,allow_redirects=False,timeout=(30,900),**kwargs)
+        if allow404 and response.status_code==404:return None
+        if not 200<=response.status_code<300:raise RuntimeError(f'GitHub {method} {parsed.path}: HTTP {response.status_code}')
+        return response.json()
+    base=P['base_commit'];remote=api('GET','/git/ref/heads/main')['object']['sha']
+    prior=json.loads((G/'docs_publication.json').read_text('utf-8')) if (G/'docs_publication.json').exists() else None
+    if not prior or prior['status']!='PUSHED_VERIFIED':
+        assert remote==base,'Remote changed; never force'
+        dirty=git('status','--porcelain').decode('utf-8');STATE['git_status_before']=dirty;save()
+        if dirty:
+            # Repository-wide JPEG ignore stays untouched; only this validated
+            # public allowlist may bypass it, never the asset/source directories.
+            git('add','-f','--',*[r['path'] for r in ROWS]);staged=set(filter(None,git('diff','--cached','--name-only','-z').decode('utf-8').split('\0')))
+            assert staged==set(r['path'] for r in ROWS)
+            git('commit','-m','Present HarborCity M5-VS4 R2 capital sample gate and D implementation status')
+        local=git('rev-parse','HEAD').decode().strip();tree=git('rev-parse','HEAD^{tree}').decode().strip();assert git('rev-parse','HEAD^').decode().strip()==base
+        parent=api('GET','/git/commits/'+base);entries=[]
+        for row in ROWS:
+            raw=git('show','HEAD:'+row['path']);blob=api('POST','/git/blobs',json={'content':base64.b64encode(raw).decode('ascii'),'encoding':'base64'})
+            assert blob['sha']==git('rev-parse','HEAD:'+row['path']).decode().strip()
+            entries.append(dict(path=row['path'],mode='100644',type='blob',sha=blob['sha']))
+        created=api('POST','/git/trees',json={'base_tree':parent['tree']['sha'],'tree':entries});assert created['sha']==tree
+        headers,message=git('cat-file','commit',local).decode('utf-8').split('\n\n',1)
+        def identity(prefix):
+            row=next(x for x in headers.splitlines() if x.startswith(prefix+' '));m=re.fullmatch(prefix+r' (.*) <([^>]+)> (\d+) ([+-]\d{4})',row);assert m
+            zone=m[4];minutes=(int(zone[1:3])*60+int(zone[3:]))*(1 if zone[0]=='+' else -1)
+            dt=datetime.datetime.fromtimestamp(int(m[3]),datetime.timezone(datetime.timedelta(minutes=minutes)))
+            return dict(name=m[1],email=m[2],date=dt.isoformat())
+        commit=api('POST','/git/commits',json=dict(message=message,tree=tree,parents=[base],author=identity('author'),committer=identity('committer')))
+        assert commit['sha']==local and api('GET','/git/ref/heads/main')['object']['sha']==base
+        api('PATCH','/git/refs/heads/main',json={'sha':local,'force':False});assert api('GET','/git/ref/heads/main')['object']['sha']==local
+        prior=dict(status='PUSHED_VERIFIED',commit=local,tree=tree,url='https://github.com/'+REPO+'/commit/'+local)
+        (G/'docs_publication.json').write_text(json.dumps(prior,indent=2),'utf-8')
+    assert api('GET','/git/ref/heads/main')['object']['sha']==prior['commit']
+    STATE.update(status='DOCS_PUSHED',commit=prior['commit']);save()
+    release=api('GET','/releases/tags/'+P['release_tag'],allow404=True)
+    if release is None:
+        matches=[r for r in api('GET','/releases?per_page=100') if r['tag_name']==P['release_tag']];assert len(matches)<=1
+        if matches:release=matches[0]
+    if release is None:release=api('POST','/releases',json=dict(tag_name=P['release_tag'],target_commitish=prior['commit'],name=P['release_name'],body=P['release_body'],draft=True,prerelease=True,make_latest='false'))
+    assert release['target_commitish']==prior['commit']
+    STATE['release_url']=release['html_url'];save()
+    existing={r['name']:r for r in api('GET',f"/releases/{release['id']}/assets?per_page=100")}
+    for item in P['release_assets']:
+        path=Path(item['path']).resolve();assert path.is_relative_to((D/'gate').resolve()) and path.name==item['name'] and path.suffix.lower() in ('.mp4','.txt')
+        assert path.stat().st_size==item['size'] and hashlib.sha256(path.read_bytes()).hexdigest()==item['sha256']
+        asset=existing.get(path.name)
+        if asset is None:
+            assert release['draft'],'Never overwrite published release assets'
+            print(json.dumps(dict(stage='upload',file=path.name,bytes=item['size'])),flush=True)
