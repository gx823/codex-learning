+                if max(abs(p.x),abs(p.y))<45000:continue
+                j=len(R['ridge_changes']);cluster=j//5;part=j%5
+                cx,cy=((-700,-410),(-785,0),(-730,415),(-260,650),(15,-660))[cluster]
