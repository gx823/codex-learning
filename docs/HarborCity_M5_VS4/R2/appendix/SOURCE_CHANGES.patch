+function Set-HCVS4R2Stop {
+ param([string]$Reason,[string]$Run='')
+ $stop=Join-Path (Split-Path $PSScriptRoot -Parent) 'docs/HarborCity_M5_VS4/R2/STOP_DESKTOP_CHAIN'
+ if(-not (Test-Path -LiteralPath $stop)){@{reason=$Reason;run=$Run;time=(Get-Date -Format o)}|ConvertTo-Json|Set-Content -LiteralPath $stop -Encoding utf8}
+}
+function Test-HCVS4R2Stopped {
+ param([string]$Run='')
+ $stop=Join-Path (Split-Path $PSScriptRoot -Parent) 'docs/HarborCity_M5_VS4/R2/STOP_DESKTOP_CHAIN'
+ if(Test-Path -LiteralPath $stop){return $true}
+ if(('HCR3WindowGuard' -as [type]) -and ([HCR3WindowGuard]::GetAsyncKeyState(27) -band 0x8001)){Set-HCVS4R2Stop 'OS Escape pressed' $Run;return $true}
+ return $false
+}
+
+function Test-HCVS4R2PowerAllowed {
+ param([int]$AC,[int]$Percent,[switch]$BatteryUntil20)
+ if($BatteryUntil20){return $AC -in @(0,1) -and $Percent -gt 20 -and $Percent -le 100}
+ return $AC -eq 1
+}
+
+function Test-HCVS4R2BatteryStop {
+ param([switch]$Enabled,[string]$Run='')
+ if(-not $Enabled){return $false}
+ if(-not ('HCVS4R2Battery' -as [type])){
+  Add-Type @'
+using System;using System.Runtime.InteropServices;
+public static class HCVS4R2Battery {
+ [StructLayout(LayoutKind.Sequential)] public struct Power {public byte AC,Flag,Percent,Reserved;public uint Life,Full;}
+ [DllImport("kernel32.dll")] public static extern bool GetSystemPowerStatus(out Power p);
+}
+'@
+ }
+ $power=[HCVS4R2Battery+Power]::new()
+ $ok=[HCVS4R2Battery]::GetSystemPowerStatus([ref]$power)
+ if($ok -and (Test-HCVS4R2PowerAllowed -AC $power.AC -Percent $power.Percent -BatteryUntil20)){return $false}
+ $reason=if($ok -and $power.Percent -le 20){'BATTERY_AT_OR_BELOW_20'}else{'BATTERY_STATUS_UNKNOWN'}
+ Set-HCVS4R2Stop -Reason $reason -Run $Run
+ if($Run){@{status='WAITING_HOST';reason=$reason;ac_line=$power.AC;battery_percent=$power.Percent;time=(Get-Date -Format o)}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $Run 'battery_stop.json') -Encoding utf8}
+ return $true
+}

