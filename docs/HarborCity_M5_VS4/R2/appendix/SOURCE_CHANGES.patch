+"""Local-only geometry measurements and diagnostic projections."""
+from pathlib import Path
+import json,numpy as np
+import matplotlib
+matplotlib.use('Agg')
+import matplotlib.pyplot as plt
+from matplotlib.collections import PolyCollection
+P=Path('E:/GameDev/Assets/HarborCity/M5_VS4/R2')
+rows=json.loads((P/'scale_geometry.json').read_text('utf-8'))
+fig,axs=plt.subplots(2,4,figsize=(16,8))
+for ax,row in zip(axs.flat,rows):
+    vertices=np.array(row['vertices']);tri=vertices[np.array(row['triangles'])]
+    axes=[1,2] if 'Bridge' in row['path'] else [0,2]
+    ax.add_collection(PolyCollection(tri[:,:,axes],facecolors='#b8b4a6',edgecolors='#403b3b',linewidths=.15))
+    ax.autoscale();ax.set_aspect('equal');ax.set_title(row['path'].split('/')[-1],fontsize=8)
+fig.tight_layout();fig.savefig(P/'scale_diagnostic.png',dpi=100);plt.close(fig)
+def center_clearance(row):
+    v=np.array(row['vertices']);tri=v[np.array(row['triangles'])];intervals=[]
+    for t in tri:
+        zz=[]
+        for p,q in zip(t,np.roll(t,-1,axis=0)):
+            if (p[0]<0<q[0]) or (q[0]<0<p[0]):zz.append(p[2]+(q[2]-p[2])*(-p[0])/(q[0]-p[0]))
+        if len(zz)>=2:intervals.append((min(zz),max(zz)))
+    # Front-projected opening, sampling at 1 mm through the centreline.
+    z=np.arange(0,max(v[:,2]),.1);occupied=np.zeros(len(z),bool)
+    for a,b in intervals:occupied|=(z>=a)&(z<=b)
+    free=np.where(~occupied)[0];groups=np.split(free,np.where(np.diff(free)>1)[0]+1)
+    return [[float(z[g[0]]),float(z[g[-1]])] for g in groups if len(g)>10]
+print(json.dumps({r['path'].split('/')[-1]:center_clearance(r) for r in rows if 'frame' in r['path'] or 'wall_small_door' in r['path']},indent=2))

