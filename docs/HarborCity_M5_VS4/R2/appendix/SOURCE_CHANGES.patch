+function Test-HCVS4R2AssetLog {
+ param([Parameter(Mandatory)][string]$LogPath,[Parameter(Mandatory)][string]$EvidencePath)
+ if(-not (Test-Path -LiteralPath $LogPath)){
+  @{status='FAIL_MISSING_LOG';log=$LogPath;time=(Get-Date -Format o)} | ConvertTo-Json | Set-Content -LiteralPath $EvidencePath -Encoding utf8
+  return $false
+ }
+ $patterns=@('Failed to compile Material','Default Material will be used','Failed to load.*(/Game/|/Engine/|\.uasset|\.umap)','Can.t find file.*(/Game/|/Engine/)','Unable to find package','Failed to find object.*(/Game/|/Engine/)','Missing cached shader map.*using default')
+ $hits=@(Select-String -LiteralPath $LogPath -Pattern $patterns | ForEach-Object {[ordered]@{line=$_.LineNumber;text=$_.Line}})
+ [ordered]@{status=if($hits.Count){'FAIL_RENDER_ASSETS'}else{'PASS_LOG_SCAN_ONLY'};log=$LogPath;time=(Get-Date -Format o);hits=$hits;scope='Material/package errors only; optional profiling DLL notices are not missing game assets'} | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath $EvidencePath -Encoding utf8
+ return $hits.Count -eq 0
+}
+
+function Confirm-HCVS4R2PackageAssets {
+ param([Parameter(Mandatory)][string]$Executable,[Parameter(Mandatory)][string]$Run)
+ $candidate=(Get-Item -LiteralPath $Executable).Directory.Parent.Parent.Parent.Parent.Parent.FullName
+ $record=Get-Content -LiteralPath (Join-Path $candidate 'package_manifest.json') -Raw|ConvertFrom-Json
+ if($record.status -ne 'PASS' -or $record.actual_executable -ine $Executable -or (Get-FileHash -LiteralPath $Executable -Algorithm SHA256).Hash -ine $record.actual_executable_sha256){throw 'Candidate receipt or executable hash mismatch'}
+ $stamp=(Split-Path $candidate -Leaf).Substring('Candidate_'.Length)
+ $cookLog=Join-Path (Split-Path $PSScriptRoot -Parent) ('docs/HarborCity_M5_VS4/R2/builds/'+$stamp+'_package/uat_console.log')
+ if(-not (Test-HCVS4R2AssetLog -LogPath $cookLog -EvidencePath (Join-Path $Run 'cook_asset_log_gate.json'))){throw 'Cook material/package log gate failed'}
+ @{candidate=$candidate;executable_sha256=$record.actual_executable_sha256;cook_log=$cookLog;cook_log_sha256=(Get-FileHash -LiteralPath $cookLog).Hash}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $Run 'package_asset_provenance.json') -Encoding utf8
+ return $record
+}
+
+function Test-HCVS4R2RunAssets {
+ param([Parameter(Mandatory)][string]$Run,[bool]$Packaged,[DateTime]$Started,[switch]$Final)
+ $log=Join-Path $Run 'game.log';$evidence=Join-Path $Run 'asset_log_gate.json'
+ if(Test-Path -LiteralPath $log){
+  if(-not (Test-HCVS4R2AssetLog -LogPath $log -EvidencePath $evidence)){return $false}
+  if(-not $Packaged){
+   $nativeEditor=Join-Path $Run 'runtime_assets.json'
+   if(Test-Path -LiteralPath $nativeEditor){
+    try{$audit=Get-Content -LiteralPath $nativeEditor -Raw|ConvertFrom-Json}catch{return -not $Final}
+    if($audit.status -eq 'FAIL_RUNTIME_MATERIALS'){
+     @{status='FAIL_RENDER_ASSETS';native_report=$nativeEditor;engine_log_available=$true}|ConvertTo-Json|Set-Content -LiteralPath $evidence -Encoding utf8
+     return $false
+    }
+   }
+   return $true
+  }
+ }
+ $nativePath=Join-Path $Run 'runtime_assets.json'
+ if($Packaged -and (Test-Path -LiteralPath $nativePath)){
+  try{$native=Get-Content -LiteralPath $nativePath -Raw|ConvertFrom-Json}catch{return -not $Final}
+  if($native.status -eq 'PASS_RUNTIME_MATERIALS' -and (Test-Path -LiteralPath (Join-Path $Run 'package_asset_provenance.json'))){
+   @{status='PASS_COOK_LOG_AND_NATIVE_MATERIALS';engine_log_available=(Test-Path -LiteralPath $log);native_report=$nativePath;actual_map=$native.map;scope='Cook compilation/reference log plus native loaded material/shader-map audit; not a Shipping engine log'}|ConvertTo-Json|Set-Content -LiteralPath $evidence -Encoding utf8
+   return $true
+  }
+  if($native.status -eq 'FAIL_RUNTIME_MATERIALS'){
+   @{status='FAIL_RENDER_ASSETS';native_report=$nativePath}|ConvertTo-Json|Set-Content -LiteralPath $evidence -Encoding utf8
+   return $false
+  }
+ }
+ $pending=-not $Final -and ((Get-Date)-$Started).TotalSeconds -lt 90
+ @{status=if($pending){'WAITING_STARTUP_ASSET_EVIDENCE'}else{'FAIL_MISSING_ASSET_EVIDENCE'};engine_log_available=(Test-Path -LiteralPath $log);native_report=$nativePath}|ConvertTo-Json|Set-Content -LiteralPath $evidence -Encoding utf8
+ return $pending
+}

