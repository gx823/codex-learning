+#requires -Version 7.0
+$ErrorActionPreference='Stop'
+$root=Split-Path $PSScriptRoot -Parent
+$doc=Join-Path $root 'docs/HarborCity_M5_VS4/R2'
+$file=Join-Path $doc 'gate/VS4_R2_GATE_WALK_EDITOR_65S_PUBLIC_1080P.mp4'
+$repo='gx823/codex-learning';$api='https://api.github.com/repos/'+$repo
+$env:GIT_TERMINAL_PROMPT='0';$env:GCM_INTERACTIVE='Never'
+$raw="protocol=https`nhost=github.com`npath=$repo.git`n`n" | git -C $root credential fill 2>$null
+if($LASTEXITCODE -ne 0){throw 'Existing Git credential unavailable; no login attempted'}
+$secret=($raw|Where-Object {$_ -like 'password=*'}|Select-Object -First 1).Substring(9)
+if(-not $secret){throw 'No existing credential'}
+$headers=@{Authorization="Bearer $secret";Accept='application/vnd.github+json';'X-GitHub-Api-Version'='2022-11-28';'User-Agent'='HarborCity-Authorized-Gate'}
+$raw=$null;$secret=$null
+$state=[ordered]@{status='RUNNING';file=(Split-Path $file -Leaf);started=(Get-Date -Format o);attempts=@()}
+function Save-Receipt {$state|ConvertTo-Json -Depth 8|Set-Content -LiteralPath (Join-Path $doc 'github/gate_video_v2_publication.json') -Encoding utf8}
+function Api([string]$method,[string]$path,$body=$null){
+ $a=@{Method=$method;Uri=($api+$path);Headers=$headers;TimeoutSec=120;MaximumRedirection=0}
+ if($null -ne $body){$a.Body=($body|ConvertTo-Json -Compress);$a.ContentType='application/json'}
+ Invoke-RestMethod @a
+}
+try {
+ $hash=(Get-FileHash -LiteralPath $file -Algorithm SHA256).Hash.ToLowerInvariant();$size=(Get-Item -LiteralPath $file).Length
+ $state.sha256=$hash;$state.bytes=$size;Save-Receipt
+ $release=Api GET '/releases/401550033'
+ if($release.tag_name -ne 'harborcity-m5-vs4-r2-sample-gate-20261002'){throw 'Unexpected release'}
+ for($attempt=1;$attempt -le 3;$attempt++){
+  $all=Api GET "/releases/$($release.id)/assets?per_page=100"
+  foreach($asset in $all){
+   if($asset.state -eq 'starter' -and $asset.name -in @('VS4_R2_GATE_WALK_EDITOR_65S.mp4',$state.file)){
+    Api DELETE "/releases/assets/$($asset.id)"|Out-Null
+   }
+  }
+  $matches=@($all|Where-Object {$_.name -eq $state.file -and $_.state -eq 'uploaded'})
+  if($matches.Count -gt 1){throw 'Duplicate uploaded asset'}
+  if($matches.Count -eq 1){$uploaded=$matches[0];break}
+  Write-Output "Uploading compressed gate video, attempt $attempt / 3, timeout 1800 s"
+  try {
+   $url="https://uploads.github.com/repos/$repo/releases/$($release.id)/assets?name=$([Uri]::EscapeDataString($state.file))"
+   $uploaded=Invoke-RestMethod -Method Post -Uri $url -Headers $headers -ContentType 'video/mp4' -InFile $file -TimeoutSec 1800 -MaximumRedirection 0
+   $state.attempts+=@{attempt=$attempt;status='HTTP_SUCCESS';time=(Get-Date -Format o)};Save-Receipt;break
+  } catch {
+   $state.attempts+=@{attempt=$attempt;status='HTTP_FAILED';error_type=$_.Exception.GetType().Name;time=(Get-Date -Format o)};Save-Receipt
+   if($attempt -eq 3){throw 'Three upload attempts failed'}
+  }
+ }
+ $verified=Api GET "/releases/assets/$($uploaded.id)"
+ if($verified.state -ne 'uploaded' -or $verified.size -ne $size -or $verified.digest -ne "sha256:$hash"){throw 'Remote size/digest verification failed'}
+ $body=$release.body+"`n`nPublic compressed walk: 1080p H.264, approximately 5 Mbps; native audio is silent because this walk has no city sound sources (accepted by user). Local master retained. Editor -game footage, not Shipping acceptance."
+ if($release.draft){$release=Api PATCH "/releases/$($release.id)" @{draft=$false;prerelease=$true;make_latest='false';body=$body}}
+ $check=Api GET '/releases/tags/harborcity-m5-vs4-r2-sample-gate-20261002'
+ if($check.draft){throw 'Release still draft'}
+ $state.status='PUBLISHED_VERIFIED';$state.release_url=$check.html_url;$state.asset=@{id=$verified.id;size=$verified.size;digest=$verified.digest;url=$verified.browser_download_url};Save-Receipt
+ Write-Output ($state|ConvertTo-Json -Depth 8)
+} catch {$state.status='INCOMPLETE';$state.error_type=$_.Exception.GetType().Name;Save-Receipt;Write-Output 'Gate video publication incomplete; receipt preserved';exit 1}

