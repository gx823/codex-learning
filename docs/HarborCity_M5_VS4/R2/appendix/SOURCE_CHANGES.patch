+"""Join four actual flight legs and prepare bounded public video copies."""
+import argparse
+import bisect
+import csv
+import hashlib
+import json
+import shutil
+import subprocess
+from pathlib import Path
+
+W = Path('D:/科研学习/codex学习')
+D = W/'docs/HarborCity_M5_VS4/R2'
+FF = W/'video_build/manga_mad_project_20260827/qa_tools/ffmpeg-master-latest-win64-gpl-shared/bin/ffmpeg.exe'
+ap = argparse.ArgumentParser()
+ap.add_argument('--ledger', type=Path, required=True)
+ap.add_argument('--mode', choices=('flight_camera', 'public'), required=True)
+a = ap.parse_args()
+
+def read(p):
+    return json.loads(p.read_text('utf-8-sig'))
+
+def sha(p):
+    with p.open('rb') as f:
+        return hashlib.file_digest(f, 'sha256').hexdigest()
+
+plan = read(D/'final/FINAL_TEST_PLAN.json')
+batch = read(a.ledger)
+assert batch['status'] == 'COMPLETE_SEE_INDIVIDUAL_RESULTS' and batch['sha256'] == plan['sha256']
+jobs = {r['id']: r for r in batch['jobs']}
+
+def capture_for(job):
+    run = Path(job['run'])
+    launch, end = read(run/'launch.json'), read(run/'exit.json')
+    assert launch['executable_sha256'] == plan['sha256']
+    assert end['status'] == 'EXITED' and end['actual_maps'] == ['L_CapitalR2']
+    matches = []
+    for p in (D/'recordings').glob('*/run_binding.json'):
+        b = read(p)
+        if b.get('started') == launch['started'] and b.get('executable') == launch['executable']:
+            matches.append(p.parent)
+    # Bind the exact recorded launch, not a nearest filename or file modification time.
+    assert len(matches) == 1, f'Expected one capture binding for {run}, got {len(matches)}'
+    folder = matches[0]
+    qa = read(folder/'capture.qa.json')
+    assert qa['decode_validation'] == 'PASS_FULL_VIDEO_AND_AUDIO_DECODE'
+    assert qa['capture_completeness'] == 'COMPLETE'
+    return run, folder, read(folder/'capture.json'), qa
+
+def execute(args, log):
+    p = subprocess.run([str(FF), '-hide_banner', '-nostdin', *args], capture_output=True, timeout=1800)
+    log.write_bytes(p.stderr)
+    assert p.returncode == 0, str(log)
+
+def verify(path):
+    execute(['-v','error','-xerror','-threads','2','-i',str(path),'-f','null','-'], path.with_suffix('.decode.log'))
+    probe = json.loads(subprocess.check_output([str(FF.with_name('ffprobe.exe')), '-v','error',
+                                               '-show_streams','-show_format','-of','json',str(path)]))
+    v = next(s for s in probe['streams'] if s['codec_type'] == 'video')
+    num, den = map(int, v['avg_frame_rate'].split('/'))
+    return dict(video=str(path), bytes=path.stat().st_size, sha256=sha(path),
+                duration=float(probe['format']['duration']), width=v['width'], height=v['height'],
+                average_fps=num/den, decode='PASS', executable_sha256=plan['sha256'],
+                visual='NOT_REVIEWED', listening='NOT_RUN')
+
+if a.mode == 'flight_camera':
+    out = D/'final/VS4_R2_FLIGHT.mp4'
+    assert not out.exists()
+    inputs, graph, segments = [], [], []
+    for i in range(4):
+        run, folder, cap, qa = capture_for(jobs[f'flight_{i+1}'])
+        assert jobs[f'flight_{i+1}']['status'] == 'PASS_NATIVE'
+        result = next((run/'User/Saved/M5Tests').rglob('VS4_FLIGHT_LEG.csv'))
+        with result.open(encoding='utf-8-sig', newline='') as f:
+            flight = [r for r in csv.DictReader(f) if r['flying'] == '1']
+        assert flight
+        frames = cap['frames']
+        worlds = [float(f['world_seconds']) for f in frames]
+        walls = [float(f['seconds'])-float(frames[0]['seconds']) for f in frames]
+        assert all(b > a for a, b in zip(worlds, worlds[1:]))
+        def at(t):
+            assert worlds[0]-.05 <= t <= worlds[-1]+.05
+            j = max(1, min(len(worlds)-1, bisect.bisect_left(worlds, t)))
+            return max(0, min(walls[-1], walls[j-1]+(t-worlds[j-1])/(worlds[j]-worlds[j-1])*(walls[j]-walls[j-1])))
+        first=max(float(flight[0]['world_time']),worlds[0])
+        last=min(float(flight[-1]['world_time']),worlds[-1])
+        assert last>first, 'Flight must overlap actual captured frames'
+        start, end = at(first), at(last)
+        assert end>start
+        inputs += ['-i', str(folder/'capture.mp4')]
+        graph += [f'[{i}:v]trim=start={start:.6f}:end={end:.6f},setpts=PTS-STARTPTS[v{i}]',
+                  f'[{i}:a]atrim=start={start:.6f}:end={end:.6f},asetpts=PTS-STARTPTS[a{i}]']
+        segments.append(dict(run=run.name, source=str(folder/'capture.mp4'), start=start, end=end,
+                             scope='Only recorded flying interval; uncaptured end of leg omitted'))
+    graph += [''.join(f'[v{i}][a{i}]' for i in range(4))+'concat=n=4:v=1:a=1[v][a]']
+    graph_path = out.with_suffix('.filter.txt')
+    graph_path.write_text(';\n'.join(graph), 'utf-8')
+    execute([*inputs,'-filter_complex_threads','2','-filter_complex',';'.join(graph),'-map','[v]','-map','[a]',
+             '-c:v','libx264','-threads','2','-preset','fast','-crf','19','-fps_mode:v','vfr','-pix_fmt','yuv420p',
+             '-c:a','aac','-b:a','192k','-movflags','+faststart',str(out)], out.with_suffix('.encode.log'))
+    receipt = verify(out)
+    assert 60 <= receipt['duration'] <= 90
+    receipt.update(segments=segments, scope='Four independent ordinary-stamina flights, hard cuts at normal speed. Not one continuous flight.')
+    out.with_suffix('.qa.json').write_text(json.dumps(receipt, indent=2), 'utf-8')
+    run, folder, cap, qa = capture_for(jobs['camera_film'])
+    camera = D/'final/VS4_R2_CAMERA.mp4'
+    assert not camera.exists()
+    shutil.copy2(folder/'capture.mp4', camera)
+    receipt = verify(camera)
+    receipt.update(source=str(folder/'capture.mp4'), native_status=jobs['camera_film']['status'])
+    camera.with_suffix('.qa.json').write_text(json.dumps(receipt, indent=2), 'utf-8')
+else:
+    receipts = []
+    for name in ('MAIN','FLIGHT','CAMERA'):
+        src = D/f'final/VS4_R2_{name}.mp4'
+        assert src.exists()
+        out = src.with_name(src.stem+'_PUBLIC.mp4')
+        assert not out.exists()
+        def encode(height):
+            execute(['-i',str(src),'-map','0:v','-map','0:a','-vf',f'scale=-2:{height}',
+                     '-c:v','libx264','-threads','2','-preset','fast','-b:v','5M','-maxrate','6M','-bufsize','10M',
+                     '-fps_mode:v','passthrough','-enc_time_base:v','1:1000','-pix_fmt','yuv420p','-c:a','copy','-movflags','+faststart',str(out)],
+                    out.with_suffix('.encode.log'))
+        encode(1080)
+        if out.stat().st_size > 200000000:
+            assert out.parent == (D/'final') and out.name.endswith('_PUBLIC.mp4')
+            out.rename(out.with_suffix('.1080-too-large.mp4'))
+            encode(720)
+        assert out.stat().st_size <= 200000000
+        receipt = verify(out)
+        receipt['source_master'] = str(src)
+        out.with_suffix('.qa.json').write_text(json.dumps(receipt, indent=2), 'utf-8')
+        receipts.append(receipt)
+    (D/'appendix/FINAL_PUBLIC_MEDIA.json').write_text(json.dumps(receipts, indent=2), 'utf-8')
+print(json.dumps(dict(status='GENERATED_VERIFY_VISUALS_SEPARATELY', mode=a.mode)))

