+#requires -Version 7.0
+param([Parameter(Mandatory)][ValidateSet('functional','performance','stability','media')][string]$Group)
+$ErrorActionPreference='Stop'
+$root=Split-Path $PSScriptRoot -Parent
+$doc=Join-Path $root 'docs/HarborCity_M5_VS4/R2'
+$plan=Get-Content -LiteralPath (Join-Path $doc 'final/FINAL_TEST_PLAN.json') -Raw|ConvertFrom-Json -AsHashtable
+if((Get-FileHash -LiteralPath $plan.executable).Hash -ne $plan.sha256){throw 'Candidate hash changed'}
+$jobs=@($plan.jobs|Where-Object group -eq $Group)
+$ledger=Join-Path $doc ('final/batch_'+$Group+'_'+(Get-Date -Format 'yyyyMMdd_HHmmss')+'.json')
+$record=[ordered]@{status='RUNNING';group=$Group;executable=$plan.executable;sha256=$plan.sha256;started=(Get-Date -Format o);jobs=@()}
+function Save-Ledger { $record|ConvertTo-Json -Depth 12|Set-Content -LiteralPath $ledger -Encoding utf8 }
+Save-Ledger
+try {
+ foreach($job in $jobs){
+  if($job.args.Mode -eq 'm5_full'){throw 'Full regression excluded; one-run authorization handled separately'}
+  $row=[ordered]@{id=$job.id;status='RUNNING';started=(Get-Date -Format o);args=$job.args;run=$null;results=@()}
+  $record.jobs+=,$row
+  Save-Ledger
+  $parameters=@{}+$job.args
+  $parameters.Executable=$plan.executable
+  & (Join-Path $PSScriptRoot 'run_m5_vs4_r2.ps1') @parameters
+  $active=Get-Content -LiteralPath (Join-Path $doc 'active_run.json') -Raw|ConvertFrom-Json
+  if($active.status -ne 'EXITED' -or $active.exit_code -ne 0){throw 'Job did not exit normally'}
+  $row.run=$active.run
+  $reports=@(Get-ChildItem -LiteralPath (Join-Path $active.run 'User/Saved/M5Tests') -Recurse -Filter results.json)
+  if(-not $reports.Count){throw 'Native results absent'}
+  foreach($file in $reports){
+   $r=Get-Content -LiteralPath $file.FullName -Raw|ConvertFrom-Json
+   $row.results+=@{path=$file.FullName;status=$r.status;map=$r.map;checks=$r.checks.Count;failures=$r.failures}
+  }
+  $row.status=if(@($row.results|Where-Object {$_.failures -gt 0 -or $_.status -ne 'COMPLETE'}).Count){'FAIL_NATIVE'}else{'PASS_NATIVE'}
+  $row.ended=Get-Date -Format o
+  Save-Ledger
+  if($job.args.R4Case -eq 'r2perf'){
+   & 'C:/Users/HP/.codex/runtimes/scientific-skills/Scripts/python.exe' (Join-Path $PSScriptRoot 'hc_vs4_r2_perf_report.py') --run $active.run
+   if($LASTEXITCODE -ne 0){throw 'Performance counters incomplete; inspect rather than retry'}
+  }
+ }
+ $record.status='COMPLETE_SEE_INDIVIDUAL_RESULTS'
+} catch {
+ $record.status='STOPPED_INSPECT_BEFORE_RESUME'
+ $record.error=$_.Exception.Message
+ throw
+} finally {
+ $record.ended=Get-Date -Format o
+ Save-Ledger
+ Write-Output ('Batch receipt: '+$ledger)
+}

