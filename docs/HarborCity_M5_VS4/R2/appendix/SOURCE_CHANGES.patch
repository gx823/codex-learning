+"""Native test markers for the three narrowest planned lanes; no gameplay moves."""
+from pathlib import Path
+import json, math, re, traceback
+import unreal as U
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line())
+OUT=Path(m[1] or m[2]);DOC=OUT.parent.parent
+P=json.loads(Path('E:/GameDev/Assets/HarborCity/M5_VS4/R2/v2/full_plan.json').read_text('utf-8'))
+E=U.get_editor_subsystem(U.EditorActorSubsystem);L=U.get_editor_subsystem(U.LevelEditorSubsystem)
+R=dict(status='RUNNING',map=P['map'],routes=[],runtime='NOT_RUN')
+TAG='HCR2CameraRoute'
+
+def at_distance(points,distance):
+    for a,b in zip(points,points[1:]):
+        length=math.dist(a,b)
+        if distance<=length:
+            t=distance/max(.001,length);return [a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t]
+        distance-=length
+    return points[-1]
+
+try:
+    assert L.load_level(P['map'])
+    for a in list(E.get_all_level_actors()):
+        if TAG in map(str,a.tags):assert E.destroy_actor(a)
+    world=U.get_editor_subsystem(U.UnrealEditorSubsystem).get_editor_world()
+    for index,road in enumerate(sorted(P['roads'],key=lambda r:(r['width_m'],r['id']))[:3],1):
+        total=sum(math.dist(a,b) for a,b in zip(road['points'],road['points'][1:]))
+        xy=[at_distance(road['points'],total/2+d) for d in (-5,5)]
+        z=U.HCM5VS4WorldAuthoring.sample_capital_terrain_heights(world,[U.Vector(x*100,y*100,0) for x,y in xy]);assert len(z)==2
+        for j,side in enumerate(('Start','End')):
+            label='R2CameraLane%d%s'%(index,side)
+            a=E.spawn_actor_from_class(U.TargetPoint,U.Vector(xy[j][0]*100,xy[j][1]*100,z[j]),U.Rotator(),False)
+            assert a;a.set_actor_label(label);a.tags=[U.Name(TAG),U.Name(label)]
+        R['routes'].append(dict(id=index,road=road['id'],planned_width_m=road['width_m'],xy_m=xy,z_cm=list(z)))
+    assert L.save_current_level();R['status']='PASS'
+except Exception:R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+(OUT/'author_result.json').write_text(json.dumps(R,indent=2),'utf-8')

