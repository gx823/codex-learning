+    if release['draft']:release=api('PATCH',f"/releases/{release['id']}",json=dict(draft=False,prerelease=True,make_latest='false'))
+    check=api('GET','/releases/tags/'+P['release_tag']);assert not check['draft'] and check['prerelease']
+    STATE.update(status='PUBLISHED_VERIFIED',release_url=check['html_url']);save();print(json.dumps(STATE,ensure_ascii=False))
