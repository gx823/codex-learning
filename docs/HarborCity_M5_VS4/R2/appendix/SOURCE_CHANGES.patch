+"""Export bound Shipping captures without retouching scene pixels."""
+from pathlib import Path
+import argparse, hashlib, io, json, subprocess
+from PIL import Image, ImageDraw, ImageFont
+
+DOC=Path('D:/科研学习/codex学习/docs/HarborCity_M5_VS4/R2')
+ap=argparse.ArgumentParser()
+ap.add_argument('--capital-run',required=True,type=Path)
+ap.add_argument('--old-run',required=True,type=Path)
+ap.add_argument('--thermal-run',required=True,type=Path)
+ap.add_argument('--main-video',type=Path)
+ap.add_argument('--os-run',type=Path)
+a=ap.parse_args()
+plan=json.loads((DOC/'final/FINAL_TEST_PLAN.json').read_text('utf-8-sig'))
+dest=DOC/'final/screenshots';dest.mkdir(parents=True,exist_ok=False)
+records=[];sources={}
+
+def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+
+def export(im,name,src,method='Native Shipping frame, JPEG encoding only'):
+    im=im.convert('RGB')
+    for quality in range(94,29,-2):
+        buf=io.BytesIO();im.save(buf,'JPEG',quality=quality,optimize=True)
+        if buf.tell()<=500000:break
+    assert buf.tell()<=500000
+    path=dest/(name+'.jpg');assert not path.exists();path.write_bytes(buf.getvalue())
+    records.append(dict(file=path.relative_to(DOC).as_posix(),bytes=path.stat().st_size,
+                        sha256=sha(path),source=[p.relative_to(DOC).as_posix() for p in src],
+                        source_sha256=[sha(p) for p in src],method=method,
+                        executable_sha256=plan['sha256'],kind='STANDALONE_PACKAGE'))
+
+for run,expected in ((a.capital_run,'L_CapitalR2'),(a.old_run,'L_HarborTown')):
+    run=run.resolve();assert run.parent==DOC.resolve()
+    exit_record=json.loads((run/'exit.json').read_text('utf-8-sig'))
+    assert exit_record['kind']=='STANDALONE_PACKAGE' and exit_record['status']=='EXITED' and exit_record['exit_code']==0
+    assert exit_record['executable_sha256']==plan['sha256'] and exit_record['actual_maps']==[expected]
+    results=list((run/'User/Saved/M5Tests').rglob('results.json'));assert len(results)==1
+    r=json.loads(results[0].read_text('utf-8-sig'));assert r['status']=='COMPLETE' and r['failures']==0
+    files=sorted(results[0].parent.glob('*.png'));assert len(files)>0
+    for p in files:
+        assert p.stem not in sources;sources[p.stem]=p
+        export(Image.open(p),p.stem,[p])
+
+thermal=a.thermal_run.resolve();assert thermal.parent==DOC.resolve()
+t=json.loads((thermal/'thermal_summary.json').read_text('utf-8-sig'))
+assert t['kind']=='STANDALONE_PACKAGE' and t['sha256']==plan['sha256']
+p=thermal/'D_GRAPHICS_UI.png';export(Image.open(p),'D_GRAPHICS_UI',[p])
+font=ImageFont.truetype('C:/Windows/Fonts/arial.ttf',24)
+for season in ('AFTERNOON','DUSK'):
+    contact=Image.new('RGB',(1920,1544),(24,29,33));draw=ImageDraw.Draw(contact);src=[]
+    for i in range(12):
+        name=f'R2_GATE_V{i+1:02}_{season}';p=sources[name];src.append(p)
+        im=Image.open(p).convert('RGB');im.thumbnail((640,360))
+        x,y=(i%3)*640,(i//3)*386;contact.paste(im,(x,y))
+        draw.text((x+8,y+362),f'V{i+1:02} {season}',font=font,fill='white')
+    export(contact,'R2_FIXED_'+season+'_CONTACT',src,'Twelve complete fixed-view Shipping frames resized equally; labels only')
+
+def pair(names,labels,out):
+    sheet=Image.new('RGB',(1920,592),(24,29,33));d=ImageDraw.Draw(sheet)
+    src=[]
+    for i,(name,label) in enumerate(zip(names,labels)):
+        p=sources[name];src.append(p);im=Image.open(p).convert('RGB');im.thumbnail((960,540))
+        sheet.paste(im,(960*i,0));d.text((960*i+15,555),label,font=font,fill='white')
+    export(sheet,out,src,'Complete native frames resized equally; labels only; not identical map geometry/cameras')
+
+pair(('VS4_OLD_OVERHEAD','R2_GATE_OVERHEAD'),('Old harbor | Shipping','Capital R2 | Shipping'),'COMPARE_OLD_CAPITAL_OVERHEAD')
+sheet=Image.new('RGB',(1920,412),(24,29,33));draw=ImageDraw.Draw(sheet);src=[]
+for i,(pack,scale,ratio) in enumerate((('City','1.00','1.390'),('Castle','0.97','1.399'),('Village','1.12','1.401'))):
+    p=sources['R2_SCALE_'+pack];src.append(p);im=Image.open(p).convert('RGB');im.thumbnail((640,360))
+    sheet.paste(im,(i*640,0));draw.text((i*640+14,376),f'{pack} {scale} | door / hero {ratio}',font=font,fill='white')
+export(sheet,'SCALE_COMPARISON',src,'Three complete Shipping views resized equally; labels only')
+if a.os_run:
+    run=a.os_run.resolve();assert run.parent==DOC.resolve()
+    e=json.loads((run/'exit.json').read_text('utf-8-sig'))
+    assert e['executable_sha256']==plan['sha256'] and e['exit_code']==0
+    assert e['actual_map'].endswith('/L_CapitalR2')
+    for p in sorted(run.glob('OS_*.jpg')):
+        export(Image.open(p),p.stem,[p],'Computer Use screenshot of actual Shipping window; includes window title bar, no scene retouch')
+if a.main_video:
+    video=a.main_video.resolve();assert video.parent==(DOC/'final').resolve()
