+    migration=U.MigrationOptions();migration.prompt=False;migration.ignore_dependencies=True
+    migration.asset_conflict=U.AssetMigrationConflict.SKIP
+    U.AssetToolsHelpers.get_asset_tools().migrate_packages([U.Name(p) for p,_,_ in selected],str(DST),migration)
+    R['migration']='CALLED_ASSETTOOLS'
+    copied=[]
+    for package,_,kind in selected:
+        rel=package.removeprefix('/Game/')+'.uasset';path=DST/rel
+        assert path.exists(),rel
+        copied.append(dict(path=rel,bytes=path.stat().st_size,sha256=digest(path),kind=kind))
+    assert before==inventory(),'Original purchased files changed'
+    R['originals_unchanged']=True;R['copied']=copied
+    R['totals']={pack:dict(assets=sum(x['path'].startswith(pack+'/') for x in copied),bytes=sum(x['bytes'] for x in copied if x['path'].startswith(pack+'/'))) for pack in PACKS}
+    R['status']='PASS'
+except Exception:
+    R['status']='FAIL';R['error']=traceback.format_exc();U.log_error(R['error'])
+save()

