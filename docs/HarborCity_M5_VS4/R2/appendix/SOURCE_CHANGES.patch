+    names=('barrel','crate','basket','bucket','sack','hay','bench','cart','bottle','plate','cup','book','chair','stool','table')
+    for a in E.get_all_level_actors():
+        for c in a.get_components_by_class(U.InstancedStaticMeshComponent):
