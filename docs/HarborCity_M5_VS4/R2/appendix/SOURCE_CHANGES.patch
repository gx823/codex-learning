+"""Read-only inspection of the private spatial-fade material graph."""
+from pathlib import Path
+import json, re, traceback
+import unreal as U
+
+A=U.EditorAssetLibrary; M=U.MaterialEditingLibrary
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line())
+OUT=Path(m[1] or m[2]); DOC=OUT.parent.parent
+MAP=json.loads((DOC/'WORK_CHECKPOINT.json').read_text('utf-8'))['map']
+ROOT=MAP.rsplit('/',1)[0]+'/SpatialCamera'
+R=dict(status='RUNNING',read_only=True,collection={},materials=[])
+
+def prop(obj,name):
+    try:return str(obj.get_editor_property(name))
+    except Exception as e:return 'UNAVAILABLE: '+str(e)
+
+def graph(material,node,seen):
+    if not node or node.get_path_name() in seen:return None
+    seen.add(node.get_path_name())
+    result=dict(name=node.get_name(),type=node.get_class().get_name())
+    fields={'MaterialExpressionCollectionParameter':('collection','parameter_name','parameter_id'),
+            'MaterialExpressionCustom':('code','output_type'),
+            'MaterialExpressionWorldPosition':('world_position_shader_offset',),
