+"""Read original staging assets and migrate a bounded, map-free package set."""
+from pathlib import Path
+import hashlib,json,re,traceback
+import unreal as U
+
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line())
+OUT=Path(m[1] or m[2]);SRC=Path('C:/Users/HP/Documents/Unreal Projects/VFXStaging/Content')
+DST=Path('D:/科研学习/codex学习/HarborCity/Content')
+PACKS=('Fantastic_City_Pack','Fantastic_Highlands_Castle')
+R=dict(status='RUNNING',visual='NOT_RUN_NULLRHI',engine=U.SystemLibrary.get_engine_version(),assets=[],missing=[],migration='NOT_RUN')
+def save():(OUT/'author_result.json').write_text(json.dumps(R,ensure_ascii=False,indent=2),'utf-8')
+def digest(path):
+    with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
+def inventory():
+    return {p.relative_to(SRC).as_posix():dict(bytes=p.stat().st_size,sha256=digest(p)) for pack in PACKS for p in (SRC/pack).rglob('*') if p.is_file()}
+try:
+    assert Path(U.Paths.project_content_dir()).resolve()==SRC.resolve(),'Must load original staging project'
+    before=inventory();(OUT/'original_inventory.json').write_text(json.dumps(before,indent=2),'utf-8')
+    registry=U.AssetRegistryHelpers.get_asset_registry();registry.search_all_assets(True)
+    paths=['/Game/'+pack for pack in PACKS];registry.scan_paths_synchronous(paths,force_rescan=True)
+    selected=[];excluded=[]
+    for root in paths:
+        for data in registry.get_assets_by_path(root,recursive=True):
+            package=str(data.package_name);parts=package.split('/');kind=str(data.asset_class_path.asset_name)
+            if any(p.lower() in ('maps','build','demo') for p in parts) or kind in ('World','MapBuildDataRegistry'):
+                excluded.append(package);continue
+            selected.append((package,data,kind))
+    assert len(selected)>500 and all(not (DST/pack).exists() for pack in PACKS),'Do not overwrite existing migrated folders'
+    known={row[0] for row in selected}
+    options=U.AssetRegistryDependencyOptions(include_soft_package_references=True,include_hard_package_references=True)
+    for index,(package,data,kind) in enumerate(selected):
+        row=dict(package=package,kind=kind)
+        dependencies=[str(p) for p in registry.get_dependencies(package,options)]
+        row['dependencies']=dependencies
+        for dep in dependencies:
+            if dep.startswith('/Game/') and dep not in known:R['missing'].append(dict(package=package,dependency=dep))
+        obj=data.get_asset();row['loaded']=bool(obj)
+        if not obj:R['missing'].append(dict(package=package,reason='load failed'))
+        if obj and isinstance(obj,U.StaticMesh):
+            box=obj.get_bounding_box();row['bounds_cm']=dict(min=[box.min.x,box.min.y,box.min.z],max=[box.max.x,box.max.y,box.max.z])
+            row['materials']=[str(x.material_interface.get_path_name()) if x.material_interface else None for x in obj.static_materials]
+        R['assets'].append(row)
+        if index%100==0:save();U.SystemLibrary.collect_garbage()
+    R['excluded']=excluded
+    # Missing demo-only dependencies are disclosed before migration, never silently imported.
+    unresolved=[r for r in R['missing'] if r.get('reason') or r.get('dependency') not in excluded]
