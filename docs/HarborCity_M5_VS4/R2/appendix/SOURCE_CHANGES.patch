+    try:run()
+    except Exception as e:
+        STATE.update(status='INCOMPLETE',error=str(e) if isinstance(e,(RuntimeError,AssertionError)) else type(e).__name__);save();print(json.dumps(STATE,ensure_ascii=False));raise SystemExit(1)

