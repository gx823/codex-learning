+A=U.EditorAssetLibrary; M=U.MaterialEditingLibrary
+E=U.get_editor_subsystem(U.EditorActorSubsystem); L=U.get_editor_subsystem(U.LevelEditorSubsystem)
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line())
+OUT=Path(m[1] or m[2]); DOC=OUT.parent.parent
+MAP=json.loads((DOC/'WORK_CHECKPOINT.json').read_text('utf-8'))['map']
+ROOT=MAP.rsplit('/',1)[0]+'/SpatialCamera'
+COLLECTION=ROOT+'/MPC_R2Camera'
+R=dict(status='RUNNING',map=MAP,materials=[],components=[],skipped=[],runtime='NOT_RUN',original_assets_modified=False)
+done={}
+
+def fields(cls, **values):
+    value=cls()
+    for name,item in values.items():value.set_editor_property(name,item)
+    return value
+
+def masked_material(source):
+    if isinstance(source,U.MaterialInstanceConstant):
+        overrides=source.get_editor_property('base_property_overrides')
+        if overrides.get_editor_property('override_blend_mode'):
+            return overrides.get_editor_property('blend_mode') in (U.BlendMode.BLEND_OPAQUE,U.BlendMode.BLEND_MASKED)
+        return masked_material(source.get_editor_property('parent'))
+    return isinstance(source,U.Material) and source.get_editor_property('blend_mode') in (U.BlendMode.BLEND_OPAQUE,U.BlendMode.BLEND_MASKED)
+
+def fade(source):
+    key=source.get_path_name()
+    if key.startswith(ROOT+'/'):return source
+    if key in done:return done[key]
+    name=source.get_name()+'_'+hashlib.md5(key.encode('ascii')).hexdigest()[:12]
+    path=ROOT+'/'+name
+    result=A.load_asset(path) if A.does_asset_exist(path) else A.duplicate_asset(key.split('.')[0],path)
+    assert result,key
+    done[key]=result
+    if A.get_metadata_tag(result,'HCR2SpatialFade')=='1':return result
+    if isinstance(result,U.MaterialInstanceConstant):
+        M.set_material_instance_parent(result,fade(source.get_editor_property('parent')))
+        overrides=result.get_editor_property('base_property_overrides')
+        overrides.set_editor_property('override_blend_mode',False)
+        result.set_editor_property('base_property_overrides',overrides)
+        M.update_material_instance(result)
+    else:
+        assert isinstance(result,U.Material),key
+        attributes=result.get_editor_property('use_material_attributes')
+        old=M.get_material_property_input_node(result,U.MaterialProperty.MP_OPACITY_MASK)
+        old_output=M.get_material_property_input_node_output_name(result,U.MaterialProperty.MP_OPACITY_MASK) if old else ''
+        attr=None
+        if attributes:
+            attr=M.get_material_property_input_node(result,U.MaterialProperty.MP_MATERIAL_ATTRIBUTES)
+            attr_output=M.get_material_property_input_node_output_name(result,U.MaterialProperty.MP_MATERIAL_ATTRIBUTES)
+            assert attr,key
+            old=M.create_material_expression(result,U.MaterialExpressionBreakMaterialAttributes)
+            assert M.connect_material_expressions(attr,attr_output,old,'Attr')
+            old_output='OpacityMask'
+        custom=M.create_material_expression(result,U.MaterialExpressionCustom)
+        custom.set_editor_property('description','Local camera-to-hero opening; no component-wide fade')
+        custom.set_editor_property('inputs',[fields(U.CustomInput,input_name=v) for v in ('World','Camera','Hero','Enabled')])
+        custom.set_editor_property('output_type',U.CustomMaterialOutputType.CMOT_FLOAT1)
+        custom.set_editor_property('code','float3 axis=Hero.xyz-Camera.xyz; float t=dot(World.xyz-Camera.xyz,axis)/max(dot(axis,axis),1.0); float radius=lerp(22.0,110.0,saturate(t)); float d=length(World.xyz-(Camera.xyz+saturate(t)*axis)); float fade=(1.0-smoothstep(radius,radius+25.0,d))*smoothstep(0.0,0.04,t)*(1.0-smoothstep(0.94,1.02,t))*saturate(Enabled); return 1.0-0.96*fade;')
+        wp=M.create_material_expression(result,U.MaterialExpressionWorldPosition)
+        assert M.connect_material_expressions(wp,'',custom,'World')
+        for name in ('Camera','Hero','Enabled'):
+            expr=M.create_material_expression(result,U.MaterialExpressionCollectionParameter)
+            expr.set_editor_property('collection',collection)
+            expr.set_editor_property('parameter_name',name)
+            assert M.connect_material_expressions(expr,'',custom,name)
+        dither=M.create_material_expression(result,U.MaterialExpressionMaterialFunctionCall)
+        dither.set_editor_property('material_function',A.load_asset('/Engine/Functions/Engine_MaterialFunctions02/Utility/DitherTemporalAA'))
+        assert M.connect_material_expressions(custom,'',dither,'Alpha Threshold')
+        alpha=dither
+        if old:
+            alpha=M.create_material_expression(result,U.MaterialExpressionMultiply)
+            assert M.connect_material_expressions(old,old_output,alpha,'A')
+            assert M.connect_material_expressions(dither,'',alpha,'B')
+        if attributes:
+            setter=M.create_material_expression(result,U.MaterialExpressionSetMaterialAttributes)
+            assert U.HCM5VS4BowAuthoring.configure_camera_fade_attribute_setter(setter,True)
+            assert M.connect_material_expressions(attr,attr_output,setter,'MaterialAttributes')
+            names=M.get_material_expression_input_names(setter);assert len(names)==2
+            assert M.connect_material_expressions(alpha,'',setter,str(names[1]))
+            assert M.connect_material_property(setter,'',U.MaterialProperty.MP_MATERIAL_ATTRIBUTES)
+        else:assert M.connect_material_property(alpha,'',U.MaterialProperty.MP_OPACITY_MASK)
+        result.set_editor_property('blend_mode',U.BlendMode.BLEND_MASKED)
+        assert U.HCM5VS4BowAuthoring.clear_r2_legacy_opaque_shortcut(result)>=0
+        M.set_material_usage(result,U.MaterialUsage.MATUSAGE_INSTANCED_STATIC_MESHES)
+        M.recompile_material(result)
+    A.set_metadata_tag(result,'HCR2SpatialFade','1')
+    assert A.save_loaded_asset(result,False)
+    R['materials'].append(dict(source=key,derived=result.get_path_name()))
+    return result
+
+try:
+    assert MAP.endswith('R2_eae16c3bde68/L_CapitalR2') and L.load_level(MAP)
+    collection=A.load_asset(COLLECTION) if A.does_asset_exist(COLLECTION) else U.AssetToolsHelpers.get_asset_tools().create_asset('MPC_R2Camera',ROOT,U.MaterialParameterCollection,U.MaterialParameterCollectionFactoryNew())
+    assert collection
+    if A.get_metadata_tag(collection,'HCR2SpatialFade')!='1':
+        collection.set_editor_property('vector_parameters',[fields(U.CollectionVectorParameter,parameter_name=n,default_value=U.LinearColor(0,0,0,0)) for n in ('Camera','Hero')])
+        collection.set_editor_property('scalar_parameters',[fields(U.CollectionScalarParameter,parameter_name='Enabled',default_value=0.)])
+        A.set_metadata_tag(collection,'HCR2SpatialFade','1');assert A.save_loaded_asset(collection,False)
+    for a in E.get_all_level_actors():
+        for c in a.get_components_by_class(U.StaticMeshComponent):
+            sm=c.static_mesh
+            if not sm:continue
+            path=sm.get_path_name().lower()
+            architecture=('/fantastic_city_pack/meshes/modular/' in path or '/fantastic_highlands_castle/meshes/' in path and any('/'+v+'/' in path for v in ('walls','tower','roof','railings','stairs','floors_and_ceilings','deco')))
+            if not architecture:continue
+            originals=[c.get_material(i) for i in range(c.get_num_materials())]
+            if not originals or any(v is None or not masked_material(v) for v in originals):
+                R['skipped'].append(dict(component=c.get_path_name(),mesh=sm.get_path_name(),reason='Non-opaque material; retain full collision'))
+                continue
+            for i,mat in enumerate(originals):c.set_material(i,fade(mat))
+            tags=list(c.component_tags)
+            if U.Name('HCR2SpatialFade') not in tags:tags.append(U.Name('HCR2SpatialFade'))
+            c.component_tags=tags
+            R['components'].append(dict(component=c.get_path_name(),mesh=sm.get_path_name(),instances=c.get_instance_count() if isinstance(c,U.InstancedStaticMeshComponent) else 1))
+    assert R['components'], 'No architectural components were converted'
+    assert L.save_current_level()
+    R.update(status='PASS',collection=COLLECTION,masked_components=len(R['components']),render_log_gate='NOT_RUN')
+except Exception:
+    R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+(OUT/'author_result.json').write_text(json.dumps(R,indent=2),'utf-8')

