+"""Join the three native workload intervals with existing host counter samples."""
+import argparse, csv, io, json, statistics
+from datetime import datetime
+from pathlib import Path
+
+p=argparse.ArgumentParser();p.add_argument('--run',required=True,type=Path);a=p.parse_args();d=a.run.resolve()
+assert d.parent==Path('D:/科研学习/codex学习/docs/HarborCity_M5_VS4/R2').resolve()
+def stamp(s):return datetime.fromisoformat(s.replace('Z','+00:00'))
+ex=json.loads((d/'exit.json').read_text('utf-8-sig'))
+assert ex['status']=='EXITED' and ex['exit_code']==0 and '-R4Case=r2perf' in ex['arguments']
+files=list((d/'User/Saved/M5Tests').rglob('R2_DENSE_PERFORMANCE.csv'));assert len(files)==1
+with files[0].open(encoding='utf-8-sig',newline='') as f:rows=list(csv.DictReader(f))
+samples=[json.loads(x) for x in (d/'thermal_samples.jsonl').read_text('utf-8-sig').splitlines() if x.strip()]
+results=[]
+for row in rows:
+    selected=[s for s in samples if stamp(row['utc_start'])<=stamp(s['time'])<=stamp(row['utc_end'])]
+    counters={k:[] for k in ('gpu_percent','power_w','temperature_c','memory_mib','cpu_percent')}
+    for s in selected:
+        if s.get('gpu') and s.get('gpu_exit')==0:
+            fields=next(csv.reader(io.StringIO(s['gpu'])))
+            for key,index in [('gpu_percent',2),('power_w',3),('temperature_c',4),('memory_mib',5)]:
+                try:counters[key].append(float(fields[index]))
+                except (ValueError,IndexError):pass
+        try:counters['cpu_percent'].append(float(s['cpu_total_percent']))
+        except (ValueError,TypeError,KeyError):pass
+    stats={k:dict(count=len(v),mean=statistics.mean(v) if v else None,maximum=max(v) if v else None) for k,v in counters.items()}
+    enough=len(selected)>=10 and all(v['count']>=10 for v in stats.values())
+    pass_fps=float(row['mean_fps'])>=60 and float(row['p99_ms'])<=25 if row['quality']=='2' else float(row['mean_fps'])>=45
+    vram=stats['memory_mib']['maximum'];pass_vram=vram is not None and vram<=7168
+    results.append(dict(**row,counters=stats,counter_samples=len(selected),sampling_status='PASS' if enough else 'FAIL',render_target='PASS' if pass_fps else 'FAIL',vram_target='PASS' if pass_vram else 'FAIL'))
+assert len(results)==3
+native=json.loads((files[0].parent/'results.json').read_text('utf-8-sig'))
+out=dict(kind=ex['kind'],actual_maps=ex['actual_maps'],executable=ex['executable'],sha256=ex['executable_sha256'],quality=rows[0]['quality'],host=ex['host'],native_failures=native['failures'],views=results,scope='Uncapped1920x1080 native rendering,100percent; all existingNPCs and bow shots, no recording. NVIDIA memory includes desktop driver allocation; Epic45fps is a target, not a minimum user requirement.')
+(d/'performance_summary.json').write_text(json.dumps(out,indent=2),'utf-8')
+print(json.dumps(dict(kind=out['kind'],views=[{k:r[k] for k in ('view','mean_fps','p99_ms','render_target','vram_target','counter_samples')} for r in results])))

