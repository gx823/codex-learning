+
+float AHCM5VS4TrainingDummy::TakeDamage(float Amount,const FDamageEvent& Event,AController* EventInstigator,AActor* Causer)
+{
+    if(!GetWorld()||!FMath::IsFinite(Amount)||Amount<=0)return 0;
+    const float Applied=AActor::TakeDamage(Amount,Event,EventInstigator,Causer);
+    if(!FMath::IsFinite(Applied)||Applied<=0)return 0;
+    FHitResult Hit;FVector Direction;Event.GetBestHitInfo(this,Causer,Hit,Direction);
+    LastImpactPoint=Hit.ImpactPoint;++HitCount;TotalAppliedDamage+=Applied;
+    DisplayHealth=FMath::Max(0.f,DisplayHealth-Applied);
+    // Let the existing attack read its exact damage delta before this fixed prop resets.
+    GetWorldTimerManager().SetTimerForNextTick(FTimerDelegate::CreateWeakLambda(this,[this]{DisplayHealth=MaxHealth;}));
+    return Applied;
+}

