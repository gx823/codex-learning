+        TestEqual(TEXT("Background also caps unpaused play"), UHCM5VS4GraphicsSettings::ResolveLimit(Limit,false,true),10.f);
+    }
+    TestEqual(TEXT("A custom cap below ten is not raised"),UHCM5VS4GraphicsSettings::ResolveLimit(5,true,true),5.f);
+    TStrongObjectPtr<UGameUserSettings> Settings(NewObject<UGameUserSettings>());
+    for(int32 Quality=0;Quality<4;++Quality)
+    {
+        Settings->SetOverallScalabilityLevel(Quality);Settings->SetResolutionScaleValueEx(100);
+        TestEqual(TEXT("Full-resolution quality is still the selected preset"),UHCM5VS4GraphicsSettings::QualityPreset(Settings.Get()),Quality);
+        Settings->SetShadowQuality((Quality+1)%4);
