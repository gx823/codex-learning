+    for (const float Limit : {0.f, 24.f, 30.f, 60.f, 90.f, 120.f})
+    {
+        TestEqual(TEXT("Active play preserves the user limit"), UHCM5VS4GraphicsSettings::ResolveLimit(Limit,false,false),Limit);
