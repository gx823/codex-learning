+TArray<float> UHCM5VS4WorldAuthoring::SampleCapitalTerrainHeights(UObject* EditorWorld,const TArray<FVector>& Locations)
+{
+    TArray<float> Result;
+#if WITH_EDITOR
+    auto* World=Cast<UWorld>(EditorWorld);
+    if(!World||World->IsGameWorld()||!World->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Capital/R2_"))||Locations.Num()>100000)return Result;
+    ALandscape* Landscape=nullptr;
+    for(TActorIterator<ALandscape> It(World);It;++It){if(Landscape)return {};Landscape=*It;}
+    if(!Landscape)return Result;
+    Result.Reserve(Locations.Num());
+    for(const FVector& Location:Locations)
+    {
+        const TOptional<float> Height=Landscape->GetHeightAtLocation(Location);
+        if(!Height.IsSet()||!FMath::IsFinite(Height.GetValue()))return {};
+        Result.Add(Height.GetValue());
+    }
+#endif
+    return Result;
+}
+
+FString UHCM5VS4WorldAuthoring::ExportTownActors(UObject* EditorWorld,const TArray<AActor*>& Actors)
+{
+    FString Text;
+#if WITH_EDITOR
+    auto* World=Cast<UWorld>(EditorWorld);
+    if(!GEditor||!World||World->IsGameWorld()||World->GetOutermost()->GetName()!=TEXT("/Game/HarborCity/M5VS3/Town_169edc3f2e92/L_HarborTown")||Actors.IsEmpty()||Actors.Num()>128)
+    {
+        UE_LOG(LogTemp,Warning,TEXT("R2 actor export rejected: editor=%s world=%s game=%d actors=%d"),GEditor?*GEditor->GetClass()->GetName():TEXT("none"),World?*World->GetOutermost()->GetName():TEXT("none"),World?World->IsGameWorld():false,Actors.Num());
+        return Text;
+    }
+    for(const auto* Actor:Actors)if(!IsValid(Actor)||Actor->GetWorld()!=World)return Text;
+    FStringOutputDevice Output;
+    const FSelectedActorExportObjectInnerContext Context(Actors);
+    if(UExporter::ExportToOutputDevice(&Context,World,nullptr,Output,TEXT("copy"),0,PPF_DeepCompareInstances|PPF_ExportsNotFullyQualified))Text=MoveTemp(Output);
+#endif
+    return Text;
+}
+
+TArray<AActor*> UHCM5VS4WorldAuthoring::ImportCapitalActors(UObject* EditorWorld,const FString& ActorText)
+{
+    TArray<AActor*> Result;
+#if WITH_EDITOR
+    auto* World=Cast<UWorld>(EditorWorld);
+    if(!GEditor||!World||World->IsGameWorld()||!World->GetOutermost()->GetName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Capital/R2_"))||!ActorText.StartsWith(TEXT("Begin Map")))return Result;
+    // Use the same factory as editor paste, also available in commandlets.
+    // The factory remaps inter-actor references without touching the clipboard.
+    auto* Factory=NewObject<ULevelFactory>();const TCHAR* Buffer=*ActorText;
+    Factory->LevelFactoryCreateText(ULevel::StaticClass(),World->GetCurrentLevel(),World->GetCurrentLevel()->GetFName(),RF_Transactional,nullptr,TEXT("paste"),Buffer,Buffer+ActorText.Len(),GWarn,&Result);
+    for(auto* Actor:Result)if(IsValid(Actor)){Actor->PostEditMove(true);Actor->PostDuplicate(EDuplicateMode::Normal);Actor->MarkPackageDirty();}
+#endif
+    return Result;
+}
+
+bool UHCM5VS4WorldAuthoring::QueryCapitalVehiclePlacement(AActor* Vehicle,const FTransform& Requested,FTransform& Safe,FString& Diagnostic)
+{
+#if WITH_EDITOR
+    const auto* Car=Cast<AHCM1Vehicle>(Vehicle);
+    const auto* World=Car?Car->GetWorld():nullptr;
+    if(World&&!World->IsGameWorld()&&World->GetOutermost()->GetName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Capital/R2_")))
+    {
+        const bool Valid=Car->QuerySafeVehicleTransform(Requested,Safe);
+        Diagnostic=Car->GetPlacementDiagnostic();return Valid;
+    }
+#endif
+    Diagnostic=TEXT("Not an authored R2 capital vehicle");return false;
+}

