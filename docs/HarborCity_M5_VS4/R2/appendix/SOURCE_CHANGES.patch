+def route(start):
+    if not (0<=start[0]<SZ[0] and 0<=start[1]<SZ[1]) or blocked[start[1],start[0]]:return None
+    costs={start:0.};previous={};queue=[(heuristic[start[1],start[0]],0.,start)]
+    while queue:
+        _,g,p=heapq.heappop(queue)
