+void AHCM5VS4TrainingDummy::BeginPlay()
+{
+    Super::BeginPlay();
+    DisplayHealth=MaxHealth;
+    GetMesh()->SetHiddenInGame(true);GetMesh()->SetVisibility(false);GetMesh()->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    GetMesh()->SetComponentTickEnabled(false);
