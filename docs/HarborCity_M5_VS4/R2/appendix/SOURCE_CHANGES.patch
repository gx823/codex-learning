+
+void TickHCM5VS4RuntimeAssetAudit(UWorld* World)
+{
+    static const bool Requested=FParse::Param(FCommandLine::Get(),TEXT("VS4R2Capture"))
+        ||FString(FCommandLine::Get()).Contains(TEXT("-R2ThermalProbe="));
+    if(!Requested||!World||!World->IsGameWorld()||!World->AreActorsInitialized()||World->GetTimeSeconds()<2)return;
+#if WITH_EDITOR
+    if((GShaderCompilingManager&&GShaderCompilingManager->IsCompiling())||FAssetCompilingManager::Get().GetNumRemainingAssets()>0)return;
+#endif
+    static TWeakObjectPtr<UWorld> AuditedWorld;
+    static int32 Attempts=0;
+    static double LastAttempt=0;
+    static bool Complete=false;
+    if(AuditedWorld!=World){AuditedWorld=World;Attempts=0;LastAttempt=0;Complete=false;}
+    if(Complete||FPlatformTime::Seconds()-LastAttempt<2)return;
+    LastAttempt=FPlatformTime::Seconds();++Attempts;
+    TSet<UMaterialInterface*> Materials;
+    TMap<UMaterialInterface*,TArray<FString>> Owners;
+    TArray<TSharedPtr<FJsonValue>> Failures;
+    int32 Components=0;
+    for(TActorIterator<AActor> It(World);It;++It)
+    {
+        if(It->IsHidden())continue;
+        TInlineComponentArray<UMeshComponent*> Meshes(*It);
+        for(auto* Mesh:Meshes)
+        {
+            if(!Mesh->IsRegistered()||!Mesh->IsVisible()||Mesh->bHiddenInGame||!Mesh->GetSceneProxy())continue;
+            ++Components;
+            TArray<UMaterialInterface*> Used;Mesh->GetUsedMaterials(Used);
+            for(auto* Material:Used)if(Material){Materials.Add(Material);Owners.FindOrAdd(Material).AddUnique(Mesh->GetPathName());}
+        }
+    }
+    struct FProbe { UMaterialInterface* Material; const FMaterialRenderProxy* Proxy; bool Ready=false,Fallback=false,Complete=false,MapValid=false; };
+    TArray<FProbe> Probes;
+    for(auto* Material:Materials)Probes.Add({Material,Material->GetRenderProxy()});
+    const auto FeatureLevel=World->GetFeatureLevel();
+    ENQUEUE_RENDER_COMMAND(R2MaterialAudit)([&Probes,FeatureLevel](FRHICommandListImmediate&)
+    {
+        for(auto& Probe:Probes)
+        {
+            const auto* Resource=Probe.Proxy?Probe.Proxy->GetMaterialNoFallback(FeatureLevel):nullptr;
+            const auto* ShaderMap=Resource?Resource->GetRenderingThreadShaderMap():nullptr;
+            Probe.Complete=Resource&&Resource->IsRenderingThreadShaderMapComplete();
+            Probe.MapValid=ShaderMap&&ShaderMap->IsValidForRendering();
+            // Editor on-demand maps can render without every unused permutation.
+            // Cooked Shipping still requires the complete-map contract.
+            Probe.Ready=Probe.MapValid;
+#if !WITH_EDITOR
+            Probe.Ready&=Probe.Complete;
+#endif
+            Probe.Fallback=!Probe.Ready;
+        }
+    });
+    FlushRenderingCommands();
+    for(const auto& Probe:Probes)
+    {
+        auto* Material=Probe.Material;
+        const auto* Base=Material->GetMaterial();
+        const bool Default=Base==UMaterial::GetDefaultMaterial(MD_Surface)||Base->GetPathName()==TEXT("/Engine/EngineMaterials/DefaultMaterial.DefaultMaterial");
+        const bool Ready=Probe.Ready;
+        if(Default||!Ready)
+        {
+            auto Row=MakeShared<FJsonObject>();Row->SetStringField(TEXT("material"),Material->GetPathName());
+            Row->SetBoolField(TEXT("default_surface"),Default);Row->SetBoolField(TEXT("shader_map_ready"),Ready);
+            Row->SetBoolField(TEXT("render_fallback_required"),Probe.Fallback);
+            Row->SetBoolField(TEXT("shader_map_valid"),Probe.MapValid);Row->SetBoolField(TEXT("shader_map_complete"),Probe.Complete);
+            TArray<TSharedPtr<FJsonValue>> Sources;for(const auto& Name:Owners[Material])Sources.Add(MakeShared<FJsonValueString>(Name));
+            Row->SetArrayField(TEXT("components"),Sources);
+            Failures.Add(MakeShared<FJsonValueObject>(Row));
+        }
+    }
+    Complete=Failures.IsEmpty()||Attempts>=3;
+    auto Report=MakeShared<FJsonObject>();
+    Report->SetStringField(TEXT("status"),!Complete?TEXT("WAITING_SHADERS"):Failures.IsEmpty()?TEXT("PASS_RUNTIME_MATERIALS"):TEXT("FAIL_RUNTIME_MATERIALS"));
+    Report->SetStringField(TEXT("map"),World->GetOutermost()->GetName());
+    Report->SetStringField(TEXT("scope"),TEXT("Native visible mesh render proxies and valid render-thread shader maps at actual world feature level. Cooked Shipping also requires map completeness; editor on-demand permutation completeness is diagnostic only. Engine/Cook logs separately verify compilation/references. Not proof of every mesh-pass permutation or later dynamic effects."));
+    int32 Incomplete=0;for(const auto& Probe:Probes)Incomplete+=!Probe.Complete;
+    Report->SetNumberField(TEXT("incomplete_shader_maps"),Incomplete);
+    Report->SetBoolField(TEXT("engine_logging_compiled"),!NO_LOGGING);
+    Report->SetNumberField(TEXT("components"),Components);Report->SetNumberField(TEXT("materials"),Materials.Num());
+    Report->SetNumberField(TEXT("attempt"),Attempts);Report->SetArrayField(TEXT("failures"),Failures);
+    FString Json,RequestedLog;FJsonSerializer::Serialize(Report,TJsonWriterFactory<>::Create(&Json));
+    if(FParse::Value(FCommandLine::Get(),TEXT("abslog="),RequestedLog))
+        FFileHelper::SaveStringToFile(Json,*(FPaths::GetPath(RequestedLog)/TEXT("runtime_assets.json")));
+}

