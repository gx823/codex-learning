+if not backup.exists():backup.write_bytes(data)
+CELL=.5;LO=(-100,-70);SZ=(530,440);WIDTH=2.4
+def cell(p):return (round((p[0]-LO[0])/CELL),round((p[1]-LO[1])/CELL))
+def world(p):return (p[0]*CELL+LO[0],p[1]*CELL+LO[1])
+im=Image.new('1',SZ);draw=ImageDraw.Draw(im)
+for b in plan['buildings']:draw.polygon([cell(p) for p in b['corners']],fill=1)
+blocked=distance_transform_edt(~np.array(im))*CELL<1.7
+base=[r for r in plan['roads'] if 'service' not in r['id']]
+targets=Image.new('1',SZ);draw=ImageDraw.Draw(targets)
+for r in base:
+    if r['id'] in plan['sample_road_ids']:draw.line([cell(p) for p in r['points']],fill=1,width=3)
