+"""User-approved five material overrides in the backed-up old harbor map."""
+from pathlib import Path
+import hashlib
+import json
+import re
+import shutil
+import traceback
+import unreal as U
+
+m = re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))', U.SystemLibrary.get_command_line())
+OUT = Path(m[1] or m[2])
+MAP = '/Game/HarborCity/M5VS3/Town_169edc3f2e92/L_HarborTown'
+SOURCE = Path(U.Paths.project_content_dir()) / (MAP.removeprefix('/Game/') + '.umap')
+BACKUP = Path('E:/GameDev/Assets/HarborCity/M5_VS4/R2/old_map_backups') / OUT.name
+R = dict(status='RUNNING', map=MAP, slots=[], modified=False)
+
+def sha(path):
+    return hashlib.file_digest(path.open('rb'), 'sha256').hexdigest()
+
+def transform(t):
+    p, q, s = t.translation, t.rotation, t.scale3d
+    return [p.x, p.y, p.z, q.x, q.y, q.z, q.w, s.x, s.y, s.z]
+
+def snapshot(actors):
+    rows = []
+    for actor in actors:
+        components = []
+        for c in actor.get_components_by_class(U.MeshComponent):
+            components.append(dict(path=c.get_path_name(), transform=transform(c.get_world_transform()),
+                                   collision=str(c.get_collision_enabled()),
+                                   profile=str(c.get_collision_profile_name()),
+                                   visible=c.is_visible(), hidden=c.get_editor_property('hidden_in_game'),
+                                   mesh=c.static_mesh.get_path_name() if isinstance(c, U.StaticMeshComponent) and c.static_mesh else None))
+        rows.append(dict(path=actor.get_path_name(), transform=transform(actor.get_actor_transform()), components=components))
+    return rows
+
+try:
+    assert SOURCE.is_file()
+    BACKUP.mkdir(parents=True, exist_ok=False)
+    saved = BACKUP / SOURCE.name
+    shutil.copy2(SOURCE, saved)
+    assert sha(SOURCE) == sha(saved)
+    R['backup'] = dict(path=str(saved), bytes=saved.stat().st_size, sha256=sha(saved))
+    (BACKUP / 'backup_receipt.json').write_text(json.dumps(R['backup'], indent=2), 'utf-8')
+    assert U.get_editor_subsystem(U.LevelEditorSubsystem).load_level(MAP)
+    mats = {name: U.EditorAssetLibrary.load_asset(path) for name, path in {
+        'iron': '/Game/HarborCity/M5VS3/R4/World/M_Iron',
+        'brass': '/Game/HarborCity/M5VS3/R4/World/M_Brass',
+        'vehicle': '/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/Materials/M_R2VehicleIron',
+    }.items()}
+    assert all(mats.values())
+    actors = U.get_editor_subsystem(U.EditorActorSubsystem).get_all_level_actors()
+    before = snapshot(actors)
+    allowed = {('HCM3Experience', 'CoffeeParcel'), ('HCM5StoryTerminal', 'TerminalMesh'),
+               ('HCM1LightSwitch', 'SwitchMesh'), ('BP_VehicleDrivingHands_C', 'VehicleMesh')}
+    changes = []
+    for a in actors:
+        for c in a.get_components_by_class(U.MeshComponent):
+            for i in range(c.get_num_materials()):
+                old = c.get_material(i)
+                base = old
+                while isinstance(base, U.MaterialInstance):
+                    base = base.get_editor_property('parent')
+                default = not base or any(n in base.get_path_name() for n in ('/WorldGridMaterial.', '/DefaultMaterial.'))
+                if default and (a.get_class().get_name(), c.get_name()) in allowed:
+                    new = mats['vehicle' if c.get_name() == 'VehicleMesh' else 'brass' if c.get_name() in ('CoffeeParcel', 'TerminalMesh') else 'iron']
+                    changes.append((c, i, new))
+                    R['slots'].append(dict(actor=a.get_actor_label(), component=c.get_path_name(), slot=i,
+                                           before=old.get_path_name() if old else None, after=new.get_path_name()))
+    assert len(changes) == 5, 'Unexpected inventory; map not saved'
+    for c, i, new in changes:
+        c.set_material(i, new)
+    after = snapshot(actors)
+    R['non_material_differences'] = [dict(before=a, after=b) for a, b in zip(before, after) if a != b]
+    assert not R['non_material_differences'], 'Non-material actor state changed; map not saved'
+    assert U.get_editor_subsystem(U.LevelEditorSubsystem).save_current_level()
+    R.update(status='PASS', modified=True, after_sha256=sha(SOURCE), invariant_actor_count=len(actors),
+             runtime='NOT_RUN', scope='Only five material overrides; no layouts, collisions, gameplay or source materials changed')
+except Exception:
+    R.update(status='FAIL', error=traceback.format_exc())
+    U.log_error(R['error'])
+(OUT / 'author_result.json').write_text(json.dumps(R, indent=2), 'utf-8')

