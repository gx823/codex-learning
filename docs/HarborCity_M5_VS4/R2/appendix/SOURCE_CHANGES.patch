+void AHCM4R2PlayerCameraManager::InitializeSpatialCamera()
+{
+    if(bSpatialCameraInitialized)return;
+    bSpatialCameraInitialized=true;
+    FString Root=GetWorld()->GetOutermost()->GetName();
+    if(!Root.Contains(TEXT("/M5VS4/Capital/R2_")))return;
+    Root=Root.Left(Root.Find(TEXT("/"),ESearchCase::CaseSensitive,ESearchDir::FromEnd));
+    const FString MaterialRoot=Root+TEXT("/SpatialCamera/");
+    SpatialCameraCollection=LoadObject<UMaterialParameterCollection>(nullptr,*(MaterialRoot+TEXT("MPC_R2Camera.MPC_R2Camera")),nullptr,LOAD_NoWarn|LOAD_Quiet);
+    if(!SpatialCameraCollection)return;
+    for(TActorIterator<AActor> It(GetWorld());It;++It)
+    {
+        TInlineComponentArray<UStaticMeshComponent*> Components(*It);
+        for(auto* Component:Components)
+        {
+            if(!Component->ComponentHasTag(TEXT("HCR2SpatialFade")))continue;
+            bool Ready=Component->GetNumMaterials()>0;
+            for(int32 Slot=0;Slot<Component->GetNumMaterials();++Slot)
+            {
+                const UMaterialInterface* Material=Component->GetMaterial(Slot);
+                if(const auto* Dynamic=Cast<UMaterialInstanceDynamic>(Material))Material=Dynamic->Parent;
+                Ready&=Material&&Material->GetPathName().StartsWith(MaterialRoot);
+            }
+            if(Ready)SpatialFadeComponents.Add(Component);
+        }
+    }
+}
+
+FVector AHCM4R2PlayerCameraManager::ResolveSpatialCamera(AHCM1Character* Character,const FVector& Pivot,const FVector& Desired)
+{
+    FCollisionQueryParams Solid(SCENE_QUERY_STAT(R2SpatialCamera),false,Character);
+    for(TActorIterator<APawn> It(GetWorld());It;++It)Solid.AddIgnoredActor(*It);
+    FCollisionQueryParams Sight=Solid;
+    for(const auto& Component:SpatialFadeComponents)if(Component.IsValid())Sight.AddIgnoredComponent(Component.Get());
+    const FVector Center=Character->GetActorLocation();
+    const float Radius=Character->GetCapsuleComponent()->GetScaledCapsuleRadius();
+    const float Half=Character->GetCapsuleComponent()->GetScaledCapsuleHalfHeight();
+    auto Clear=[&](const FVector& P)
+    {
+        FVector Axis=Center;Axis.Z=FMath::Clamp(P.Z,Center.Z-Half+Radius,Center.Z+Half-Radius);
+        return P.Z>=Pivot.Z&&FVector::Dist(P,Axis)>=Radius+20.f
+            &&!GetWorld()->OverlapBlockingTestByChannel(P,FQuat::Identity,ECC_Camera,FCollisionShape::MakeSphere(14.f),Solid);
+    };
+    FVector Base=Desired-Pivot;Base.Z=FMath::Max(0.,Base.Z);
+    FVector Best=Desired;double Score=TNumericLimits<double>::Max();bool Found=false;
+    // Only sight rays ignore verified fade surfaces. The camera volume never does.
+    for(float Yaw:{0.f,-35.f,35.f,-70.f,70.f,180.f})
+        for(float Rise:{0.f,70.f,140.f})
+        {
+            FVector Wanted=Pivot+Base.RotateAngleAxis(Yaw,FVector::UpVector)+FVector(0,0,Rise);
+            FHitResult Hit;
+            if(GetWorld()->SweepSingleByChannel(Hit,Pivot,Wanted,FQuat::Identity,ECC_Camera,FCollisionShape::MakeSphere(15.f),Sight))Wanted=Hit.Location;
+            if(!Clear(Wanted))continue;
+            const double Cost=FVector::DistSquared(Wanted,Desired);
+            if(Cost<.01){LastSafeSpatialCamera=Wanted;bHasSafeSpatialCamera=true;return Wanted;}
+            if(Cost<Score){Best=Wanted;Score=Cost;Found=true;}
+        }
+    if(Found){LastSafeSpatialCamera=Best;bHasSafeSpatialCamera=true;return Best;}
+    if(bHasSafeSpatialCamera&&FVector::Dist(LastSafeSpatialCamera,Pivot)<700&&Clear(LastSafeSpatialCamera))return LastSafeSpatialCamera;
+    bHasSafeSpatialCamera=false;
+    FHitResult Hit;
+    FVector Fallback=Desired;Fallback.Z=FMath::Max(Fallback.Z,Pivot.Z);
+    if(GetWorld()->SweepSingleByChannel(Hit,Pivot,Fallback,FQuat::Identity,ECC_Camera,FCollisionShape::MakeSphere(15.f),Solid))Fallback=Hit.Location;
+    return Fallback;
+}
 
