+FHCM5VS4R3ViewportCapture::~FHCM5VS4R3ViewportCapture()
+{
+    if (State && State->bStarted && !GetStats().bClosed) AbortAndClose(TEXT("OWNER_DESTROYED_WITHOUT_VERIFIED_DRAIN"));
+}
+
+bool FHCM5VS4R3ViewportCapture::ValidateViewport(FString& OutReason) const
+{
+    check(IsInGameThread());
+    const auto Viewport = SceneViewport.Pin();
+    const auto Target = Window.Pin();
+    if (!Viewport || !Target || Viewport->GetSize() != FIntPoint(Width, Height))
+    {
+        OutReason = TEXT("INVALID_OR_NON_1920X1080_VIEWPORT");
+        return false;
+    }
+    const auto Widget = Viewport->GetViewportWidget().Pin();
+    if (!Widget)
+    {
+        OutReason = TEXT("MISSING_VIEWPORT_WIDGET");
+        return false;
+    }
+    const FGeometry Inner = Target->GetWindowGeometryInWindow();
+    FArrangedChildren Children(EVisibility::Visible);
+    Children.AddWidget(FArrangedWidget(Target.ToSharedRef(), Inner));
+    FWidgetPath Path(Target.ToSharedRef(), Children);
+    if (!Path.ExtendPathTo(FWidgetMatcher(Widget.ToSharedRef()), EVisibility::Visible))
+    {
+        OutReason = TEXT("VIEWPORT_NOT_VISIBLE_IN_TARGET_WINDOW");
+        return false;
+    }
+    const FGeometry Geometry = Path.FindArrangedWidget(Widget.ToSharedRef()).Get(FArrangedWidget::GetNullWidget()).Geometry;
+    const FVector2D Origin = Geometry.GetAbsolutePosition() - Inner.GetAbsolutePosition();
+    const FVector2D Delta = Geometry.GetAbsoluteSize() - Inner.GetAbsoluteSize();
+    if (!Origin.IsNearlyZero(0.5) || !Delta.IsNearlyZero(0.5))
+    {
+        OutReason = FString::Printf(TEXT("VIEWPORT_DOES_NOT_FILL_WINDOW; origin=(%.3f,%.3f), size_delta=(%.3f,%.3f); NO_RESIZE_OR_CROP"),
+            Origin.X, Origin.Y, Delta.X, Delta.Y);
+        return false;
+    }
+    OutReason.Reset();
+    return true;
+}
+
+bool FHCM5VS4R3ViewportCapture::Start(const TSharedRef<FSceneViewport>& Viewport, FString& OutReason)
+{
+    check(IsInGameThread());
+    if (State->bStarted || !FSlateApplication::IsInitialized())
+    {
+        OutReason = TEXT("ALREADY_STARTED_OR_SLATE_UNAVAILABLE");
+        return false;
+    }
+    const auto Widget = Viewport->GetViewportWidget().Pin();
+    if (!Widget)
+    {
+        OutReason = TEXT("MISSING_VIEWPORT_WIDGET");
+        return false;
+    }
+    SceneViewport = Viewport;
+    Window = FSlateApplication::Get().FindWidgetWindow(Widget.ToSharedRef());
+    if (!ValidateViewport(OutReason)) return false;
+    State->TargetWindow = Window.Pin().Get();
+    State->bStarted = true;
+    const auto Shared = State.ToSharedRef();
+    PresentHandle = FSlateApplication::Get().GetRenderer()->OnBackBufferReadyToPresent().AddLambda(
+        [Shared](SWindow& SlateWindow, ISlateViewportProvider& Provider) { Shared->Present(SlateWindow, Provider); });
+    ENQUEUE_RENDER_COMMAND(HCR3ViewportStart)([Shared](FRHICommandListImmediate&)
+    {
+        Shared->EndFrameHandle = FCoreDelegates::OnEndFrameRT.AddLambda([Shared] { Shared->EndFrameRT(); });
+    });
+    return true;
+}
+
+bool FHCM5VS4R3ViewportCapture::Request(const FHCR3ViewportRequest& Metadata, uint64& OutTicket, FString& OutReason)
+{
+    check(IsInGameThread());
+    OutTicket = 0;
+    const bool bViewportValid = ValidateViewport(OutReason);
+    FScopeLock Lock(&State->Mutex);
+    ++State->Stats.Attempts;
+    auto Reject = [this, &OutReason](const TCHAR* Reason)
+    {
+        ++State->Stats.Rejected;
+        OutReason = Reason;
+        return false;
+    };
+    if (!State->bStarted || State->Stats.bStopRequested || State->Stats.bClosed) return Reject(TEXT("NOT_ACCEPTING_REQUESTS"));
+    if (!bViewportValid) { ++State->Stats.Rejected; return false; }
+    if (Metadata.EngineFrame != GFrameCounter || (State->Stats.Accepted && Metadata.EngineFrame <= State->LastRequestedEngineFrame) ||
+        !FMath::IsFinite(Metadata.WallSeconds) || !FMath::IsFinite(Metadata.WorldSeconds))
+        return Reject(TEXT("INVALID_REQUEST_FRAME_OR_TIME; CURRENT_UNIQUE_GT_FRAME_REQUIRED"));
+    int32 Index = INDEX_NONE;
+    for (int32 I = 0; I < Capacity; ++I) if (State->Slots[I].Phase == FState::EPhase::Free) { Index = I; break; }
+    if (Index == INDEX_NONE) return Reject(TEXT("QUEUE_FULL_8; NO_WAIT_NO_DROP_NO_OVERWRITE"));
+    auto& Slot = State->Slots[Index];
+    Slot.Frame = FHCR3ViewportFrame();
+    Slot.Frame.Request = Metadata;
+    const auto Viewport = SceneViewport.Pin();
+    const auto Target = Window.Pin();
+    const auto NativeWindow = Target->GetNativeWindow();
+    Slot.OSWindow = NativeWindow ? NativeWindow->GetOSWindowHandle() : nullptr;
+    Slot.WindowTopLeft = Target->GetPositionInScreen();
+    Slot.WindowBottomRight = Slot.WindowTopLeft + Target->GetSizeInScreen();
+    Slot.Frame.bViewportHDR = Viewport->GetSceneHDREnabled();
+    Slot.Frame.ViewportOutputFormat = int32(Viewport->GetDisplayOutputFormat());
+    Slot.Frame.ViewportColorGamut = int32(Viewport->GetDisplayColorGamut());
+    Slot.Frame.ViewportDisplayGamma = Viewport->GetDisplayGamma();
+    Slot.Frame.RequestWindowColor = ReadWindowColorProfile(Target->GetIsHDR(), Slot.OSWindow,
+        Slot.WindowTopLeft, Slot.WindowBottomRight);
+    Slot.Frame.Ticket = ++State->Stats.Accepted;
+    Slot.Frame.Status = TEXT("QUEUED_RENDER_ARM");
+    Slot.Phase = FState::EPhase::Queued;
+    State->LastRequestedEngineFrame = Metadata.EngineFrame;
+    ++State->Stats.OccupiedSlots;
+    State->Stats.HighWaterSlots = FMath::Max(State->Stats.HighWaterSlots, State->Stats.OccupiedSlots);
+    OutTicket = Slot.Frame.Ticket;
+    const auto Shared = State.ToSharedRef();
+    ENQUEUE_RENDER_COMMAND(HCR3ViewportArm)([Shared, Index](FRHICommandListImmediate&)
+    {
+        FScopeLock Guard(&Shared->Mutex);
+        auto& Pending = Shared->Slots[Index];
+        if (Pending.Phase != FState::EPhase::Queued) return;
+        Pending.Frame.ArmEngineCounterRT = GFrameCounterRenderThread;
+        Pending.Frame.ArmRenderFrame = GFrameNumberRenderThread;
+        Pending.Frame.bEngineCounterEqualsRequest = Pending.Frame.Request.EngineFrame == GFrameCounterRenderThread;
+        Shared->Stats.EngineCounterMismatches += !Pending.Frame.bEngineCounterEqualsRequest;
+        Pending.Phase = FState::EPhase::Armed;
+    });
+    return true;
+}
+
+void FHCM5VS4R3ViewportCapture::Poll(TArray<FHCR3ViewportFrame>& OutFrames, int32 MaxResults)
+{
+    check(IsInGameThread());
+    bool bQueuePoll = false;
+    {
+        FScopeLock Lock(&State->Mutex);
+        TArray<int32, TInlineAllocator<Capacity>> Terminal;
+        for (int32 I = 0; I < Capacity; ++I)
+            if (State->Slots[I].Phase == FState::EPhase::Ready || State->Slots[I].Phase == FState::EPhase::Failed) Terminal.Add(I);
+        Terminal.Sort([this](int32 A, int32 B) { return State->Slots[A].Frame.Ticket < State->Slots[B].Frame.Ticket; });
+        const int32 Count = FMath::Min(Terminal.Num(), FMath::Clamp(MaxResults, 0, Capacity));
+        for (int32 I = 0; I < Count; ++I)
+        {
+            auto& Slot = State->Slots[Terminal[I]];
+            if (Slot.Frame.Ticket != State->NextDeliveryTicket) break;
+            if (Slot.Phase == FState::EPhase::Ready) ++State->Stats.Delivered;
+            else ++State->Stats.DeliveredFailures;
+            OutFrames.Add(MoveTemp(Slot.Frame));
+            Slot.Phase = FState::EPhase::Free;
+            --State->Stats.OccupiedSlots;
+            ++State->NextDeliveryTicket;
+        }
+        bQueuePoll = State->bStarted && !State->Stats.bClosed && !State->bPollQueued;
+        if (bQueuePoll) State->bPollQueued = true;
+    }
+    OutFrames.Sort([](const auto& A, const auto& B) { return A.Ticket < B.Ticket; });
+    if (!bQueuePoll) return;
+    const auto Shared = State.ToSharedRef();
+    ENQUEUE_RENDER_COMMAND(HCR3ViewportPoll)([Shared](FRHICommandListImmediate&)
+    {
+        FScopeLock Lock(&Shared->Mutex);
+        Shared->bPollQueued = false;
+        if (!Shared->Stats.bClosed) Shared->CollectReadyRT();
+    });
+}
+
+void FHCM5VS4R3ViewportCapture::BeginStop()
+{
+    check(IsInGameThread());
+    {
+        FScopeLock Lock(&State->Mutex);
+        if (!State->bStarted || State->Stats.bStopRequested || State->Stats.bClosed) return;
+        State->Stats.bStopRequested = true;
+    }
+    const auto Shared = State.ToSharedRef();
+    ENQUEUE_RENDER_COMMAND(HCR3ViewportStop)([Shared](FRHICommandListImmediate&)
+    {
+        FScopeLock Lock(&Shared->Mutex);
+        Shared->bStopArmedRT = true;
+    });
+}
+
+FHCR3ViewportCaptureStats FHCM5VS4R3ViewportCapture::GetStats() const
+{
+    check(IsInGameThread());
+    FScopeLock Lock(&State->Mutex);
+    auto Result = State->Stats;
+    Result.UpdateDrainStatus();
+    return Result;
+}
+
+TArray<FHCR3ViewportPresentEvidence> FHCM5VS4R3ViewportCapture::TakePresentEvidenceAfterClose()
+{
+    check(IsInGameThread());
+    FScopeLock Lock(&State->Mutex);
+    check(State->Stats.bClosed);
+    return MoveTemp(State->PresentEvidence);
+}
+
+void FHCM5VS4R3ViewportCapture::RemovePresentDelegate()
+{
+    if (PresentHandle.IsValid() && FSlateApplication::IsInitialized())
+        FSlateApplication::Get().GetRenderer()->OnBackBufferReadyToPresent().Remove(PresentHandle);
+    PresentHandle.Reset();
+}
+
+bool FHCM5VS4R3ViewportCapture::Close(FString& OutReason)
+{
+    check(IsInGameThread());
+    if (!GetStats().bDrainComplete)
+    {
+        OutReason = TEXT("DRAIN_NOT_COMPLETE; KEEP_TICKING_AND_POLLING");
+        return false;
+    }
+    RemovePresentDelegate();
+    const auto Shared = State.ToSharedRef();
+    ENQUEUE_RENDER_COMMAND(HCR3ViewportClose)([Shared](FRHICommandListImmediate&)
+    {
+        FScopeLock Lock(&Shared->Mutex);
+        FCoreDelegates::OnEndFrameRT.Remove(Shared->EndFrameHandle);
+        Shared->EndFrameHandle.Reset();
+        for (auto& Slot : Shared->Slots) Slot.Readback.Reset();
+        Shared->Stats.bClosed = true;
+    });
+    FlushRenderingCommands();
+    OutReason.Reset();
+    return true;
+}
+
+void FHCM5VS4R3ViewportCapture::AbortAndClose(const FString& Reason)
+{
+    check(IsInGameThread());
+    RemovePresentDelegate();
+    {
+        FScopeLock Lock(&State->Mutex);
+        if (State->Stats.bClosed) return;
+        State->Stats.bStopRequested = true;
+        State->Stats.bAborted = true;
+    }
+    const auto Shared = State.ToSharedRef();
+    ENQUEUE_RENDER_COMMAND(HCR3ViewportAbort)([Shared, Reason](FRHICommandListImmediate& Commands)
+    {
+        FScopeLock Lock(&Shared->Mutex);
+        FCoreDelegates::OnEndFrameRT.Remove(Shared->EndFrameHandle);
+        Shared->EndFrameHandle.Reset();
+        bool bPendingGPU = false;
+        for (const auto& Slot : Shared->Slots) bPendingGPU |= Slot.Phase == FState::EPhase::CopyPending;
+        if (bPendingGPU) Commands.SubmitAndBlockUntilGPUIdle();
+        for (auto& Slot : Shared->Slots)
+        {
+            if (Slot.Phase != FState::EPhase::Free && Slot.Phase != FState::EPhase::Ready && Slot.Phase != FState::EPhase::Failed)
+                Shared->Fail(Slot, *(TEXT("ABORTED: ") + Reason));
+            Slot.Readback.Reset();
+        }
+        Shared->Stats.bClosed = true;
+    });
+    FlushRenderingCommands();
+}
