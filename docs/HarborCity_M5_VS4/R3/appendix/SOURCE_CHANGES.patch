+FString UHCM5VS2VillageEditor::CopyVillageCompleteSelection(const TArray<FString>& Roots, const FString& Destination, bool bApply)
+{
+#if WITH_EDITOR
+    auto Report = MakeShared<FJsonObject>();
+    Report->SetBoolField(TEXT("apply_requested"), bApply);
+    Report->SetStringField(TEXT("selection_kind"), TEXT("R3_COMPLETE_THREE_VILLAGE_BLUEPRINTS"));
+    Report->SetNumberField(TEXT("native_copy_calls"), 0);
+    Report->SetNumberField(TEXT("native_save_requests"), 0);
+    Report->SetNumberField(TEXT("saved_destination_packages"), 0);
+    Report->SetBoolField(TEXT("native_save_completed"), false);
+    Report->SetArrayField(TEXT("roots"), Strings(Roots));
+    Report->SetStringField(TEXT("destination"), Destination);
+    Report->SetStringField(TEXT("blueprint_logic"), TEXT("Original serialized Blueprint and particle logic copied by UE; no actor construction or gameplay executed by this helper"));
+    FVillageMountScope Mount;
+    if (!Mount.Error.IsEmpty()) return Result(Report, Mount.Error);
+
+    const FString TargetPrefix = TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/Village/R3_Complete_");
+    const TSet<FString> RequiredRoots = {
+        VillageMount + TEXT("blueprints/buildings/BP_BLD_house_1"),
+        VillageMount + TEXT("blueprints/buildings/BP_BLD_house_2"),
+        VillageMount + TEXT("blueprints/buildings/BP_BLD_house_3")};
+    TSet<FString> ActualRoots;
+    for (const FString& Root : Roots) ActualRoots.Add(Root);
+    if (Roots.Num() != 3 || ActualRoots.Num() != 3)
+        return Result(Report, TEXT("Exactly three distinct approved complete Village house roots required"));
+    for (const FString& Root : ActualRoots)
+        if (!RequiredRoots.Contains(Root)) return Result(Report, TEXT("Unexpected complete Village root: ") + Root);
+    if (!Destination.StartsWith(TargetPrefix) || Destination.Len() != TargetPrefix.Len() + 12
+        || !FPackageName::IsValidLongPackageName(Destination))
+        return Result(Report, TEXT("Fresh exact R3 Village/R3_Complete_<12 hex> destination required"));
+    for (TCHAR Ch : Destination.Right(12))
+        if (!FChar::IsHexDigit(Ch)) return Result(Report, TEXT("Invalid complete-copy destination digest"));
+    const FString TargetFolder = FPackageName::LongPackageNameToFilename(Destination);
+    if (IFileManager::Get().DirectoryExists(*TargetFolder))
+        return Result(Report, TEXT("Complete-copy destination directory already exists; no overwrite or partial reuse"));
+
+    // This independent allowlist does not alter the older static-only copy contract.
+    IAssetRegistry& Registry = FModuleManager::LoadModuleChecked<FAssetRegistryModule>(TEXT("AssetRegistry")).Get();
+    TSet<FString> Seen;
+    TArray<FString> Queue = Roots, Packages, External;
+    TMap<FString, FString> Classes;
+    const FString RectBlueprint = VillageMount + TEXT("blueprints/FX/BP_FX_RectLight");
+    const FString SmokeParticle = VillageMount + TEXT("effects/PS_FX_smoke");
+    for (int32 Index = 0; Index < Queue.Num(); ++Index)
+    {
+        const FString Current = Queue[Index];
+        if (Seen.Contains(Current)) continue;
+        Seen.Add(Current);
+        if (Current.StartsWith(TEXT("/Engine/")) || Current.StartsWith(TEXT("/Script/")))
+        { External.AddUnique(Current); continue; }
+        if (!Current.StartsWith(VillageMount) || !FPackageName::IsValidLongPackageName(Current))
+            return Result(Report, TEXT("Unexpected complete-copy dependency: ") + Current);
+        if (Packages.Num() >= MaxClosure)
+            return Result(Report, TEXT("Complete selected closure exceeds 280 source packages"));
+        TArray<FAssetData> Assets;
+        Registry.GetAssetsByPackageName(FName(*Current), Assets, true);
+        if (Assets.Num() != 1)
+            return Result(Report, TEXT("Expected one source registry asset in ") + Current);
+        const FString Class = Assets[0].AssetClassPath.GetAssetName().ToString();
+        const bool bStaticDependency = Class == TEXT("StaticMesh") || Class == TEXT("Material")
+            || Class == TEXT("MaterialInstanceConstant") || Class == TEXT("MaterialFunction")
+            || Class == TEXT("MaterialParameterCollection") || Class == TEXT("Texture2D") || Class == TEXT("TextureCube");
+        const bool bApprovedBlueprint = Class == TEXT("Blueprint") && (RequiredRoots.Contains(Current) || Current == RectBlueprint);
+        const bool bApprovedParticle = Class == TEXT("ParticleSystem") && Current == SmokeParticle;
+        if (!bStaticDependency && !bApprovedBlueprint && !bApprovedParticle)
+            return Result(Report, TEXT("Unsupported complete-copy dependency class: ") + Class + TEXT(" ") + Current);
+        FString Filename;
+        if (!FPackageName::DoesPackageExist(Current, &Filename)
+            || !FPaths::ConvertRelativePathToFull(Filename).StartsWith(VillageDisk))
+            return Result(Report, TEXT("Complete source package escaped exact mounted folder: ") + Current);
+        TArray<FName> Dependencies;
+        if (!Registry.GetDependencies(FName(*Current), Dependencies, UE::AssetRegistry::EDependencyCategory::Package))
+            return Result(Report, TEXT("Source dependency node unavailable, not an empty closure: ") + Current);
+        Packages.Add(Current); Classes.Add(Current, Class);
+        for (FName Dependency : Dependencies) Queue.Add(Dependency.ToString());
+    }
+    Packages.Sort(); External.Sort();
+    if (!Packages.Contains(RectBlueprint) || !Packages.Contains(SmokeParticle))
+        return Result(Report, TEXT("Expected original RectLight and smoke packages absent from complete dependency closure"));
+
+    TMap<FString, FString> CopyMap;
+    TMap<FString, FMD5Hash> SourceHashes;
+    TMap<FString, int64> SourceSizes;
+    TArray<TSharedPtr<FJsonValue>> Entries;
+    int64 SourceBytes = 0;
+    for (const FString& SourcePackage : Packages)
+    {
+        const FString TargetPackage = Destination + TEXT("/") + SourcePackage.Mid(VillageMount.Len());
+        if (FPackageName::DoesPackageExist(TargetPackage) || FindObject<UPackage>(nullptr, *TargetPackage))
+            return Result(Report, TEXT("Complete destination package already exists: ") + TargetPackage);
+        FString Filename;
+        FPackageName::DoesPackageExist(SourcePackage, &Filename);
+        Filename = FPaths::ConvertRelativePathToFull(Filename);
+        const int64 Size = IFileManager::Get().FileSize(*Filename);
+        if (Size <= 0) return Result(Report, TEXT("Unreadable complete source package: ") + SourcePackage);
+        SourceBytes += Size;
+        if (SourceBytes > MaxSourceBytes)
+            return Result(Report, TEXT("Complete closure exceeds 1 GiB; review size before copying"));
+        SourceSizes.Add(Filename, Size);
+        const FMD5Hash SourceHash = FMD5Hash::HashFile(*Filename);
+        if (!SourceHash.IsValid()) return Result(Report, TEXT("Unable to hash complete source package: ") + SourcePackage);
+        SourceHashes.Add(Filename, SourceHash);
+        auto Entry = MakeShared<FJsonObject>();
+        Entry->SetStringField(TEXT("source"), SourcePackage);
+        Entry->SetStringField(TEXT("destination"), TargetPackage);
+        Entry->SetStringField(TEXT("source_class"), Classes.FindChecked(SourcePackage));
+        Entry->SetStringField(TEXT("source_file"), Filename);
+        Entry->SetNumberField(TEXT("source_bytes"), static_cast<double>(Size));
+        Entries.Add(MakeShared<FJsonValueObject>(Entry));
+        CopyMap.Add(SourcePackage, TargetPackage);
+    }
+    Report->SetArrayField(TEXT("packages"), Entries);
+    Report->SetArrayField(TEXT("external_engine_script_dependencies"), Strings(External));
+    Report->SetNumberField(TEXT("package_count"), Packages.Num());
+    Report->SetNumberField(TEXT("source_bytes"), static_cast<double>(SourceBytes));
+    Report->SetStringField(TEXT("source_content_check"), TEXT("All closure files: native MD5 plus size before/after; caller binds SHA-256 evidence separately"));
+    if (!bApply) return Result(Report);
+
+    const bool bOriginalUnattendedScript = GIsRunningUnattendedScript;
+    Report->SetBoolField(TEXT("unattended_script_before"), bOriginalUnattendedScript);
+    Report->SetNumberField(TEXT("native_copy_calls"), 1);
+    Report->SetNumberField(TEXT("native_save_requests"), 1);
+    bool bCopied = false;
+    {
+        // Slate callbacks outlive Python's scoped unattended-script guard.
+        // FileHelpers otherwise cancels this save under -unattended, while
+        // AdvancedCopyPackages still returns true without checking that result.
+        TGuardValue<bool> UnattendedScriptGuard(GIsRunningUnattendedScript, true);
+        bCopied = FAssetToolsModule::GetModule().Get().AdvancedCopyPackages(CopyMap, true, false, nullptr, EMessageSeverity::Error);
+    }
+    Report->SetBoolField(TEXT("unattended_script_restored"), GIsRunningUnattendedScript == bOriginalUnattendedScript);
+    Report->SetBoolField(TEXT("native_advanced_copy_returned"), bCopied);
+    int32 SavedPackages = 0;
+    int32 DirtyDestinationPackages = 0;
+    for (const auto& Pair : CopyMap)
+    {
+        FString SavedFilename;
+        if (FPackageName::DoesPackageExist(Pair.Value, &SavedFilename)
+            && IFileManager::Get().FileSize(*SavedFilename) > 0) ++SavedPackages;
+        if (UPackage* Package = FindPackage(nullptr, *Pair.Value))
+            if (Package->IsDirty()) ++DirtyDestinationPackages;
+    }
+    Report->SetNumberField(TEXT("saved_destination_packages"), SavedPackages);
+    Report->SetNumberField(TEXT("dirty_destination_packages"), DirtyDestinationPackages);
+    Report->SetBoolField(TEXT("native_save_completed"), bCopied && SavedPackages == CopyMap.Num() && DirtyDestinationPackages == 0);
+    bool bSourceUnchanged = true;
+    for (const auto& Pair : SourceHashes)
+        bSourceUnchanged &= IFileManager::Get().FileSize(*Pair.Key) == SourceSizes.FindChecked(Pair.Key)
+            && FMD5Hash::HashFile(*Pair.Key) == Pair.Value;
+    Report->SetBoolField(TEXT("source_closure_bytes_unchanged"), bSourceUnchanged);
+    if (!bSourceUnchanged) return Result(Report, TEXT("Source bytes changed during complete native copy; preserve diagnostic output"));
+    if (!bCopied) return Result(Report, TEXT("Complete native copy failed; preserve partial destination without retry/reuse"));
+    if (SavedPackages != CopyMap.Num() || DirtyDestinationPackages != 0)
+        return Result(Report, TEXT("Native copy did not complete the one requested destination save; preserve actual disk/dirty counts"));
+    Registry.ScanPathsSynchronous({Destination}, true);
+    for (const auto& Pair : CopyMap)
+    {
+        if (!FPackageName::DoesPackageExist(Pair.Value))
+            return Result(Report, TEXT("Complete copy did not save expected package: ") + Pair.Value);
+        TArray<FAssetData> Assets;
+        Registry.GetAssetsByPackageName(FName(*Pair.Value), Assets, true);
+        if (Assets.Num() != 1 || Assets[0].AssetClassPath.GetAssetName().ToString() != Classes.FindChecked(Pair.Key))
+            return Result(Report, TEXT("Complete copied asset class differs: ") + Pair.Value);
+        TArray<FName> Dependencies;
+        if (!Registry.GetDependencies(FName(*Pair.Value), Dependencies, UE::AssetRegistry::EDependencyCategory::Package))
+            return Result(Report, TEXT("Copied dependency node unavailable; cannot verify reference remapping: ") + Pair.Value);
+        for (FName Dependency : Dependencies)
+        {
+            const FString Name = Dependency.ToString();
+            if (!Name.StartsWith(Destination + TEXT("/")) && !Name.StartsWith(TEXT("/Engine/")) && !Name.StartsWith(TEXT("/Script/")))
+                return Result(Report, TEXT("Complete copy retains external dependency: ") + Pair.Value + TEXT(" -> ") + Name);
+        }
+    }
+    Report->SetBoolField(TEXT("saved_packages_and_reference_remap_verified"), true);
+    Report->SetBoolField(TEXT("source_world_or_builtdata_included"), false);
+    Report->SetNumberField(TEXT("complete_house_blueprints"), 3);
+    return Result(Report);
+#else
+    return TEXT("{\"status\":\"FAIL\",\"error\":\"Editor only\"}");
+#endif
+}
