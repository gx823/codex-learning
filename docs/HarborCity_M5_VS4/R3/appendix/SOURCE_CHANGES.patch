+struct FR3BridgeRun
+{
+    TArray<TArray<FVector>> Routes;
+    TArray<FVector> Gates, NPCPoints;
+    TArray<bool> SeenGates;
+    TWeakObjectPtr<AHCM3NPC> NPC;
+    FHCM3NPCState OriginalNPC;
+    TArray<FVector> OriginalPatrol;
+    bool OriginalStationary=false, SavedNPC=false, Failed=false, AtEnd=false, Arrived=false;
+    bool Ready=false, Entered=false;
+    int32 Route=0, Segment=0, NPCLeg=0, NPCFailures=0;
+    double ProgressBase=0, LastProgress=0, LastProgressWall=0, Travel=0, MaxCross=0;
+    double NextFlush=0, NextNPCProgress=0;
+    float Steering=0, Throttle=0;
+    FVector Previous=FVector::ZeroVector, NPCProgress=FVector::ZeroVector;
+    FString Rows=TEXT("engine_frame,world,phase,route,segment,x,y,z,speed_kmh,steer,throttle,travel_cm,cross_cm,contacts,contact_mean_z,npc_path_failures\n");
+    FString Failure;
+};
+
+bool R3BridgePoints(const TSharedPtr<FJsonObject>& Object,const TCHAR* Name,TArray<FVector>& Out,int32 Min,int32 Max)
+{
+    const TArray<TSharedPtr<FJsonValue>>* Rows=nullptr;
+    if(!Object.IsValid()||!Object->TryGetArrayField(Name,Rows)||Rows->Num()<Min||Rows->Num()>Max)return false;
+    for(const auto& Row:*Rows)
+    {
+        const TArray<TSharedPtr<FJsonValue>>* XYZ=nullptr;
+        if(!Row->TryGetArray(XYZ)||XYZ->Num()!=3)return false;
+        double V[3];
+        for(int32 I=0;I<3;++I)if(!(*XYZ)[I]->TryGetNumber(V[I])||!FMath::IsFinite(V[I]))return false;
+        if(FMath::Abs(V[0])>100000||FMath::Abs(V[1])>100000||FMath::Abs(V[2])>10000)return false;
+        Out.Add(FVector(V[0],V[1],V[2]));
+    }
+    return true;
+}
+}
+
+bool AHCM1TestRunner::AddM5VS4R3BridgeTests()
+{
+    FString Kind;FParse::Value(FCommandLine::Get(),TEXT("R4Case="),Kind);
+    if(Kind!=TEXT("r3bridgeqa"))return false;
+    const auto S=MakeShared<FR3BridgeRun>();
+    const FString RouteFile=FPlatformMisc::GetEnvironmentVariable(TEXT("HC_R3_BRIDGE_ROUTE"));
+    const FString RouteHash=FPlatformMisc::GetEnvironmentVariable(TEXT("HC_R3_BRIDGE_ROUTE_SHA256"));
+    auto Flush=[this,S]
+    {
+        if(S->Rows.IsEmpty())return;
+        FFileHelper::SaveStringToFile(S->Rows,*(RunDirectory/TEXT("R3_BRIDGE_TRAJECTORY.csv")),
+            FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM,&IFileManager::Get(),FILEWRITE_Append);
+        S->Rows.Reset();
+    };
+    auto Restore=[this,S,Flush]
+    {
+        R5FrameSample=nullptr;Release(TEXT("Drive"));Release(TEXT("Handbrake"));Release(TEXT("Interact"));Flush();
+        if(!S->SavedNPC)return;
+        auto* N=S->NPC.Get();
+        if(N){N->PatrolPoints=S->OriginalPatrol;N->bStationary=S->OriginalStationary;}
+        const bool Restored=N&&N->RestoreState(S->OriginalNPC)
+            &&N->PatrolPoints==S->OriginalPatrol&&N->bStationary==S->OriginalStationary
+            &&N->CaptureState().RegionId==S->OriginalNPC.RegionId;
+        Check(TEXT("R3 bridge restores only snapshotted pedestrian"),Restored,
+            TEXT("original state, region, stationary flag and patrol; no task NPC changed"),
+            N?N->StableId.ToString():TEXT("missing NPC"),TEXT("A fixture cleanup"));
+        S->SavedNPC=false;
+    };
+    M5ReviewCameraCleanup=Restore;
+    AddStep(TEXT("R3 bridge private route and explicit QA guard"),.1,[this,S,RouteFile,RouteHash]
+    {
+        FString Canonical=FPaths::ConvertRelativePathToFull(RouteFile);FPaths::NormalizeFilename(Canonical);
+        const bool Guard=HCM5VS3LocalQA()&&FParse::Param(FCommandLine::Get(),TEXT("VS4R3Capture"))
+            &&UHCM5VS4PreviewSession::IsCapital(GetWorld())&&PC&&Character&&Car&&IsOnFoot()
+            &&PC->GetSaveSlotName().StartsWith(TEXT("HarborCity_M5_VS1_Test_VS3_R3_"))
+            &&Canonical.StartsWith(TEXT("E:/GameDev/Assets/HarborCity/M5_VS4/R3/"))&&RouteHash.Len()==64;
+        if(!RequireCamera(TEXT("R3 bridge isolated explicit QA prerequisite"),Guard,
