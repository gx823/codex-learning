+bool HCR3RequiresNativeInitialFocus()
+{
+    return HCM5VS3LocalQA()&&FParse::Param(FCommandLine::Get(),TEXT("VS4R3Capture"));
+}
+
+struct FHCR3InitialFocus
+{
+    bool PlatformForeground=false,ViewportMatches=false,Visible=false,Minimized=true;
+    uint64 ViewportHandle=0,ForegroundHandle=0;
+    bool Ready() const { return PlatformForeground&&ViewportMatches&&Visible&&!Minimized; }
+    FString Describe(bool SlateFocused) const
+    {
+        return FString::Printf(TEXT("slate_focused=%d platform_foreground=%d viewport_matches=%d visible=%d minimized=%d viewport_hwnd=%llu foreground_hwnd=%llu frame=%llu"),
+            SlateFocused,PlatformForeground,ViewportMatches,Visible,Minimized,ViewportHandle,ForegroundHandle,GFrameCounter);
+    }
+};
+
+// Read the actual game window, not Slate's initially-true activation cache.
+FHCR3InitialFocus HCR3ObserveInitialFocus()
+{
+    FHCR3InitialFocus Out;
+#if PLATFORM_WINDOWS
+    Out.PlatformForeground=FPlatformApplicationMisc::IsThisApplicationForeground();
+    const HWND Foreground=::GetForegroundWindow();
+    Out.ForegroundHandle=static_cast<uint64>(reinterpret_cast<UPTRINT>(Foreground));
+    UGameViewportClient* Viewport=GEngine?GEngine->GameViewport.Get():nullptr;
+    const auto Window=Viewport?Viewport->GetWindow():TSharedPtr<SWindow>();
+    if(Window.IsValid()&&Window->GetNativeWindow().IsValid())
+    {
+        const HWND Handle=static_cast<HWND>(Window->GetNativeWindow()->GetOSWindowHandle());
+        Out.ViewportHandle=static_cast<uint64>(reinterpret_cast<UPTRINT>(Handle));
+        Out.ViewportMatches=Handle&&Handle==Foreground;
+        Out.Visible=Handle&&::IsWindowVisible(Handle);
+        Out.Minimized=!Handle||::IsIconic(Handle);
+    }
+#endif
+    return Out;
+}
+}
 
