+
+struct FHCR3ViewportCaptureStats
+{
+    uint64 Attempts = 0;
+    uint64 Accepted = 0;
+    uint64 Rejected = 0;
+    uint64 CopySubmitted = 0;
+    uint64 Ready = 0;
+    uint64 Failed = 0;
+    uint64 Delivered = 0;
+    uint64 DeliveredFailures = 0;
+    uint64 EngineCounterMismatches = 0;
+    uint64 DuplicatePresentCallbacks = 0;
+    uint64 TargetPresentCallbacks = 0;
+    uint64 NonConsumingPresentCallbacks = 0;
+    uint64 NonConsumingDuplicateCallbacks = 0;
+    uint64 InvalidPresentCallbacks = 0;
+    uint64 PresentEvidenceEvents = 0;
+    uint64 PresentEvidenceOverflow = 0;
+    int32 OccupiedSlots = 0;
+    int32 HighWaterSlots = 0;
+    bool bStopRequested = false;
+    bool bRenderStopBoundaryObserved = false;
+    bool bAborted = false;
+    bool bClosed = false;
+    bool bDrainComplete = false;
+    bool bLosslessReadback = false;
+
+    void UpdateDrainStatus()
+    {
+        bDrainComplete = bStopRequested && bRenderStopBoundaryObserved && OccupiedSlots == 0 &&
+            Accepted == Delivered + DeliveredFailures;
+        bLosslessReadback = bDrainComplete && !bAborted && Accepted > 0 && Rejected == 0 && Failed == 0 &&
+            EngineCounterMismatches == 0 && InvalidPresentCallbacks == 0 && PresentEvidenceOverflow == 0 &&
+            DuplicatePresentCallbacks == NonConsumingDuplicateCallbacks &&
+            PresentEvidenceEvents == NonConsumingPresentCallbacks &&
+            TargetPresentCallbacks == CopySubmitted + NonConsumingPresentCallbacks &&
+            Accepted == CopySubmitted && Accepted == Ready && Accepted == Delivered;
+    }
+};
