+                {S->ProgressBase+=AB.Size2D();++S->Segment;A=Points[S->Segment];B=Points[S->Segment+1];AB=B-A;AB.Z=0;T=FVector::DotProduct(P-A,AB)/FMath::Max(AB.SizeSquared(),1.);}
+                const FVector Closest=A+AB*FMath::Clamp(T,0.,1.);const double Cross=FVector::Dist2D(P,Closest);
+                S->MaxCross=FMath::Max(S->MaxCross,Cross);Sample(TEXT("drive"),P,Contacts,ContactZ,-1);
+                if(Cross>400){Fail(TEXT("physical route departure exceeds existing 400cm bound"));return;}
+                const double Progress=S->ProgressBase+AB.Size2D()*FMath::Clamp(T,0.,1.);
+                if(Progress>S->LastProgress+20){S->LastProgress=Progress;S->LastProgressWall=FPlatformTime::Seconds();}
+                const double EndDistance=FVector::Dist2D(P,Points.Last());
+                if(S->Segment==Last&&EndDistance<85)S->AtEnd=true;
+                if(S->AtEnd)
+                {
+                    Release(TEXT("Drive"));Hold(TEXT("Handbrake"),FInputActionValue(true));S->Throttle=0;
+                    if(Car->GetSpeedKmh()<.8)
+                    {
+                        if(EndDistance>140){Fail(TEXT("natural braking overshot original 140cm endpoint bound"));return;}
+                        S->Arrived=S->SeenGates[0]&&S->SeenGates[1];
+                        if(!S->Arrived)S->Failure=TEXT("both deck-height physical end gates were not observed");
+                        StepElapsed=Steps[StepIndex].Duration;
+                    }
+                    return;
+                }
+                if(FPlatformTime::Seconds()-S->LastProgressWall>8){Fail(TEXT("no20cm physical progress for8sec"));return;}
+                double Lookahead=FMath::Clamp(FMath::Abs(double(Car->GetSignedSpeed()))*.45+220.,280.,650.);FVector Target=Closest;
+                for(int32 I=S->Segment;I<Points.Num()-1;++I){const double Length=FVector::Dist2D(Target,Points[I+1]);if(Length>=Lookahead){Target+=(Points[I+1]-Target)*(Lookahead/FMath::Max(Length,1.));break;}Lookahead-=Length;Target=Points[I+1];}
+                const FVector Local=Car->GetActorTransform().InverseTransformPosition(Target);
+                const double WheelAngle=FMath::RadiansToDegrees(FMath::Atan2(2*270.*FMath::Sin(FMath::Atan2(Local.Y,Local.X)),FMath::Max(Local.Size2D(),150.)));
+                const FRichCurve* Curve=M->SteeringSetup.SteeringCurve.GetRichCurveConst();float Min=0,Max=1;
+                if(!Curve){Fail(TEXT("missing original steering curve"));return;}Curve->GetValueRange(Min,Max);
+                const float SpeedScale=Curve->Eval(Car->GetSignedSpeed()*.0223694185f)/FMath::Max(Max,.01f);
+                const float Normalized=FMath::Clamp(float(WheelAngle)/FMath::Max(40.f*M->GetEffectiveSteeringGain()*SpeedScale,1.f),-1.f,1.f);
+                S->Steering=FMath::FInterpTo(S->Steering,FMath::Sign(Normalized)*FMath::Sqrt(FMath::Abs(Normalized)),Dt,6.f);
+                double Desired=FMath::Clamp(16.-FMath::Abs(S->Steering)*9.,7.,16.);
+                if(S->Segment>=Last-3)Desired=FMath::Min(Desired,FMath::Clamp(EndDistance*.018,3.,16.));
+                const double Speed=Car->GetSpeedKmh();S->Throttle=Speed>Desired+.7?-FMath::Clamp(float((Speed-Desired)*.1),.1f,.5f):FMath::Clamp(float((Desired-Speed)*.075),0.f,.55f);
+                Hold(TEXT("Drive"),FInputActionValue(FVector2D(S->Steering,S->Throttle)));
+            };
+        },[this,S,Flush]
+        {
+            R5FrameSample=nullptr;Release(TEXT("Drive"));Hold(TEXT("Handbrake"),FInputActionValue(true));Flush();
+            Check(FString::Printf(TEXT("R3 bridge physical direction %d"),S->Route+1),!S->Failed&&S->Arrived,
