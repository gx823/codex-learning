+        Result->SetNumberField(TEXT("heightfield_rows"),Rows);Result->SetNumberField(TEXT("heightfield_columns"),Cols);
+        Result->SetNumberField(TEXT("cooked_material_count"),MaterialCount);Result->SetArrayField(TEXT("heightfield_native_scale"),JsonVector(Scale));
+        Result->SetArrayField(TEXT("body_position_cm"),JsonVector(BodyPose.GetTranslation()));
+        const FQuat Q=BodyPose.GetRotation();Result->SetArrayField(TEXT("body_quaternion"),
+            {MakeShared<FJsonValueNumber>(Q.X),MakeShared<FJsonValueNumber>(Q.Y),MakeShared<FJsonValueNumber>(Q.Z),MakeShared<FJsonValueNumber>(Q.W)});
+        if(!BodyPose.IsValid()||Scale.ContainsNaN()||Scale.X==0||Scale.Y==0||Scale.Z==0||Rows<2||Cols<2||
+            HF->GeomData.Heights.Num()!=int64(Rows)*Cols||
+            (MaterialCount!=1&&MaterialCount!=int64(Rows-1)*(Cols-1)))
+        {Missing(TEXT("INVALID_NATIVE_POSE_HEIGHTFIELD_SIZE_SCALE_OR_MATERIAL_DENOMINATOR"));return;}
+        const Chaos::FRigidTransform3 HFToWorld(BodyPose.GetTranslation(),Q);
+        // GetTransformedTriangle already applies the cooked heightfield scale.
+        const FVector A=BodyPose.InverseTransformPositionNoScale(Start),B=BodyPose.InverseTransformPositionNoScale(End);
+        const double AX=A.X/Scale.X,AY=A.Y/Scale.Y,BX=B.X/Scale.X,BY=B.Y/Scale.Y;
+        if(!FMath::IsFinite(AX)||!FMath::IsFinite(AY)||!FMath::IsFinite(BX)||!FMath::IsFinite(BY)||
+            FMath::Abs(AX)>MAX_int32/2||FMath::Abs(AY)>MAX_int32/2||FMath::Abs(BX)>MAX_int32/2||FMath::Abs(BY)>MAX_int32/2)
+        {Missing(TEXT("INVALID_PROJECTED_GRID_COORDINATE"));return;}
+        const int32 CX=FMath::FloorToInt32(AX),CY=FMath::FloorToInt32(AY);
+        const int32 EX=FMath::FloorToInt32(BX),EY=FMath::FloorToInt32(BY);
+        Result->SetArrayField(TEXT("segment_grid_xy_start_end"),{MakeShared<FJsonValueNumber>(AX),MakeShared<FJsonValueNumber>(AY),
+            MakeShared<FJsonValueNumber>(BX),MakeShared<FJsonValueNumber>(BY)});
+        if(FMath::Abs(EX-CX)>1||FMath::Abs(EY-CY)>1)
+        {Missing(TEXT("SEGMENT_PROJECTION_EXCEEDS_BOUNDED_3_BY_3_CELLS"));return;}
+        int32 ValidCells=0,Holes=0,Tested=0,Hits=0,NearestFace=INDEX_NONE;Chaos::FReal Nearest=2;
+        FVector NearestPoint=FVector::ZeroVector;TArray<TSharedPtr<FJsonValue>> Cells;
+        for(int32 Y=CY-1;Y<=CY+1;++Y)for(int32 X=CX-1;X<=CX+1;++X)
+        {
+            if(Stopped()){Missing(TEXT("STOPPED"));return;}
+            if(X<0||Y<0||X>=Cols-1||Y>=Rows-1)continue;
+            ++ValidCells;const int32 Cell=Y*(Cols-1)+X;
+            // IsHole(int32) does not expand a single default-material entry.
