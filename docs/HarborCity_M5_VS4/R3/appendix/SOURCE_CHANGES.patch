+FString UHCM5VS4R3Geometry::ReadStaticMeshRenderJson(UStaticMesh* Mesh)
+{
+    auto Result = NewRecord(TEXT("StaticMesh RenderData LOD0, mesh-local cm"));
+#if WITH_EDITOR
+    if (!IsInGameThread()) return NotRun(Result, TEXT("Game-thread-only read"));
+    if (!IsValid(Mesh) || Mesh->IsCompiling()) return NotRun(Result, TEXT("Missing static mesh or still compiling; no forced rebuild"));
+    Result->SetStringField(TEXT("mesh"), Mesh->GetPathName());
+    Result->SetStringField(TEXT("space"), TEXT("mesh_local_cm"));
+    Result->SetBoolField(TEXT("nanite_enabled"), Mesh->GetNaniteSettings().bEnabled);
+    AttachStaticSections(Result, Mesh);
+    Result->SetStringField(TEXT("nanite_scope"), Mesh->GetNaniteSettings().bEnabled ?
+        TEXT("FALLBACK_LOD0_ONLY_NOT_NANITE_CLUSTER_SURFACE") : TEXT("NOT_ENABLED"));
+    const FStaticMeshRenderData* Render = Mesh->GetRenderData();
+    if (!Render || !Render->LODResources.IsValidIndex(0)) return NotRun(Result, TEXT("No static RenderData LOD0"));
+    const FStaticMeshLODResources& LOD = Render->LODResources[0];
+    const auto& Buffer = LOD.VertexBuffers.PositionVertexBuffer;
+    if (!Buffer.GetNumVertices() || Buffer.GetNumVertices() > 2000000 || !Buffer.GetVertexData() ||
+        LOD.IndexBuffer.GetNumIndices() <= 0 || LOD.IndexBuffer.GetIndexDataSize() <= 0)
+        return NotRun(Result, TEXT("CPU render buffers unavailable or outside bounded size"));
+    TArray<FVector> Positions;
+    Positions.Reserve(Buffer.GetNumVertices());
+    for (uint32 I = 0; I < Buffer.GetNumVertices(); ++I) Positions.Add(FVector(Buffer.VertexPosition(I)));
+    const FIndexArrayView View = LOD.IndexBuffer.GetArrayView();
+    if (View.Num() != LOD.IndexBuffer.GetNumIndices()) return NotRun(Result, TEXT("Incomplete retained index data"));
+    TArray<uint32> Indices;
+    Indices.Reserve(View.Num());
+    for (int32 I = 0; I < View.Num(); ++I) Indices.Add(View[I]);
+    if (!AttachGeometry(Result, Positions, Indices)) return NotRun(Result, TEXT("Invalid static render geometry"));
+    return Encode(Result);
+#else
+    return NotRun(Result, TEXT("Editor diagnostic only; not enabled in packaged builds"));
+#endif
+}
