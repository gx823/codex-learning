+        const bool ReadAfter = FFileHelper::LoadFileToArray(After, *S->File);
+        Check(TEXT("R3 fresh F9 leaves entire current-slot file unchanged"),
+            ReadAfter && S->Bytes == After,
+            TEXT("identical actual file before and after F9; no F5 or import write"),
+            FString::Printf(TEXT("before=%d after=%d"), S->Bytes.Num(), After.Num()), TEXT("A disk bytes"));
+    });
+    return true;
+}
