+            if(!RequireCamera(TEXT("R3 bridge normal driver interaction stand"),Safe,TEXT("unchanged safe exit predicate before E"),Door.ToString(),TEXT("A start fixture")))return;
+            PlaceCharacter(Door.GetLocation(),(Car->GetActorLocation()-Door.GetLocation()).Rotation().Yaw);
+        });
+        AddStep(TEXT("R3 bridge ordinary E enters car"),.12,[this,S]{if(S->Ready)Hold(TEXT("Interact"),FInputActionValue(true));},[this]{Release(TEXT("Interact"));});
+        AddStep(TEXT("R3 bridge boarding settle"),1,[this]{},[this,S]
+        {S->Entered=IsDriving();Check(TEXT("R3 bridge real vehicle possession"),S->Entered,TEXT("normal E action, no direct Possess"),State(),TEXT("B"));});
+        AddStep(TEXT("R3 bridge continuous physical direction"),120,[this,S,Fail,Sample]
