+TSharedRef<FJsonObject> FHCM5VS4R3Telemetry::Depth(AHCM1PlayerController* PC)
+{
+    auto Result = MakeShared<FJsonObject>();
+    Result->SetStringField(TEXT("status"), TEXT("NOT_RUN_INVALID_CAPTURE"));
+    auto* Hero = PC->GetControlledCharacter();
+    if (!Hero || !Hero->GetMesh()) return Result;
+    for (int32 I = 0; I < 3; ++I) if (!Captures[I].IsValid() || !Targets[I].IsValid()) return Result;
+    if (PendingDepth.Num() >= 8)
+    {
+        Result->SetStringField(TEXT("status"), TEXT("NOT_RUN_GPU_READBACK_BACKPRESSURE"));
+        return Result;
+    }
+    const FMinimalViewInfo View = PC->PlayerCameraManager->GetCameraCacheView();
+    auto Batch = MakeShared<FDepthBatch, ESPMode::ThreadSafe>();
+    Batch->Result = Result;
+    Batch->View = View;
+    Batch->Player = Hero->GetActorLocation();
+    Batch->FeetZ = Batch->Player.Z - Hero->GetCapsuleComponent()->GetScaledCapsuleHalfHeight();
+    Result->SetStringField(TEXT("status"), TEXT("PENDING_GPU_READBACK"));
+    Result->SetNumberField(TEXT("capture_engine_frame"), double(GFrameCounter));
+    PendingDepth.Add(Batch);
+    TArray<AActor*> Attached;
+    Hero->GetAttachedActors(Attached, true, true);
+    TArray<FTextureRenderTargetResource*> Resources;
+    for (int32 I = 0; I < 3; ++I)
+    {
+        auto* C = Captures[I].Get();
+        C->SetWorldLocationAndRotation(View.Location, View.Rotation);
+        C->FOVAngle = View.FOV;
+        C->HiddenActors.Reset(); C->HiddenComponents.Reset(); C->ShowOnlyComponents.Reset();
+        C->PrimitiveRenderMode = I == 1 ? ESceneCapturePrimitiveRenderMode::PRM_UseShowOnlyList : ESceneCapturePrimitiveRenderMode::PRM_RenderScenePrimitives;
+        if (I == 1) C->ShowOnlyComponent(Hero->GetMesh());
+        if (I == 2)
+        {
+            C->HideActorComponents(Hero, true);
+            for (auto* Actor : Attached) C->HideActorComponents(Actor, true);
+        }
+        Batch->Readbacks[I] = MakeUnique<FRHIGPUTextureReadback>(TEXT("HCR3SceneDepth"));
+        Resources.Add(Targets[I]->GameThread_GetRenderTargetResource());
+        C->bCameraCutThisFrame = true;
+        C->CaptureScene();
+    }
+    // Main-renderer captures execute later in the frame. Copy only after those passes,
+    // with separate targets so the three views cannot overwrite each other.
+    ENQUEUE_RENDER_COMMAND(HCR3ScheduleDepthCopy)([Resources, Batch](FRHICommandListImmediate& Commands)
+    {
+        Batch->EndFrameHandle = FCoreDelegates::OnEndFrameRT.AddLambda([Resources, Batch]
+        {
+            auto& Commands = FRHICommandListExecutor::GetImmediateCommandList();
+            for (int32 I = 0; I < 3; ++I) Batch->Readbacks[I]->EnqueueCopy(Commands, Resources[I]->GetRenderTargetTexture());
+            Batch->CopyRenderFrame = GFrameNumberRenderThread;
+            FCoreDelegates::OnEndFrameRT.Remove(Batch->EndFrameHandle);
+            Batch->EndFrameHandle.Reset();
+        });
+    });
+    return Result;
+}
+
+void FHCM5VS4R3Telemetry::PollDepth()
+{
+    for (int32 I = PendingDepth.Num() - 1; I >= 0; --I)
+        if (PendingDepth[I]->Complete.Load())
+        {
+            FinishDepth(*PendingDepth[I]);
+            PendingDepth.RemoveAt(I);
+        }
+    if (PendingDepth.IsEmpty()) return;
+    const auto Batches = PendingDepth;
+    ENQUEUE_RENDER_COMMAND(HCR3CollectDepth)([Batches](FRHICommandListImmediate& Commands)
+    {
+        for (const auto& Batch : Batches)
+        {
+            if (Batch->Complete.Load()) continue;
+            if (Batch->CopyRenderFrame == 0) continue;
+            bool Ready = true;
+            for (int32 I = 0; I < 3; ++I) Ready &= Batch->Readbacks[I] && Batch->Readbacks[I]->IsReady();
+            if (!Ready) continue;
+            for (int32 I = 0; I < 3; ++I)
+            {
+                int32 Pitch = 0, Rows = 0;
+                const auto* Source = static_cast<const FFloat16Color*>(Batch->Readbacks[I]->Lock(Pitch, &Rows));
+                if (!Source || Pitch < Width || Rows < Height) Batch->Valid = false;
+                else
+                {
+                    Batch->Pixels[I].SetNumUninitialized(Width * Height);
+                    for (int32 Y = 0; Y < Height; ++Y)
+                        FMemory::Memcpy(Batch->Pixels[I].GetData() + Y * Width, Source + Y * Pitch, Width * sizeof(FFloat16Color));
+                }
+                if (Source) Batch->Readbacks[I]->Unlock();
+            }
+            Batch->Complete.Store(true);
+        }
+    });
+}
