+    Node->Modify();
+    const int32 Index = Node->CreateOrGetInputAttribute(MP_Opacity);
+    Node->MarkPackageDirty();
+    return Index > 0 && Node->GetInput(Index) != nullptr;
+}
+
+FString UHCM5VS4R3Materials::ReadCloudMaterialOutputsJson(UObject* MaterialAsset)
+{
+    const TSharedRef<FJsonObject> Root = MakeShared<FJsonObject>();
+    Root->SetStringField(TEXT("schema"), TEXT("R3_CLOUD_MATERIAL_OUTPUTS_01"));
+    Root->SetStringField(TEXT("status"), TEXT("NOT_RUN"));
+    Root->SetStringField(TEXT("material"), MaterialAsset ? MaterialAsset->GetPathName() : TEXT(""));
+    TArray<TSharedPtr<FJsonValue>> Rows;
+    auto Finish = [&]()
+    {
+        Root->SetArrayField(TEXT("outputs"), Rows);
+        FString Json;
+        const TSharedRef<TJsonWriter<>> Writer = TJsonWriterFactory<>::Create(&Json);
+        FJsonSerializer::Serialize(Root, Writer);
+        return Json;
+    };
+    auto* Material = Cast<UMaterial>(MaterialAsset);
+    const FString Path = Material ? Material->GetPathName() : FString();
+    const bool CloudMode = FParse::Param(FCommandLine::Get(), TEXT("R3CityCloudMaterial"));
+    const bool CloudPath = Path == TEXT("/Game/HarborCity/M5VS2/WorldRev2/Corner_0454e8f79212/Materials/M_AnimeCloudDome.M_AnimeCloudDome")
+        || Path == TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/Environment/R3_CityCloud_01/M_R3_CityCloud_01.M_R3_CityCloud_01");
+    FString TerrainAB;
+    FParse::Value(FCommandLine::Get(), TEXT("R3TerrainMaterialAB="), TerrainAB);
+    const bool TerrainMode = FParse::Param(FCommandLine::Get(), TEXT("R3TerrainMaterialAdaptation"))
+        || TerrainAB == TEXT("ADAPTED");
+    const bool TerrainPath = Path == TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/Finish_20261004/City/Materials/M_V2_ContinuousGround.M_V2_ContinuousGround")
+        || Path == TEXT("/Game/Fantastic_City_Pack/materials/master_materials/M_Master_landscape_city.M_Master_landscape_city")
+        || Path == TEXT("/Game/Fantastic_Highlands_Castle/materials/master_materials/M_Master_landscape_castle.M_Master_landscape_castle")
+        || Path == TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/EnvironmentAdaptation/Terrain01/M_CityContinuousMask01.M_CityContinuousMask01")
+        || Path == TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/EnvironmentAdaptation/Terrain01/M_CastleContinuousMask01.M_CastleContinuousMask01");
+    if (!Material || !Material->GetEditorOnlyData()
+        || !FParse::Param(FCommandLine::Get(), TEXT("R3ManagedAuthor"))
+        || !((CloudMode && CloudPath) || (TerrainMode && TerrainPath)))
+    {
+        Root->SetStringField(TEXT("reason"), TEXT("Exact managed cloud or terrain material read mode required"));
+        return Finish();
+    }
+    struct FPropertyEntry { EMaterialProperty Value; const TCHAR* Name; };
+    // Material.cpp GetExpressionInputDescription: 22 cases plus eight UV inputs.
+    static const FPropertyEntry Properties[] = {
+        { MP_EmissiveColor, TEXT("MP_EmissiveColor") },
+        { MP_Opacity, TEXT("MP_Opacity") },
+        { MP_OpacityMask, TEXT("MP_OpacityMask") },
+        { MP_BaseColor, TEXT("MP_BaseColor") },
+        { MP_Metallic, TEXT("MP_Metallic") },
+        { MP_Specular, TEXT("MP_Specular") },
+        { MP_Roughness, TEXT("MP_Roughness") },
+        { MP_Anisotropy, TEXT("MP_Anisotropy") },
+        { MP_Normal, TEXT("MP_Normal") },
+        { MP_Tangent, TEXT("MP_Tangent") },
+        { MP_WorldPositionOffset, TEXT("MP_WorldPositionOffset") },
+        { MP_SubsurfaceColor, TEXT("MP_SubsurfaceColor") },
+        { MP_CustomData0, TEXT("MP_CustomData0") },
+        { MP_CustomData1, TEXT("MP_CustomData1") },
+        { MP_AmbientOcclusion, TEXT("MP_AmbientOcclusion") },
+        { MP_Refraction, TEXT("MP_Refraction") },
+        { MP_CustomizedUVs0, TEXT("MP_CustomizedUVs0") },
+        { MP_CustomizedUVs1, TEXT("MP_CustomizedUVs1") },
+        { MP_CustomizedUVs2, TEXT("MP_CustomizedUVs2") },
+        { MP_CustomizedUVs3, TEXT("MP_CustomizedUVs3") },
+        { MP_CustomizedUVs4, TEXT("MP_CustomizedUVs4") },
+        { MP_CustomizedUVs5, TEXT("MP_CustomizedUVs5") },
+        { MP_CustomizedUVs6, TEXT("MP_CustomizedUVs6") },
+        { MP_CustomizedUVs7, TEXT("MP_CustomizedUVs7") },
+        { MP_PixelDepthOffset, TEXT("MP_PixelDepthOffset") },
+        { MP_ShadingModel, TEXT("MP_ShadingModel") },
+        { MP_FrontMaterial, TEXT("MP_FrontMaterial") },
+        { MP_SurfaceThickness, TEXT("MP_SurfaceThickness") },
+        { MP_Displacement, TEXT("MP_Displacement") },
+        { MP_MaterialAttributes, TEXT("MP_MaterialAttributes") },
+    };
+    static_assert(UE_ARRAY_COUNT(Properties) == 30);
+    for (const FPropertyEntry& Property : Properties)
+    {
+        const FExpressionInput* Input = Material->GetExpressionInputForProperty(Property.Value);
+        if (!Input)
+        {
+            Root->SetStringField(TEXT("reason"), FString(TEXT("Unsupported native input: ")) + Property.Name);
+            return Finish();
+        }
+        const TSharedRef<FJsonObject> Row = MakeShared<FJsonObject>();
+        Row->SetStringField(TEXT("property_enum"), Property.Name);
+        Row->SetNumberField(TEXT("property_index"), static_cast<int32>(Property.Value));
+        Row->SetStringField(TEXT("status"), TEXT("OBSERVED"));
+        Row->SetNumberField(TEXT("output_index"), Input->OutputIndex);
+        Row->SetNumberField(TEXT("mask"), Input->Mask);
+        Row->SetNumberField(TEXT("mask_r"), Input->MaskR);
+        Row->SetNumberField(TEXT("mask_g"), Input->MaskG);
+        Row->SetNumberField(TEXT("mask_b"), Input->MaskB);
+        Row->SetNumberField(TEXT("mask_a"), Input->MaskA);
+        FString OutputName;
+        if (Input->Expression)
+        {
+            if (!IsValid(Input->Expression) || !Input->Expression->Outputs.IsValidIndex(Input->OutputIndex))
+            {
+                Root->SetStringField(TEXT("reason"), FString(TEXT("Invalid connected expression output: ")) + Property.Name);
+                return Finish();
+            }
+            Row->SetStringField(TEXT("expression_path"), Input->Expression->GetPathName());
+            const FExpressionOutput& Output = Input->Expression->Outputs[Input->OutputIndex];
+            if (!Output.OutputName.IsNone()) OutputName = Output.OutputName.ToString();
+            else if (Output.Mask)
+            {
+                if (Output.MaskR && !Output.MaskG && !Output.MaskB && !Output.MaskA) OutputName = TEXT("R");
+                else if (!Output.MaskR && Output.MaskG && !Output.MaskB && !Output.MaskA) OutputName = TEXT("G");
+                else if (!Output.MaskR && !Output.MaskG && Output.MaskB && !Output.MaskA) OutputName = TEXT("B");
+                else if (!Output.MaskR && !Output.MaskG && !Output.MaskB && Output.MaskA) OutputName = TEXT("A");
+            }
+        }
+        else Row->SetField(TEXT("expression_path"), MakeShared<FJsonValueNull>());
+        Row->SetStringField(TEXT("output_name"), OutputName);
+        Rows.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    Root->SetStringField(TEXT("status"), TEXT("OBSERVED"));
+    return Finish();
+}
