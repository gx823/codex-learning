+TArray<uint16> ReadHeights(ULandscapeInfo* Info,const FGuid& Layer,int32 X1,int32 Y1,int32 X2,int32 Y2)
+{
+    const int32 Width=X2-X1+1;
+    TArray<int32> Samples;Samples.Init(-1,Width*(Y2-Y1+1));
+    TMap<UTexture2D*,TArray64<uint8>> Mips;
+    for(const auto& Pair:Info->XYtoComponentMap)
+    {
+        auto* Component=Pair.Value;
+        if(!Component)return {};
+        const FIntPoint Base=Component->GetSectionBase();
+        const int32 Quads=Component->ComponentSizeQuads,SubQuads=Component->SubsectionSizeQuads;
+        if(Base.X>X2||Base.Y>Y2||Base.X+Quads<X1||Base.Y+Quads<Y1)continue;
+        UTexture2D* Texture=nullptr;
+        if(Layer.IsValid())
+        {
+            const auto* Data=Component->GetLayerData(Layer);
+            if(!Data||!Data->HeightmapData.Texture)return {};
+            Texture=Data->HeightmapData.Texture;
+        }
+        else Texture=Component->GetHeightmap(false);
+        if(!Texture||Texture->Source.GetFormat()!=TSF_BGRA8||SubQuads<=0)return {};
+        const int32 U=Texture->Source.GetSizeX(),V=Texture->Source.GetSizeY();
+        if(U<=0||V<=0)return {};
+        if(!Mips.Contains(Texture))
+        {
+            TArray64<uint8> Bytes;
+            // Source.GetMipData copies under a ReadOnly lock. LandscapeEdit's getter
+            // uses a ReadWrite lock and would rewrite Source metadata on unlock.
+            if(!Texture->Source.GetMipData(Bytes,0)||Bytes.Num()!=int64(U)*V*sizeof(FColor))return {};
+            Mips.Add(Texture,MoveTemp(Bytes));
+        }
+        const FColor* Pixels=reinterpret_cast<const FColor*>(Mips.FindChecked(Texture).GetData());
+        const int32 OffsetX=int32(Component->HeightmapScaleBias.Z*U),OffsetY=int32(Component->HeightmapScaleBias.W*V);
+        for(int32 SY=0;SY<Component->NumSubsections;++SY)for(int32 SX=0;SX<Component->NumSubsections;++SX)
+            for(int32 LY=0;LY<=SubQuads;++LY)for(int32 LX=0;LX<=SubQuads;++LX)
+        {
+            const int32 X=Base.X+SX*SubQuads+LX,Y=Base.Y+SY*SubQuads+LY;
+            if(X<X1||X>X2||Y<Y1||Y>Y2)continue;
+            const int32 TX=OffsetX+SX*(SubQuads+1)+LX,TY=OffsetY+SY*(SubQuads+1)+LY;
+            if(TX<0||TY<0||TX>=U||TY>=V)return {};
+            const FColor Pixel=Pixels[TX+TY*U];const int32 Height=(int32(Pixel.R)<<8)|Pixel.G;
+            int32& Existing=Samples[(Y-Y1)*Width+X-X1];
+            if(Existing>=0&&Existing!=Height)return {};
+            Existing=Height;
+        }
+    }
+    TArray<uint16> Values;Values.Reserve(Samples.Num());
+    for(int32 Value:Samples){if(Value<0)return {};Values.Add(uint16(Value));}
+    return Values;
+}
