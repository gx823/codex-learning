+                for(int32 I=0;I<2;++I)if(FVector::Dist2D(P,S->Gates[I])<=140&&Contacts>=2&&FMath::Abs(ContactZ-S->Gates[I].Z)<=70)S->SeenGates[I]=true;
+                const auto& Points=S->Routes[S->Route];const int32 Last=Points.Num()-2;
+                FVector A=Points[S->Segment],B=Points[S->Segment+1],AB=B-A;AB.Z=0;
+                double T=FVector::DotProduct(P-A,AB)/FMath::Max(AB.SizeSquared(),1.);
