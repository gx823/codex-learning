+FHCM5VS4R3Telemetry::FHCM5VS4R3Telemetry(AActor* InOwner) : Owner(InOwner)
+{
+    for (int32 I = 0; I < 3; ++I)
+    {
+        auto* C = NewObject<USceneCaptureComponent2D>(InOwner);
+        InOwner->AddInstanceComponent(C);
+        C->bCaptureEveryFrame = C->bCaptureOnMovement = false;
+        C->bRenderInMainRenderer = true;
+        C->CaptureSource = SCS_SceneDepth;
+        C->ShowFlags.SetTemporalAA(false);
+        C->ShowFlags.SetMotionBlur(false);
+        C->RegisterComponent();
+        auto* RT = NewObject<UTextureRenderTarget2D>(C);
+        RT->InitCustomFormat(Width, Height, PF_FloatRGBA, false);
+        C->TextureTarget = RT;
+        Captures[I] = C;
+        Targets[I] = RT;
+    }
+}
+
+FHCM5VS4R3Telemetry::~FHCM5VS4R3Telemetry()
+{
+    FlushRenderingCommands();
+    PendingDepth.Reset();
+    for (const auto& Capture : Captures) if (Capture.IsValid()) Capture->DestroyComponent();
+}
