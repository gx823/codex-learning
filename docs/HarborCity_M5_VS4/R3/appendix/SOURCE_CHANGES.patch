+
+struct FHCR3ViewportSlotEvidence
+{
+    int32 Slot = 0;
+    FString Phase;
+    uint64 Ticket = 0;
+    uint64 RequestEngineFrame = 0;
+    uint64 ArmEngineCounterRT = 0;
+    uint32 ArmRenderFrame = 0;
+    bool bCopySubmitted = false;
+};
+
+struct FHCR3ViewportPresentEvidence
+{
+    uint64 Callback = 0;
+    uint64 EngineCounterRT = 0;
+    uint32 RenderFrame = 0;
+    double WallSeconds = 0;
+    uint64 LastCopiedTicket = 0;
+    uint64 LastCopyEngineCounterRT = 0;
+    uint32 LastCopyRenderFrame = 0;
+    uint64 CopiesBefore = 0;
+    uint64 CopiesAfter = 0;
+    int32 ArmedSlots = 0;
+    bool bRepeatedRenderFrame = false;
+    bool bStopRequested = false;
+    bool bStopArmedRT = false;
+    bool bNonConsuming = false;
