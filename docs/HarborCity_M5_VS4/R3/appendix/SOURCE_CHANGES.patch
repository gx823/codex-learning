+TSharedPtr<FJsonObject> SolverProbeJSON(const FHCM5VS4R3SolverProbe& Probe)
+{
+    auto Result=MakeShared<FJsonObject>();
+    Result->SetStringField(TEXT("status"),Probe.bMeasured?TEXT("OBSERVED_COLLISION_RANKING_PROBE"):TEXT("NOT_RUN_NOT_SCORED"));
+    if(!Probe.bMeasured)return Result;
+    Result->SetArrayField(TEXT("position_xyz_cm"),VectorJSON(Probe.Position));
+    Result->SetArrayField(TEXT("rotation_pitch_yaw_roll"),VectorJSON(FVector(Probe.Rotation.Pitch,Probe.Rotation.Yaw,Probe.Rotation.Roll)));
+    Result->SetNumberField(TEXT("penalty"),Probe.Penalty);
+    Result->SetNumberField(TEXT("near_hit_count"),Probe.NearHits);
+    Result->SetNumberField(TEXT("middle_hit_count"),Probe.MiddleHits);
+    Result->SetNumberField(TEXT("near_probe_count"),25);
+    Result->SetNumberField(TEXT("middle_probe_count"),15);
+    Result->SetNumberField(TEXT("ranking_near_depth_cm"),Probe.NearDepth);
+    Result->SetNumberField(TEXT("ranking_middle_depth_cm"),Probe.MiddleDepth);
+    TArray<TSharedPtr<FJsonValue>> Rays;
+    for(const auto& Ray:Probe.Rays)
+    {
+        auto R=MakeShared<FJsonObject>();
+        R->SetNumberField(TEXT("view_plane_x"),Ray.X);R->SetNumberField(TEXT("view_plane_y"),Ray.Y);
+        R->SetBoolField(TEXT("blocked"),Ray.bBlocked);R->SetBoolField(TEXT("pawn_hit_selected"),Ray.bPawnHit);
+        R->SetBoolField(TEXT("counted_near"),Ray.bNear);R->SetBoolField(TEXT("counted_middle"),Ray.bMiddle);
+        if(Ray.bBlocked)
+        {
+            R->SetNumberField(TEXT("hit_forward_depth_cm"),Ray.HitForwardDepth);
+            R->SetStringField(TEXT("collision_component"),GetPathNameSafe(Ray.Component.Get()));
+            R->SetNumberField(TEXT("collision_hit_item"),Ray.HitItem);
+        }
+        Rays.Add(MakeShared<FJsonValueObject>(R));
+    }
+    Result->SetArrayField(TEXT("rays"),Rays);
+    Result->SetStringField(TEXT("scope"),TEXT("Existing 5x5 collision ranking samples; not rendered pixels, render-visible IDs, validated render-instance indices or C3/C4 acceptance."));
+    return Result;
+}
