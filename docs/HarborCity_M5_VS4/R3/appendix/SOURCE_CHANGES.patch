+            auto CellRow=MakeShared<FJsonObject>();CellRow->SetNumberField(TEXT("x"),X);CellRow->SetNumberField(TEXT("y"),Y);
+            CellRow->SetNumberField(TEXT("material_index"),HF->GetMaterialIndex(MaterialCount==1?0:Cell));CellRow->SetBoolField(TEXT("hole"),Hole);
