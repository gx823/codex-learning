+    TestTrue(TEXT("Lossless readback requires all independent counters"), Stats.bLosslessReadback);
+    Stats.OccupiedSlots = 1;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Unread CPU frame occupies queue and blocks drain"), Stats.bDrainComplete);
+    Stats.OccupiedSlots = 0;
+    ++Stats.Rejected;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Queue-full rejection cannot pass lossless gate"), Stats.bLosslessReadback);
+    Stats.Rejected = 0;
+    Stats.Delivered = 7;
+    Stats.DeliveredFailures = Stats.Failed = 1;
+    Stats.UpdateDrainStatus();
+    TestTrue(TEXT("Failed terminal ticket can be drained"), Stats.bDrainComplete);
+    TestFalse(TEXT("Drained failure is not lossless"), Stats.bLosslessReadback);
+    Stats.Delivered = 8;
+    Stats.DeliveredFailures = Stats.Failed = 0;
+    Stats.bAborted = true;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Abort cannot be accepted as complete capture"), Stats.bLosslessReadback);
+    Stats.bAborted = false;
+    Stats.EngineCounterMismatches = 1;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Unverified GT/RT agreement retains evidence but cannot pass"), Stats.bLosslessReadback);
+    Stats.EngineCounterMismatches = 0;
+    Stats.DuplicatePresentCallbacks = 1;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Unclassified duplicate present still fails"), Stats.bLosslessReadback);
+    Stats.NonConsumingDuplicateCallbacks = 1;
+    Stats.NonConsumingPresentCallbacks = Stats.PresentEvidenceEvents = 1;
+    ++Stats.TargetPresentCallbacks;
+    Stats.UpdateDrainStatus();
+    TestTrue(TEXT("One proven non-consuming callback cannot duplicate a captured ticket"), Stats.bLosslessReadback);
+    Stats.InvalidPresentCallbacks = 1;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Armed second-copy attempt fails"), Stats.bLosslessReadback);
+    Stats.InvalidPresentCallbacks = 0;
+    Stats.PresentEvidenceOverflow = 1;
+    Stats.UpdateDrainStatus();
+    TestFalse(TEXT("Missing event evidence fails"), Stats.bLosslessReadback);
+    return true;
+}
