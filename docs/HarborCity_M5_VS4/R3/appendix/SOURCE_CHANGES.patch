+TArray<AActor*> UHCM5VS4R3SceneCopy::PasteAuthorGroup(const FString& CopyFile, FString& OutRootBindingsJSON, FString& OutError)
+{
+    TArray<AActor*> Pasted;
+    OutRootBindingsJSON.Reset();
+    OutError.Reset();
+    UWorld* World = GEditor ? GEditor->GetEditorWorldContext().World() : nullptr;
+    const FString ExpectedMap = TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/L_CapitalR2");
+    if (!GUnrealEd || !World || World->WorldType != EWorldType::Editor ||
+        World->GetOutermost()->GetName() != ExpectedMap ||
+        !FParse::Param(FCommandLine::Get(), TEXT("R3AuthorGroupImport")))
+    {
+        OutError = TEXT("Explicit R3AuthorGroupImport editor session on the exact Capital map required");
+        return Pasted;
+    }
+    const FString Stop = FPaths::ConvertRelativePathToFull(
+        FPaths::ProjectDir(), TEXT("../docs/HarborCity_M5_VS4/R3/STOP_DESKTOP_CHAIN"));
+    if (IFileManager::Get().FileExists(*Stop))
+    {
+        OutError = TEXT("USER_STOPPED");
+        return Pasted;
+    }
+    FString SourcePath = FPaths::ConvertRelativePathToFull(CopyFile);
+    FPaths::NormalizeFilename(SourcePath);
+    if (!FPaths::CollapseRelativeDirectories(SourcePath) ||
+        !FPaths::IsUnderDirectory(SourcePath, TEXT("E:/GameDev/Assets/HarborCity/M5_VS4/R3/author_groups")) ||
+        !FPaths::GetExtension(SourcePath).Equals(TEXT("COPY"), ESearchCase::IgnoreCase))
+    {
+        OutError = TEXT("Native COPY text must remain in the private author_groups directory");
+        return Pasted;
+    }
+    FString Text;
+    if (!FFileHelper::LoadFileToString(Text, *SourcePath) ||
+        !Text.Contains(TEXT("Begin Map")) || !Text.Contains(TEXT("Begin Actor ")) ||
+        !Text.Contains(TEXT("End Map")) || Text.Contains(TEXT("Begin MapPackage")) ||
+        Text.Contains(TEXT("LandscapeHeightfieldCollisionComponent")) ||
+        Text.Contains(TEXT("Class=/Script/Landscape.Landscape")) ||
+        Text.Contains(TEXT("Class=/Script/Engine.MapBuildDataRegistry")))
+    {
+        OutError = TEXT("Invalid native selection text or forbidden landscape/baked-data object");
+        return Pasted;
+    }
+    struct FCopyRoot { FString Class,Name,ExportPath; };
+    TArray<FCopyRoot> Roots;
+    TSet<FString> SourceNames;
+    const TCHAR* Cursor=*Text;
+    FString Line;
+    while(FParse::Line(&Cursor,Line))
+    {
+        const TCHAR* Header=*Line;
+        if(!FParse::Command(&Header,TEXT("Begin"))||!FParse::Command(&Header,TEXT("Actor")))continue;
+        FCopyRoot Root;
+        if(!FParse::Value(Header,TEXT("Class="),Root.Class)||
+            !FParse::Value(Header,TEXT("Name="),Root.Name)||
+            !FParse::Value(Header,TEXT("ExportPath="),Root.ExportPath)||SourceNames.Contains(Root.Name))
+        {
+            OutError=TEXT("COPY root class/name/export path is absent or duplicated; nothing pasted");
+            return Pasted;
+        }
+        SourceNames.Add(Root.Name);Roots.Add(MoveTemp(Root));
+    }
+    if(Roots.IsEmpty())
+    {
+        OutError=TEXT("COPY contains no complete native root headers; nothing pasted");
+        return Pasted;
+    }
+    TSet<AActor*> Existing;
+    for(TActorIterator<AActor> It(World);It;++It)Existing.Add(*It);
+    const FScopedTransaction Transaction(NSLOCTEXT("HarborCity", "R3PasteAuthorGroup", "R3 author scene group"));
+    GUnrealEd->PasteActors(Pasted, World, FVector::ZeroVector, false, false, &Text);
+    if(Pasted.Num()!=Roots.Num())
+    {
+        OutError=FString::Printf(TEXT("Native paste root count mismatch (%d/%d); unsaved transaction retained"),Pasted.Num(),Roots.Num());
+        return Pasted;
+    }
+    // UE 5.8.2 LevelFactory appends roots to NewActorMap in COPY order and
+    // returns that same insertion-ordered map without removals. The caller pins
+    // that engine source and verifies every component/world pose before saving.
+    TSet<AActor*> Bound;
+    TArray<TSharedPtr<FJsonValue>> Bindings;
+    for(int32 Index=0;Index<Roots.Num();++Index)
+    {
+        AActor* Actor=Pasted[Index];
+        if(!IsValid(Actor)||Existing.Contains(Actor)||Bound.Contains(Actor)||
+            Actor->GetLevel()!=World->GetCurrentLevel()||Actor->GetClass()->GetPathName()!=Roots[Index].Class)
+        {
+            OutError=TEXT("Native ordered root provenance failed; do not transform or save this transaction");
+            return Pasted;
+        }
+        Bound.Add(Actor);
+        auto Row=MakeShared<FJsonObject>();
+        Row->SetNumberField(TEXT("copy_root_index"),Index);
+        Row->SetStringField(TEXT("source_name"),Roots[Index].Name);
+        Row->SetStringField(TEXT("source_class"),Roots[Index].Class);
+        Row->SetStringField(TEXT("source_export_path"),Roots[Index].ExportPath);
+        Row->SetStringField(TEXT("target_path"),Actor->GetPathName());
+        Bindings.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    auto Receipt=MakeShared<FJsonObject>();
+    Receipt->SetStringField(TEXT("status"),TEXT("ORDERED_NATIVE_ROOT_BINDING_PENDING_FULL_POSE_VERIFICATION"));
+    Receipt->SetStringField(TEXT("contract"),TEXT("UE_5_8_2_LevelFactory_CopyInsertionOrder"));
+    Receipt->SetArrayField(TEXT("roots"),Bindings);
+    FJsonSerializer::Serialize(Receipt,TJsonWriterFactory<>::Create(&OutRootBindingsJSON));
+    return Pasted;
+}
