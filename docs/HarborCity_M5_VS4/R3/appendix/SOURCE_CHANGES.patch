+FString UHCM5VS4R3Geometry::ReadWorldInventoryJson(UWorld* World)
+{
+    auto Result = NewRecord(TEXT("Native owned components in all currently loaded UWorld levels"));
+#if WITH_EDITOR
+    if (!IsInGameThread()) return NotRun(Result, TEXT("Game-thread-only read"));
+    if (!IsValid(World)) return NotRun(Result, TEXT("Missing world"));
+    Result->SetNumberField(TEXT("schema_version"), 2);
+    Result->SetNumberField(TEXT("collision_snapshot_schema_version"), 1);
+    Result->SetNumberField(TEXT("collision_serialized_channel_count"), int32(ECC_OverlapAll_Deprecated));
+    Result->SetArrayField(TEXT("collision_channel_catalog"), CollisionChannelCatalog());
+    Result->SetStringField(TEXT("map"), World->GetOutermost()->GetName());
+    Result->SetNumberField(TEXT("engine_frame"), double(GFrameCounter));
+    Result->SetBoolField(TEXT("is_game_world"), World->IsGameWorld());
+    Result->SetStringField(TEXT("scope"), TEXT("LOADED_WORLD_LEVELS_ALL_OWNED_COMPONENTS"));
+    Result->SetStringField(TEXT("dynamic_same_frame_pose"), TEXT("NOT_RUN_STATIC_INVENTORY_ONLY"));
+    Result->SetStringField(TEXT("rendered_visibility"), TEXT("NOT_RUN_FLAGS_ARE_NOT_RENDER_VISIBILITY_PROOF"));
+    Result->SetBoolField(TEXT("world_partition_present"), World->GetWorldPartition() != nullptr);
+    Result->SetStringField(TEXT("unloaded_world_partition_actors"), TEXT("NOT_RUN_NOT_ENUMERATED"));
+    auto Counts = MakeShared<FJsonObject>();
+    TMap<FString, int64> Counters;
+    for (const TCHAR* Key : {TEXT("loaded_level_slots"), TEXT("valid_levels"), TEXT("null_level_slots"),
+        TEXT("actor_slots"), TEXT("null_actor_slots"), TEXT("invalid_actor_slots"), TEXT("actors"),
+        TEXT("actor_duplicate_slots"), TEXT("owned_component_slots"), TEXT("null_component_slots"),
+        TEXT("invalid_component_slots"), TEXT("components"), TEXT("scene_components"), TEXT("primitive_components"),
+        TEXT("hidden_actors"), TEXT("hidden_scene_components"), TEXT("unregistered_components"),
+        TEXT("static_mesh_components"), TEXT("null_static_mesh_components"), TEXT("static_object_slots"),
+        TEXT("hidden_static_object_slots"), TEXT("null_asset_static_object_slots"), TEXT("ism_components"),
+        TEXT("hism_components"), TEXT("empty_ism_components"), TEXT("instance_slots"), TEXT("failed_instance_transforms"),
+        TEXT("skeletal_components"), TEXT("null_skeletal_assets"), TEXT("landscape_components"),
+        TEXT("brush_components"), TEXT("other_primitive_components"), TEXT("streaming_level_slots"), TEXT("unloaded_streaming_levels")})
+        Counters.Add(Key, 0);
+    TSet<const AActor*> SeenActors;
+    TSet<const UActorComponent*> SeenComponents;
+    TArray<TSharedPtr<FJsonValue>> Actors, Levels, Streaming;
+    auto Materials = MakeShared<FJsonObject>();
+    for (ULevel* Level : World->GetLevels())
+    {
+        ++Counters[TEXT("loaded_level_slots")];
+        if (!Level) { ++Counters[TEXT("null_level_slots")]; continue; }
+        ++Counters[TEXT("valid_levels")];
+        auto LevelRow = MakeShared<FJsonObject>();
+        LevelRow->SetStringField(TEXT("path"), Level->GetPathName());
+        LevelRow->SetNumberField(TEXT("actor_slots"), Level->Actors.Num());
+        Levels.Add(MakeShared<FJsonValueObject>(LevelRow));
+        for (AActor* Actor : Level->Actors)
+        {
+            ++Counters[TEXT("actor_slots")];
+            if (!Actor) { ++Counters[TEXT("null_actor_slots")]; continue; }
+            if (!IsValid(Actor)) { ++Counters[TEXT("invalid_actor_slots")]; continue; }
+            if (SeenActors.Contains(Actor)) { ++Counters[TEXT("actor_duplicate_slots")]; continue; }
+            SeenActors.Add(Actor);
+            ++Counters[TEXT("actors")];
+            Counters[TEXT("hidden_actors")] += Actor->IsHidden();
+            auto ActorRow = MakeShared<FJsonObject>();
+            ActorRow->SetStringField(TEXT("path"), Actor->GetPathName());
+            ActorRow->SetStringField(TEXT("level"), Level->GetPathName());
+            ActorRow->SetStringField(TEXT("class"), Actor->GetClass()->GetPathName());
+            ActorRow->SetBoolField(TEXT("hidden_in_game"), Actor->IsHidden());
+            ActorRow->SetBoolField(TEXT("is_editor_only"), Actor->IsEditorOnly());
+            ActorRow->SetObjectField(TEXT("world_transform"), TransformRecord(Actor->GetActorTransform()));
+            TArray<TSharedPtr<FJsonValue>> ClassChain, Components;
+            for (const UClass* Type = Actor->GetClass(); Type; Type = Type->GetSuperClass())
+                ClassChain.Add(MakeShared<FJsonValueString>(Type->GetPathName()));
+            ActorRow->SetArrayField(TEXT("class_chain"), ClassChain);
+            for (UActorComponent* Component : Actor->GetComponents())
+            {
+                ++Counters[TEXT("owned_component_slots")];
+                if (!Component) { ++Counters[TEXT("null_component_slots")]; continue; }
+                if (!IsValid(Component)) { ++Counters[TEXT("invalid_component_slots")]; continue; }
+                if (SeenComponents.Contains(Component)) return NotRun(Result, TEXT("Duplicate component in native owned-component enumeration"));
+                SeenComponents.Add(Component);
+                ++Counters[TEXT("components")];
+                Counters[TEXT("unregistered_components")] += !Component->IsRegistered();
+                auto Row = MakeShared<FJsonObject>();
+                Row->SetStringField(TEXT("path"), Component->GetPathName());
+                Row->SetStringField(TEXT("class"), Component->GetClass()->GetPathName());
+                TArray<TSharedPtr<FJsonValue>> ComponentClassChain;
+                for (const UClass* Type = Component->GetClass(); Type; Type = Type->GetSuperClass())
+                    ComponentClassChain.Add(MakeShared<FJsonValueString>(Type->GetPathName()));
+                Row->SetArrayField(TEXT("class_chain"), ComponentClassChain);
+                Row->SetBoolField(TEXT("is_editor_only"), Component->IsEditorOnly());
+                Row->SetBoolField(TEXT("registered"), Component->IsRegistered());
+                Row->SetStringField(TEXT("category"), TEXT("non_scene_component"));
+                if (auto* Scene = Cast<USceneComponent>(Component))
+                {
+                    ++Counters[TEXT("scene_components")];
+                    Counters[TEXT("hidden_scene_components")] += Scene->bHiddenInGame || !Scene->GetVisibleFlag();
+                    Row->SetStringField(TEXT("category"), TEXT("scene_component"));
+                    Row->SetBoolField(TEXT("visible_flag"), Scene->GetVisibleFlag());
+                    Row->SetBoolField(TEXT("hidden_in_game"), Scene->bHiddenInGame);
+                    Row->SetBoolField(TEXT("is_visible"), Scene->IsVisible());
+                    Row->SetObjectField(TEXT("world_transform"), TransformRecord(Scene->GetComponentTransform()));
+                }
+                if (auto* Primitive = Cast<UPrimitiveComponent>(Component))
+                {
+                    ++Counters[TEXT("primitive_components")];
+                    Row->SetStringField(TEXT("category"), TEXT("other_primitive"));
+                    Row->SetObjectField(TEXT("collision_snapshot"), CollisionRecord(Primitive));
+                    TArray<TSharedPtr<FJsonValue>> Slots;
+                    for (int32 I = 0; I < Primitive->GetNumMaterials(); ++I)
+                    {
+                        auto Slot = MakeShared<FJsonObject>();
+                        Slot->SetNumberField(TEXT("material_slot"), I);
+                        UMaterialInterface* Material = Primitive->GetMaterial(I);
+                        if (Material)
+                        {
+                            const FString Path = Material->GetPathName();
+                            Slot->SetStringField(TEXT("material"), Path);
+                            if (!Materials->HasField(Path)) Materials->SetObjectField(Path, MaterialRecord(Material));
+                        }
+                        else Slot->SetField(TEXT("material"), MakeShared<FJsonValueNull>());
+                        Slots.Add(MakeShared<FJsonValueObject>(Slot));
+                    }
+                    Row->SetArrayField(TEXT("effective_material_slots"), Slots);
+                    if (auto* Static = Cast<UStaticMeshComponent>(Primitive))
+                    {
+                        ++Counters[TEXT("static_mesh_components")];
+                        Row->SetStringField(TEXT("category"), TEXT("static_mesh"));
+                        UStaticMesh* Mesh = Static->GetStaticMesh();
+                        if (Mesh) Row->SetStringField(TEXT("mesh"), Mesh->GetPathName());
+                        else Row->SetField(TEXT("mesh"), MakeShared<FJsonValueNull>());
+                        Counters[TEXT("null_static_mesh_components")] += Mesh == nullptr;
+                        Row->SetBoolField(TEXT("evaluate_world_position_offset"), Static->bEvaluateWorldPositionOffset);
+                        int32 ObjectSlots = 1;
+                        if (auto* ISM = Cast<UInstancedStaticMeshComponent>(Static))
+                        {
+                            ++Counters[TEXT("ism_components")];
+                            const bool bHISM = Cast<UHierarchicalInstancedStaticMeshComponent>(ISM) != nullptr;
+                            Counters[TEXT("hism_components")] += bHISM;
+                            Row->SetStringField(TEXT("category"), bHISM ? TEXT("hism") : TEXT("ism"));
+                            ObjectSlots = ISM->GetInstanceCount();
+                            Counters[TEXT("empty_ism_components")] += ObjectSlots == 0;
+                            Counters[TEXT("instance_slots")] += ObjectSlots;
+                            TArray<TSharedPtr<FJsonValue>> Indices, Failures;
+                            for (int32 I = 0; I < ObjectSlots; ++I)
+                            {
+                                Indices.Add(MakeShared<FJsonValueNumber>(I));
+                                FTransform Transform;
+                                if (!ISM->GetInstanceTransform(I, Transform, true) || !Transform.IsValid())
+                                {
+                                    ++Counters[TEXT("failed_instance_transforms")];
+                                    Failures.Add(MakeShared<FJsonValueNumber>(I));
+                                }
+                            }
+                            Row->SetNumberField(TEXT("instance_count"), ObjectSlots);
+                            Row->SetArrayField(TEXT("instance_indices"), Indices);
+                            Row->SetArrayField(TEXT("invalid_transform_indices"), Failures);
+                            Row->SetStringField(TEXT("per_instance_render_visibility"), TEXT("NOT_RUN_CULLING_AND_SHADER_VISIBILITY_NOT_EVALUATED"));
+                        }
+                        Row->SetNumberField(TEXT("object_slots"), ObjectSlots);
+                        Counters[TEXT("static_object_slots")] += ObjectSlots;
+                        Counters[TEXT("null_asset_static_object_slots")] += Mesh ? 0 : ObjectSlots;
+                        Counters[TEXT("hidden_static_object_slots")] += Actor->IsHidden() || Static->bHiddenInGame || !Static->GetVisibleFlag() ? ObjectSlots : 0;
+                    }
+                    else if (auto* Skinned = Cast<USkinnedMeshComponent>(Primitive))
+                    {
+                        Row->SetStringField(TEXT("category"), TEXT("skeletal_mesh"));
+                        ++Counters[TEXT("skeletal_components")];
+                        USkinnedAsset* Asset = Skinned->GetSkinnedAsset();
+                        Counters[TEXT("null_skeletal_assets")] += Asset == nullptr;
+                        if (Asset) Row->SetStringField(TEXT("skeletal_mesh"), Asset->GetPathName());
+                        else Row->SetField(TEXT("skeletal_mesh"), MakeShared<FJsonValueNull>());
+                        Row->SetStringField(TEXT("same_frame_render_vertices"), TEXT("NOT_RUN_STATIC_INVENTORY_ONLY"));
+                    }
+                    else if (Cast<ULandscapeComponent>(Primitive))
+                    {
+                        ++Counters[TEXT("landscape_components")];
+                        Row->SetStringField(TEXT("category"), TEXT("landscape"));
+                    }
+                    else if (Cast<UBrushComponent>(Primitive))
+                    {
+                        ++Counters[TEXT("brush_components")];
+                        Row->SetStringField(TEXT("category"), TEXT("brush"));
+                    }
+                    else ++Counters[TEXT("other_primitive_components")];
+                }
+                Components.Add(MakeShared<FJsonValueObject>(Row));
+            }
+            ActorRow->SetArrayField(TEXT("components"), Components);
+            Actors.Add(MakeShared<FJsonValueObject>(ActorRow));
+        }
+    }
+    for (ULevelStreaming* Level : World->GetStreamingLevels())
+    {
+        ++Counters[TEXT("streaming_level_slots")];
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetStringField(TEXT("path"), Level ? Level->GetPathName() : TEXT(""));
+        const ULevel* Loaded = Level ? Level->GetLoadedLevel() : nullptr;
+        Row->SetBoolField(TEXT("loaded"), Loaded != nullptr);
+        Counters[TEXT("unloaded_streaming_levels")] += Loaded == nullptr;
+        Streaming.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    for (const auto& Counter : Counters) Counts->SetNumberField(Counter.Key, double(Counter.Value));
+    Result->SetObjectField(TEXT("counts"), Counts);
+    Result->SetArrayField(TEXT("levels"), Levels);
+    Result->SetArrayField(TEXT("streaming_levels"), Streaming);
+    Result->SetArrayField(TEXT("actors"), Actors);
+    Result->SetObjectField(TEXT("material_semantics"), Materials);
+    Result->SetBoolField(TEXT("loaded_world_enumeration_complete"), Counters[TEXT("invalid_actor_slots")] == 0 && Counters[TEXT("invalid_component_slots")] == 0);
+    Result->SetStringField(TEXT("status"), TEXT("EXPORTED_NATIVE_ENUMERATION"));
+    return Encode(Result);
+#else
+    return NotRun(Result, TEXT("Editor diagnostic only; not enabled in packaged builds"));
+#endif
+}
