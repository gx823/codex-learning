+            if(!Shape.IsValid())continue;
+            const Chaos::FImplicitObject* Geometry=&Shape.GetGeometry();
+            if(const auto* Wrapped=Geometry->GetObject<Chaos::TImplicitObjectTransformed<Chaos::FReal,3>>())
+            {
+                if(!Wrapped->GetTransform().GetTranslation().IsNearlyZero(1.e-12)||
+                    !Wrapped->GetTransform().GetRotation().Equals(FQuat::Identity,1.e-12))continue;
+                Geometry=Wrapped->GetTransformedObject();
+            }
+            if(Geometry==HF)++BoundShapes;
