+FString R3SnapshotJSON(const TSharedRef<FJsonObject>& Value)
+{
+    FString Text;
+    FJsonSerializer::Serialize(Value,TJsonWriterFactory<>::Create(&Text));
+    return Text;
+}
+
+TSharedRef<FJsonObject> R3SnapshotTransform(const FTransform& Value)
+{
+    auto Row=MakeShared<FJsonObject>();
+    const FVector P=Value.GetTranslation(),S=Value.GetScale3D();
+    const FQuat Q=Value.GetRotation();
+    Row->SetArrayField(TEXT("translation_cm"),{MakeShared<FJsonValueNumber>(P.X),MakeShared<FJsonValueNumber>(P.Y),MakeShared<FJsonValueNumber>(P.Z)});
+    Row->SetArrayField(TEXT("quaternion"),{MakeShared<FJsonValueNumber>(Q.X),MakeShared<FJsonValueNumber>(Q.Y),MakeShared<FJsonValueNumber>(Q.Z),MakeShared<FJsonValueNumber>(Q.W)});
+    Row->SetArrayField(TEXT("scale"),{MakeShared<FJsonValueNumber>(S.X),MakeShared<FJsonValueNumber>(S.Y),MakeShared<FJsonValueNumber>(S.Z)});
+    return Row;
+}
+
+TArray<TSharedPtr<FJsonValue>> R3SnapshotStrings(const TArray<FString>& Strings)
+{
+    TArray<TSharedPtr<FJsonValue>> Values;
+    for(const FString& Value:Strings)Values.Add(MakeShared<FJsonValueString>(Value));
+    return Values;
+}
