+struct FCapitalTerrainPatch
+{
+    ALandscape* Landscape=nullptr;
+    ULandscapeInfo* Info=nullptr;
+    FGuid Guid;
+    TArray<uint16> Heights;
+    const TCHAR* Phase=TEXT("PREWRITE");
+    int32 PreLayerCount=INDEX_NONE,PreFinalCount=INDEX_NONE;
+    int32 PostLayerCount=INDEX_NONE,PostFinalCount=INDEX_NONE,LayersUpToDate=INDEX_NONE;
+    int32 ExpectedCount=0,ReplacementCount=0,ChangedSamples=0;
+    bool bHeightWriteReturned=false;
+
+    void Report(const TCHAR* Gate,const TCHAR* Why,bool bSuccess) const
+    {
+        const FString Message=FString::Printf(
+            TEXT("R3_TERRAIN_APPLY gate=%s phase=%s success=%d height_write_returned=%d expected_count=%d replacement_count=%d pre_layer_count=%d pre_final_count=%d post_layer_count=%d post_final_count=%d layers_up_to_date=%d changed_samples=%d reason=%s"),
+            Gate,Phase,bSuccess?1:0,bHeightWriteReturned?1:0,ExpectedCount,ReplacementCount,
+            PreLayerCount,PreFinalCount,PostLayerCount,PostFinalCount,LayersUpToDate,ChangedSamples,Why);
+        if(bSuccess){UE_LOG(LogTemp,Display,TEXT("%s"),*Message);}
+        else {UE_LOG(LogTemp,Error,TEXT("%s"),*Message);}
+    }
+
+    FString Fail(const TCHAR* Gate,const TCHAR* Why) const
+    {
+        Report(Gate,Why,false);
+        return FString::Printf(TEXT("gate=%s phase=%s reason=%s"),Gate,Phase,Why);
+    }
+};
