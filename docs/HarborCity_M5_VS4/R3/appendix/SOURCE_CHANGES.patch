+FString ReadSkeletal(USkeletalMeshComponent* Component)
+{
+    auto Result = NewRecord(TEXT("Current component pose, CPU linear skinning of RenderData LOD0, world cm"));
+    AttachComponentContext(Result, Component);
+    Result->SetStringField(TEXT("pose_scope"), TEXT("Existing evaluated component-space bone transforms; no tick, refresh, reference-pose fallback or asset mutation"));
+    Result->SetNumberField(TEXT("bone_transform_revision"), Component->GetBoneTransformRevisionNumber());
+    Result->SetStringField(TEXT("pose_evaluation_frame"), TEXT("NOT_RUN_NO_PUBLIC_EVALUATION_TIMESTAMP; engine_frame is the read frame"));
+    if (Component->IsRunningParallelEvaluation()) return NotRun(Result, TEXT("Animation evaluation still running; no forced wait or pose mutation"));
+    Result->SetStringField(TEXT("morph_targets"), TEXT("NOT_RUN_NOT_APPLIED_BY_ComputeSkinnedPositions"));
+    Result->SetStringField(TEXT("cloth_deformation"), TEXT("NOT_RUN_NOT_APPLIED_BY_ComputeSkinnedPositions"));
+    Result->SetStringField(TEXT("mesh_deformer"), TEXT("NOT_RUN_GPU_DEFORMER_NOT_EVALUATED"));
+    Result->SetStringField(TEXT("nanite"), TEXT("NOT_RUN_CPU_LOD0_NOT_NANITE_CLUSTER_SURFACE"));
+    USkinnedAsset* Asset = Component->GetSkinnedAsset();
+    if (!Asset || Asset->IsCompiling()) return NotRun(Result, TEXT("Missing skinned asset or asset still compiling"));
+    Result->SetStringField(TEXT("skeletal_mesh"), Asset->GetPathName());
+    Result->SetNumberField(TEXT("morph_target_asset_count"), Asset->GetMorphTargets().Num());
+    if (Component->GetComponentSpaceTransforms().IsEmpty()) return NotRun(Result, TEXT("No evaluated component-space pose; do not fabricate reference pose"));
+    const FSkeletalMeshRenderData* Render = Component->GetSkeletalMeshRenderData();
+    if (!Render || !Render->LODRenderData.IsValidIndex(0)) return NotRun(Result, TEXT("No skeletal RenderData LOD0"));
+    const FSkeletalMeshLODRenderData& LOD = Render->LODRenderData[0];
+    const auto& PositionBuffer = LOD.StaticVertexBuffers.PositionVertexBuffer;
+    const FSkinWeightVertexBuffer* Weights = Component->GetSkinWeightBuffer(0);
+    const auto* IndexBuffer = LOD.MultiSizeIndexContainer.IsIndexBufferValid() ? LOD.MultiSizeIndexContainer.GetIndexBuffer() : nullptr;
+    const uint32 Count = LOD.GetNumVertices();
+    if (!Count || Count > 2000000 || PositionBuffer.GetNumVertices() != Count || !PositionBuffer.GetVertexData() ||
+        !IndexBuffer || IndexBuffer->Num() <= 0 || IndexBuffer->GetResourceDataSize() <= 0 ||
+        !Weights || Weights->GetNumVertices() != Count || !Weights->GetDataVertexBuffer()->GetWeightData())
+        return NotRun(Result, TEXT("CPU render position/index/skin-weight data unavailable or outside bounded size"));
+    if (Weights->GetVariableBonesPerVertex() && (!Weights->GetLookupVertexBuffer()->GetNeedsCPUAccess() ||
+        Weights->GetLookupVertexBuffer()->GetNumVertices() != Count))
+        return NotRun(Result, TEXT("Variable-influence CPU weight lookup retention cannot be verified"));
+    Result->SetBoolField(TEXT("lod_has_cloth_data"), LOD.HasClothData());
+    TArray<FMatrix44f> Matrices;
+    Component->GetCurrentRefToLocalMatrices(Matrices, 0);
+    if (Matrices.IsEmpty()) return NotRun(Result, TEXT("No evaluated ref-to-local matrices"));
+    TBitArray<> Covered(false, Count);
+    for (const FSkelMeshRenderSection& Section : LOD.RenderSections)
+    {
+        if (uint64(Section.BaseVertexIndex) + Section.NumVertices > Count)
+            return NotRun(Result, TEXT("Invalid skeletal section vertex range"));
+        for (const FBoneIndexType Bone : Section.BoneMap)
+            if (!Matrices.IsValidIndex(Bone)) return NotRun(Result, TEXT("Section bone map exceeds evaluated pose"));
+        for (uint32 I = 0; I < Section.NumVertices; ++I) Covered[Section.BaseVertexIndex + I] = true;
+    }
+    for (uint32 I = 0; I < Count; ++I)
+        if (!Covered[I]) return NotRun(Result, TEXT("Uncovered skeletal vertex would be uninitialized by CPU skinning"));
+    TArray<FVector3f> Local;
+    USkinnedMeshComponent::ComputeSkinnedPositions(Component, Local, Matrices, LOD, *Weights);
+    if (Local.Num() != int32(Count)) return NotRun(Result, TEXT("CPU skinning returned incomplete geometry"));
+    const FTransform Transform = Component->GetComponentTransform();
+    TArray<FVector> Positions;
+    Positions.Reserve(Local.Num());
+    for (const FVector3f& P : Local) Positions.Add(Transform.TransformPosition(FVector(P)));
+    TArray<uint32> AllIndices, Indices;
+    LOD.MultiSizeIndexContainer.GetIndexBuffer(AllIndices);
+    int32 ExcludedSections = 0;
+    for (const FSkelMeshRenderSection& Section : LOD.RenderSections)
+    {
+        if (Section.bDisabled || !Component->IsMaterialSectionShown(Section.MaterialIndex, 0))
+        {
+            ++ExcludedSections;
+            continue;
+        }
+        const uint64 End = uint64(Section.BaseIndex) + uint64(Section.NumTriangles) * 3;
+        if (End > uint64(AllIndices.Num())) return NotRun(Result, TEXT("Invalid skeletal section index range"));
+        for (uint32 I = Section.BaseIndex; I < End; ++I) Indices.Add(AllIndices[I]);
+    }
+    Result->SetNumberField(TEXT("hidden_or_disabled_sections_excluded"), ExcludedSections);
+    if (!AttachGeometry(Result, Positions, Indices)) return NotRun(Result, TEXT("Invalid or empty skinned render geometry"));
+    return Encode(Result);
+}
+#endif
+}
