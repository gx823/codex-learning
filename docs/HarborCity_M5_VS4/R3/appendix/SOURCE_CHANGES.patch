+FString UHCM5VS4R3SceneCopy::ReadInstanceSnapshotJSON(const TArray<FString>& ComponentPaths)
+{
+    const FString ExpectedMap=TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/L_CapitalR2");
+    auto Fail=[](const FString& Error)
+    {
+        auto R=MakeShared<FJsonObject>();
+        R->SetStringField(TEXT("status"),TEXT("FAIL_READONLY_INSTANCE_SNAPSHOT"));
+        R->SetBoolField(TEXT("read_only"),true);
+        R->SetStringField(TEXT("error"),Error);
+        return R3SnapshotJSON(R);
+    };
+    UWorld* World=GEditor?GEditor->GetEditorWorldContext().World():nullptr;
+    if(!IsInGameThread()||!World||!World->PersistentLevel||World->WorldType!=EWorldType::Editor||World->GetOutermost()->GetName()!=ExpectedMap)
+        return Fail(TEXT("Exact Capital Editor world on game thread required; never Game/PIE"));
+    if(ComponentPaths.IsEmpty()||ComponentPaths.Num()>512)return Fail(TEXT("Component batch must contain 1..512 exact paths"));
+    const FString Stop=FPaths::ConvertRelativePathToFull(FPaths::ProjectDir(),TEXT("../docs/HarborCity_M5_VS4/R3/STOP_DESKTOP_CHAIN"));
+    auto Stopped=[&Stop](){return IFileManager::Get().FileExists(*Stop);};
+    if(Stopped())return Fail(TEXT("USER_STOPPED"));
+    const FString ComponentPrefix=World->PersistentLevel->GetPathName()+TEXT(".");
+    TSet<FString> Wanted;
+    for(const FString& Path:ComponentPaths)
+    {
+        if(!Path.StartsWith(ComponentPrefix)||Wanted.Contains(Path))
+            return Fail(TEXT("Foreign or duplicate component identity"));
+        Wanted.Add(Path);
+    }
+    TMap<FString,UStaticMeshComponent*> Found;
+    for(TActorIterator<AActor> It(World);It;++It)
+    {
+        if(Stopped())return Fail(TEXT("USER_STOPPED"));
+        TArray<UStaticMeshComponent*> Components;
+        It->GetComponents(Components);
+        for(UStaticMeshComponent* C:Components)
+        {
+            if(IsValid(C)&&Wanted.Contains(C->GetPathName()))Found.Add(C->GetPathName(),C);
+        }
+    }
+    if(Found.Num()!=Wanted.Num())return Fail(TEXT("At least one exact live static component path was not found"));
+    IConsoleVariable* ForceSwap=IConsoleManager::Get().FindConsoleVariable(TEXT("r.InstancedStaticMeshes.ForceRemoveAtSwap"));
+    if(!ForceSwap)return Fail(TEXT("Native ForceRemoveAtSwap CVar unavailable"));
+    const int32 ForceSwapValue=ForceSwap->GetInt();
+    int64 InstanceTotal=0,FloatTotal=0;
+    TArray<TSharedPtr<FJsonValue>> Records;
+    for(const FString& Path:ComponentPaths)
+    {
+        if(Stopped())return Fail(TEXT("USER_STOPPED"));
+        UStaticMeshComponent* C=Found[Path];
+        AActor* Owner=C->GetOwner();
+        const UClass* Class=C->GetClass();
+        if((Class!=UStaticMeshComponent::StaticClass()&&Class!=UInstancedStaticMeshComponent::StaticClass()&&
+            Class!=UHierarchicalInstancedStaticMeshComponent::StaticClass())||C->IsTemplate()||C->GetWorld()!=World||
+            !IsValid(Owner)||Owner->GetWorld()!=World||Owner->GetLevel()!=World->PersistentLevel||!Owner->GetRootComponent()||!C->GetStaticMesh())
+            return Fail(TEXT("Unknown subclass, template, foreign owner, absent root or null mesh"));
+        if(C->GetComponentTransform().ContainsNaN()||C->GetRelativeTransform().ContainsNaN())
+            return Fail(TEXT("Nonfinite native component transform"));
+        auto R=MakeShared<FJsonObject>();
+        R->SetStringField(TEXT("path"),Path);
+        R->SetStringField(TEXT("owner_path"),Owner->GetPathName());
+        R->SetStringField(TEXT("class_path"),Class->GetPathName());
+        R->SetStringField(TEXT("mesh"),C->GetStaticMesh()->GetPathName());
+        R->SetObjectField(TEXT("world_transform"),R3SnapshotTransform(C->GetComponentTransform()));
+        R->SetObjectField(TEXT("relative_transform"),R3SnapshotTransform(C->GetRelativeTransform()));
+        R->SetBoolField(TEXT("visible"),C->GetVisibleFlag());
+        R->SetBoolField(TEXT("hidden_in_game"),C->bHiddenInGame);
+        R->SetBoolField(TEXT("owner_hidden_in_game"),Owner->IsHidden());
+        R->SetStringField(TEXT("attach_parent_path"),C->GetAttachParent()?C->GetAttachParent()->GetPathName():TEXT(""));
+        R->SetStringField(TEXT("attach_socket_name"),C->GetAttachSocketName().ToString());
+        R->SetArrayField(TEXT("absolute_flags"),{MakeShared<FJsonValueBoolean>(C->IsUsingAbsoluteLocation()),
+            MakeShared<FJsonValueBoolean>(C->IsUsingAbsoluteRotation()),MakeShared<FJsonValueBoolean>(C->IsUsingAbsoluteScale())});
+        R->SetNumberField(TEXT("mobility"),static_cast<int32>(C->Mobility));
+        TArray<FString> Tags,OwnerComponents,Children;
+        for(const FName& Tag:C->ComponentTags)Tags.Add(Tag.ToString());
+        R->SetArrayField(TEXT("component_tags"),R3SnapshotStrings(Tags));
+        TArray<UActorComponent*> Owned;
+        Owner->GetComponents(Owned);
+        for(const UActorComponent* Item:Owned)if(IsValid(Item))OwnerComponents.Add(Item->GetPathName());
+        OwnerComponents.Sort();
+        for(const USceneComponent* Child:C->GetAttachChildren())if(IsValid(Child))Children.Add(Child->GetPathName());
+        Children.Sort();
+        R->SetArrayField(TEXT("owner_component_paths"),R3SnapshotStrings(OwnerComponents));
+        R->SetStringField(TEXT("owner_root_component_path"),Owner->GetRootComponent()->GetPathName());
+        R->SetArrayField(TEXT("attached_child_paths"),R3SnapshotStrings(Children));
+        FString Creation;
+        switch(C->CreationMethod)
+        {
+            case EComponentCreationMethod::Native:Creation=TEXT("Native");break;
+            case EComponentCreationMethod::SimpleConstructionScript:Creation=TEXT("SimpleConstructionScript");break;
+            case EComponentCreationMethod::UserConstructionScript:Creation=TEXT("UserConstructionScript");break;
+            case EComponentCreationMethod::Instance:Creation=TEXT("Instance");break;
+            default:return Fail(TEXT("Unknown component creation method"));
+        }
+        R->SetStringField(TEXT("creation_method"),Creation);
+        TArray<TSharedPtr<FJsonValue>> Materials,Overrides;
+        for(int32 Slot=0;Slot<C->GetNumMaterials();++Slot)
+        {
+            const UMaterialInterface* M=C->GetMaterial(Slot);
+            Materials.Add(M?StaticCastSharedRef<FJsonValue>(MakeShared<FJsonValueString>(M->GetPathName())):
+                StaticCastSharedRef<FJsonValue>(MakeShared<FJsonValueNull>()));
+        }
+        for(const UMaterialInterface* M:C->OverrideMaterials)
+            Overrides.Add(M?StaticCastSharedRef<FJsonValue>(MakeShared<FJsonValueString>(M->GetPathName())):
+                StaticCastSharedRef<FJsonValue>(MakeShared<FJsonValueNull>()));
+        R->SetArrayField(TEXT("materials"),Materials);
+        R->SetArrayField(TEXT("override_materials"),Overrides);
+        auto Collision=MakeShared<FJsonObject>();
+        Collision->SetNumberField(TEXT("collision_enabled"),static_cast<int32>(C->GetCollisionEnabled()));
+        Collision->SetNumberField(TEXT("object_type"),static_cast<int32>(C->GetCollisionObjectType()));
+        Collision->SetStringField(TEXT("profile_name"),C->GetCollisionProfileName().ToString());
+        Collision->SetBoolField(TEXT("generate_overlap_events"),C->GetGenerateOverlapEvents());
+        Collision->SetBoolField(TEXT("simulate_physics"),C->IsSimulatingPhysics());
+        Collision->SetBoolField(TEXT("gravity_enabled"),C->IsGravityEnabled());
+        TArray<TSharedPtr<FJsonValue>> Responses;
+        static_assert(ECC_OverlapAll_Deprecated==64,"Native collision response contract changed");
+        for(int32 Channel=0;Channel<ECC_OverlapAll_Deprecated;++Channel)
+            Responses.Add(MakeShared<FJsonValueNumber>(static_cast<int32>(C->GetCollisionResponseToChannel(static_cast<ECollisionChannel>(Channel)))));
+        Collision->SetArrayField(TEXT("responses"),Responses);
+        R->SetObjectField(TEXT("collision"),Collision);
+        TArray<TSharedPtr<FJsonValue>> Instances;
+        UInstancedStaticMeshComponent* ISM=Cast<UInstancedStaticMeshComponent>(C);
+        if(ISM)
+        {
+            const int32 Count=ISM->GetInstanceCount(),Width=ISM->NumCustomDataFloats;
+            if(Count<0||Width<0||Width>1024||int64(Count)*Width!=ISM->PerInstanceSMCustomData.Num())
+                return Fail(TEXT("Incomplete/oversized instance custom-float array"));
+            InstanceTotal+=Count;FloatTotal+=int64(Count)*Width;
+            if(InstanceTotal>200000||FloatTotal>4000000)return Fail(TEXT("Bounded snapshot exceeds 200000 instances/4000000 custom floats"));
+            const bool SupportsSwap=ISM->SupportsRemoveSwap();
+            auto Behavior=MakeShared<FJsonObject>();
+            Behavior->SetStringField(TEXT("source"),TEXT("NATIVE_SUPPORTS_REMOVE_SWAP_AND_CVAR"));
+            Behavior->SetStringField(TEXT("mode"),(SupportsSwap||ForceSwapValue!=0)?TEXT("REMOVE_SWAP"):TEXT("PRESERVE_ORDER"));
+            Behavior->SetBoolField(TEXT("supports_remove_swap"),SupportsSwap);
+            Behavior->SetNumberField(TEXT("force_remove_at_swap"),ForceSwapValue);
+            R->SetObjectField(TEXT("removal_behavior"),Behavior);
+            R->SetStringField(TEXT("kind"),Class==UHierarchicalInstancedStaticMeshComponent::StaticClass()?TEXT("HISM"):TEXT("ISM"));
+            R->SetNumberField(TEXT("num_custom_data_floats"),Width);
+            R->SetNumberField(TEXT("instancing_random_seed"),ISM->InstancingRandomSeed);
+            TArray<TSharedPtr<FJsonValue>> Seeds;
+            for(const FInstancedStaticMeshRandomSeed& Seed:ISM->AdditionalRandomSeeds)
+            {
+                auto S=MakeShared<FJsonObject>();
+                S->SetNumberField(TEXT("start_instance_index"),Seed.StartInstanceIndex);
+                S->SetNumberField(TEXT("random_seed"),Seed.RandomSeed);
+                Seeds.Add(MakeShared<FJsonValueObject>(S));
+            }
+            R->SetArrayField(TEXT("additional_random_seeds"),Seeds);
+            for(int32 Index=0;Index<Count;++Index)
+            {
+                if((Index%128)==0&&Stopped())return Fail(TEXT("USER_STOPPED"));
+                FTransform Local,Global;
+                if(!ISM->GetInstanceTransform(Index,Local,false)||!ISM->GetInstanceTransform(Index,Global,true)||
+                    Local.ContainsNaN()||Global.ContainsNaN())return Fail(TEXT("Missing/nonfinite original instance transform"));
+                auto I=MakeShared<FJsonObject>();
+                I->SetNumberField(TEXT("index"),Index);
+                I->SetObjectField(TEXT("local_transform"),R3SnapshotTransform(Local));
+                I->SetObjectField(TEXT("world_transform"),R3SnapshotTransform(Global));
+                TArray<TSharedPtr<FJsonValue>> Bits;
+                for(int32 J=0;J<Width;++J)
+                {
+                    uint32 Raw=0;
+                    FMemory::Memcpy(&Raw,&ISM->PerInstanceSMCustomData[Index*Width+J],sizeof(Raw));
+                    Bits.Add(MakeShared<FJsonValueString>(FString::Printf(TEXT("%08x"),Raw)));
+                }
+                I->SetArrayField(TEXT("custom_data_f32_bits"),Bits);
+                Instances.Add(MakeShared<FJsonValueObject>(I));
+            }
+        }
+        else
+        {
+            R->SetStringField(TEXT("kind"),TEXT("SMC"));
+            R->SetNumberField(TEXT("num_custom_data_floats"),0);
+            R->SetField(TEXT("removal_behavior"),MakeShared<FJsonValueNull>());
+        }
+        R->SetArrayField(TEXT("instances"),Instances);
+        Records.Add(MakeShared<FJsonValueObject>(R));
+    }
+    if(Stopped())return Fail(TEXT("USER_STOPPED"));
+    if(ForceSwap->GetInt()!=ForceSwapValue)return Fail(TEXT("RemoveSwap CVar changed during read-only snapshot"));
+    auto Result=MakeShared<FJsonObject>();
+    Result->SetNumberField(TEXT("schema"),1);
+    Result->SetStringField(TEXT("status"),TEXT("READ_ONLY_NATIVE_INSTANCE_SNAPSHOT"));
+    Result->SetBoolField(TEXT("read_only"),true);
+    Result->SetStringField(TEXT("map"),ExpectedMap);
+    Result->SetStringField(TEXT("world_type"),TEXT("Editor"));
+    Result->SetStringField(TEXT("engine_frame"),LexToString(GFrameCounter));
+    Result->SetNumberField(TEXT("component_count"),Records.Num());
+    Result->SetNumberField(TEXT("instance_count"),InstanceTotal);
+    Result->SetNumberField(TEXT("custom_float_count"),FloatTotal);
+    Result->SetArrayField(TEXT("components"),Records);
+    return R3SnapshotJSON(Result);
+}
