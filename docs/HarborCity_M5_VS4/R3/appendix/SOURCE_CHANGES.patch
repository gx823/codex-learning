+TSharedPtr<FJsonObject> FHCM5VS4R3Telemetry::Sample(AHCM1PlayerController* PC, bool bSampleDepth)
+{
+    PollDepth();
+    auto Row = MakeShared<FJsonObject>();
+    auto* Hero = PC ? PC->GetControlledCharacter() : nullptr;
+    if (!Hero || !PC->PlayerCameraManager || !Owner.IsValid()) return Row;
+    UWorld* World = Owner->GetWorld();
+    const double Now = World->GetTimeSeconds();
+    const FVector P = Hero->GetActorLocation();
+    const auto View = PC->PlayerCameraManager->GetCameraCacheView();
+    const auto Mode = PC->GetPlayerMode();
+    const bool FirstPerson = PC->IsFirstPersonPerspective();
+    if (LastMode >= 0 && (int32(Mode) != LastMode || FirstPerson != bLastFirstPerson))
+    {
+        TransitionUntil = Now + .2;
+        TransitionReason = int32(Mode) != LastMode ? TEXT("vehicle_mode_change") : TEXT("perspective_change");
+    }
+    LastMode = int32(Mode); bLastFirstPerson = FirstPerson;
+    const auto* Move = Hero->GetCharacterMovement();
+    const auto* Abilities = Hero->GetAbilities();
+    const auto* Combat = Hero->GetCombatComponent();
+    const auto* Flight = Hero->GetFlightComponent();
+    const bool Attack = (Combat && Combat->IsAttacking()) || (Abilities && Abilities->IsBusy());
+    const auto* Input = Cast<UEnhancedPlayerInput>(PC->PlayerInput);
+    const auto* Action = PC->GetM1Action(TEXT("Move"));
+    const FVector2D Axis = Input && Action ? Input->GetActionValue(Action).Get<FVector2D>() : FVector2D::ZeroVector;
+    const double Dt = LastWorldSeconds >= 0 ? Now - LastWorldSeconds : 0;
+    const double Speed = Dt > 0 ? FVector::Dist2D(P, LastPlayer) / Dt : -1;
+    const bool Walking = Move && Move->IsMovingOnGround() && Mode == EHCPlayerMode::OnFoot;
+    Row->SetNumberField(TEXT("engine_frame"), double(GFrameCounter));
+    Row->SetNumberField(TEXT("world_seconds"), Now);
+    Row->SetNumberField(TEXT("wall_seconds"), FPlatformTime::Seconds());
+    Row->SetStringField(TEXT("actual_map"), World->GetOutermost()->GetName());
+    Row->SetArrayField(TEXT("player_xyz_cm"), VectorJSON(P));
+    Row->SetArrayField(TEXT("camera_xyz_cm"), VectorJSON(View.Location));
+    Row->SetArrayField(TEXT("camera_pitch_yaw_roll"), VectorJSON(FVector(View.Rotation.Pitch, View.Rotation.Yaw, View.Rotation.Roll)));
+    Row->SetNumberField(TEXT("camera_fov"), View.FOV);
+    Row->SetNumberField(TEXT("camera_to_player_cm"), FVector::Distance(View.Location, P));
+    if(const auto* Manager=Cast<AHCM4R2PlayerCameraManager>(PC->PlayerCameraManager))
+    {
+        if(Manager->IsR3SpatialPrototypeEnabled())Row->SetObjectField(TEXT("r3_camera_solver"),SolverJSON(*Manager,View));
+        if(const auto ObjectFade=Manager->GetR3ObjectFadeObservation())
+        {
+            ObjectFade->SetBoolField(TEXT("same_game_frame"),ObjectFade->GetNumberField(TEXT("engine_frame"))==double(GFrameCounter));
+            Row->SetObjectField(TEXT("r3_object_fade"),ObjectFade);
+        }
+    }
+    Row->SetNumberField(TEXT("feet_z_cm"), P.Z - Hero->GetCapsuleComponent()->GetScaledCapsuleHalfHeight());
+    FVector Eye; FRotator EyeRotation; Hero->GetActorEyesViewPoint(Eye, EyeRotation);
+    Row->SetNumberField(TEXT("eye_z_cm"), Eye.Z);
+    Row->SetStringField(TEXT("camera_mode"), FirstPerson ? TEXT("first_person") : TEXT("third_person"));
+    Row->SetStringField(TEXT("view_target"), GetPathNameSafe(PC->GetViewTarget()));
+    Row->SetNumberField(TEXT("view_dynamic_gi_method"), int32(View.PostProcessSettings.DynamicGlobalIlluminationMethod));
+    Row->SetNumberField(TEXT("view_reflection_method"), int32(View.PostProcessSettings.ReflectionMethod));
+    Row->SetBoolField(TEXT("view_overrides_gi"), View.PostProcessSettings.bOverride_DynamicGlobalIlluminationMethod);
+    Row->SetBoolField(TEXT("view_overrides_reflections"), View.PostProcessSettings.bOverride_ReflectionMethod);
+    Row->SetStringField(TEXT("camera_transition_reason"), Now <= TransitionUntil ? TransitionReason : TEXT(""));
+    Row->SetStringField(TEXT("black_transition_reason"), TEXT(""));
+    Row->SetNumberField(TEXT("input_x"), Axis.X); Row->SetNumberField(TEXT("input_y"), Axis.Y);
+    Row->SetStringField(TEXT("input_source"), Input && Action ? TEXT("EnhancedPlayerInput.Move") : TEXT("NOT_RUN_MISSING_ACTION"));
+    Row->SetNumberField(TEXT("horizontal_actual_speed_cm_s"), Speed);
+    Row->SetNumberField(TEXT("delta_world_seconds"), Dt);
+    Row->SetBoolField(TEXT("walking_or_running"), Walking);
+    Row->SetBoolField(TEXT("attack_or_draw"), Attack);
+    Row->SetBoolField(TEXT("dialogue_visible"), PC->IsDialogueOpen());
+    Row->SetBoolField(TEXT("pause_visible"), PC->IsPauseMenuOpen());
+    Row->SetBoolField(TEXT("vehicle_transition"), Mode == EHCPlayerMode::Entering || Mode == EHCPlayerMode::Exiting);
+    Row->SetBoolField(TEXT("flight_or_landing"), Flight && (Flight->IsFlying() || Flight->IsLanding()));
+    Row->SetBoolField(TEXT("door_interaction"), false);
+    Row->SetStringField(TEXT("door_state_source"), TEXT("R2 baseline doors are static meshes; no native opening-door interaction exists. Update observer when R3 interactive doors are introduced."));
+    Row->SetBoolField(TEXT("stuck_eligible"), Walking && !Attack && !PC->IsDialogueOpen() && !PC->IsPauseMenuOpen() && !Axis.IsNearlyZero() && Dt > 0);
+    FString Interior;
+    for (TActorIterator<AHCM3NavRegion> I(World); I; ++I)
+    {
+        const FString Id = I->StableId.ToString();
+        if ((Id == TEXT("VS2_Guild") || Id == TEXT("VS2_Cafe") || Id == TEXT("VS2_Tavern") || Id == TEXT("VS2_Shop") || Id.StartsWith(TEXT("R3_Interior_"))) && I->ContainsPoint(P))
+        { Interior = Id; break; }
+    }
+    FString InteriorContext=Interior.IsEmpty()?TEXT("NATIVE_REGION_OUTDOOR"):TEXT("NATIVE_AUTHORED_REGION");
+    // The two Castle rooms have no City NavRegion. This is measurement only:
+    // do not change production camera distances, navigation or gameplay state.
+    // Bounds are the saved room inventory, and an actual overhead static hit
+    // is also required. An unconfirmed room candidate remains unknown, not day outdoors.
+    if(Interior.IsEmpty()&&World->GetMapName()==TEXT("L_CapitalR2"))
+    {
+        const FBox Throne(FVector(-2700,-26500,3500),FVector(-700,-21900,5000));
+        const FBox Cellar(FVector(-3300,-22400,1650),FVector(300,-19200,2850));
+        const FBox* Room=Throne.IsInsideOrOn(P)?&Throne:Cellar.IsInsideOrOn(P)?&Cellar:nullptr;
+        if(Room)
+        {
+            const FString Candidate=Room==&Throne?TEXT("R3_Castle_Throne"):TEXT("R3_Castle_Cellar");
+            FHitResult Roof;FCollisionQueryParams RoofQuery(SCENE_QUERY_STAT(R3TelemetryRoomCeiling),true,Hero);
+            const FVector Start=Eye+FVector(0,0,30),End(Eye.X,Eye.Y,Room->Max.Z);
+            const bool Confirmed=End.Z>Start.Z&&World->LineTraceSingleByChannel(Roof,Start,End,ECC_WorldStatic,RoofQuery)
+                &&!Roof.bStartPenetrating&&Roof.ImpactPoint.Z>Start.Z;
+            Row->SetStringField(TEXT("interior_candidate_id"),Candidate);
+            Row->SetBoolField(TEXT("interior_ceiling_confirmed"),Confirmed);
+            Row->SetStringField(TEXT("interior_ceiling_component"),Confirmed?GetPathNameSafe(Roof.GetComponent()):TEXT(""));
+            Row->SetNumberField(TEXT("interior_ceiling_z_cm"),Confirmed?Roof.ImpactPoint.Z:0);
+            if(Confirmed){Interior=Candidate;InteriorContext=TEXT("NATIVE_CASTLE_BOUNDS_AND_OVERHEAD_STATIC_HIT");}
+            else InteriorContext=TEXT("NOT_RUN_CASTLE_CEILING_UNCONFIRMED");
+        }
+    }
+    Row->SetStringField(TEXT("interior_context_status"),InteriorContext);
+    Row->SetStringField(TEXT("interior_id"), Interior);
+    Row->SetBoolField(TEXT("is_indoor"), !Interior.IsEmpty());
+    FString Period = TEXT("NOT_RUN_NO_TIME_DIRECTOR");
+    for (TActorIterator<AHCM5VS2CornerTimeDirector> I(World); I; ++I) { Period = I->CurrentPeriod.ToString(); break; }
+    Row->SetStringField(TEXT("time_of_day"), Period);
+    TArray<TSharedPtr<FJsonValue>> Vehicles;
+    for (TActorIterator<AHCM1Vehicle> Vehicle(World); Vehicle; ++Vehicle)
+    {
+        auto VehicleRow = MakeShared<FJsonObject>();
+        VehicleRow->SetStringField(TEXT("actor_path"), Vehicle->GetPathName());
+        VehicleRow->SetStringField(TEXT("actor_label"), Vehicle->GetActorNameOrLabel());
+        VehicleRow->SetBoolField(TEXT("components_complete"), true);
+        VehicleRow->SetStringField(TEXT("component_scope"), TEXT("All owned UMeshComponent instances; attached passenger actors are separate NPC subjects"));
+        TArray<TSharedPtr<FJsonValue>> Meshes;
+        TInlineComponentArray<UMeshComponent*> Components(*Vehicle);
+        for (auto* Component : Components)
+        {
+            auto* Static = Cast<UStaticMeshComponent>(Component);
+            auto* Skeletal = Cast<USkeletalMeshComponent>(Component);
+            auto* Instanced = Cast<UInstancedStaticMeshComponent>(Component);
+            const int32 Count = Instanced ? Instanced->GetInstanceCount() : 1;
+            for (int32 Index = 0; Index < Count; ++Index)
+            {
+                auto Mesh = MakeShared<FJsonObject>();
+                FTransform Transform = Component->GetComponentTransform();
+                if (Instanced) Instanced->GetInstanceTransform(Index, Transform, true);
+                const FQuat Q = Transform.GetRotation();
+                Mesh->SetStringField(TEXT("path"), Component->GetPathName());
+                Mesh->SetStringField(TEXT("type"), Component->GetClass()->GetName());
+                Mesh->SetBoolField(TEXT("rendered"), Component->IsVisible() && !Vehicle->IsHidden());
+                Mesh->SetBoolField(TEXT("component_visible"), Component->IsVisible());
+                Mesh->SetBoolField(TEXT("actor_hidden"), Vehicle->IsHidden());
+                if (Static && Static->GetStaticMesh()) Mesh->SetStringField(TEXT("mesh"), Static->GetStaticMesh()->GetPathName());
+                if (Skeletal)
+                {
+                    Mesh->SetStringField(TEXT("skeletal_mesh"), GetPathNameSafe(Skeletal->GetSkinnedAsset()));
+                    Mesh->SetStringField(TEXT("pose_geometry"), TEXT("NOT_RUN_NO_SAME_FRAME_VERTEX_EXPORT"));
+                }
+                if (Instanced) Mesh->SetNumberField(TEXT("instance_index"), Index);
+                auto Pose = MakeShared<FJsonObject>();
+                Pose->SetArrayField(TEXT("translation_cm"), VectorJSON(Transform.GetLocation()));
+                Pose->SetArrayField(TEXT("scale"), VectorJSON(Transform.GetScale3D()));
+                Pose->SetArrayField(TEXT("quaternion"), {MakeShared<FJsonValueNumber>(Q.X), MakeShared<FJsonValueNumber>(Q.Y), MakeShared<FJsonValueNumber>(Q.Z), MakeShared<FJsonValueNumber>(Q.W)});
+                Mesh->SetObjectField(TEXT("world_transform"), Pose);
+                Meshes.Add(MakeShared<FJsonValueObject>(Mesh));
+            }
+        }
+        VehicleRow->SetArrayField(TEXT("components"), Meshes);
+        Vehicles.Add(MakeShared<FJsonValueObject>(VehicleRow));
+    }
+    Row->SetArrayField(TEXT("vehicles"), Vehicles);
+    if (auto* Settings = UGameUserSettings::GetGameUserSettings()) Row->SetNumberField(TEXT("quality"), Settings->GetOverallScalabilityLevel());
+    if (bSampleDepth) Row->SetObjectField(TEXT("depth"), Depth(PC));
+    Frames.Add(MakeShared<FJsonValueObject>(Row));
+    LastWorldSeconds = Now; LastPlayer = P;
+    return Row;
+}
+
+void FHCM5VS4R3Telemetry::Save(const FString& Directory)
+{
+    // Drain only after recording stops; never block the live capture on a GPU read.
+    const double Deadline = FPlatformTime::Seconds() + 5;
+    while (!PendingDepth.IsEmpty() && FPlatformTime::Seconds() < Deadline)
+    {
+        PollDepth();
+        FlushRenderingCommands();
+        FPlatformProcess::SleepNoStats(.001f);
+    }
+    PollDepth();
+    FlushRenderingCommands();
+    for (const auto& Batch : PendingDepth)
+    {
+        if (Batch->Complete.Load()) FinishDepth(*Batch);
+        else Batch->Result->SetStringField(TEXT("status"), TEXT("NOT_RUN_GPU_READBACK_TIMEOUT"));
+    }
+    const auto Unfinished = PendingDepth;
+    ENQUEUE_RENDER_COMMAND(HCR3CancelDepthCopies)([Unfinished](FRHICommandListImmediate& Commands)
+    {
+        for (const auto& Batch : Unfinished)
+            if (Batch->EndFrameHandle.IsValid()) FCoreDelegates::OnEndFrameRT.Remove(Batch->EndFrameHandle);
+    });
+    FlushRenderingCommands();
+    PendingDepth.Reset();
+    auto Report = MakeShared<FJsonObject>();
+    Report->SetStringField(TEXT("status"), TEXT("OBSERVED_PENDING_OFFLINE_VALIDATION"));
+    Report->SetStringField(TEXT("run_id"), Directory);
+    Report->SetStringField(TEXT("scope"), TEXT("Native per-game-frame observer and asynchronous depth; no interpolation. Geometry clearance is NOT_RUN until offline render-mesh audit."));
+    Report->SetArrayField(TEXT("frames"), Frames);
+    auto Variables = MakeShared<FJsonObject>();
+    for (const TCHAR* Name : {TEXT("r.GenerateMeshDistanceFields"), TEXT("r.DynamicGlobalIlluminationMethod"), TEXT("r.ReflectionMethod"), TEXT("r.Lumen.DiffuseIndirect.Allow"), TEXT("r.Lumen.Reflections.Allow"), TEXT("r.Lumen.TraceMeshSDFs"), TEXT("r.AllowStaticLighting"), TEXT("r.ScreenPercentage"), TEXT("sg.GlobalIlluminationQuality"), TEXT("sg.ReflectionQuality")})
+        if (const auto* Variable = IConsoleManager::Get().FindConsoleVariable(Name)) Variables->SetNumberField(Name, Variable->GetFloat());
+    Report->SetObjectField(TEXT("render_cvars_at_end"), Variables);
+    Report->SetStringField(TEXT("gi_evidence_scope"), TEXT("Runtime console state and camera overrides only; not proof of actual Lumen surface-cache coverage. Separate native Lumen Scene captures required."));
+    FString JSON;
+    auto Writer = TJsonWriterFactory<>::Create(&JSON);
+    FJsonSerializer::Serialize(Report, Writer);
+    FFileHelper::SaveStringToFile(JSON, *(Directory / TEXT("native_r3.json")), FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM);
+}
