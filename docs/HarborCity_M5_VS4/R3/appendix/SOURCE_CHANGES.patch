+FString UHCM5VS4R3Geometry::ReadComponentRenderJson(UActorComponent* Component)
+{
+    auto Result = NewRecord(TEXT("Component-specific render geometry"));
+#if WITH_EDITOR
+    if (!IsInGameThread()) return NotRun(Result, TEXT("Game-thread-only read"));
+    if (!IsValid(Component)) return NotRun(Result, TEXT("Missing component"));
+    if (auto* Skeletal = Cast<USkeletalMeshComponent>(Component)) return ReadSkeletal(Skeletal);
+    if (auto* Landscape = Cast<ULandscapeComponent>(Component))
+    {
+        AttachComponentContext(Result, Landscape);
+        Result->SetStringField(TEXT("representation"), TEXT("Composed Landscape heightmap Mip0, world cm"));
+        AttachLandscapeSurface(Result, Landscape);
+        const TArray<FVector> Positions = UHCM5VS4WorldAuthoring::ReadLandscapeRenderVertices(Landscape);
+        const int32 Side = Landscape->ComponentSizeQuads + 1;
+        if (Side <= 1 || Side > 1025 || Positions.Num() != Side * Side)
+            return NotRun(Result, TEXT("Read-only Landscape helper returned no valid Mip0 grid"));
+        TArray<uint32> Indices;
+        Indices.Reserve((Side - 1) * (Side - 1) * 6);
+        for (int32 Y = 0; Y < Side - 1; ++Y) for (int32 X = 0; X < Side - 1; ++X)
+        {
+            const uint32 I = Y * Side + X;
+            Indices.Append({I, I + uint32(Side), I + 1, I + 1, I + uint32(Side), I + uint32(Side) + 1});
+        }
+        if (!AttachGeometry(Result, Positions, Indices)) return NotRun(Result, TEXT("Invalid Landscape geometry"));
+        return Encode(Result);
+    }
+    Result->SetStringField(TEXT("component"), Component->GetPathName());
+    if (auto* Brush = Cast<UBrushComponent>(Component))
+    {
+        AttachComponentContext(Result, Brush);
+        const AActor* Owner = Brush->GetOwner();
+        const bool bOwnerIsVolume = Cast<AVolume>(Owner) != nullptr;
+        Result->SetStringField(TEXT("owner_path"), Owner ? Owner->GetPathName() : TEXT(""));
+        Result->SetStringField(TEXT("owner_class"), Owner ? Owner->GetClass()->GetPathName() : TEXT(""));
+        Result->SetBoolField(TEXT("owner_is_volume"), bOwnerIsVolume);
+        Result->SetBoolField(TEXT("owner_hidden_in_game"), Owner && Owner->IsHidden());
+        Result->SetBoolField(TEXT("component_hidden_in_game"), Brush->bHiddenInGame);
+        Result->SetBoolField(TEXT("component_visible_flag"), Brush->GetVisibleFlag());
+        if (bOwnerIsVolume && Brush->bHiddenInGame)
+        {
+            Result->SetStringField(TEXT("status"), TEXT("EXCLUDED_NON_RENDERED_VOLUME"));
+            Result->SetStringField(TEXT("reason"), TEXT("Native AVolume owner and hidden-in-game BrushComponent; no visible surface in normal gameplay. Editor/debug volume visualization is outside this scope."));
+            Result->SetBoolField(TEXT("excluded_from_visible_surface_denominator"), true);
+            Result->SetStringField(TEXT("overlap_exemption"), TEXT("NONE_SCOPE_EXCLUSION_ONLY"));
+            return Encode(Result);
+        }
+        return NotRun(Result, TEXT("Brush render triangulation not implemented; BSP collision/volume hull is not a render substitute"));
+    }
+    return NotRun(Result, TEXT("Unsupported component type"));
+#else
+    return NotRun(Result, TEXT("Editor diagnostic only; not enabled in packaged builds"));
+#endif
+}
