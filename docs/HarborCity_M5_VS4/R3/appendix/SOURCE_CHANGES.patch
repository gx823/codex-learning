+
+bool FHCR3ViewportColorProfile::IsVerifiedSDRsRGB() const
+{
+    return bMetadataAvailable && !bGlobalHDR && !bWindowHDR && !bMetadataHDR &&
+        OutputFormat == int32(EDisplayOutputFormat::SDR_sRGB) &&
+        ColorGamut == int32(EDisplayColorGamut::sRGB_D65) && TonemapperGamma == 0.f;
+}
+
+namespace
+{
+FHCR3ViewportColorProfile ReadWindowColorProfile(bool bWindowHDR, void* OSWindow,
+    const FVector2D& TopLeft, const FVector2D& BottomRight)
+{
+    FHCR3ViewportColorProfile Result;
+    Result.bGlobalHDR = IsHDREnabled();
+    Result.bWindowHDR = bWindowHDR;
+    const auto* Gamma = IConsoleManager::Get().FindTConsoleVariableDataFloat(TEXT("r.TonemapperGamma"));
+    if (!OSWindow || !Gamma) return Result;
+    FHDRMetaData Metadata;
+    HDRGetMetaDataForWindow(Metadata, TopLeft, BottomRight, OSWindow);
+    Result.bMetadataAvailable = true;
+    Result.bMetadataHDR = Metadata.bHDRSupported;
+    Result.OutputFormat = int32(Metadata.DisplayOutputFormat);
+    Result.ColorGamut = int32(Metadata.DisplayColorGamut);
+    Result.TonemapperGamma = Gamma->GetValueOnAnyThread();
+    return Result;
+}
+}
+
+struct FHCM5VS4R3ViewportCapture::FState
+{
+    enum class EPhase : uint8 { Free, Queued, Armed, CopyPending, Ready, Failed };
+    struct FSlot
+    {
+        EPhase Phase = EPhase::Free;
+        FHCR3ViewportFrame Frame;
+        TUniquePtr<FRHIGPUTextureReadback> Readback;
+        EPixelFormat Format = PF_Unknown;
+        void* OSWindow = nullptr;
+        FVector2D WindowTopLeft = FVector2D::ZeroVector;
+        FVector2D WindowBottomRight = FVector2D::ZeroVector;
+    };
+    mutable FCriticalSection Mutex;
+    FSlot Slots[Capacity];
+    FHCR3ViewportCaptureStats Stats;
+    FDelegateHandle EndFrameHandle;
+    const void* TargetWindow = nullptr;
+    uint64 LastRequestedEngineFrame = 0;
+    uint64 NextDeliveryTicket = 1;
+    uint64 LastCopiedTicket = 0;
+    uint64 LastCopyEngineCounterRT = 0;
+    uint32 LastCopiedRenderFrame = MAX_uint32;
+    TArray<FHCR3ViewportPresentEvidence> PresentEvidence;
+    bool bStarted = false;
+    bool bStopArmedRT = false;
+    bool bPollQueued = false;
+
+    void RecordExtraPresent(bool bRepeated, int32 ArmedSlots, bool bNonConsuming, const TCHAR* Classification)
+    {
+        // Cumulative diagnostic evidence is bounded separately from the eight GPU slots.
+        if (PresentEvidence.Num() >= 32768) { ++Stats.PresentEvidenceOverflow; return; }
+        auto& Event = PresentEvidence.AddDefaulted_GetRef();
+        Event.Callback = Stats.TargetPresentCallbacks;
+        Event.EngineCounterRT = GFrameCounterRenderThread;
+        Event.RenderFrame = GFrameNumberRenderThread;
+        Event.WallSeconds = FPlatformTime::Seconds();
+        Event.LastCopiedTicket = LastCopiedTicket;
+        Event.LastCopyEngineCounterRT = LastCopyEngineCounterRT;
+        Event.LastCopyRenderFrame = LastCopiedRenderFrame;
+        Event.CopiesBefore = Event.CopiesAfter = Stats.CopySubmitted;
+        Event.ArmedSlots = ArmedSlots;
+        Event.bRepeatedRenderFrame = bRepeated;
+        Event.bStopRequested = Stats.bStopRequested;
+        Event.bStopArmedRT = bStopArmedRT;
+        Event.bNonConsuming = bNonConsuming;
+        Event.Classification = Classification;
+        static const TCHAR* PhaseNames[] = {TEXT("Free"), TEXT("Queued"), TEXT("Armed"), TEXT("CopyPending"), TEXT("Ready"), TEXT("Failed")};
+        for (int32 I = 0; I < Capacity; ++I)
+        {
+            const auto& Slot = Slots[I];
+            auto& Evidence = Event.Slots.AddDefaulted_GetRef();
+            Evidence.Slot = I;
+            Evidence.Phase = PhaseNames[int32(Slot.Phase)];
+            if (Slot.Phase != EPhase::Free)
+            {
+                Evidence.Ticket = Slot.Frame.Ticket;
+                Evidence.RequestEngineFrame = Slot.Frame.Request.EngineFrame;
+                Evidence.ArmEngineCounterRT = Slot.Frame.ArmEngineCounterRT;
+                Evidence.ArmRenderFrame = Slot.Frame.ArmRenderFrame;
+                Evidence.bCopySubmitted = Slot.Frame.bCopySubmitted;
+            }
+        }
+        ++Stats.PresentEvidenceEvents;
+    }
+
+    void Fail(FSlot& Slot, const TCHAR* Reason)
+    {
+        Slot.Frame.Status = Reason;
+        Slot.Frame.Pixels.Reset();
+        Slot.Phase = EPhase::Failed;
+        ++Stats.Failed;
+    }
+
+    void CollectReadyRT()
+    {
+        check(IsInRenderingThread());
+        for (FSlot& Slot : Slots)
+        {
+            if (Slot.Phase != EPhase::CopyPending || !Slot.Readback->IsReady()) continue;
+            int32 Pitch = 0, Rows = 0;
+            const uint8* Source = static_cast<const uint8*>(Slot.Readback->Lock(Pitch, &Rows));
+            Slot.Frame.RowPitchPixels = Pitch;
+            Slot.Frame.StagingRows = Rows;
+            Slot.Frame.ReadyRenderFrame = GFrameNumberRenderThread;
+            Slot.Frame.ReadyWallSeconds = FPlatformTime::Seconds();
+            if (!Source || Pitch < Width || Rows < Height)
+            {
+                if (Source) Slot.Readback->Unlock();
+                Fail(Slot, TEXT("FAILED_READBACK_POINTER_OR_PITCH"));
+                continue;
+            }
+            Slot.Frame.Pixels.SetNumUninitialized(Width * Height);
+            if (Slot.Format == PF_A2B10G10R10)
+            {
+                // Native UNORM requantization only. Source is already display-encoded SDR.
+                ConvertRawR10G10B10A2DataToFColor(Width, Height, const_cast<uint8*>(Source),
+                    uint32(Pitch) * 4, Slot.Frame.Pixels.GetData());
+            }
+            else for (int32 Y = 0; Y < Height; ++Y)
+            {
+                FColor* Destination = Slot.Frame.Pixels.GetData() + Y * Width;
+                const uint8* Row = Source + int64(Y) * Pitch * 4;
+                if (Slot.Format == PF_B8G8R8A8) FMemory::Memcpy(Destination, Row, Width * sizeof(FColor));
+                else for (int32 X = 0; X < Width; ++X)
+                    Destination[X] = FColor(Row[X * 4], Row[X * 4 + 1], Row[X * 4 + 2], Row[X * 4 + 3]);
+            }
+            Slot.Readback->Unlock();
+            Slot.Frame.Status = Slot.Frame.bEngineCounterEqualsRequest ? TEXT("READ_BACK_SAME_RT_ARM_AND_PRESENT") :
+                TEXT("READ_BACK_GT_RT_COUNTER_AGREEMENT_UNVERIFIED");
+            Slot.Phase = EPhase::Ready;
+            ++Stats.Ready;
+        }
+    }
+
+    void Present(SWindow& SlateWindow, ISlateViewportProvider& Provider)
+    {
+        check(IsInRenderingThread());
+        if (&SlateWindow != TargetWindow) return;
+        FScopeLock Lock(&Mutex);
+        if (Stats.bClosed) return;
+        ++Stats.TargetPresentCallbacks;
+        CollectReadyRT();
+        const bool bRepeated = LastCopiedTicket > 0 && LastCopiedRenderFrame == GFrameNumberRenderThread;
+        Stats.DuplicatePresentCallbacks += bRepeated;
+        int32 ArmedSlots = 0;
+        for (const auto& Slot : Slots) ArmedSlots += Slot.Phase == EPhase::Armed;
+        if (ArmedSlots == 0)
+        {
+            RecordExtraPresent(bRepeated, ArmedSlots, true, TEXT("NO_ARMED_TICKET_NO_COPY_OR_REQUEST_CONSUMPTION"));
+            ++Stats.NonConsumingPresentCallbacks;
+            Stats.NonConsumingDuplicateCallbacks += bRepeated;
+            return;
+        }
+        if (bRepeated || ArmedSlots != 1)
+        {
+            ++Stats.InvalidPresentCallbacks;
+            RecordExtraPresent(bRepeated, ArmedSlots, false, TEXT("FAILED_REPEATED_COPY_OR_MULTIPLE_ARMED_TICKETS"));
+            for (auto& Slot : Slots) if (Slot.Phase == EPhase::Armed)
+                Fail(Slot, TEXT("FAILED_REPEATED_COPY_OR_MULTIPLE_ARMED_TICKETS"));
+            return;
+        }
+        for (FSlot& Slot : Slots)
+        {
+            if (Slot.Phase != EPhase::Armed) continue;
+            Slot.Frame.CopyEngineCounterRT = GFrameCounterRenderThread;
+            Slot.Frame.CopyRenderFrame = GFrameNumberRenderThread;
+            Slot.Frame.CopyWallSeconds = FPlatformTime::Seconds();
+            Slot.Frame.bSameArmAndPresentFrame = Slot.Frame.HasExactArmPresentBinding();
+            if (!Slot.Frame.bSameArmAndPresentFrame)
+            {
+                Fail(Slot, TEXT("FAILED_PRESENT_NOT_IN_ARMED_RENDER_FRAME"));
+                continue;
+            }
+            if (Slot.Frame.Ticket != Stats.CopySubmitted + 1)
+            {
+                Fail(Slot, TEXT("FAILED_COPY_TICKET_ORDER; NO_REORDER_OR_DUPLICATE_COPY"));
+                continue;
+            }
+            const FTextureRHIRef Texture = Provider.GetBackBufferResource();
+            if (!Texture || Texture->GetSizeX() != Width || Texture->GetSizeY() != Height || Texture->IsMultisampled())
+            {
+                Fail(Slot, TEXT("FAILED_BACKBUFFER_SIZE_OR_MULTISAMPLE; NO_RESIZE_OR_CROP"));
+                continue;
+            }
+            const EPixelFormat Format = Texture->GetFormat();
+            Slot.Frame.SourcePixelFormat = int32(Format);
+            Slot.Frame.Size = FIntPoint(Texture->GetSizeX(), Texture->GetSizeY());
+            Slot.Frame.bSourceSRGB = EnumHasAnyFlags(Texture->GetFlags(), ETextureCreateFlags::SRGB);
+            if (Format != PF_B8G8R8A8 && Format != PF_R8G8B8A8 && Format != PF_A2B10G10R10)
+            {
+                Fail(Slot, TEXT("FAILED_UNSUPPORTED_BACKBUFFER; ONLY_8BIT_OR_1010102_UNORM_SDR"));
+                continue;
+            }
+            Slot.Frame.PresentWindowColor = ReadWindowColorProfile(SlateWindow.GetIsHDR(), Slot.OSWindow,
+                Slot.WindowTopLeft, Slot.WindowBottomRight);
+            Slot.Frame.bColorConversionVerified = !Slot.Frame.bViewportHDR &&
+                Slot.Frame.ViewportOutputFormat == int32(EDisplayOutputFormat::SDR_sRGB) &&
+                Slot.Frame.ViewportColorGamut == int32(EDisplayColorGamut::sRGB_D65) &&
+                Slot.Frame.RequestWindowColor.IsVerifiedSDRsRGB() && Slot.Frame.PresentWindowColor.IsVerifiedSDRsRGB();
+            if (!Slot.Frame.bColorConversionVerified)
+            {
+                Fail(Slot, TEXT("FAILED_HDR_OR_UNVERIFIED_SDR_SRGB_TRANSFER; NO_IMPLICIT_TONEMAPPING"));
+                continue;
+            }
+            Slot.Frame.ColorConversion = Format == PF_A2B10G10R10 ?
+                TEXT("UE_ConvertRawR10G10B10A2DataToFColor; R=bits0..9,G=10..19,B=20..29,A=30..31; round(UNORM*255); no gamma/gamut/tone-map") :
+                TEXT("8BIT_DISPLAY_ENCODED_SRGB_CHANNEL_COPY; no gamma/gamut/tone-map");
+            if (!Slot.Readback || Slot.Format != Format)
+            {
+                Slot.Readback = MakeUnique<FRHIGPUTextureReadback>(TEXT("HCR3ViewportAsync"));
+                Slot.Format = Format;
+            }
+            auto& Commands = FRHICommandListExecutor::GetImmediateCommandList();
+            Commands.Transition(FRHITransitionInfo(Texture, ERHIAccess::Unknown, ERHIAccess::CopySrc));
+            Slot.Readback->EnqueueCopy(Commands, Texture);
+            Commands.Transition(FRHITransitionInfo(Texture, ERHIAccess::CopySrc, ERHIAccess::Present));
+            Slot.Frame.bCopySubmitted = true;
+            Slot.Frame.CopyOrdinal = Stats.CopySubmitted + 1;
+            Slot.Frame.Status = TEXT("PENDING_GPU_READBACK");
+            Slot.Phase = EPhase::CopyPending;
+            ++Stats.CopySubmitted;
+            LastCopiedTicket = Slot.Frame.Ticket;
+            LastCopyEngineCounterRT = GFrameCounterRenderThread;
+            LastCopiedRenderFrame = GFrameNumberRenderThread;
+            break;
+        }
+    }
+
+    void EndFrameRT()
+    {
+        check(IsInRenderingThread());
+        FScopeLock Lock(&Mutex);
+        CollectReadyRT();
+        for (FSlot& Slot : Slots)
+            if (Slot.Phase == EPhase::Armed)
+                Fail(Slot, TEXT("FAILED_NO_TARGET_PRESENT_BEFORE_RENDER_END; NO_NEXT_FRAME_SUBSTITUTION"));
+        if (bStopArmedRT) Stats.bRenderStopBoundaryObserved = true;
+    }
+};
