+        if(GetWorld()->GetTimeSeconds()>=S->NextFlush){Flush();S->NextFlush=GetWorld()->GetTimeSeconds()+1;}
+    };
+    for(int32 Direction=0;Direction<2;++Direction)
+    {
+        AddStep(TEXT("R3 bridge independent direction start setup"),2,[this,S,Direction]
+        {
+            if(!S->Ready)return;
+            S->Route=Direction;S->Ready=IsOnFoot();S->Entered=false;
+            if(!RequireCamera(TEXT("R3 bridge start on foot"),S->Ready,TEXT("previous leg exited through ordinary E"),State(),TEXT("A")))return;
+            const auto& Points=S->Routes[Direction];const float Yaw=(Points[1]-Points[0]).Rotation().Yaw;
+            FHitResult Floor;FCollisionQueryParams Q(SCENE_QUERY_STAT(R3BridgeStart),false,Character);Q.AddIgnoredActor(Car);
+            const bool Ground=GetWorld()->LineTraceSingleByChannel(Floor,Points[0]+FVector(0,0,120),Points[0]-FVector(0,0,180),ECC_WorldStatic,Q);
+            if(!RequireCamera(TEXT("R3 bridge actual start road"),Ground&&!Floor.bStartPenetrating,
+                TEXT("existing road collision, no endpoint or in-route teleport"),GetPathNameSafe(Floor.GetComponent()),TEXT("A setup only")))return;
+            PlaceCar(FTransform(FRotator(0,Yaw,0),Floor.ImpactPoint+FVector(0,0,90)));
+        });
+        AddStep(TEXT("R3 bridge driver safe door setup"),.5,[this,S]
+        {
