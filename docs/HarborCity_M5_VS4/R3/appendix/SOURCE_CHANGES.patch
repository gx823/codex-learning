diff --git a/HarborCity/Source/HarborCity/M1/HCM1TestM5VS4R3Diagnostics.cpp b/HarborCity/Source/HarborCity/M1/HCM1TestM5VS4R3Diagnostics.cpp
--- /dev/null
+++ b/HarborCity/Source/HarborCity/M1/HCM1TestM5VS4R3Diagnostics.cpp
@@ -0,0 +1,98 @@
+#include "HCM1TestRunner.h"
+#include "HCM1Character.h"
+#include "HCM1PlayerController.h"
+#include "M3/HCM3NavRegion.h"
+#include "M5VS2/HCM5VS2CornerTimeDirector.h"
+#include "M5VS3/HCM5VS3QA.h"
+#include "Camera/CameraActor.h"
+#include "Camera/CameraComponent.h"
+#include "EngineUtils.h"
+#include "HAL/IConsoleManager.h"
+#include "Misc/CommandLine.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Parse.h"
+
+bool AHCM1TestRunner::AddM5VS4R3Diagnostics()
+{
+    FString Kind;
+    FParse::Value(FCommandLine::Get(), TEXT("R4Case="), Kind);
+    if(Kind==TEXT("r3combatcoverage"))
+    {
+        if(!HCM5VS3LocalQA()||!FParse::Param(FCommandLine::Get(),TEXT("VS4R3Capture")))return false;
+        AddStep(TEXT("R3 combat coverage preflight scope"),.1,[this]
+        {
+            RequireCamera(TEXT("R3 combat coverage actual map"),GetWorld()->GetMapName()==TEXT("L_CapitalR2"),
+                TEXT("Capital; focused preflight, never full-regression evidence"),GetWorld()->GetOutermost()->GetName(),TEXT("A native map"));
+            FFileHelper::SaveStringToFile(TEXT("FOCUSED_PREFLIGHT_ONLY\nReuses combat and coverage steps; no story, save or full-regression acceptance. All resulting failures retained.\n"),*(RunDirectory/TEXT("R3_PREFLIGHT_SCOPE.txt")));
+        });
+        const FString OriginalMode=Mode;Mode=TEXT("m5_vs3_combat");AddM5VS3Tests();Mode=OriginalMode;
+        AddM5VS3R6Coverage();
+        return true;
+    }
+    if (Kind != TEXT("r3lumen")) return false;
+    auto Camera = MakeShared<TWeakObjectPtr<ACameraActor>>();
+    AddStep(TEXT("R3 Lumen diagnostic native setup"), 12, [this, Camera]
+    {
+        if (!RequireCamera(TEXT("R3 Lumen actual map"), GetWorld()->GetMapName() == TEXT("L_CapitalR2"),
+            TEXT("unchanged Capital, diagnostic only"), GetWorld()->GetOutermost()->GetName(), TEXT("A actual map"))) return;
+        for (TActorIterator<AHCM5VS2CornerTimeDirector> I(GetWorld()); I; ++I) I->SetTimeOfDay(TEXT("Afternoon"));
+        *Camera = GetWorld()->SpawnActor<ACameraActor>();
+        Camera->Get()->Tags.Add(TEXT("VS4FixedReviewCamera"));
+        Camera->Get()->GetCameraComponent()->SetFieldOfView(70);
+        PC->SetViewTarget(Camera->Get());
+    });
+    for (const bool Indoor : {false, true})
+    {
+        const FString Place = Indoor ? TEXT("GUILD") : TEXT("PLAZA");
+        AddStep(TEXT("R3 fixed GI inspection pose"), 5, [this, Camera, Indoor]
+        {
+            if (!Camera->IsValid()) return;
+            FVector Position(-1100, 2900, 730), Target(-2200, 1900, 720);
+            if (Indoor)
+            {
+                AHCM3NavRegion* Room = nullptr;
+                for (TActorIterator<AHCM3NavRegion> I(GetWorld()); I; ++I)
+                    if (I->StableId == TEXT("VS2_Guild")) Room = *I;
+                if (!RequireCamera(TEXT("R3 native guild GI region"), Room != nullptr,
+                    TEXT("VS2_Guild"), GetNameSafe(Room), TEXT("A diagnostic anchor"))) return;
+                const FTransform T = Room->GetActorTransform();
+                Position = T.TransformPosition(FVector(-500, 70, 180));
+                Target = T.TransformPosition(FVector(200, 0, 155));
+            }
+            Camera->Get()->SetActorLocation(Position);
+            Camera->Get()->SetActorRotation((Target - Position).Rotation());
+        });
+        for (const int32 VisualizationMode : {0, 3, 5})
+        {
+            const FString Name = FString::Printf(TEXT("R3_A_LUMEN_%s_%d"), *Place, VisualizationMode);
+            AddStep(Name + TEXT(" warmup"), 5, [this, VisualizationMode]
+            {
+                auto* Variable = IConsoleManager::Get().FindConsoleVariable(TEXT("r.Lumen.Visualize"));
+                if (RequireCamera(TEXT("R3 native Lumen visualization available"), Variable != nullptr,
+                    TEXT("local UE renderer cvar"), Variable ? TEXT("present") : TEXT("missing"), TEXT("A no renderer setting change")))
+                    Variable->Set(VisualizationMode, ECVF_SetByCode);
+            }, [this, Camera, VisualizationMode, Name]
+            {
+                if (!Camera->IsValid()) return;
+                FString Text = FString::Printf(TEXT("actual_map=%s\nvisualization_mode=%d\ncamera=%s\nrotation=%s\n"),
+                    *GetWorld()->GetOutermost()->GetName(), VisualizationMode, *Camera->Get()->GetActorLocation().ToString(), *Camera->Get()->GetActorRotation().ToString());
+                for (const TCHAR* VariableName : {TEXT("r.GenerateMeshDistanceFields"), TEXT("r.DynamicGlobalIlluminationMethod"),
+                    TEXT("r.ReflectionMethod"), TEXT("r.Lumen.DiffuseIndirect.Allow"), TEXT("r.Lumen.Reflections.Allow"),
+                    TEXT("r.Lumen.TraceMeshSDFs"), TEXT("r.AllowStaticLighting"), TEXT("r.ScreenPercentage"),
+                    TEXT("sg.GlobalIlluminationQuality"), TEXT("sg.ReflectionQuality")})
+                    if (const auto* V = IConsoleManager::Get().FindConsoleVariable(VariableName))
+                        Text += FString::Printf(TEXT("%s=%.6f\n"), VariableName, V->GetFloat());
+                FFileHelper::SaveStringToFile(Text, *(RunDirectory / (Name + TEXT(".txt"))));
+                Capture(Name);
+            });
+            AddM3CaptureCompletion(Name);
+        }
+    }
+    AddStep(TEXT("R3 GI diagnostic cleanup"), .2, [this, Camera]
+    {
+        if (auto* V = IConsoleManager::Get().FindConsoleVariable(TEXT("r.Lumen.Visualize"))) V->Set(0, ECVF_SetByCode);
+        PC->SetViewTarget(Character);
+        if (Camera->IsValid()) Camera->Get()->Destroy();
+    });
+    return true;
+}
