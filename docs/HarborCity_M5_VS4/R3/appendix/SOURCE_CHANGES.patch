+#pragma once
+
+#include "CoreMinimal.h"
+#include "GameFramework/Actor.h"
+#include "M1/HCInteractable.h"
+#include "HCM5VS4R3Door.generated.h"
+
+class USceneComponent;
+class UStaticMeshComponent;
+
+// The actor origin is the interaction point, not necessarily the mesh pivot.
+UCLASS(Blueprintable)
+class HARBORCITY_API AHCM5VS4R3Door : public AActor, public IHCInteractable
+{
+    GENERATED_BODY()
+public:
+    AHCM5VS4R3Door();
+
+    virtual void Tick(float DeltaSeconds) override;
+    virtual FString GetInteractionText_Implementation(APlayerController* Player) const override;
+    virtual void Interact_Implementation(APlayerController* Player) override;
+
+    UFUNCTION(BlueprintCallable, Category="HarborCity|Door")
+    bool SetDoorOpen(bool bOpen);
+
+    UFUNCTION(BlueprintCallable, CallInEditor, Category="HarborCity|Door")
+    void RefreshDoorPose();
+
+    UFUNCTION(BlueprintPure, Category="HarborCity|Door")
+    bool IsDoorConfigured() const;
+
+    UFUNCTION(BlueprintPure, Category="HarborCity|Door")
+    bool IsDoorMoving() const;
+
+    UFUNCTION(BlueprintPure, Category="HarborCity|Door")
+    float GetOpenFraction() const { return OpenFraction; }
+
+    UFUNCTION(BlueprintPure, Category="HarborCity|Door")
+    bool IsOpenRequested() const { return bOpenRequested; }
+
+    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="HarborCity|Door")
+    TObjectPtr<USceneComponent> InteractionRoot;
+
+    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="HarborCity|Door")
+    TObjectPtr<UStaticMeshComponent> DoorLeaf;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    FName StableId;
+
+    // Empty for single doors; a double doorway links its other complete leaf.
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    TArray<TObjectPtr<AHCM5VS4R3Door>> PairedLeaves;
+
+    // All three fields are in the actor's local space. No inferred hinge.
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    FTransform ClosedLeafTransform = FTransform::Identity;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    FVector HingeLocation = FVector::ZeroVector;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    FVector HingeAxis = FVector::UpVector;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    bool bHingeConfigured = false;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door", meta=(ClampMin="-175", ClampMax="175"))
+    float OpenAngleDegrees = 90.0f;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door", meta=(ClampMin="0.05"))
+    float OpenDurationSeconds = 0.35f;
+
+    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="HarborCity|Door")
+    bool bStartOpen = false;
+
+protected:
+    virtual void OnConstruction(const FTransform& Transform) override;
+    virtual void BeginPlay() override;
+
+private:
+    UPROPERTY(Transient) float OpenFraction = 0.0f;
+    UPROPERTY(Transient) bool bOpenRequested = false;
+    void ApplyLeafPose();
+};
diff --git a/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3FilmWarmup.h b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3FilmWarmup.h
--- /dev/null
+++ b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3FilmWarmup.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#if WITH_EDITOR
+#include "ShaderCompiler.h"
+#include "AssetCompilingManager.h"
+#endif
+
+struct FHCM5VS4R3CompileJobs
+{
+    int32 ShaderJobs=0,AssetJobs=0;
+    bool bShaderCompiling=false,bEditorCounters=false;
+    bool Busy() const { return bShaderCompiling||ShaderJobs>0||AssetJobs>0; }
+    static FHCM5VS4R3CompileJobs Read()
+    {
+        FHCM5VS4R3CompileJobs Jobs;
+#if WITH_EDITOR
+        Jobs.bEditorCounters=true;
+        if(GShaderCompilingManager)
+        {
+            Jobs.ShaderJobs=GShaderCompilingManager->GetNumRemainingJobs();
+            // RemainingJobs alone excludes queued/finalizing shader maps.
+            Jobs.bShaderCompiling=GShaderCompilingManager->IsCompiling();
+        }
+        Jobs.AssetJobs=FAssetCompilingManager::Get().GetNumRemainingAssets();
+#endif
+        return Jobs;
+    }
+};
+
+struct FHCM5VS4R3FilmWarmup
+{
+    static constexpr double QuietSeconds=2.,MaximumWaitSeconds=120.,MaximumObservationGap=.25;
+    double WaitStarted=0,QuietSince=-1,LastObserved=-1;
+    bool bReady=false,bTimedOut=false,bGateOpened=false,bWarmupRouteValid=true;
+    int32 WarmupLegs=0,RecordingFrames=0,RecordingBusyFrames=0,ShaderPeak=0,AssetPeak=0;
+    uint64 LastJobFrame=MAX_uint64,FirstRecordingBusyFrame=MAX_uint64;
+    FString CSV=TEXT("engine_frame,world_seconds,wall_seconds,phase,recording_gate_open,editor_counters,shader_jobs,shader_compiling,asset_jobs\n");
+
+    void BeginQuiet(double Now)
+    { WaitStarted=Now;QuietSince=LastObserved=-1;bReady=bTimedOut=false; }
+
+    void ObserveQuiet(double Now,const FHCM5VS4R3CompileJobs& Jobs,bool bFocused)
+    {
+        const bool Gap=LastObserved>=0&&(Now<LastObserved||Now-LastObserved>MaximumObservationGap);
+        if(!bFocused||Jobs.Busy()||Gap)QuietSince=-1;
+        if(bFocused&&!Jobs.Busy()&&QuietSince<0)QuietSince=Now;
+        LastObserved=Now;
+        bReady=QuietSince>=0&&Now-QuietSince>=QuietSeconds;
+        bTimedOut=!bReady&&Now-WaitStarted>=MaximumWaitSeconds;
+    }
+};
diff --git a/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Geometry.cpp b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Geometry.cpp
