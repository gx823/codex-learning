+}
+bool InteriorLeafPairsValid(const TArray<TWeakObjectPtr<AHCM5VS4R3Door>>& Doors)
+{
+    if(Doors.Num()<1||Doors.Num()>2)return false;
+    for(int32 I=0;I<Doors.Num();++I)
+    {
+        auto* Door=Doors[I].Get();
