+        if(BoundShapes!=1){Missing(TEXT("COMPLEX_HEIGHTFIELD_NOT_UNIQUELY_BOUND_TO_IDENTITY_LOCAL_BODY_SHAPE"));return;}
+        const FTransform BodyPose=FPhysicsInterface::GetGlobalPose_AssumesLocked(Handle);
+        const FVector Scale=HF->GeomData.Scale;
