@@ -0,0 +1,652 @@
+#include "HCM5VS4R3ViewportCapture.h"
+
+#include "Framework/Application/SlateApplication.h"
+#include "GenericPlatform/GenericWindow.h"
+#include "HAL/IConsoleManager.h"
