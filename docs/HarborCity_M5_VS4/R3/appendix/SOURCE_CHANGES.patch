+                {Fail(TEXT("ownership/upright/forward-only or verified steering contract failed"));return;}
+                const FVector P=Car->GetActorLocation();S->Travel+=FVector::Dist2D(P,S->Previous);S->Previous=P;
+                int32 Contacts=0;double ContactZ=0;
+                for(int32 I=0;I<M->Wheels.Num();++I){const auto& W=M->GetWheelState(I);if(W.bInContact){++Contacts;ContactZ+=W.ContactPoint.Z;}}
