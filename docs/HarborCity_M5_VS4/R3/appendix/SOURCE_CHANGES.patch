+    ++Frame.CopyRenderFrame;
+    TestFalse(TEXT("No next render-frame substitution"), Frame.HasExactArmPresentBinding());
+    --Frame.CopyRenderFrame;
+    ++Frame.CopyEngineCounterRT;
