+            if(!Component||!Component->IsVisible()||Component->GetOwner()->IsHidden()||!Component->GetStaticMesh())continue;
+            const FBox LocalBox=Component->GetStaticMesh()->GetBoundingBox();
+            auto Near=[&](const FTransform& Pose)
+            {
+                const FVector Scale=Pose.GetScale3D().GetAbs();
+                const double MinimumScale=Scale.GetMin();
+                if(MinimumScale<=SMALL_NUMBER)return false;
