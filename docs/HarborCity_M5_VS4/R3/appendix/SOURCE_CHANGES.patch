+        const bool bRestored=R3ObjectFade->Restore();
+        const FString Diagnostics=R3ObjectFade->Diagnostics();
+        if(bRestored){UE_LOG(LogTemp,Display,TEXT("R3_OBJECT_FADE_ENDPLAY restored=1 %s"),*Diagnostics);}
+        else {UE_LOG(LogTemp,Error,TEXT("R3_OBJECT_FADE_ENDPLAY restored=0 %s"),*Diagnostics);}
+    }
+    R3ObjectFade.Reset();
+    for(const auto& State:R3CameraOnlyWindows)if(auto* C=State.Component.Get())
+    {C->SetCollisionProfileName(State.Profile);C->SetCollisionResponseToChannels(State.Responses);C->SetCollisionEnabled(ECollisionEnabled::NoCollision);}
+    R3CameraOnlyWindows.Reset();
+    R3CompactCameraOccluders.Reset();
+    R3PreloadedHeroFadeMaterials.Reset();
+    Super::EndPlay(EndPlayReason);
+}
