+void AttachStaticSections(const FJson& Result, UStaticMesh* Mesh)
+{
+    TArray<TSharedPtr<FJsonValue>> Slots, Sections;
+    for (int32 I = 0; I < Mesh->GetStaticMaterials().Num(); ++I)
+    {
+        auto Slot = MaterialRecord(Mesh->GetMaterial(I));
+        Slot->SetNumberField(TEXT("material_slot"), I);
+        Slots.Add(MakeShared<FJsonValueObject>(Slot));
+    }
+    Result->SetArrayField(TEXT("asset_material_slots"), Slots);
+    const FStaticMeshRenderData* Render = Mesh->GetRenderData();
+    if (!Render || !Render->LODResources.IsValidIndex(0)) return;
+    int32 I = 0;
+    for (const FStaticMeshSection& Section : Render->LODResources[0].Sections)
+    {
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetNumberField(TEXT("section_index"), I++);
+        Row->SetNumberField(TEXT("material_slot"), Section.MaterialIndex);
+        Row->SetNumberField(TEXT("first_index"), Section.FirstIndex);
+        Row->SetNumberField(TEXT("triangle_count"), Section.NumTriangles);
+        Row->SetStringField(TEXT("material_binding"), TEXT("Component override at material_slot, otherwise asset_material_slots; native inventory records effective component binding"));
+        Sections.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    Result->SetArrayField(TEXT("sections"), Sections);
+}
+
+void AttachLandscapeSurface(const FJson& Result, ULandscapeComponent* Component)
+{
+    Result->SetObjectField(TEXT("landscape_material"), MaterialRecord(Component->GetLandscapeMaterial(0)));
+    Result->SetObjectField(TEXT("landscape_hole_material"), MaterialRecord(Component->GetLandscapeHoleMaterial()));
+    TArray<TSharedPtr<FJsonValue>> Materials, Allocations;
+    for (int32 I = 0; I < Component->GetMaterialInstanceCount(); ++I)
+    {
+        auto Material = MaterialRecord(Component->GetMaterialInstance(I));
+        Material->SetNumberField(TEXT("generated_instance_index"), I);
+        Materials.Add(MakeShared<FJsonValueObject>(Material));
+    }
+    Result->SetArrayField(TEXT("landscape_generated_material_instances"), Materials);
+    const auto& Layers = Component->GetWeightmapLayerAllocations(false);
+    const auto& Textures = Component->GetWeightmapTextures(false);
+    ULandscapeLayerInfoObject* Visibility = Component->GetVisibilityLayer();
+    const FWeightmapLayerAllocationInfo* VisibilityAllocation = nullptr;
+    for (const FWeightmapLayerAllocationInfo& Layer : Layers)
+    {
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetStringField(TEXT("layer_info"), Layer.LayerInfo ? Layer.LayerInfo->GetPathName() : TEXT(""));
+        Row->SetNumberField(TEXT("texture_index"), Layer.WeightmapTextureIndex);
+        Row->SetNumberField(TEXT("texture_channel_rgba"), Layer.WeightmapTextureChannel);
+        Row->SetBoolField(TEXT("is_visibility_layer"), Visibility && Layer.LayerInfo == Visibility);
+        UTexture2D* Texture = Textures.IsValidIndex(Layer.WeightmapTextureIndex) ? Textures[Layer.WeightmapTextureIndex].Get() : nullptr;
+        Row->SetStringField(TEXT("texture"), Texture ? Texture->GetPathName() : TEXT(""));
+        Allocations.Add(MakeShared<FJsonValueObject>(Row));
+        if (Visibility && Layer.LayerInfo == Visibility) VisibilityAllocation = &Layer;
+    }
+    Result->SetArrayField(TEXT("composed_weightmap_allocations"), Allocations);
+    auto Holes = MakeShared<FJsonObject>();
+    Holes->SetStringField(TEXT("source"), TEXT("Native composed weightmap Mip0; editor source, not runtime shader clipping"));
+    Holes->SetStringField(TEXT("status"), TEXT("NOT_RUN_VISIBILITY_LAYER_OR_SOURCE_UNAVAILABLE"));
+    Holes->SetStringField(TEXT("runtime_hole_surface"), TEXT("NOT_RUN_SHADER_VISIBILITY_CLIP_NOT_EVALUATED"));
+    Result->SetObjectField(TEXT("landscape_visibility"), Holes);
+    Result->SetStringField(TEXT("visibility_holes"), TEXT("NOT_RUN_RUNTIME_CLIP; full Mip0 grid retained, see landscape_visibility"));
+    if (!Visibility) return;
+    Holes->SetStringField(TEXT("visibility_layer"), Visibility->GetPathName());
+    Holes->SetBoolField(TEXT("visibility_allocation_present"), VisibilityAllocation != nullptr);
+    if (!VisibilityAllocation)
+    {
+        Holes->SetStringField(TEXT("status"), TEXT("READ_NATIVE_NO_VISIBILITY_ALLOCATION"));
+        Holes->SetNumberField(TEXT("nonzero_source_samples"), 0);
+        return;
+    }
+    if (!Textures.IsValidIndex(VisibilityAllocation->WeightmapTextureIndex) || VisibilityAllocation->WeightmapTextureChannel > 3) return;
+    UTexture2D* Texture = Textures[VisibilityAllocation->WeightmapTextureIndex];
+    UTexture2D* Heightmap = Component->GetHeightmap(false);
+    if (!Texture || !Heightmap || !Heightmap->Source.IsValid() || !Texture->Source.IsValid() || Texture->Source.GetFormat() != TSF_BGRA8) return;
+    const int32 TextureSide = (Component->SubsectionSizeQuads + 1) * Component->NumSubsections;
+    const int32 Side = Component->ComponentSizeQuads + 1;
+    if (Texture->Source.GetSizeX() != TextureSide || Texture->Source.GetSizeY() != TextureSide || Side <= 1 || Side > 1025) return;
+    TArray64<uint8> Bytes;
+    if (!Texture->Source.GetMipData(Bytes, 0) || Bytes.Num() != int64(TextureSide) * TextureSide * sizeof(FColor)) return;
+    // The engine's own subsection mapping removes duplicated boundary texels.
+    FLandscapeComponentDataInterfaceBase Mapping(Component, 0, false);
+    const int32 Offsets[] = {STRUCT_OFFSET(FColor, R), STRUCT_OFFSET(FColor, G), STRUCT_OFFSET(FColor, B), STRUCT_OFFSET(FColor, A)};
+    TArray<TSharedPtr<FJsonValue>> Values;
+    Values.Reserve(Side * Side);
+    int32 Nonzero = 0;
+    for (int32 I = 0; I < Side * Side; ++I)
+    {
+        const int64 Offset = int64(Mapping.VertexIndexToTexel(I)) * sizeof(FColor) + Offsets[VisibilityAllocation->WeightmapTextureChannel];
+        if (!Bytes.IsValidIndex(Offset)) return;
+        const uint8 Value = Bytes[Offset];
+        Nonzero += Value != 0;
+        Values.Add(MakeShared<FJsonValueNumber>(Value));
+    }
+    Holes->SetStringField(TEXT("status"), TEXT("EXPORTED_SOURCE_VISIBILITY_MASK"));
+    Holes->SetStringField(TEXT("texture"), Texture->GetPathName());
+    Holes->SetNumberField(TEXT("side"), Side);
+    Holes->SetNumberField(TEXT("nonzero_source_samples"), Nonzero);
+    Holes->SetArrayField(TEXT("vertex_values_uint8"), Values);
+}
+
+bool AttachGeometry(const FJson& Object, const TArray<FVector>& Positions, const TArray<uint32>& Indices)
+{
+    if (Positions.IsEmpty() || Indices.IsEmpty() || Indices.Num() % 3 != 0) return false;
+    TArray<TSharedPtr<FJsonValue>> Vertices, Triangles;
+    Vertices.Reserve(Positions.Num());
+    Triangles.Reserve(Indices.Num() / 3);
+    for (const FVector& P : Positions)
+    {
+        if (P.ContainsNaN()) return false;
+        TArray<TSharedPtr<FJsonValue>> XYZ = {MakeShared<FJsonValueNumber>(P.X), MakeShared<FJsonValueNumber>(P.Y), MakeShared<FJsonValueNumber>(P.Z)};
+        Vertices.Add(MakeShared<FJsonValueArray>(MoveTemp(XYZ)));
+    }
+    for (int32 I = 0; I < Indices.Num(); I += 3)
+    {
+        TArray<TSharedPtr<FJsonValue>> Face;
+        for (int32 J = 0; J < 3; ++J)
+        {
+            if (Indices[I + J] >= uint32(Positions.Num())) return false;
+            Face.Add(MakeShared<FJsonValueNumber>(Indices[I + J]));
+        }
+        Triangles.Add(MakeShared<FJsonValueArray>(MoveTemp(Face)));
+    }
+    Object->SetArrayField(TEXT("vertices_cm"), Vertices);
+    Object->SetArrayField(TEXT("triangles"), Triangles);
+    Object->SetNumberField(TEXT("vertex_count"), Positions.Num());
+    Object->SetNumberField(TEXT("triangle_count"), Indices.Num() / 3);
+    Object->SetStringField(TEXT("status"), TEXT("EXPORTED"));
+    return true;
+}
