+            FHCM3NPCState Start=Original,End=Original;Start.PatrolIndex=0;End.PatrolIndex=0;
+            Start.Transform.SetLocation(S->NPCPoints[0]+FVector(0,0,N->GetCapsuleComponent()->GetScaledCapsuleHalfHeight()+3));
+            End.Transform.SetLocation(S->NPCPoints[1]+FVector(0,0,N->GetCapsuleComponent()->GetScaledCapsuleHalfHeight()+3));
