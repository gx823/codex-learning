+bool InteriorVector(const TSharedPtr<FJsonObject>& O,const TCHAR* Name,FVector& Out)
+{
+    const TArray<TSharedPtr<FJsonValue>>* Values=nullptr;
+    if(!O.IsValid()||!O->TryGetArrayField(Name,Values)||Values->Num()!=3)return false;
+    for(int32 I=0;I<3;++I)
