+        });
+        AddStep(TEXT("R3 bridge stationary before ordinary exit"),3,[this]{Hold(TEXT("Handbrake"),FInputActionValue(true));});
+        AddStep(TEXT("R3 bridge ordinary E exit"),.12,[this]{if(IsDriving())Hold(TEXT("Interact"),FInputActionValue(true));},[this]{Release(TEXT("Interact"));});
+        AddStep(TEXT("R3 bridge actual safe exit"),1,[this]{},[this]{Release(TEXT("Handbrake"));Check(TEXT("R3 bridge returned to on foot"),IsOnFoot(),TEXT("unchanged normal E exit"),State(),TEXT("B"));});
+    }
+    AddStep(TEXT("R3 bridge original pedestrian patrol setup"),.5,[this,S]
+    {
