diff --git a/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Door.cpp b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Door.cpp
--- /dev/null
+++ b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Door.cpp
@@ -0,0 +1,111 @@
+#include "HCM5VS4R3Door.h"
+#include "M1/HCM1PlayerController.h"
+
+#include "Components/SceneComponent.h"
+#include "Components/StaticMeshComponent.h"
+
+AHCM5VS4R3Door::AHCM5VS4R3Door()
+{
+    PrimaryActorTick.bCanEverTick = true;
+    PrimaryActorTick.bStartWithTickEnabled = false;
+    InteractionRoot = CreateDefaultSubobject<USceneComponent>(TEXT("InteractionRoot"));
+    SetRootComponent(InteractionRoot);
+    InteractionRoot->SetMobility(EComponentMobility::Movable);
+    DoorLeaf = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("DoorLeaf"));
+    DoorLeaf->SetupAttachment(InteractionRoot);
+    DoorLeaf->SetMobility(EComponentMobility::Movable);
+    DoorLeaf->SetCollisionProfileName(TEXT("BlockAll"));
+    DoorLeaf->SetSimulatePhysics(false);
+    // A closed movable door must not remove the persistent floor's nav surface.
+    // Physical collision still blocks passage until the player opens the leaf.
+    DoorLeaf->SetCanEverAffectNavigation(false);
+}
+
+bool AHCM5VS4R3Door::IsDoorConfigured() const
+{
+    return DoorLeaf && DoorLeaf->GetStaticMesh() && bHingeConfigured
+        && !ClosedLeafTransform.ContainsNaN() && ClosedLeafTransform.GetRotation().IsNormalized()
+        && !HingeLocation.ContainsNaN() && !HingeAxis.ContainsNaN() && !HingeAxis.IsNearlyZero()
+        && FMath::IsFinite(OpenAngleDegrees) && FMath::Abs(OpenAngleDegrees) > KINDA_SMALL_NUMBER
+        && FMath::Abs(OpenAngleDegrees) <= 175.0f
+        && FMath::IsFinite(OpenDurationSeconds) && OpenDurationSeconds >= 0.05f
+        && !DoorLeaf->IsSimulatingPhysics();
+}
+
+void AHCM5VS4R3Door::OnConstruction(const FTransform& Transform)
+{
+    Super::OnConstruction(Transform);
+    RefreshDoorPose();
+}
+
+void AHCM5VS4R3Door::BeginPlay()
+{
+    Super::BeginPlay();
+    RefreshDoorPose();
+    if (!IsDoorConfigured())
+        UE_LOG(LogTemp, Warning, TEXT("R3_DOOR_NOT_CONFIGURED actor=%s id=%s"), *GetPathName(), *StableId.ToString());
+}
+
+void AHCM5VS4R3Door::RefreshDoorPose()
+{
+    bOpenRequested = bStartOpen;
+    OpenFraction = bStartOpen ? 1.0f : 0.0f;
+    ApplyLeafPose();
+    SetActorTickEnabled(false);
+}
+
+bool AHCM5VS4R3Door::IsDoorMoving() const
+{
+    return IsDoorConfigured() && OpenFraction != (bOpenRequested ? 1.0f : 0.0f);
+}
+
+bool AHCM5VS4R3Door::SetDoorOpen(bool bOpen)
+{
+    if (!IsDoorConfigured()) return false;
+    bOpenRequested = bOpen;
+    SetActorTickEnabled(IsDoorMoving());
+    return true;
+}
+
+void AHCM5VS4R3Door::Tick(float DeltaSeconds)
+{
+    Super::Tick(DeltaSeconds);
+    if (!IsDoorConfigured()) { SetActorTickEnabled(false); return; }
+    const float Target = bOpenRequested ? 1.0f : 0.0f;
+    OpenFraction = FMath::FInterpConstantTo(OpenFraction, Target, DeltaSeconds, 1.0f / OpenDurationSeconds);
+    ApplyLeafPose();
+    SetActorTickEnabled(IsDoorMoving());
+}
+
+void AHCM5VS4R3Door::ApplyLeafPose()
+{
+    if (!DoorLeaf || ClosedLeafTransform.ContainsNaN()) return;
+    FTransform Pose = ClosedLeafTransform;
+    if (IsDoorConfigured())
+    {
+        const float Smoothed = OpenFraction * OpenFraction * (3.0f - 2.0f * OpenFraction);
+        const FQuat Swing(HingeAxis.GetSafeNormal(), FMath::DegreesToRadians(OpenAngleDegrees * Smoothed));
+        Pose.SetLocation(HingeLocation + Swing.RotateVector(ClosedLeafTransform.GetLocation() - HingeLocation));
+        Pose.SetRotation((Swing * ClosedLeafTransform.GetRotation()).GetNormalized());
+    }
+    // Derive every frame from the saved closed pose; never accumulate rotations.
+    DoorLeaf->SetRelativeTransform(Pose);
+}
+
+FString AHCM5VS4R3Door::GetInteractionText_Implementation(APlayerController* Player) const
+{
+    if (!IsDoorConfigured()) return FString();
+    return bOpenRequested ? TEXT("E  \u5173\u95e8") : TEXT("E  \u5f00\u95e8");
+}
+
+void AHCM5VS4R3Door::Interact_Implementation(APlayerController* Player)
+{
+    AHCM1PlayerController* PC = Cast<AHCM1PlayerController>(Player);
+    if (!PC || !PC->CanReachInteraction(this)) return;
+    if (PairedLeaves.Num() > 1) return;
+    for (AHCM5VS4R3Door* Other : PairedLeaves)
+        if (!IsValid(Other) || Other == this || Other->GetWorld() != GetWorld() || !Other->IsDoorConfigured()) return;
+    const bool bOpen = !bOpenRequested;
+    if (!SetDoorOpen(bOpen)) return;
+    for (AHCM5VS4R3Door* Other : PairedLeaves) Other->SetDoorOpen(bOpen);
+}
diff --git a/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Door.h b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3Door.h
