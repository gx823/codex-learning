+void AttachComponentContext(const FJson& Object, const USceneComponent* Component)
+{
+    Object->SetStringField(TEXT("component"), Component->GetPathName());
+    Object->SetStringField(TEXT("space"), TEXT("world_cm"));
+    Object->SetNumberField(TEXT("engine_frame"), double(GFrameCounter));
+    Object->SetBoolField(TEXT("component_visible"), Component->IsVisible());
+    if (const UWorld* World = Component->GetWorld())
+    {
+        Object->SetStringField(TEXT("map"), World->GetOutermost()->GetName());
+        Object->SetNumberField(TEXT("world_seconds"), World->GetTimeSeconds());
+        Object->SetBoolField(TEXT("is_game_world"), World->IsGameWorld());
+    }
+}
