+bool AHCM1TestRunner::AddM5VS4R3ReloadTests()
+{
+    struct FState
+    {
+        TStrongObjectPtr<UHCM1SaveGame> Source;
+        TWeakObjectPtr<AHCM5StoryDirector> Story;
+        TArray<uint8> Bytes;
+        FString Slot, File;
+    };
+    auto S = MakeShared<FState>();
+    FParse::Value(FCommandLine::Get(), TEXT("R3ReloadSeededCurrentSlot="), S->Slot);
+    AddStep(TEXT("R3 fresh current-slot reload prerequisites"), 4, [this, S]
+    {
+        FString Forbidden;
+        const bool NoFallback = !FParse::Value(FCommandLine::Get(), TEXT("R3CapitalSaveSlot="), Forbidden)
+            && !FParse::Value(FCommandLine::Get(), TEXT("R2LegacySaveSlot="), Forbidden);
+        const bool Allowed = HCM5VS3LocalQA() && FParse::Param(FCommandLine::Get(), TEXT("VS4R3Capture"))
+            && R3ReloadTestSlot(S->Slot) && S->Slot == PC->GetSaveSlotName() && NoFallback;
+        if (!RequireCamera(TEXT("R3 fresh reload isolated current slot without import fallback"), Allowed,
+            TEXT("local R3 QA; explicit safe current slot; no R2 or legacy fallback flags"),
+            S->Slot + TEXT(" / ") + PC->GetSaveSlotName(), TEXT("A launcher seeded actual prior F5 bytes"))) return;
+
