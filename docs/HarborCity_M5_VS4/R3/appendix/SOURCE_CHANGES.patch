+    Result->SetObjectField(TEXT("goal_probe"),SolverProbeJSON(O->GoalProbe));
+    Result->SetObjectField(TEXT("scored_continuation_probe"),SolverProbeJSON(O->ContinuationProbe));
+    Result->SetObjectField(TEXT("actual_probe"),SolverProbeJSON(O->ActualProbe));
+    Result->SetBoolField(TEXT("actual_probe_reused_exact_position"),O->bActualProbeReused);
+    Result->SetNumberField(TEXT("observation_only_extra_probe_calls"),O->ObservationOnlyProbeCalls);
+    Result->SetStringField(TEXT("scope"),TEXT("QA prototype only. Extra fallback probes occur after camera state commit and never enter selection. Game frame counters bind solver/sample only; depth/render-copy frames remain separate. Post-solver cache differences are retained, not treated as matching."));
