+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHCR3ViewportSDR10BitTest, "HarborCity.VS4.R3.ViewportCapture.SDR10Bit",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FHCR3ViewportSDR10BitTest::RunTest(const FString&)
+{
+    FHCR3ViewportColorProfile Color;
+    TestFalse(TEXT("Missing color metadata fails closed"), Color.IsVerifiedSDRsRGB());
+    Color.bMetadataAvailable = true;
+    Color.bGlobalHDR = Color.bWindowHDR = Color.bMetadataHDR = false;
+    Color.OutputFormat = int32(EDisplayOutputFormat::SDR_sRGB);
+    Color.ColorGamut = int32(EDisplayColorGamut::sRGB_D65);
+    Color.TonemapperGamma = 0;
+    TestTrue(TEXT("Native SDR sRGB metadata is required"), Color.IsVerifiedSDRsRGB());
+    Color.TonemapperGamma = 2.2f;
+    TestFalse(TEXT("Explicit gamma output cannot masquerade as sRGB"), Color.IsVerifiedSDRsRGB());
+    Color.TonemapperGamma = 0;
+    Color.bMetadataHDR = true;
+    TestFalse(TEXT("Window-specific HDR override fails even if global HDR is off"), Color.IsVerifiedSDRsRGB());
+    Color.bMetadataHDR = false;
+    Color.OutputFormat = int32(EDisplayOutputFormat::SDR_Rec709);
+    TestFalse(TEXT("Rec709 transfer requires a separate conversion, not relabeling"), Color.IsVerifiedSDRsRGB());
+
+    bool bAllLevels = true;
+    for (uint32 V = 0; V < 1024; ++V)
+        bAllLevels &= FColor::Requantize10to8(V) == (V * 255 + 511) / 1023;
+    TestTrue(TEXT("All 1024 UNORM levels match nearest-integer scaling"), bAllLevels);
+    uint32 Packed[] = {0xC00003FFu, 0xC00FFC00u, 0xFFFFFFFFu, 0xFFFFFFFFu,
+        0xFFF00000u, 0xFFFFFFFFu, 0u, 0u};
+    FColor Converted[4];
+    ConvertRawR10G10B10A2DataToFColor(2, 2, reinterpret_cast<uint8*>(Packed), 4 * sizeof(uint32), Converted);
+    TestEqual(TEXT("Low ten bits are red"), Converted[0], FColor(255, 0, 0, 255));
+    TestEqual(TEXT("Middle ten bits are green"), Converted[1], FColor(0, 255, 0, 255));
+    TestEqual(TEXT("Row pitch padding is skipped and high color bits are blue"), Converted[2], FColor(0, 0, 255, 255));
+    TestEqual(TEXT("White endpoint remains 255, not 254"), Converted[3], FColor::White);
+    uint32 Seed = 0x48C32026u;
+    bool bRandomChannels = true;
+    for (int32 I = 0; I < 1024; ++I)
+    {
+        Seed = 1664525u * Seed + 1013904223u;
+        FColor Actual;
+        ConvertRawR10G10B10A2DataToFColor(1, 1, reinterpret_cast<uint8*>(&Seed), sizeof(uint32), &Actual);
+        const FColor Expected(((Seed & 1023) * 255 + 511) / 1023,
+            (((Seed >> 10) & 1023) * 255 + 511) / 1023,
+            (((Seed >> 20) & 1023) * 255 + 511) / 1023, (Seed >> 30) * 85);
+        bRandomChannels &= Actual == Expected;
+    }
+    TestTrue(TEXT("Random packed UNORM channels match independent integer oracle"), bRandomChannels);
+    return true;
+}
