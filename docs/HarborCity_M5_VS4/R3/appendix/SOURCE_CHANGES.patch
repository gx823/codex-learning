+                // bound. Offline C6 still measures actual triangles separately.
+                return LocalBox.ComputeSquaredDistanceToPoint(Pose.InverseTransformPosition(Position))<=FMath::Square(25./MinimumScale);
+            };
+            if(auto* Instances=Cast<UInstancedStaticMeshComponent>(Component))
+            {
+                for(int32 Item:Instances->GetInstancesOverlappingSphere(Position,25.f,true))
+                {FTransform Pose;if(Instances->GetInstanceTransform(Item,Pose,true)&&Near(Pose))return true;}
+            }
+            else if(Near(Component->GetComponentTransform()))return true;
+        }
+        return false;
+    };
+    auto Clear=[&](const FVector& Position)
+    {
+        return Position.Z>=MinimumZ&&FVector::DistSquared(Position,Character->GetActorLocation())>FMath::Square(90.)
+            &&!GetWorld()->OverlapBlockingTestByChannel(Position,FQuat::Identity,ECC_Camera,FCollisionShape::MakeSphere(25.f),Query)
+            &&!GetWorld()->OverlapBlockingTestByChannel(Position,FQuat::Identity,ECC_Camera,FCollisionShape::MakeSphere(25.f),SimpleQuery)
+            &&!NearReviewedLantern(Position);
