+FString UHCM5VS4R3SceneCopy::PredictInstanceMovesJSON(const FString& RequestJSON)
+{
+    const FString ExpectedMap=TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/L_CapitalR2");
+    auto Fail=[](const FString& Error)
+    {
+        auto R=MakeShared<FJsonObject>();
+        R->SetStringField(TEXT("status"),TEXT("FAIL_READONLY_INSTANCE_MOVE_PREDICTION"));
+        R->SetBoolField(TEXT("read_only"),true);
+        R->SetStringField(TEXT("error"),Error);
+        return R3SnapshotJSON(R);
+    };
+    UWorld* World=GEditor?GEditor->GetEditorWorldContext().World():nullptr;
+    if(!IsInGameThread()||!World||!World->PersistentLevel||World->WorldType!=EWorldType::Editor||World->GetOutermost()->GetName()!=ExpectedMap)
+        return Fail(TEXT("Exact Capital Editor world on game thread required"));
+    if(RequestJSON.Len()>4*1024*1024)return Fail(TEXT("Prediction request exceeds bounded size"));
+    TSharedPtr<FJsonObject> Request;
+    if(!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(RequestJSON),Request)||!Request.IsValid())
+        return Fail(TEXT("Invalid request JSON"));
+    double Schema=0;
+    FString Map;
+    const TArray<TSharedPtr<FJsonValue>>* Moves=nullptr;
+    if(Request->Values.Num()!=3||!Request->TryGetNumberField(TEXT("schema"),Schema)||Schema!=1||
+        !Request->TryGetStringField(TEXT("map"),Map)||Map!=ExpectedMap||
+        !Request->TryGetArrayField(TEXT("moves"),Moves)||!Moves||Moves->IsEmpty()||Moves->Num()>512)
+        return Fail(TEXT("Exact schema/map and 1..512 moves required"));
+    const FString Stop=FPaths::ConvertRelativePathToFull(FPaths::ProjectDir(),TEXT("../docs/HarborCity_M5_VS4/R3/STOP_DESKTOP_CHAIN"));
+    const FString Prefix=World->PersistentLevel->GetPathName()+TEXT(".");
+    TSet<FString> Identities;
+    TArray<TSharedPtr<FJsonValue>> Predicted;
+    for(const TSharedPtr<FJsonValue>& Value:*Moves)
+    {
+        if(IFileManager::Get().FileExists(*Stop))return Fail(TEXT("USER_STOPPED"));
+        const TSharedPtr<FJsonObject>* Move=nullptr;
+        if(!Value.IsValid()||!Value->TryGetObject(Move)||!Move||!Move->IsValid()||(*Move)->Values.Num()!=3)
+            return Fail(TEXT("Complete move object required"));
+        FString Path;
+        double IndexValue=-1;
+        const TSharedPtr<FJsonObject>* Pose=nullptr;
+        if(!(*Move)->TryGetStringField(TEXT("component"),Path)||!Path.StartsWith(Prefix)||
+            !(*Move)->TryGetNumberField(TEXT("original_index"),IndexValue)||!FMath::IsFinite(IndexValue)||
+            IndexValue<0||IndexValue>200000||FMath::FloorToDouble(IndexValue)!=IndexValue||
+            !(*Move)->TryGetObjectField(TEXT("setter_world_transform"),Pose)||!Pose||!Pose->IsValid()||(*Pose)->Values.Num()!=3)
+            return Fail(TEXT("Exact component/index and complete setter world transform required"));
+        const int32 Index=static_cast<int32>(IndexValue);
+        const FString Identity=Path+TEXT("#instance=")+LexToString(Index);
+        if(Identities.Contains(Identity))return Fail(TEXT("Duplicate original identity"));
+        Identities.Add(Identity);
+        UInstancedStaticMeshComponent* C=FindObject<UInstancedStaticMeshComponent>(nullptr,*Path);
+        if(!IsValid(C)||C->IsTemplate()||C->GetWorld()!=World||!IsValid(C->GetOwner())||
+            C->GetOwner()->GetLevel()!=World->PersistentLevel||!C->GetStaticMesh()||
+            (C->GetClass()!=UInstancedStaticMeshComponent::StaticClass()&&C->GetClass()!=UHierarchicalInstancedStaticMeshComponent::StaticClass())||
+            Index>=C->GetInstanceCount())return Fail(TEXT("Missing or unsupported exact live ISM identity"));
+        auto Numbers=[&Pose](const TCHAR* Name,int32 Count,TArray<double>& Out)
+        {
+            const TArray<TSharedPtr<FJsonValue>>* Items=nullptr;
+            if(!(*Pose)->TryGetArrayField(Name,Items)||!Items||Items->Num()!=Count)return false;
+            for(const TSharedPtr<FJsonValue>& Item:*Items)
+            {
+                double Number=0;
+                if(!Item.IsValid()||!Item->TryGetNumber(Number)||!FMath::IsFinite(Number))return false;
+                Out.Add(Number);
+            }
+            return true;
+        };
+        TArray<double> P,Q,S;
+        if(!Numbers(TEXT("translation_cm"),3,P)||!Numbers(TEXT("quaternion"),4,Q)||!Numbers(TEXT("scale"),3,S)||
+            S[0]==0||S[1]==0||S[2]==0||FMath::Abs(Q[0]*Q[0]+Q[1]*Q[1]+Q[2]*Q[2]+Q[3]*Q[3]-1)>1.e-8)
+            return Fail(TEXT("Finite nonsingular transform and unit quaternion required; no normalization"));
+        const FTransform Setter(FQuat(Q[0],Q[1],Q[2],Q[3]),FVector(P[0],P[1],P[2]),FVector(S[0],S[1],S[2]));
+        FTransform BeforeLocal,BeforeWorld;
+        if(!C->GetInstanceTransform(Index,BeforeLocal,false)||!C->GetInstanceTransform(Index,BeforeWorld,true))
+            return Fail(TEXT("Original instance read failed"));
+        const FTransform ComponentWorld=C->GetComponentTransform();
+        const FVector ComponentScale=ComponentWorld.GetScale3D();
+        if(ComponentWorld.ContainsNaN()||ComponentScale.X==0||ComponentScale.Y==0||ComponentScale.Z==0)
+            return Fail(TEXT("Nonfinite/singular component transform"));
+        // Mirrors UpdateInstanceTransform(bWorldSpace=true), then GetInstanceTransform.
+        const FTransform LocalInput=Setter.GetRelativeTransform(ComponentWorld);
+        const FTransform LocalReadback(LocalInput.ToMatrixWithScale());
+        const FTransform WorldReadback=LocalReadback*ComponentWorld;
+        if(LocalReadback.ContainsNaN()||WorldReadback.ContainsNaN())return Fail(TEXT("Nonfinite predicted native readback"));
+        auto R=MakeShared<FJsonObject>();
+        R->SetStringField(TEXT("component"),Path);
+        R->SetNumberField(TEXT("original_index"),Index);
+        R->SetObjectField(TEXT("component_world_transform"),R3SnapshotTransform(ComponentWorld));
+        R->SetObjectField(TEXT("before_local_transform"),R3SnapshotTransform(BeforeLocal));
+        R->SetObjectField(TEXT("before_world_transform"),R3SnapshotTransform(BeforeWorld));
+        R->SetObjectField(TEXT("setter_world_transform"),R3SnapshotTransform(Setter));
+        R->SetObjectField(TEXT("target_local_transform"),R3SnapshotTransform(LocalReadback));
+        R->SetObjectField(TEXT("target_world_transform"),R3SnapshotTransform(WorldReadback));
+        Predicted.Add(MakeShared<FJsonValueObject>(R));
+    }
+    auto Result=MakeShared<FJsonObject>();
+    Result->SetNumberField(TEXT("schema"),1);
+    Result->SetStringField(TEXT("status"),TEXT("READ_ONLY_NATIVE_INSTANCE_MOVE_PREDICTION"));
+    Result->SetBoolField(TEXT("read_only"),true);
+    Result->SetStringField(TEXT("map"),ExpectedMap);
+    Result->SetStringField(TEXT("world_type"),TEXT("Editor"));
+    Result->SetStringField(TEXT("engine_frame"),LexToString(GFrameCounter));
+    Result->SetArrayField(TEXT("moves"),Predicted);
+    return R3SnapshotJSON(Result);
+}
