+{
+    uint64 EngineFrame = 0;
+    double WallSeconds = 0;
+    double WorldSeconds = 0;
+};
+
+struct FHCR3ViewportColorProfile
+{
+    bool bMetadataAvailable = false;
+    bool bGlobalHDR = true;
+    bool bWindowHDR = true;
+    bool bMetadataHDR = true;
+    int32 OutputFormat = -1;
+    int32 ColorGamut = -1;
+    float TonemapperGamma = -1;
+
+    bool IsVerifiedSDRsRGB() const;
+};
+
+struct FHCR3ViewportFrame
+{
+    uint64 Ticket = 0;
+    uint64 CopyOrdinal = 0;
+    FHCR3ViewportRequest Request;
+    uint64 ArmEngineCounterRT = 0;
+    uint32 ArmRenderFrame = 0;
+    uint64 CopyEngineCounterRT = 0;
+    uint32 CopyRenderFrame = 0;
+    uint32 ReadyRenderFrame = 0;
+    double CopyWallSeconds = 0;
+    double ReadyWallSeconds = 0;
+    int32 SourcePixelFormat = 0;
+    int32 RowPitchPixels = 0;
+    int32 StagingRows = 0;
+    FIntPoint Size = FIntPoint::ZeroValue;
+    bool bCopySubmitted = false;
+    bool bSameArmAndPresentFrame = false;
+    bool bEngineCounterEqualsRequest = false;
+    bool bSourceSRGB = false;
+    bool bViewportHDR = true;
+    int32 ViewportOutputFormat = -1;
+    int32 ViewportColorGamut = -1;
+    float ViewportDisplayGamma = 0;
+    FHCR3ViewportColorProfile RequestWindowColor;
+    FHCR3ViewportColorProfile PresentWindowColor;
