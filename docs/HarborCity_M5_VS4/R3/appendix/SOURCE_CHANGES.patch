+        Result->SetNumberField(TEXT("candidate_cell_slots"),9);Result->SetNumberField(TEXT("valid_cells"),ValidCells);
+        Result->SetNumberField(TEXT("hole_cells"),Holes);Result->SetNumberField(TEXT("tested_triangles"),Tested);
+        Result->SetNumberField(TEXT("intersected_triangles"),Hits);Result->SetArrayField(TEXT("cells"),Cells);
+        Result->SetBoolField(TEXT("hit"),Hits>0);
+        if(Hits>0)
+        {
+            Result->SetNumberField(TEXT("nearest_face"),NearestFace);Result->SetNumberField(TEXT("nearest_fraction"),Nearest);
+            Result->SetNumberField(TEXT("nearest_cell_x"),(NearestFace/2)%(Cols-1));Result->SetNumberField(TEXT("nearest_cell_y"),(NearestFace/2)/(Cols-1));
+            Result->SetArrayField(TEXT("nearest_point_cm"),JsonVector(NearestPoint));Result->SetNumberField(TEXT("collision_z_cm"),NearestPoint.Z);
+        }
+        Result->SetStringField(TEXT("status"),TEXT("OBSERVED_NATIVE_TRIANGLES_ONLY"));
+    });
+    if(!ReadExecuted)Missing(TEXT("PHYSICS_READ_LOCK_NOT_EXECUTED"));
+    return Result;
+}
