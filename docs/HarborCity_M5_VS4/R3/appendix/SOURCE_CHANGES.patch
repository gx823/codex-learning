+#include "Rendering/SkeletalMeshLODRenderData.h"
+#include "Rendering/SkinWeightVertexBuffer.h"
+#include "StaticMeshResources.h"
+#endif
+
+namespace
+{
+using FJson = TSharedRef<FJsonObject>;
+
+FJson NewRecord(const TCHAR* Representation)
+{
+    auto Result = MakeShared<FJsonObject>();
+    Result->SetNumberField(TEXT("schema_version"), 1);
+    Result->SetStringField(TEXT("status"), TEXT("NOT_RUN"));
+    Result->SetStringField(TEXT("representation"), Representation);
+    Result->SetBoolField(TEXT("read_only"), true);
+    Result->SetStringField(TEXT("collision_substitution"), TEXT("NEVER"));
+    Result->SetStringField(TEXT("shader_wpo"), TEXT("NOT_RUN_NOT_EVALUATED"));
+    Result->SetStringField(TEXT("opacity_mask"), TEXT("NOT_RUN_NOT_EVALUATED"));
+    Result->SetStringField(TEXT("surface_acceptance"), TEXT("NOT_RUN_REPRESENTATION_ONLY"));
+    return Result;
+}
+
+FString Encode(const FJson& Object)
+{
+    FString Json;
+    const auto Writer = TJsonWriterFactory<TCHAR, TCondensedJsonPrintPolicy<TCHAR>>::Create(&Json);
+    FJsonSerializer::Serialize(Object, Writer);
+    return Json;
+}
+
+FString NotRun(const FJson& Object, const TCHAR* Reason)
+{
+    Object->SetStringField(TEXT("status"), TEXT("NOT_RUN"));
+    Object->SetStringField(TEXT("reason"), Reason);
+    return Encode(Object);
+}
+
+#if WITH_EDITOR
+FJson TransformRecord(const FTransform& Transform)
+{
+    auto Row = MakeShared<FJsonObject>();
+    const FVector P = Transform.GetTranslation(), S = Transform.GetScale3D();
+    const FQuat Q = Transform.GetRotation();
+    Row->SetBoolField(TEXT("valid"), Transform.IsValid());
+    Row->SetArrayField(TEXT("translation_cm"), {MakeShared<FJsonValueNumber>(P.X), MakeShared<FJsonValueNumber>(P.Y), MakeShared<FJsonValueNumber>(P.Z)});
+    Row->SetArrayField(TEXT("quaternion"), {MakeShared<FJsonValueNumber>(Q.X), MakeShared<FJsonValueNumber>(Q.Y), MakeShared<FJsonValueNumber>(Q.Z), MakeShared<FJsonValueNumber>(Q.W)});
+    Row->SetArrayField(TEXT("scale"), {MakeShared<FJsonValueNumber>(S.X), MakeShared<FJsonValueNumber>(S.Y), MakeShared<FJsonValueNumber>(S.Z)});
+    return Row;
+}
+
+TArray<TSharedPtr<FJsonValue>> CollisionChannelCatalog()
+{
+    TArray<TSharedPtr<FJsonValue>> Rows;
+    const UEnum* Channels = StaticEnum<ECollisionChannel>();
+    const UCollisionProfile* Profile = UCollisionProfile::Get();
+    // Only serialized response slots. The deprecated overlap marker and MAX
+    // are not channels; UE 5.8 has 64 slots, not the older 32-slot layout.
+    for (int32 Channel = 0; Channel < int32(ECC_OverlapAll_Deprecated); ++Channel)
+    {
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetNumberField(TEXT("index"), Channel);
+        Row->SetStringField(TEXT("enum_name"), Channels->GetNameStringByValue(Channel));
+        Row->SetStringField(TEXT("configured_name"), Profile ? Profile->ReturnChannelNameFromContainerIndex(Channel).ToString() : TEXT(""));
+        Rows.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    return Rows;
+}
+
+FJson CollisionRecord(const UPrimitiveComponent* Primitive)
+{
+    auto Row = MakeShared<FJsonObject>();
+    Row->SetNumberField(TEXT("schema_version"), 1);
+    Row->SetStringField(TEXT("status"), TEXT("READ_NATIVE_COMPONENT_GETTERS"));
+    Row->SetBoolField(TEXT("read_only"), true);
+    const ECollisionEnabled::Type Enabled = Primitive->GetCollisionEnabled();
+    const ECollisionChannel ObjectType = Primitive->GetCollisionObjectType();
+    Row->SetNumberField(TEXT("collision_enabled"), int32(Enabled));
+    Row->SetStringField(TEXT("collision_enabled_name"), StaticEnum<ECollisionEnabled::Type>()->GetNameStringByValue(int64(Enabled)));
+    Row->SetNumberField(TEXT("object_type"), int32(ObjectType));
+    Row->SetStringField(TEXT("object_type_name"), StaticEnum<ECollisionChannel>()->GetNameStringByValue(int64(ObjectType)));
+    Row->SetStringField(TEXT("profile_name"), Primitive->GetCollisionProfileName().ToString());
+    Row->SetStringField(TEXT("profile_name_type"), TEXT("FName; not an enum or stable numeric ID"));
+    Row->SetBoolField(TEXT("generate_overlap_events"), Primitive->GetGenerateOverlapEvents());
+    Row->SetBoolField(TEXT("is_simulating_physics_default_body"), Primitive->IsSimulatingPhysics());
+    Row->SetBoolField(TEXT("gravity_enabled"), Primitive->IsGravityEnabled());
+    Row->SetStringField(TEXT("scope"), TEXT("Component/default-body getters; per-shape and per-bone overrides are not enumerated"));
+    TArray<TSharedPtr<FJsonValue>> Responses;
+    bool bComplete = true;
+    for (int32 Channel = 0; Channel < int32(ECC_OverlapAll_Deprecated); ++Channel)
+    {
+        const ECollisionResponse Response = Primitive->GetCollisionResponseToChannel(ECollisionChannel(Channel));
+        auto Value = MakeShared<FJsonObject>();
+        Value->SetNumberField(TEXT("channel"), Channel);
+        Value->SetStringField(TEXT("channel_name"), StaticEnum<ECollisionChannel>()->GetNameStringByValue(Channel));
+        Value->SetNumberField(TEXT("response"), int32(Response));
+        Value->SetStringField(TEXT("response_name"), StaticEnum<ECollisionResponse>()->GetNameStringByValue(int64(Response)));
+        Responses.Add(MakeShared<FJsonValueObject>(Value));
+        bComplete &= Response >= ECR_Ignore && Response <= ECR_Block;
+    }
+    Row->SetArrayField(TEXT("responses"), Responses);
+    Row->SetNumberField(TEXT("serialized_channel_count"), int32(ECC_OverlapAll_Deprecated));
+    Row->SetBoolField(TEXT("full_channel_responses"), bComplete);
+    Row->SetStringField(TEXT("query_geometry_acceptance"), TEXT("NOT_RUN_RENDER_MESH_AND_RUNTIME_QUERY_TESTS_REQUIRED"));
+    return Row;
+}
+
+FJson MaterialRecord(UMaterialInterface* Material)
+{
+    auto Row = MakeShared<FJsonObject>();
+    Row->SetStringField(TEXT("status"), Material ? TEXT("READ_NATIVE") : TEXT("NOT_RUN_NULL_MATERIAL_SLOT"));
+    if (Material) Row->SetStringField(TEXT("material"), Material->GetPathName());
+    else Row->SetField(TEXT("material"), MakeShared<FJsonValueNull>());
+    Row->SetStringField(TEXT("opacity_surface"), TEXT("NOT_RUN_SHADER_ALPHA_NOT_EVALUATED"));
+    Row->SetStringField(TEXT("shader_deformation"), TEXT("NOT_RUN_SHADER_NOT_EVALUATED"));
+    if (!Material) return Row;
+    UMaterial* Base = Material->GetMaterial();
+    if (Base) Row->SetStringField(TEXT("base_material"), Base->GetPathName());
+    else Row->SetField(TEXT("base_material"), MakeShared<FJsonValueNull>());
+    if (Base) Row->SetBoolField(TEXT("is_sky"), Base->bIsSky);
+    else Row->SetField(TEXT("is_sky"), MakeShared<FJsonValueNull>());
+    Row->SetNumberField(TEXT("blend_mode"), int32(Material->GetBlendMode()));
+    Row->SetStringField(TEXT("blend_mode_name"), StaticEnum<EBlendMode>()->GetNameStringByValue(int64(Material->GetBlendMode())));
+    Row->SetBoolField(TEXT("masked"), Material->IsMasked());
+    Row->SetBoolField(TEXT("two_sided"), Material->IsTwoSided());
+    Row->SetNumberField(TEXT("opacity_mask_clip_value"), Material->GetOpacityMaskClipValue());
+    Row->SetNumberField(TEXT("max_world_position_offset_displacement"), Material->GetMaxWorldPositionOffsetDisplacement());
+    Row->SetNumberField(TEXT("shader_platform"), int32(GMaxRHIShaderPlatform));
+    const FMaterialResource* Resource = Material->GetMaterialResource(GMaxRHIShaderPlatform);
+    const bool bHasMap = Resource && Resource->GetGameThreadShaderMap();
+    const bool bComplete = bHasMap && Resource->IsGameThreadShaderMapComplete();
+    Row->SetBoolField(TEXT("game_thread_shader_map_present"), bHasMap);
+    Row->SetBoolField(TEXT("game_thread_shader_map_complete"), bComplete);
+    Row->SetStringField(TEXT("wpo_usage_status"), bComplete ? TEXT("READ_NATIVE_COMPILED_SHADER_MAP") : TEXT("NOT_RUN_SHADER_MAP_UNAVAILABLE_OR_INCOMPLETE"));
+    if (bComplete)
+    {
+        Row->SetBoolField(TEXT("uses_world_position_offset"), Resource->MaterialUsesWorldPositionOffset_GameThread());
+        Row->SetBoolField(TEXT("uses_displacement"), Resource->MaterialUsesDisplacement_GameThread());
+    }
+    else
+    {
+        Row->SetField(TEXT("uses_world_position_offset"), MakeShared<FJsonValueNull>());
+        Row->SetField(TEXT("uses_displacement"), MakeShared<FJsonValueNull>());
+    }
+    return Row;
+}
