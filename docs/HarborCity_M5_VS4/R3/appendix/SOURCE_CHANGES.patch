+void AHCM3Recording::PollR3Capture(bool bWorldEnding)
+{
+    FRecordingState& S = *Recording;
+    if (!S.R3Capture) return;
+    if (bWorldEnding)
+    {
+        S.bR3WorldEnded = S.bR3AsyncFailed = true;
+        S.R3Capture->AbortAndClose(TEXT("WORLD_ENDED_BEFORE_ASYNC_DRAIN"));
+    }
+    else if (S.bR3DrainPending && FPlatformTime::Seconds() - S.R3StopWall > 5 && !S.R3Capture->GetStats().bClosed)
+    {
+        S.bR3AsyncFailed = true;
+        S.R3Capture->AbortAndClose(TEXT("R3_ASYNC_DRAIN_TIMEOUT_5_SECONDS"));
+    }
+    for (int32 I = S.WriteTasks.Num() - 1; I >= 0; --I)
+    {
+        if (!S.WriteTasks[I].IsReady()) continue;
+        const bool bWritten = S.WriteTasks[I].Get();
+        S.R3WriteRows[I]->SetStringField(TEXT("write_status"), bWritten ? TEXT("WRITTEN") : TEXT("FAILED"));
+        if (!bWritten) { ++S.WriteFailures; S.bR3AsyncFailed = true; }
+        S.WriteTasks.RemoveAt(I);
+        S.R3WriteRows.RemoveAt(I);
+    }
+    TArray<FHCR3ViewportFrame> Captured;
+    S.R3Capture->Poll(Captured, bWorldEnding ? FHCM5VS4R3ViewportCapture::Capacity : FMath::Max(0, 3 - S.WriteTasks.Num()));
+    for (FHCR3ViewportFrame& Frame : Captured)
+    {
+        auto Row = R3FrameJSON(Frame, S.Started);
+        const bool bPixelsValid = Frame.Size == FIntPoint(FHCM5VS4R3ViewportCapture::Width, FHCM5VS4R3ViewportCapture::Height) &&
+            Frame.Size == S.RequestedSize && Frame.Pixels.Num() == Frame.Size.X * Frame.Size.Y;
+        if (!bPixelsValid || !Frame.bCopySubmitted || !Frame.bSameArmAndPresentFrame || S.WriteTasks.Num() >= 3)
+        {
+            Row->SetStringField(TEXT("stage"), bWorldEnding ? TEXT("ABORTED_WORLD_END") : TEXT("READBACK_FAILED"));
+            S.R3CaptureFailures.Add(MakeShared<FJsonValueObject>(Row));
+            ++S.Dropped;
+            S.bR3AsyncFailed = true;
+            continue;
+        }
+        if (!Frame.bEngineCounterEqualsRequest) S.bR3AsyncFailed = true;
+        const FString Name = FString::Printf(TEXT("frame_%06d.jpg"), S.Frames.Num());
+        const FString File = S.Directory / Name;
+        Row->SetStringField(TEXT("file"), Name);
+        Row->SetStringField(TEXT("write_status"), TEXT("PENDING_JPG_WORKER"));
+        S.Frames.Add(MakeShared<FJsonValueObject>(Row));
+        S.R3WriteRows.Add(Row);
+        S.OutputSize = Frame.Size;
+        const FIntPoint Size = Frame.Size;
+        S.WriteTasks.Add(AsyncPool(*S.R3WritePool, [Pixels = MoveTemp(Frame.Pixels), Size, File]() mutable
+        {
+            for (FColor& Pixel : Pixels) Pixel.A = 255;
+            TArray64<uint8> Bytes;
+            FImageUtils::CompressImage(Bytes, TEXT("jpg"), FImageView(Pixels.GetData(), Size.X, Size.Y), 85);
+            return !Bytes.IsEmpty() && FFileHelper::SaveArrayToFile(Bytes, *File);
+        }));
+    }
+    S.R3CaptureStats = S.R3Capture->GetStats();
+    if (!S.bR3DrainPending) return;
+    const bool bTerminalReadback = S.R3CaptureStats.bDrainComplete ||
+        (S.R3CaptureStats.bClosed && S.R3CaptureStats.OccupiedSlots == 0);
+    if (!bTerminalReadback || (!S.WriteTasks.IsEmpty() && !bWorldEnding)) return;
+    if (!S.R3CaptureStats.bClosed)
+    {
+        FString Failure;
+        if (!S.R3Capture->Close(Failure)) { S.bR3AsyncFailed = true; return; }
+    }
+    S.R3CaptureStats = S.R3Capture->GetStats();
+    S.R3PresentEvidence = S.R3Capture->TakePresentEvidenceAfterClose();
+    S.R3Capture.Reset();
+    S.bR3DrainPending = false;
+    S.bR3Finalizing = true;
+    Stop(S.R3StopReason);
+    S.bR3Finalizing = false;
+    S.bR3Finalized = true;
+}
