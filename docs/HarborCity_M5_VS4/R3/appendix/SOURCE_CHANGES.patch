+struct FHCM5VS4R3Telemetry::FDepthBatch
+{
+    TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+    FMinimalViewInfo View;
+    FVector Player;
+    double FeetZ = 0;
+    TUniquePtr<FRHIGPUTextureReadback> Readbacks[3];
+    TArray<FFloat16Color> Pixels[3];
+    TAtomic<bool> Complete{false};
+    FDelegateHandle EndFrameHandle;
+    uint32 CopyRenderFrame = 0;
+    bool Valid = true;
+};
