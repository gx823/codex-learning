+++ b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFade.cpp
@@ -0,0 +1,535 @@
+#include "HCM5VS4R3ObjectFade.h"
+
+#include "Camera/CameraTypes.h"
+#include "Components/CapsuleComponent.h"
+#include "Components/InstancedStaticMeshComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Dom/JsonObject.h"
+#include "Engine/World.h"
+#include "Engine/StaticMesh.h"
+#include "EngineUtils.h"
+#include "GameFramework/Pawn.h"
+#include "M1/HCM1Character.h"
+#include "M1/HCM1PlayerController.h"
+#include "M5VS3/HCM5VS3Abilities.h"
+#include "M5VS3/HCM5VS3QA.h"
+#include "Materials/MaterialInstanceDynamic.h"
+#include "Materials/MaterialInterface.h"
+#include "Misc/CommandLine.h"
+#include "Misc/Parse.h"
+#include "Misc/SecureHash.h"
+#include "Serialization/JsonSerializer.h"
+#include "Serialization/JsonWriter.h"
+
+namespace
+{
+const TCHAR* MaterialRoot = TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/SpatialCamera/R3_ObjectFadeClean_01/");
+const FName OpacityParameter(TEXT("R3ObjectOpacity"));
+constexpr float FadedOpacity = .05f;
+constexpr double ReleaseHoldSeconds = .08;
+constexpr int32 SoftTraceBudget = 128;
+
+bool SameData(const TArray<float>& A, const TArray<float>& B)
+{
+    return A.Num() == B.Num() && (A.IsEmpty() || FMemory::Memcmp(A.GetData(), B.GetData(), A.Num() * sizeof(float)) == 0);
+}
+
+UMaterialInterface* StaticBinding(UMaterialInterface* Material)
+{
+    TSet<UMaterialInterface*> Seen;
+    while (auto* Dynamic = Cast<UMaterialInstanceDynamic>(Material))
+    {
+        if (Seen.Contains(Material)) return nullptr;
+        Seen.Add(Material);
+        Material = Dynamic->Parent;
+    }
+    return Material;
+}
+}
+
+FHCM5VS4R3ObjectFade::~FHCM5VS4R3ObjectFade()
+{
+    Restore();
+}
+
+bool FHCM5VS4R3ObjectFade::OptIn(UWorld* InWorld) const
+{
+    return InWorld && InWorld->IsGameWorld()
+        && InWorld->GetOutermost()->GetName().Contains(TEXT("/M5VS4/Capital/R2_"));
+}
+
+FString FHCM5VS4R3ObjectFade::VariantPath(const FString& StaticBindingPath, int32 OriginalStride, bool bInstanced, bool bWholeCompact)
+{
+    if (StaticBindingPath.IsEmpty() || OriginalStride < 0) return FString();
+    FTCHARToUTF8 Bytes(*StaticBindingPath);
+    FMD5 Hash;
+    Hash.Update(reinterpret_cast<const uint8*>(Bytes.Get()), Bytes.Length());
+    uint8 Digest[16]; Hash.Final(Digest);
+    const FString Key = BytesToHex(Digest, 16).ToLower().Left(16);
+    const FString Mode = bInstanced ? FString::Printf(TEXT("I%d"), OriginalStride) : TEXT("S");
+    const FString Name = TEXT("M_R3O_") + Key + TEXT("_") + Mode + (bWholeCompact ? TEXT("_W") : TEXT(""));
+    return FString(MaterialRoot) + Name + TEXT(".") + Name;
+}
+
+bool FHCM5VS4R3ObjectFade::IsReviewedCompactMesh(const UStaticMeshComponent* Component)
+{
+    return Component && Component->GetStaticMesh() && Component->GetStaticMesh()->GetPathName() ==
+        TEXT("/Game/Fantastic_City_Pack/meshes/props/SM_PROP_lantern_city_03.SM_PROP_lantern_city_03");
+}
+
+bool FHCM5VS4R3ObjectFade::SegmentCrossesCompactBounds(const FBox& LocalBounds, const FTransform& WorldTransform,
+    const FVector& Start, const FVector& End)
+{
+    if (!LocalBounds.IsValid || LocalBounds.Min.ContainsNaN() || LocalBounds.Max.ContainsNaN()
+        || WorldTransform.ContainsNaN() || Start.ContainsNaN() || End.ContainsNaN()
+        || WorldTransform.GetScale3D().GetAbsMin() < UE_SMALL_NUMBER || Start.Equals(End, 0.)) return false;
+    const FVector A = WorldTransform.InverseTransformPosition(Start), B = WorldTransform.InverseTransformPosition(End);
+    return FMath::LineBoxIntersection(LocalBounds, A, B, B - A);
+}
+
+bool FHCM5VS4R3ObjectFade::RepackOpaque(const TArray<float>& Original, int32 Count, int32 Stride, TArray<float>& Out)
+{
+    if (Count < 0 || Stride < 0 || Stride == MAX_int32 || int64(Count) * (int64(Stride) + 1) > MAX_int32
+        || Original.Num() != int64(Count) * Stride) return false;
+    Out.SetNumUninitialized(Count * (Stride + 1));
+    for (int32 I = 0; I < Count; ++I)
+    {
+        if (Stride > 0) FMemory::Memcpy(Out.GetData() + I * (Stride + 1), Original.GetData() + I * Stride, Stride * sizeof(float));
+        Out[I * (Stride + 1) + Stride] = 1.f;
+    }
+    return true;
+}
+
+bool FHCM5VS4R3ObjectFade::ExtractPrefix(const TArray<float>& Packed, int32 Count, int32 Stride, TArray<float>& Out)
+{
+    if (Count < 0 || Stride < 0 || Stride == MAX_int32 || int64(Count) * (int64(Stride) + 1) > MAX_int32
+        || Packed.Num() != int64(Count) * (Stride + 1)) return false;
+    Out.SetNumUninitialized(Count * Stride);
+    if (Stride > 0) for (int32 I = 0; I < Count; ++I)
+        FMemory::Memcpy(Out.GetData() + I * Stride, Packed.GetData() + I * (Stride + 1), Stride * sizeof(float));
+    return true;
+}
+
+float FHCM5VS4R3ObjectFade::StepOpacity(float Current, bool bOccluding, float DeltaTime)
+{
+    if (!FMath::IsFinite(Current) || !FMath::IsFinite(DeltaTime)) return 1.f;
+    const float Target = bOccluding ? FadedOpacity : 1.f;
+    const float Rate = (1.f - FadedOpacity) / (bOccluding ? .06f : .12f);
+    return FMath::FInterpConstantTo(FMath::Clamp(Current, FadedOpacity, 1.f), Target,
+        FMath::Clamp(DeltaTime, 0.f, .1f), Rate);
+}
+
+void FHCM5VS4R3ObjectFade::Issue(const FString& Reason, const UPrimitiveComponent* Component)
+{
+    Issues.Add(Reason + (Component ? TEXT(":") + Component->GetPathName() : FString()));
+}
+
+bool FHCM5VS4R3ObjectFade::Initialize(UWorld* InWorld, const TArray<UPrimitiveComponent*>& VerifiedEnvironmentComponents)
+{
+    if (!Restore()) { bOptedIn = false; Issue(TEXT("REINITIALIZE_BLOCKED_RESTORE_CONFLICT")); return false; }
+    States.Reset(); Issues.Reset();
+    World = InWorld; bOptedIn = OptIn(InWorld); bRestoreComplete = true;
+    VerifiedCount = VerifiedEnvironmentComponents.Num(); ObservedHardPolicyCount = 0; Elapsed = 0.;
+    if (!bOptedIn) return false;
+    TSet<UPrimitiveComponent*> Seen;
+    for (auto* Primitive : VerifiedEnvironmentComponents)
+    {
+        auto* Component = Cast<UStaticMeshComponent>(Primitive);
+        if (!Component || Component->GetWorld() != InWorld || !Component->GetOwner()
+            || Cast<APawn>(Component->GetOwner()) || !Component->GetStaticMesh()
+            || (!Component->ComponentHasTag(TEXT("HCR2SpatialFade")) && !IsReviewedCompactMesh(Component))
+            || (Component->ComponentHasTag(TEXT("HCR3CameraSoft")) && Component->ComponentHasTag(TEXT("HCR3CameraHard"))))
+        { Issue(TEXT("UNRESOLVED_ENVIRONMENT_MEMBERSHIP"), Primitive); continue; }
+        const bool bExplicitSoft=Component->ComponentHasTag(TEXT("HCR3CameraSoft"));
+        const bool bExplicitHard=Component->ComponentHasTag(TEXT("HCR3CameraHard"));
+        const bool bWholeCompact=IsReviewedCompactMesh(Component);
+        // Most authored solids already block Camera and never needed the R3
+        // policy repair tags. Preserve that observed policy instead of retagging.
+        if(!bWholeCompact&&!bExplicitSoft&&!bExplicitHard&&(!Component->IsQueryCollisionEnabled()
+            ||Component->GetCollisionResponseToChannel(ECC_Camera)!=ECR_Block))
+        { Issue(TEXT("UNTAGGED_NONBLOCKING_ENVIRONMENT_UNRESOLVED"), Component); continue; }
+        if (Seen.Contains(Component)) { Issue(TEXT("DUPLICATE_COMPONENT"), Component); continue; }
+        Seen.Add(Component);
+        FComponentState State;
+        State.Component = Component;
+        State.bSoft = bExplicitSoft;
+        State.bWholeCompact = bWholeCompact;
+        auto* ISM = Cast<UInstancedStaticMeshComponent>(Component);
+        State.bInstanced = ISM != nullptr;
+        State.OriginalStride = ISM ? ISM->NumCustomDataFloats : 0;
+        if (State.OriginalStride < 0 || State.OriginalStride > 64 || Component->GetNumMaterials() == 0)
+        { Issue(TEXT("INVALID_LAYOUT_OR_NO_MATERIALS"), Component); continue; }
+        bool Ready = true;
+        for (int32 Slot = 0; Slot < Component->GetNumMaterials(); ++Slot)
+        {
+            auto* Original = Component->GetMaterial(Slot);
+            auto* Identity = StaticBinding(Original);
+            State.OriginalMaterials.Add(Original);
+            if (!Identity || Identity->GetPathName().StartsWith(MaterialRoot)) { Ready = false; break; }
+            const FString Path = VariantPath(Identity->GetPathName(), State.OriginalStride, State.bInstanced, State.bWholeCompact);
+            auto* Variant = LoadObject<UMaterialInterface>(nullptr, *Path, nullptr, LOAD_NoWarn | LOAD_Quiet);
+            if (!Variant || Variant->GetBlendMode() != BLEND_Translucent)
+            { Issue(TEXT("MISSING_OR_INVALID_VARIANT:") + Path, Component); Ready = false; break; }
+            if (!ISM)
+            {
+                float DefaultOpacity = 0.f;
+                if (!Variant->GetScalarParameterValue(FMaterialParameterInfo(OpacityParameter), DefaultOpacity)
+                    || !FMath::IsNearlyEqual(DefaultOpacity, 1.f))
+                { Issue(TEXT("MISSING_OPAQUE_SMC_PARAMETER"), Component); Ready = false; break; }
+                auto* Dynamic = UMaterialInstanceDynamic::Create(Variant, Component);
+                if (!Dynamic) { Ready = false; break; }
+                Dynamic->CopyMaterialUniformParameters(Original);
+                Dynamic->SetScalarParameterValue(OpacityParameter, 1.f);
+                State.OverlayMaterials.Add(Dynamic);
+            }
+            else if (Cast<UMaterialInstanceDynamic>(Original))
+            {
+                auto* Dynamic = UMaterialInstanceDynamic::Create(Variant, Component);
+                if (!Dynamic) { Ready = false; break; }
+                Dynamic->CopyMaterialUniformParameters(Original);
+                State.OverlayMaterials.Add(Dynamic);
+            }
+            else State.OverlayMaterials.Add(Variant);
+        }
+        if (!Ready || State.OverlayMaterials.Num() != Component->GetNumMaterials())
+        { Issue(TEXT("COMPONENT_UNCOVERED_ALL_SLOTS_REQUIRED"), Component); continue; }
+        if(!bWholeCompact&&!bExplicitSoft&&!bExplicitHard)++ObservedHardPolicyCount;
+        States.Add(MoveTemp(State));
+    }
+    return !States.IsEmpty();
+}
+
+bool FHCM5VS4R3ObjectFade::IsPrepared(const UPrimitiveComponent* Component) const
+{
+    return States.ContainsByPredicate([Component](const FComponentState& State){return State.Component.Get()==Component&&State.bUsable;});
+}
+
+bool FHCM5VS4R3ObjectFade::Bind(FComponentState& State)
+{
+    auto* Component = State.Component.Get();
+    if (!Component || !State.bUsable) return false;
+    if (State.bBound) return true;
+    if (Component->GetNumMaterials() != State.OriginalMaterials.Num())
+    { Issue(TEXT("SLOT_COUNT_CHANGED_BEFORE_OVERLAY"), Component); State.bUsable = false; return false; }
+    for (int32 Slot = 0; Slot < State.OriginalMaterials.Num(); ++Slot)
+        if (Component->GetMaterial(Slot) != State.OriginalMaterials[Slot])
+        { Issue(TEXT("BINDING_CHANGED_BEFORE_OVERLAY"), Component); State.bUsable = false; return false; }
+    if (auto* ISM = Cast<UInstancedStaticMeshComponent>(Component))
+    {
+        if (ISM->NumCustomDataFloats != State.OriginalStride || ISM->GetInstanceCount() <= 0)
+        { Issue(TEXT("INSTANCE_LAYOUT_CHANGED_OR_EMPTY"), Component); State.bUsable = false; return false; }
+        State.OriginalCount = ISM->GetInstanceCount();
+        State.OriginalCustomData = ISM->PerInstanceSMCustomData;
+        TArray<float> Packed;
+        if (!RepackOpaque(State.OriginalCustomData, State.OriginalCount, State.OriginalStride, Packed))
+        { Issue(TEXT("INVALID_INSTANCE_CUSTOM_DATA"), Component); State.bUsable = false; return false; }
+        State.OriginalInstanceTransforms.SetNum(State.OriginalCount);
+        for (int32 I = 0; I < State.OriginalCount; ++I)
+            if (!ISM->GetInstanceTransform(I, State.OriginalInstanceTransforms[I], false))
+            { Issue(TEXT("INSTANCE_SNAPSHOT_FAILED"), Component); State.bUsable = false; return false; }
+        ISM->SetNumCustomDataFloats(State.OriginalStride + 1);
+        State.bBound = true;
+        if (!ISM->SetCustomData(0, State.OriginalCount - 1, Packed, true))
+        {
+            Issue(TEXT("INSTANCE_REPACK_FAILED"), Component);
+            ISM->SetNumCustomDataFloats(State.OriginalStride);
+            if (State.OriginalStride > 0)
+                bRestoreComplete &= ISM->SetCustomData(0, State.OriginalCount - 1, State.OriginalCustomData, true);
+            else ISM->MarkRenderStateDirty();
+            State.bBound = false; State.bUsable = false; return false;
+        }
+    }
+    for (int32 Slot = 0; Slot < State.OverlayMaterials.Num(); ++Slot)
+        if (auto* Dynamic = Cast<UMaterialInstanceDynamic>(State.OverlayMaterials[Slot]))
+        {
+            Dynamic->CopyMaterialUniformParameters(State.OriginalMaterials[Slot]);
+            if (!State.bInstanced) Dynamic->SetScalarParameterValue(OpacityParameter, 1.f);
+        }
+    for (int32 Slot = 0; Slot < State.OverlayMaterials.Num(); ++Slot) Component->SetMaterial(Slot, State.OverlayMaterials[Slot]);
+    State.bBound = true;
+    return true;
+}
+
+bool FHCM5VS4R3ObjectFade::RestoreState(FComponentState& State)
+{
+    if (!State.bBound) return true;
+    auto* Component = State.Component.Get();
+    if (!Component) { State.bBound = false; State.Opacities.Reset(); return true; }
+    bool Exact = true;
+    if (auto* ISM = Cast<UInstancedStaticMeshComponent>(Component))
+    {
+        TArray<float> CurrentPrefix;
+        if (ISM->NumCustomDataFloats != State.OriginalStride + 1
+            || !ExtractPrefix(ISM->PerInstanceSMCustomData, ISM->GetInstanceCount(), State.OriginalStride, CurrentPrefix))
+        { Issue(TEXT("RESTORE_LAYOUT_CONFLICT_DATA_UNTOUCHED"), Component); Exact = false; }
+        else
+        {
+            Exact = ISM->GetInstanceCount() == State.OriginalCount && SameData(CurrentPrefix, State.OriginalCustomData);
+            if (Exact) for (int32 I = 0; I < State.OriginalCount; ++I)
+            {
+                FTransform Current;
+                if (!ISM->GetInstanceTransform(I, Current, false) || !Current.Equals(State.OriginalInstanceTransforms[I], 0.))
+                { Exact = false; break; }
+            }
+            // If another runtime owner changed instances/data, preserve its current
+            // prefix instead of overwriting it with a stale snapshot. Report failure.
+            if (!Exact) Issue(TEXT("RESTORE_CONFLICT_PRESERVED_CURRENT_PREFIX"), Component);
+            const TArray<float>& RestoreData = Exact ? State.OriginalCustomData : CurrentPrefix;
+            ISM->SetNumCustomDataFloats(State.OriginalStride);
+            if (State.OriginalStride > 0 && ISM->GetInstanceCount() > 0)
+                Exact &= ISM->SetCustomData(0, ISM->GetInstanceCount() - 1, RestoreData, true);
+            else ISM->MarkRenderStateDirty();
+            Exact &= ISM->NumCustomDataFloats == State.OriginalStride && SameData(ISM->PerInstanceSMCustomData, RestoreData);
+        }
+    }
+    if (Component->GetNumMaterials() != State.OriginalMaterials.Num())
+    { Exact = false; Issue(TEXT("RESTORE_MATERIAL_SLOT_COUNT_CHANGED"), Component); }
+    for (int32 Slot = 0; Slot < State.OriginalMaterials.Num(); ++Slot)
+    {
+        if (Slot >= Component->GetNumMaterials()) { Exact = false; continue; }
+        auto* Current = Component->GetMaterial(Slot);
+        if (Current == State.OverlayMaterials[Slot] || Current == State.OriginalMaterials[Slot])
+            Component->SetMaterial(Slot, State.OriginalMaterials[Slot]);
+        else { Issue(TEXT("RESTORE_EXTERNAL_MATERIAL_CHANGE_PRESERVED"), Component); Exact = false; }
+    }
+    State.Opacities.Reset(); State.bBound = false;
+    State.bUsable &= Exact;
+    bRestoreComplete &= Exact;
+    return Exact;
+}
+
+bool FHCM5VS4R3ObjectFade::Restore()
+{
+    bool Complete = true;
+    for (auto& State : States) Complete &= RestoreState(State);
+    bRestoreComplete &= Complete;
+    return Complete && bRestoreComplete;
+}
+
+bool FHCM5VS4R3ObjectFade::HasOverrides() const
+{
+    for (const auto& State : States) if (State.bBound && State.Component.IsValid()) return true;
+    return false;
+}
+
+void FHCM5VS4R3ObjectFade::Update(const FMinimalViewInfo& FinalView, AHCM1Character* Character, float DeltaTime)
+{
+    Frame = GFrameCounter; HardUnavailable = 0; SoftUnavailable = 0; SoftBudgetUncovered = 0; TracesThisFrame = 0;
+    auto* InWorld = World.Get();
+    const auto* PC = Character ? Cast<AHCM1PlayerController>(Character->GetController()) : nullptr;
+    if (!bOptedIn || !OptIn(InWorld) || !Character || Character->GetWorld() != InWorld || !PC
+        || PC->GetPlayerMode() != EHCPlayerMode::OnFoot || PC->IsFirstPersonPerspective()
+        || !Character->GetAbilities() || Character->GetAbilities()->IsBowEquipped()
+        || (PC->GetViewTarget() && PC->GetViewTarget()->ActorHasTag(TEXT("VS4FixedReviewCamera")))
+        || !FMath::IsFinite(DeltaTime) || !FMath::IsFinite(FinalView.FOV)
+        || FinalView.Location.ContainsNaN() || FinalView.Rotation.ContainsNaN())
+    { Restore(); return; }
+    Elapsed += FMath::Clamp(DeltaTime, 0.f, .1f);
+    TMap<UPrimitiveComponent*, int32> Ready;
+    for (int32 I = 0; I < States.Num(); ++I)
+        if (States[I].bUsable && States[I].Component.IsValid()) Ready.Add(States[I].Component.Get(), I);
+    if (Ready.IsEmpty()) return;
+
+    FCollisionQueryParams Query(SCENE_QUERY_STAT(R3ObjectFade), true, Character);
+    for (TActorIterator<APawn> It(InWorld); It; ++It) Query.AddIgnoredActor(*It);
+    const FVector Eye = FinalView.Location;
+    const FRotationMatrix Basis(FinalView.Rotation);
+    const FVector Forward = Basis.GetUnitAxis(EAxis::X), Right = Basis.GetUnitAxis(EAxis::Y), Up = Basis.GetUnitAxis(EAxis::Z);
+    const double Aspect = FMath::IsFinite(FinalView.AspectRatio) && FinalView.AspectRatio > 0 ? FinalView.AspectRatio : 16. / 9.;
+    const double HalfWidth = FMath::Tan(FMath::DegreesToRadians(FMath::Clamp(FinalView.FOV, 30.f, 150.f)) * .5);
+    const FVector Hero = Character->GetActorLocation();
+    TArray<FVector> Ends;
+    Ends.Add(Hero + FVector(0,0,30));
+    Ends.Add(Hero + FVector(0,0,Character->BaseEyeHeight));
+    Ends.Add(Hero + FVector(0,0,30) + Right * 20.);
+    Ends.Add(Hero + FVector(0,0,30) - Right * 20.);
+    for (float X : {-.8f,-.4f,0.f,.4f,.8f}) for (float Y : {-.8f,-.4f,0.f,.4f,.8f})
+    {
+        const FVector Ray = (Forward + Right * (X * HalfWidth) + Up * (Y * HalfWidth / Aspect)).GetSafeNormal();
+        Ends.Add(Eye + Ray * (135. / FMath::Max(.1, FVector::DotProduct(Ray, Forward))));
+    }
+    // The old 1.35 m probe missed doorway faces that were still >1 m in
+    // front of the hero. Query only the central obstruction region farther
+    // out; selection remains exact physics hits, never all nearby scenery.
+    const int32 CentralRayStart = Ends.Num();
+    const double FeetZ = Hero.Z-Character->GetCapsuleComponent()->GetScaledCapsuleHalfHeight();
+    const double CentralDepth = FMath::Max(0.,FVector::DotProduct(Hero-Eye,Forward)-100.);
+    if(CentralDepth>135.)
+        for(float X:{-.6f,-.3f,0.f,.3f,.6f}) for(float Y:{-.7f,-.35f,0.f,.35f,.7f})
+        {
+            const FVector Ray=(Forward+Right*(X*HalfWidth)+Up*(Y*HalfWidth/Aspect)).GetSafeNormal();
+            Ends.Add(Eye+Ray*(CentralDepth/FMath::Max(.1,FVector::DotProduct(Ray,Forward))));
+        }
+    auto SelectItem = [&](UPrimitiveComponent* HitComponent, int32 HitItem)
+    {
+        const int32* Found = Ready.Find(HitComponent);
+        if (!Found) { Issue(TEXT("HIT_COMPONENT_NOT_COVERED"), HitComponent); return; }
+        auto& State = States[*Found];
+        // Keep ordinary scenery on its original opaque path until actually occluding.
+        if (!Bind(State)) return;
+        int32 Item = INDEX_NONE;
+        if (auto* ISM = Cast<UInstancedStaticMeshComponent>(State.Component.Get()))
+        {
+            Item = HitItem;
+            FTransform Current;
+            if (Item < 0 || Item >= State.OriginalCount || ISM->GetInstanceCount() != State.OriginalCount
+                || ISM->NumCustomDataFloats != State.OriginalStride + 1
+                || !ISM->GetInstanceTransform(Item, Current, false)
+                || !Current.Equals(State.OriginalInstanceTransforms[Item], 0.))
+            { Issue(TEXT("UNRESOLVED_OR_CHANGED_HIT_ITEM"), State.Component.Get()); return; }
+        }
+        State.Opacities.FindOrAdd(Item).LastHit = Elapsed;
+    };
+    auto Select = [&](const FHitResult& Hit) { SelectItem(Hit.GetComponent(), Hit.Item); };
+    // A reviewed, compact lantern has no physics body. Its oriented render bounds
+    // are a selection proxy, not collision evidence. Never select a whole ISM.
+    double SelectionRadius = 0.;
+    for (const FVector& End : Ends) SelectionRadius = FMath::Max(SelectionRadius, FVector::Dist(Eye, End));
+    for (auto& State : States) if (State.bWholeCompact && State.bUsable)
+    {
+        auto* C = State.Component.Get();
+        if (!C || !C->IsVisible() || C->GetOwner()->IsHidden()) continue;
+        const FBox LocalBounds = C->GetStaticMesh()->GetBoundingBox();
+        auto Intersects = [&](const FTransform& Pose)
+        {
+            for (const FVector& End : Ends)
+                if (SegmentCrossesCompactBounds(LocalBounds, Pose, Eye, End)) return true;
+            return false;
+        };
+        if (auto* ISM = Cast<UInstancedStaticMeshComponent>(C))
+        {
+            for (int32 Item : ISM->GetInstancesOverlappingSphere(Eye, float(SelectionRadius), true))
+            {
+                FTransform Pose;
+                if (ISM->GetInstanceTransform(Item, Pose, true) && Intersects(Pose)) SelectItem(C, Item);
+            }
+        }
+        else if (Intersects(C->GetComponentTransform())) SelectItem(C, INDEX_NONE);
+    }
+    for (auto& State : States) if (State.bSoft && !State.bWholeCompact && State.bUsable)
+        if (auto* C = State.Component.Get(); !C || !C->IsPhysicsStateCreated() || C->GetCollisionEnabled() == ECollisionEnabled::NoCollision)
+        { ++SoftUnavailable; Issue(TEXT("SOFT_RENDER_GEOMETRY_NOT_QUERYABLE"), C); }
+    for (auto& State : States) if (!State.bSoft && !State.bWholeCompact && State.bUsable)
+        if (auto* C = State.Component.Get(); !C || !C->IsQueryCollisionEnabled() || C->GetCollisionResponseToChannel(ECC_Camera) != ECR_Block)
+        { ++HardUnavailable; Issue(TEXT("HARD_CAMERA_QUERY_NOT_COVERED"), C); }
+
+    int32 SoftTraces = 0;
+    for (int32 RayIndex=0;RayIndex<Ends.Num();++RayIndex)
+    {
+        const FVector& End=Ends[RayIndex];
+        const bool CentralOnly=RayIndex>=CentralRayStart;
+        FHitResult HardHit;
+        const bool HardBlocked = InWorld->LineTraceSingleByChannel(HardHit, Eye, End, ECC_Camera, Query);
+        ++TracesThisFrame;
+        if (HardBlocked&&(!CentralOnly||HardHit.ImpactPoint.Z>FeetZ+30.)) Select(HardHit);
+        const double VisibleDistance = HardBlocked ? HardHit.Distance : FVector::Dist(Eye, End);
+        for (auto& State : States)
+        {
+            auto* Component = State.Component.Get();
+            if (!State.bSoft || State.bWholeCompact || !State.bUsable || !Component || !Component->IsPhysicsStateCreated()
+                || Component->GetCollisionEnabled() == ECollisionEnabled::NoCollision
+                || !FMath::LineBoxIntersection(Component->Bounds.GetBox(), Eye, End, End - Eye)) continue;
+            if (SoftTraces >= SoftTraceBudget)
+            { ++SoftBudgetUncovered; continue; }
+            FHitResult SoftHit;
+            ++TracesThisFrame; ++SoftTraces;
+            if (Component->LineTraceComponent(SoftHit, Eye, End, Query) && SoftHit.GetComponent() == Component
+                && SoftHit.Distance <= VisibleDistance + .01
+                && (!CentralOnly||SoftHit.ImpactPoint.Z>FeetZ+30.)) Select(SoftHit);
+        }
+    }
+    if (SoftBudgetUncovered > 0) Issue(TEXT("SOFT_QUERY_BUDGET_UNCOVERED"));
+    for (auto& State : States)
+    {
+        if (!State.bBound) continue;
+        auto* Component = State.Component.Get();
+        if (!Component) continue;
+        auto* ISM = Cast<UInstancedStaticMeshComponent>(Component);
+        bool Changed = false, Conflict = false;
+        for (auto It = State.Opacities.CreateIterator(); It; ++It)
+        {
+            if (ISM)
+            {
+                FTransform Current;
+                if (ISM->NumCustomDataFloats != State.OriginalStride + 1 || ISM->GetInstanceCount() != State.OriginalCount
+                    || It.Key() < 0 || It.Key() >= State.OriginalCount || !ISM->GetInstanceTransform(It.Key(), Current, false)
+                    || !Current.Equals(State.OriginalInstanceTransforms[It.Key()], 0.))
+                { Issue(TEXT("ACTIVE_INSTANCE_IDENTITY_CHANGED"), Component); Conflict = true; break; }
+            }
+            auto& Value = It.Value();
+            const float Next = StepOpacity(Value.Value, Elapsed - Value.LastHit <= ReleaseHoldSeconds, DeltaTime);
+            if (Next != Value.Value)
+            {
+                if (ISM)
+                {
+                    if (!ISM->SetCustomDataValue(It.Key(), State.OriginalStride, Next, false))
+                    { Issue(TEXT("INSTANCE_OPACITY_WRITE_FAILED"), Component); Conflict = true; break; }
+                    Changed = true;
+                }
+                else for (const auto& Material : State.OverlayMaterials)
+                    if (auto* Dynamic = Cast<UMaterialInstanceDynamic>(Material.Get())) Dynamic->SetScalarParameterValue(OpacityParameter, Next);
+                Value.Value = Next;
+            }
+            if (Next == 1.f && Elapsed - Value.LastHit > ReleaseHoldSeconds) It.RemoveCurrent();
+        }
+        if (Conflict) { RestoreState(State); State.bUsable = false; continue; }
+        if (Changed) ISM->MarkRenderStateDirty();
+        if (State.Opacities.IsEmpty()) bRestoreComplete &= RestoreState(State);
+    }
+}
+
+void FHCM5VS4R3ObjectFade::AddReferencedObjects(FReferenceCollector& Collector)
+{
+    for (auto& State : States)
+    {
+        Collector.AddReferencedObjects(State.OriginalMaterials);
+        Collector.AddReferencedObjects(State.OverlayMaterials);
+    }
+}
+
+TSharedRef<FJsonObject> FHCM5VS4R3ObjectFade::Observation(bool bIncludeIssues) const
+{
+    auto Result = MakeShared<FJsonObject>();
+    Result->SetStringField(TEXT("status"), TEXT("QA_PROTOTYPE_NOT_ACCEPTANCE"));
+    Result->SetNumberField(TEXT("engine_frame"), double(Frame));
+    Result->SetBoolField(TEXT("opted_in"), bOptedIn);
+    Result->SetBoolField(TEXT("has_overrides"), HasOverrides());
+    Result->SetBoolField(TEXT("exact_restore_so_far"), bRestoreComplete);
+    Result->SetNumberField(TEXT("verified_input_components"), VerifiedCount);
+    Result->SetNumberField(TEXT("prepared_components"), States.Num());
+    Result->SetNumberField(TEXT("prepared_from_observed_hard_policy"), ObservedHardPolicyCount);
+    Result->SetNumberField(TEXT("hard_unqueryable_components"), HardUnavailable);
+    Result->SetNumberField(TEXT("soft_unqueryable_components"), SoftUnavailable);
+    Result->SetNumberField(TEXT("soft_budget_uncovered_samples"), SoftBudgetUncovered);
+    Result->SetNumberField(TEXT("trace_calls"), TracesThisFrame);
+    Result->SetStringField(TEXT("soft_scope"), TEXT("Independent existing component physics traces only; no collision mutation; first hit per component/ray. Missing physics, alpha-mask mismatch and deeper same-ISM surfaces are not proven covered."));
+    Result->SetStringField(TEXT("compact_scope"), TEXT("Exact reviewed lantern mesh only; individual oriented render-bounds intersections with actual camera rays. Selection proxy, not triangle/alpha/collision acceptance. No collision changes."));
+    TArray<TSharedPtr<FJsonValue>> Targets;
+    for (const auto& State : States) for (const auto& Pair : State.Opacities)
+    {
+        auto Row = MakeShared<FJsonObject>();
+        Row->SetStringField(TEXT("component"), GetPathNameSafe(State.Component.Get()));
+        Row->SetNumberField(TEXT("hit_item"), Pair.Key);
+        Row->SetNumberField(TEXT("opacity"), Pair.Value.Value);
+        Row->SetNumberField(TEXT("seconds_since_hit"), Elapsed - Pair.Value.LastHit);
+        Row->SetStringField(TEXT("selection_policy"), State.bWholeCompact ? TEXT("REVIEWED_COMPACT_BOUNDS_WHOLE_INSTANCE") : TEXT("PHYSICS_HIT_LOCAL_CONE"));
+        Targets.Add(MakeShared<FJsonValueObject>(Row));
+    }
+    Result->SetArrayField(TEXT("selected_objects"), Targets);
+    Result->SetNumberField(TEXT("unresolved_or_conflict_count"),Issues.Num());
+    if(bIncludeIssues)
+    {
+        TArray<FString> SortedIssues = Issues.Array(); SortedIssues.Sort();
+        TArray<TSharedPtr<FJsonValue>> Messages;
+        for (const auto& Text : SortedIssues) Messages.Add(MakeShared<FJsonValueString>(Text));
+        Result->SetArrayField(TEXT("unresolved_or_conflicts"), Messages);
+    }
+    return Result;
+}
+
+FString FHCM5VS4R3ObjectFade::Diagnostics() const
+{
+    const auto Result=Observation(true);
+    FString Text; FJsonSerializer::Serialize(Result, TJsonWriterFactory<>::Create(&Text));
+    return Text;
+}
diff --git a/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFade.h b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFade.h
--- /dev/null
+++ b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFade.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include "CoreMinimal.h"
+#include "UObject/GCObject.h"
+
+class AHCM1Character;
+class FJsonObject;
+class UMaterialInterface;
+class UPrimitiveComponent;
+class UStaticMeshComponent;
+class UWorld;
+struct FMinimalViewInfo;
+
+// Runtime environment overlay. The caller owns verified environment membership and
+// the legacy MPC switch; this helper never changes collision or the camera pose.
+class HARBORCITY_API FHCM5VS4R3ObjectFade final : public FGCObject
+{
+public:
+    FHCM5VS4R3ObjectFade() = default;
+    virtual ~FHCM5VS4R3ObjectFade() override;
+    bool Initialize(UWorld* World, const TArray<UPrimitiveComponent*>& VerifiedEnvironmentComponents);
+    void Update(const FMinimalViewInfo& FinalView, AHCM1Character* Character, float DeltaTime);
+    bool Restore();
+    bool HasOverrides() const;
+    bool IsPrepared(const UPrimitiveComponent* Component) const;
+    FString Diagnostics() const;
+    TSharedRef<FJsonObject> Observation(bool bIncludeIssues) const;
+    virtual void AddReferencedObjects(FReferenceCollector& Collector) override;
+    virtual FString GetReferencerName() const override { return TEXT("FHCM5VS4R3ObjectFade"); }
+
+    static FString VariantPath(const FString& StaticBindingPath, int32 OriginalStride, bool bInstanced, bool bWholeCompact = false);
+    static bool IsReviewedCompactMesh(const UStaticMeshComponent* Component);
+    static bool SegmentCrossesCompactBounds(const FBox& LocalBounds, const FTransform& WorldTransform,
+        const FVector& Start, const FVector& End);
+    static bool RepackOpaque(const TArray<float>& Original, int32 Count, int32 Stride, TArray<float>& Out);
+    static bool ExtractPrefix(const TArray<float>& Packed, int32 Count, int32 Stride, TArray<float>& Out);
+    static float StepOpacity(float Current, bool bOccluding, float DeltaTime);
+
+private:
+    struct FOpacity
+    {
+        float Value = 1.f;
+        double LastHit = 0.;
+    };
+    struct FComponentState
+    {
+        TWeakObjectPtr<UStaticMeshComponent> Component;
+        TArray<TObjectPtr<UMaterialInterface>> OriginalMaterials;
+        TArray<TObjectPtr<UMaterialInterface>> OverlayMaterials;
+        TArray<float> OriginalCustomData;
+        TArray<FTransform> OriginalInstanceTransforms;
+        TMap<int32, FOpacity> Opacities;
+        int32 OriginalStride = 0;
+        int32 OriginalCount = 0;
+        bool bInstanced = false;
+        bool bSoft = false;
+        bool bWholeCompact = false;
+        bool bBound = false;
+        bool bUsable = true;
+    };
+
+    TWeakObjectPtr<UWorld> World;
+    TArray<FComponentState> States;
+    TSet<FString> Issues;
+    bool bOptedIn = false;
+    bool bRestoreComplete = true;
+    int32 VerifiedCount = 0;
+    int32 ObservedHardPolicyCount = 0;
+    int32 HardUnavailable = 0;
+    int32 SoftUnavailable = 0;
+    int32 SoftBudgetUncovered = 0;
+    int32 TracesThisFrame = 0;
+    uint64 Frame = 0;
+    double Elapsed = 0.;
+
+    bool OptIn(UWorld* InWorld) const;
+    bool Bind(FComponentState& State);
+    bool RestoreState(FComponentState& State);
+    void Issue(const FString& Reason, const UPrimitiveComponent* Component = nullptr);
+};
diff --git a/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFadeTests.cpp b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFadeTests.cpp
--- /dev/null
+++ b/HarborCity/Source/HarborCity/M5VS4/HCM5VS4R3ObjectFadeTests.cpp
@@ -0,0 +1,73 @@
+#include "HCM5VS4R3ObjectFade.h"
+#if WITH_DEV_AUTOMATION_TESTS
+#include "Misc/AutomationTest.h"
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHCR3ObjectFadeDataTest, "HarborCity.VS4.R3.ObjectFade.CustomDataRoundTrip",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FHCR3ObjectFadeDataTest::RunTest(const FString& Parameters)
+{
+    const TArray<float> Original = {11.f,12.f,21.f,22.f,31.f,32.f};
+    TArray<float> Packed, Restored;
+    TestTrue(TEXT("Repack keeps all source rows"), FHCM5VS4R3ObjectFade::RepackOpaque(Original,3,2,Packed));
+    TestTrue(TEXT("New column is opaque and independent"), Packed == TArray<float>({11.f,12.f,1.f,21.f,22.f,1.f,31.f,32.f,1.f}));
+    Packed[5] = .05f;
+    TestEqual(TEXT("Neighbor opacity remains opaque"),Packed[2],1.f);
+    TestEqual(TEXT("Other neighbor opacity remains opaque"),Packed[8],1.f);
+    TestTrue(TEXT("Extract source columns"),FHCM5VS4R3ObjectFade::ExtractPrefix(Packed,3,2,Restored));
+    TestTrue(TEXT("Source data exact round trip"),Restored == Original);
+    TestFalse(TEXT("Wrong source stride/count fails"),FHCM5VS4R3ObjectFade::RepackOpaque(Original,3,3,Packed));
+    TestFalse(TEXT("Overflow fails before allocation"),FHCM5VS4R3ObjectFade::RepackOpaque({},MAX_int32,2,Packed));
+    TestFalse(TEXT("Negative stride fails"),FHCM5VS4R3ObjectFade::RepackOpaque({},1,-1,Packed));
+    TestTrue(TEXT("Zero source stride reserves one column"),FHCM5VS4R3ObjectFade::RepackOpaque({},3,0,Packed));
+    TestTrue(TEXT("Zero stride rows all opaque"),Packed == TArray<float>({1.f,1.f,1.f}));
+    TestTrue(TEXT("Zero original data restores empty"),FHCM5VS4R3ObjectFade::ExtractPrefix(Packed,3,0,Restored));
+    TestTrue(TEXT("No original data invented"),Restored.IsEmpty());
+    return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHCR3ObjectFadeContractTest, "HarborCity.VS4.R3.ObjectFade.ContractAndTiming",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FHCR3ObjectFadeContractTest::RunTest(const FString& Parameters)
+{
+    const FString Root = TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/SpatialCamera/R3_ObjectFadeClean_01/");
+    TestEqual(TEXT("SMC UTF8 MD5 contract"),FHCM5VS4R3ObjectFade::VariantPath(TEXT("/Game/Example/M.M"),0,false),
+        Root+TEXT("M_R3O_58a1f1c3cb204327_S.M_R3O_58a1f1c3cb204327_S"));
+    TestEqual(TEXT("Original instance stride is variant identity"),FHCM5VS4R3ObjectFade::VariantPath(TEXT("/Game/Example/M.M"),2,true),
+        Root+TEXT("M_R3O_58a1f1c3cb204327_I2.M_R3O_58a1f1c3cb204327_I2"));
+    TestEqual(TEXT("Whole compact variant cannot overwrite the local variant"),FHCM5VS4R3ObjectFade::VariantPath(TEXT("/Game/Example/M.M"),2,true,true),
+        Root+TEXT("M_R3O_58a1f1c3cb204327_I2_W.M_R3O_58a1f1c3cb204327_I2_W"));
+    float Opacity = 1.f;
+    for(int32 I=0;I<2;++I)Opacity=FHCM5VS4R3ObjectFade::StepOpacity(Opacity,true,1.f/30.f);
+    TestTrue(TEXT("At thirty Hz opacity is at most ten percent in two frames"),Opacity<=.1f);
+    for(int32 I=0;I<4;++I)Opacity=FHCM5VS4R3ObjectFade::StepOpacity(Opacity,false,1.f/30.f);
+    TestTrue(TEXT("Release reaches opaque"),FMath::IsNearlyEqual(Opacity,1.f));
+    TestEqual(TEXT("Negative delta never advances"),FHCM5VS4R3ObjectFade::StepOpacity(.5f,true,-1.f),.5f);
+    FHCM5VS4R3ObjectFade Fade;
+    TestFalse(TEXT("No world never opts in"),Fade.Initialize(nullptr,{}));
+    TestFalse(TEXT("No opt-in never overlays"),Fade.HasOverrides());
+    TestTrue(TEXT("Unused restore is complete"),Fade.Restore());
+    return true;
+}
+
+IMPLEMENT_SIMPLE_AUTOMATION_TEST(FHCR3CompactSelectionTest, "HarborCity.VS4.R3.ObjectFade.CompactSelection",
+    EAutomationTestFlags::EditorContext | EAutomationTestFlags::EngineFilter)
+
+bool FHCR3CompactSelectionTest::RunTest(const FString& Parameters)
+{
+    const FBox Bounds(FVector(-10,-2,-4), FVector(10,2,4));
+    const FTransform Pose(FRotator(0,90,0), FVector(100,0,0), FVector(2,1,1));
+    auto Crosses = [&](const FVector& A, const FVector& B)
+    { return FHCM5VS4R3ObjectFade::SegmentCrossesCompactBounds(Bounds,Pose,A,B); };
+    TestTrue(TEXT("Rotated nonuniform scale crossing selects this instance"),Crosses(FVector(0,0,0),FVector(200,0,0)));
+    TestFalse(TEXT("Nearby but not crossing must stay opaque"),Crosses(FVector(0,30,0),FVector(200,30,0)));
+    TestFalse(TEXT("Behind camera does not cross a forward segment"),Crosses(FVector(200,0,0),FVector(300,0,0)));
+    TestFalse(TEXT("Beyond the hero endpoint is not selected"),Crosses(FVector(0,0,0),FVector(90,0,0)));
+    TestTrue(TEXT("Camera inside compact bounds is occluding"),Crosses(FVector(100,0,0),FVector(200,0,0)));
+    TestFalse(TEXT("Zero-length segment has no selection"),Crosses(FVector(100,0,0),FVector(100,0,0)));
+    TestFalse(TEXT("Degenerate scale is rejected"),FHCM5VS4R3ObjectFade::SegmentCrossesCompactBounds(
+        Bounds,FTransform(FQuat::Identity,FVector(100,0,0),FVector(0,1,1)),FVector::ZeroVector,FVector(200,0,0)));
+    return true;
+}
+#endif
