+    bool IsWritableEnvironmentDerivative(const UObject* Object)
+    {
+        if(!Object || !FParse::Param(FCommandLine::Get(), TEXT("R3ManagedAuthor"))
+            || !FParse::Param(FCommandLine::Get(), TEXT("R3WriteApply")))return false;
+        const FString Path=Object->GetPathName();
+        return (Path.StartsWith(TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/SpatialCamera/R3/"))
+                && FParse::Param(FCommandLine::Get(), TEXT("R3SpatialMaterials")))
+            || (Path.StartsWith(TEXT("/Game/HarborCity/M5VS4/Capital/R2_eae16c3bde68/SpatialCamera/R3_ObjectFade_01/"))
+                && FParse::Param(FCommandLine::Get(), TEXT("R3ObjectFadeMaterials")));
+    }
+}
+
+bool UHCM5VS4R3Materials::ConfigureEnvironmentMaskSetter(UObject* Expression)
+{
+    auto* Node = Cast<UMaterialExpressionSetMaterialAttributes>(Expression);
+    if (!IsWritableEnvironmentDerivative(Node)) return false;
+    Node->Modify();
+    Node->CreateOrGetInputAttribute(MP_OpacityMask);
+    Node->MarkPackageDirty();
+    return Node->GetInput(1) != nullptr;
+}
+
+bool UHCM5VS4R3Materials::FinalizeEnvironmentMask(UObject* MaterialAsset)
+{
+    auto* Material = Cast<UMaterial>(MaterialAsset);
+    if (!IsWritableEnvironmentDerivative(Material) || Material->BlendMode != BLEND_Masked) return false;
+    const auto* Input = Material->GetExpressionInputForProperty(Material->bUseMaterialAttributes ? MP_MaterialAttributes : MP_OpacityMask);
+    if (!Input || !Input->Expression) return false;
+    Material->Modify();
+    Material->bCanMaskedBeAssumedOpaque = false;
+    Material->PostEditChange();
+    Material->MarkPackageDirty();
+    return true;
+}
