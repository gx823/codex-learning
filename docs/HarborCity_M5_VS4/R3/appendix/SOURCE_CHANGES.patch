+#include "M5VS4/HCM5VS4R3VfxAuthoring.h"
+#include "NiagaraSystem.h"
+#include "Dom/JsonObject.h"
+#include "Serialization/JsonSerializer.h"
+#include "Serialization/JsonWriter.h"
+
+FString UHCM5VS4R3VfxAuthoring::FinishNiagaraCompilationJson(UNiagaraSystem* System)
+{
+    const TSharedRef<FJsonObject> Result = MakeShared<FJsonObject>();
+    Result->SetBoolField(TEXT("object_valid"), IsValid(System));
+    bool bRequested = false;
+    if (IsValid(System))
+    {
+#if WITH_EDITOR
+        if (GIsEditor && !IsRunningCommandlet())
+        {
+            System->RequestCompile(false);
+            System->WaitForCompilationComplete(true, false);
+            bRequested = true;
+        }
+#endif
+        Result->SetStringField(TEXT("asset"), System->GetPathName());
+        Result->SetBoolField(TEXT("ready_to_run"), System->IsReadyToRun());
+        Result->SetNumberField(TEXT("emitter_count"), System->GetEmitterHandles().Num());
+    }
+    Result->SetBoolField(TEXT("editor_compile_requested"), bRequested);
+    FString Json;
+    FJsonSerializer::Serialize(Result, TJsonWriterFactory<>::Create(&Json));
+    return Json;
+}
