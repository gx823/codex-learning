+FString UHCM5VS4R3Terrain::ReadCapitalTerrain(AActor* Actor)
+{
+    auto Result=MakeShared<FJsonObject>();Result->SetStringField(TEXT("status"),TEXT("NOT_RUN"));
+    auto* Landscape=CapitalLandscape(Actor);
+    auto* Info=Landscape?Landscape->GetLandscapeInfo():nullptr;
+    int32 X1=0,Y1=0,X2=0,Y2=0;
+    if(Info&&!Stopped()&&Info->GetLandscapeExtent(X1,Y1,X2,Y2)&&
+        X2>=X1&&Y2>=Y1&&int64(X2-X1+1)*(Y2-Y1+1)<=1025*1025)
+    {
+        const auto Layers=Landscape->GetEditLayers();
+        if(Layers.Num()<=8)
+        {
+            Result->SetStringField(TEXT("schema"),TEXT("R3_LANDSCAPE_LAYER_HEIGHTS_01"));
+            Result->SetStringField(TEXT("read_scope"),TEXT("ReadOnly Source mip copies; complete sample coverage and shared-edge agreement required; no editing interface, height writes or save"));
+            Result->SetStringField(TEXT("actor"),Landscape->GetPathName());
+            Result->SetStringField(TEXT("landscape_guid"),Landscape->GetLandscapeGuid().ToString());
+            TArray<TSharedPtr<FJsonValue>> Extent;
+            for(int32 V:{X1,Y1,X2,Y2})Extent.Add(MakeShared<FJsonValueNumber>(V));
+            Result->SetArrayField(TEXT("extent_inclusive"),Extent);
+            const FTransform T=Landscape->LandscapeActorToWorld();
+            TArray<TSharedPtr<FJsonValue>> Transform;
+            for(double V:{T.GetLocation().X,T.GetLocation().Y,T.GetLocation().Z,
+                T.GetRotation().X,T.GetRotation().Y,T.GetRotation().Z,T.GetRotation().W,
+                T.GetScale3D().X,T.GetScale3D().Y,T.GetScale3D().Z})Transform.Add(MakeShared<FJsonValueNumber>(V));
+            Result->SetArrayField(TEXT("transform_xyz_quaternion_scale"),Transform);
+            // These serialized fields are deliberately not exposed to Python properties.
+            auto Immutable=MakeShared<FJsonObject>();
+            Immutable->SetNumberField(TEXT("component_size_quads"),Landscape->ComponentSizeQuads);
+            Immutable->SetNumberField(TEXT("subsection_size_quads"),Landscape->SubsectionSizeQuads);
+            Immutable->SetNumberField(TEXT("num_subsections"),Landscape->NumSubsections);
+            TArray<ULandscapeComponent*> Components;
+            for(const auto& Pair:Info->XYtoComponentMap)if(Pair.Value)Components.AddUnique(Pair.Value);
+            Components.Sort([](const ULandscapeComponent& A,const ULandscapeComponent& B){return A.GetPathName()<B.GetPathName();});
+            TArray<TSharedPtr<FJsonValue>> ComponentRows;
+            for(const ULandscapeComponent* Component:Components)
+            {
+                auto Row=MakeShared<FJsonObject>();
+                Row->SetStringField(TEXT("path"),Component->GetPathName());
+                Row->SetNumberField(TEXT("component_size_quads"),Component->ComponentSizeQuads);
+                Row->SetNumberField(TEXT("subsection_size_quads"),Component->SubsectionSizeQuads);
+                Row->SetNumberField(TEXT("num_subsections"),Component->NumSubsections);
+                Row->SetStringField(TEXT("heightmap_texture"),GetPathNameSafe(Component->GetHeightmap(false)));
+                TArray<TSharedPtr<FJsonValue>> Weights;
+                for(const auto* Texture:Component->GetWeightmapTextures(false))Weights.Add(MakeShared<FJsonValueString>(GetPathNameSafe(Texture)));
+                Row->SetArrayField(TEXT("weightmap_textures"),Weights);
+                TArray<TSharedPtr<FJsonValue>> RawTextures;
+                for(const auto* Layer:Layers)if(Layer->NeedsPersistentTextures())
+                {
+                    auto Raw=MakeShared<FJsonObject>();Raw->SetStringField(TEXT("layer_guid"),Layer->GetGuid().ToString());
+                    const auto* Data=Component->GetLayerData(Layer->GetGuid());
+                    Raw->SetStringField(TEXT("heightmap_texture"),Data?GetPathNameSafe(Data->HeightmapData.Texture):TEXT("None"));
+                    TArray<TSharedPtr<FJsonValue>> RawWeights;
+                    for(const auto* Texture:Component->GetWeightmapTextures(Layer->GetGuid()))RawWeights.Add(MakeShared<FJsonValueString>(GetPathNameSafe(Texture)));
+                    Raw->SetArrayField(TEXT("weightmap_textures"),RawWeights);
+                    RawTextures.Add(MakeShared<FJsonValueObject>(Raw));
+                }
+                Row->SetArrayField(TEXT("raw_layer_textures"),RawTextures);
+                ComponentRows.Add(MakeShared<FJsonValueObject>(Row));
+            }
+            Immutable->SetArrayField(TEXT("components"),ComponentRows);
+            Result->SetObjectField(TEXT("immutable_landscape_fields"),Immutable);
+            Result->SetArrayField(TEXT("final_heights"),JsonHeights(ReadHeights(Info,FGuid(),X1,Y1,X2,Y2)));
+            TArray<TSharedPtr<FJsonValue>> LayerRows;
+            for(auto* Layer:Layers)
+            {
+                auto Row=MakeShared<FJsonObject>();
+                Row->SetStringField(TEXT("guid"),Layer->GetGuid().ToString());
+                Row->SetStringField(TEXT("class"),Layer->GetClass()->GetPathName());
+                Row->SetStringField(TEXT("name"),Layer->GetName().ToString());
+                Row->SetBoolField(TEXT("visible"),Layer->IsVisible());
+                Row->SetBoolField(TEXT("locked"),Layer->IsLocked());
+                Row->SetBoolField(TEXT("editable"),Layer->SupportsEditingTools());
+                Row->SetBoolField(TEXT("persistent_textures"),Layer->NeedsPersistentTextures());
+                Row->SetNumberField(TEXT("height_alpha"),Layer->GetAlphaForTargetType(ELandscapeToolTargetType::Heightmap));
+                if(Layer->NeedsPersistentTextures())
+                    Row->SetArrayField(TEXT("heights"),JsonHeights(ReadHeights(Info,Layer->GetGuid(),X1,Y1,X2,Y2)));
+                LayerRows.Add(MakeShared<FJsonValueObject>(Row));
+            }
+            Result->SetArrayField(TEXT("layers"),LayerRows);
+            Result->SetStringField(TEXT("status"),TEXT("OBSERVED_READ_ONLY"));
+        }
+    }
+    FString Text;FJsonSerializer::Serialize(Result,TJsonWriterFactory<>::Create(&Text));return Text;
+}
