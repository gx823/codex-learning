+bool R3MigrationTestSlot(const FString& Slot)
+{
+    if (!Slot.StartsWith(TEXT("HarborCity_M5_VS1_Test_VS3_")) || Slot.Len() > 100) return false;
+    for (TCHAR C : Slot) if (!FChar::IsAlnum(C) && C != TEXT('_')) return false;
+    return true;
+}
+
+bool R3ChapterTwoOrLater(FName Stage)
+{
+    const FName Stages[] = {TEXT("M5.Signal.Harbor"), TEXT("M5.Signal.Ambush"),
+        TEXT("M5.Signal.RecoverShard"), TEXT("M5.Signal.Tower"), TEXT("M5.Signal.Upload"),
+        TEXT("M5.Signal.Debrief"), TEXT("M5.Signal.Complete")};
+    for (FName Candidate : Stages) if (Stage == Candidate) return true;
+    return false;
+}
+
+bool R3StoryIdentityMatches(const FHCM5StorySaveData& Actual, const FHCM5StorySaveData& Expected)
+{
+    if (Actual.Version != Expected.Version || Actual.StageId != Expected.StageId
+        || Actual.bTrackMainStory != Expected.bTrackMainStory
+        || Actual.DefeatedInterceptorIds.Num() != Expected.DefeatedInterceptorIds.Num()) return false;
+    // ExportState traverses a TSet; compare identities without assuming its iteration order.
+    for (FName Id : Expected.DefeatedInterceptorIds)
+        if (!Actual.DefeatedInterceptorIds.Contains(Id)) return false;
+    return true;
+}
+}
+
+bool AHCM1TestRunner::AddM5VS4R3MigrationTests()
+{
+    struct FState
+    {
+        TStrongObjectPtr<UHCM1SaveGame> Old;
+        TWeakObjectPtr<AHCM5StoryDirector> Story;
+        TArray<uint8> Bytes;
+        FString Slot, File, ExpectedPosition;
+    };
+    auto S = MakeShared<FState>();
+    FParse::Value(FCommandLine::Get(), TEXT("R3CapitalSaveSlot="), S->Slot);
+    FParse::Value(FCommandLine::Get(), TEXT("R3MigrationExpectedPosition="), S->ExpectedPosition);
+    S->File = FPaths::ProjectSavedDir() / TEXT("SaveGames") / (S->Slot + TEXT(".sav"));
+
+    AddStep(TEXT("R3 real Capital R2 file prerequisites"), 4, [this, S]
+    {
+        const bool Allowed = HCM5VS3LocalQA() && FParse::Param(FCommandLine::Get(), TEXT("VS4R3Capture"))
+            && R3MigrationTestSlot(S->Slot) && R3MigrationTestSlot(PC->GetSaveSlotName())
+            && S->Slot != PC->GetSaveSlotName()
+            && (S->ExpectedPosition == TEXT("Preserve") || S->ExpectedPosition == TEXT("Guild"));
+        if (!RequireCamera(TEXT("R3 migration isolated source and explicit position expectation"), Allowed,
+            TEXT("local QA; R3 capture; distinct safe test slots; Preserve or Guild"),
+            S->Slot + TEXT(" -> ") + PC->GetSaveSlotName() + TEXT(" / ") + S->ExpectedPosition,
+            TEXT("A fixture authorization, no source file synthesized"))) return;
+
+        S->Old.Reset(Cast<UHCM1SaveGame>(UGameplayStatics::LoadGameFromSlot(S->Slot, 0)));
+        S->Story = AHCM5StoryDirector::Find(GetWorld());
+        const auto* Old = S->Old.Get();
+        const auto* Scene = PC->GetSceneSettings();
+        const auto* Preview = GetGameInstance()->GetSubsystem<UHCM5VS4PreviewSession>();
+        const bool Ready = Old && S->Story.IsValid() && Scene && Scene->PlayerStart && Preview
+            && PC->GetArmory() && PC->GetArmory()->IsAvailable()
+            && Old->Version == UHCM1SaveGame::CurrentVersion && Old->MapRevision == 2
+            && Old->LevelName == TEXT("L_CapitalR2") && Old->SceneId == Scene->SceneId
+            && Old->M5Story.Version == 1 && R3ChapterTwoOrLater(Old->M5Story.StageId)
+            && Old->ArmoryVersion > 0 && Old->EquippedSwordId == TEXT("CrimsonNight")
+            && Old->EquippedGunId == TEXT("Steamlock")
+            && Old->WeaponPaintIndices.FindRef(Old->EquippedGunId) == 7 && Old->MapTimePeriod == TEXT("Night")
+            && FFileHelper::LoadFileToArray(S->Bytes, *S->File) && !S->Bytes.IsEmpty()
+            && UHCM5VS4PreviewSession::IsCapital(GetWorld())
+            && UHCM5VS4PreviewSession::CapitalSaveRevision == 3 && !Preview->CapitalMigrationNoticeShown
+            && !UGameplayStatics::DoesSaveGameExist(PC->GetSaveSlotName(), 0);
+        RequireCamera(TEXT("R3 real changed-equipment chapter2 Capital revision2 save"), Ready,
+            TEXT("actual R2 F5 file; chapter2+ CrimsonNight/Steamlock paint7 Night; fresh R3 slot"),
+            FString::Printf(TEXT("source=%s bytes=%d revision=%d stage=%s"), *S->Slot, S->Bytes.Num(),
+                Old ? Old->MapRevision : -1, Old ? *Old->M5Story.StageId.ToString() : TEXT("missing")),
+            TEXT("A actual disk read; source provenance and SHA bound by launcher"));
+    });
+
+    const auto CheckSourceBytes = [this, S](const TCHAR* Phase)
+    {
+        TArray<uint8> After;
+        const bool Read = FFileHelper::LoadFileToArray(After, *S->File);
+        Check(FString::Printf(TEXT("R3 original R2 bytes unchanged %s"), Phase), Read && S->Bytes == After,
+            TEXT("entire original file still byte-identical, no rewrite or deletion"),
+            FString::Printf(TEXT("before=%d after=%d"), S->Bytes.Num(), After.Num()), TEXT("A disk bytes"));
+    };
+    const auto CheckLive = [this, S](const TCHAR* Phase)
+    {
+        const auto* Old = S->Old.Get();
+        if (!Old || !S->Story.IsValid()) return;
+        auto Live = TStrongObjectPtr<UHCM1SaveGame>(NewObject<UHCM1SaveGame>());
+        PC->GetArmory()->FillSave(Live.Get());
+        Check(FString::Printf(TEXT("R3 imported story %s"), Phase),
+            R3StoryIdentityMatches(S->Story->ExportState(), Old->M5Story),
+            TEXT("same version, stage, defeated IDs and tracking choice"), S->Story->GetDiagnostics(),
+            TEXT("B actual F9 then read-only story state"));
+        Check(FString::Printf(TEXT("R3 imported equipment and all paints %s"), Phase),
+            Live->ArmoryVersion == Old->ArmoryVersion && Live->EquippedSwordId == Old->EquippedSwordId
+            && Live->EquippedGunId == Old->EquippedGunId
+            && Live->WeaponPaintIndices.OrderIndependentCompareEqual(Old->WeaponPaintIndices),
+            TEXT("exact sword, gun, armory version and complete paint map"),
+            Live->EquippedSwordId.ToString() + TEXT("/") + Live->EquippedGunId.ToString(), TEXT("B F9, live armory readback"));
+        FName Time;
+        int32 TimeDirectors = 0;
+        for (TActorIterator<AHCM5VS2CornerTimeDirector> I(GetWorld()); I; ++I)
+        { Time = I->CurrentPeriod; ++TimeDirectors; }
+        Check(FString::Printf(TEXT("R3 imported time %s"), Phase), TimeDirectors == 1 && Time == Old->MapTimePeriod,
+            Old->MapTimePeriod.ToString(), Time.ToString(), TEXT("B F9 then actual time director"));
+
+        const FVector Actual = Character->GetActorLocation();
+        const auto* Scene = PC->GetSceneSettings();
+        const FVector Expected = S->ExpectedPosition == TEXT("Preserve") ? Old->PlayerTransform.GetLocation()
+            : Scene->PlayerStart->GetActorLocation();
+        const double Horizontal = FVector::Dist2D(Actual, Expected);
+        const double Vertical = FMath::Abs(Actual.Z - Expected.Z);
+        const bool PositionMatches = S->ExpectedPosition == TEXT("Preserve")
+            ? Horizontal <= 2.0 && Vertical <= 2.0 : Horizontal <= 50.0;
+        Check(FString::Printf(TEXT("R3 migration position %s"), Phase), PositionMatches,
+            S->ExpectedPosition == TEXT("Preserve") ? TEXT("original XY and Z within2cm after settle")
+                : TEXT("actual guild PlayerStart within50cm horizontally; no fixture teleport"),
+            FString::Printf(TEXT("expected_branch=%s actual=%s expected=%s horizontal_cm=%.9f vertical_cm=%.9f"),
+                *S->ExpectedPosition, *Actual.ToString(), *Expected.ToString(), Horizontal, Vertical), TEXT("B F9 settled transform"));
+    };
+
+    Tap(TEXT("Load"), 1);
+    AddStep(TEXT("R3 first migrated state and notice"), .2, [this, S, CheckSourceBytes, CheckLive]
+    {
+        CheckLive(TEXT("first F9"));
+        const auto* Preview = GetGameInstance()->GetSubsystem<UHCM5VS4PreviewSession>();
+        const FString Notice = PC->GetStatusMessage();
+        const FString BranchText = S->ExpectedPosition == TEXT("Preserve")
+            ? TEXT("合法位置已保留") : TEXT("原位置受阻，已移至公会门口");
+        Check(TEXT("R3 first migration notice reports expected position branch"),
+            Preview->CapitalMigrationNoticeShown && Notice.Contains(TEXT("R2 新王都进度")) && Notice.Contains(BranchText),
+            BranchText, Notice, TEXT("B F9 production notice and session state"));
+        Check(TEXT("R3 migration does not automatically write new slot"),
+            !UGameplayStatics::DoesSaveGameExist(PC->GetSaveSlotName(), 0), TEXT("no R3 file until explicit F5"),
+            PC->GetSaveSlotName(), TEXT("A disk existence"));
+        CheckSourceBytes(TEXT("after first F9"));
+    });
+    AddStep(TEXT("R3 migration notice capture"), .2, [this] { Capture(TEXT("R3_CAPITAL_IMPORT")); });
+    AddM3CaptureCompletion(TEXT("R3_CAPITAL_IMPORT"));
+    Tap(TEXT("Load"), 1);
+    AddStep(TEXT("R3 repeated import reads same real R2 source"), .2, [this, CheckSourceBytes, CheckLive]
+    {
+        CheckLive(TEXT("second F9"));
+        const auto* Preview = GetGameInstance()->GetSubsystem<UHCM5VS4PreviewSession>();
+        Check(TEXT("R3 repeated F9 succeeds without another migration notice"),
+            Preview->CapitalMigrationNoticeShown && PC->GetStatusMessage().StartsWith(TEXT("读取成功"))
+            && !PC->GetStatusMessage().Contains(TEXT("R2 新王都进度"))
+            && !UGameplayStatics::DoesSaveGameExist(PC->GetSaveSlotName(), 0),
+            TEXT("ordinary successful F9; once per session; still no new file"),
+            PC->GetStatusMessage(), TEXT("B second F9 plus disk absence, not merely absence of notice"));
+        CheckSourceBytes(TEXT("after second F9"));
+    });
+    Tap(TEXT("Save"), 1);
+    AddStep(TEXT("R3 explicit F5 separate slot and original bytes"), .2, [this, S, CheckSourceBytes]
+    {
+        auto Saved = TStrongObjectPtr<UHCM1SaveGame>(Cast<UHCM1SaveGame>(
+            UGameplayStatics::LoadGameFromSlot(PC->GetSaveSlotName(), 0)));
+        const auto* Old = S->Old.Get();
+        CheckSourceBytes(TEXT("after F5"));
+        Check(TEXT("R3 F5 writes revision3 separately with all imported semantic fields"),
+            Saved.IsValid() && Old && S->Slot != PC->GetSaveSlotName()
+            && Saved->Version == UHCM1SaveGame::CurrentVersion && Saved->MapRevision == 3
+            && Saved->LevelName == Old->LevelName && Saved->SceneId == Old->SceneId
+            && Saved->PlayerId == Old->PlayerId && R3StoryIdentityMatches(Saved->M5Story, Old->M5Story)
+            && Saved->ArmoryVersion == Old->ArmoryVersion && Saved->EquippedSwordId == Old->EquippedSwordId
+            && Saved->EquippedGunId == Old->EquippedGunId
+            && Saved->WeaponPaintIndices.OrderIndependentCompareEqual(Old->WeaponPaintIndices)
+            && Saved->MapTimePeriod == Old->MapTimePeriod,
+            TEXT("separate real F5 file, revision3 and unchanged progress/equipment/paint/time"),
+            FString::Printf(TEXT("new_slot=%s revision=%d status=%s"), *PC->GetSaveSlotName(),
+                Saved.IsValid() ? Saved->MapRevision : -1, *PC->GetStatusMessage()), TEXT("B F5 then actual disk deserialize"));
+        const FVector Expected = S->ExpectedPosition == TEXT("Preserve") && Old
+            ? Old->PlayerTransform.GetLocation() : PC->GetSceneSettings()->PlayerStart->GetActorLocation();
+        const double Horizontal = Saved.IsValid() ? FVector::Dist2D(Saved->PlayerTransform.GetLocation(), Expected) : MAX_dbl;
+        const double Vertical = Saved.IsValid() ? FMath::Abs(Saved->PlayerTransform.GetLocation().Z - Expected.Z) : MAX_dbl;
+        Check(TEXT("R3 F5 retains migrated position branch"), S->ExpectedPosition == TEXT("Preserve")
+            ? Horizontal <= 2.0 && Vertical <= 2.0 : Horizontal <= 50.0,
+            S->ExpectedPosition, FString::Printf(TEXT("horizontal_cm=%.9f vertical_cm=%.9f"), Horizontal, Vertical),
+            TEXT("A actual saved transform; not a synthetic expected save"));
+    });
+    return true;
+}
