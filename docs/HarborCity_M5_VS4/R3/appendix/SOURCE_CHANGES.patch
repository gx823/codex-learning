+FString CheckTerrainContext(AActor* Actor,const FString& LayerGuid,
+    int32 X1,int32 Y1,int32 X2,int32 Y2,int32 ExpectedCount,int32 ReplacementCount,
+    bool bRequireWrite,FCapitalTerrainPatch& Patch)
+{
+    Patch.ExpectedCount=ExpectedCount;Patch.ReplacementCount=ReplacementCount;
+    auto*& Landscape=Patch.Landscape;Landscape=CapitalLandscape(Actor);
+    if(!Landscape||Landscape->GetWorld()->WorldType!=EWorldType::Editor||Stopped()||
+        !FParse::Param(FCommandLine::Get(),TEXT("R3ManagedAuthor"))||
+        !FParse::Param(FCommandLine::Get(),TEXT("R3TerrainPatch"))||
+        (bRequireWrite&&!FParse::Param(FCommandLine::Get(),TEXT("R3WriteApply"))))
+        return Patch.Fail(TEXT("EDITOR_AND_AUTHORIZATION"),TEXT("Exact Capital editor, managed terrain flags, no stop marker and write authorization for Apply required"));
+    auto*& Info=Patch.Info;Info=Landscape->GetLandscapeInfo();
+    auto& Guid=Patch.Guid;const auto Layers=Landscape->GetEditLayers();
+    if(!Info||!FGuid::Parse(LayerGuid,Guid)||!Guid.IsValid()||Layers.Num()!=1||
+        Layers[0]->GetGuid()!=Guid||!Layers[0]->SupportsEditingTools()||
+        !Layers[0]->NeedsPersistentTextures()||Layers[0]->IsLocked()||!Layers[0]->IsVisible()||
+        !Landscape->GetBrushesForLayer(0).IsEmpty()||
+        !FMath::IsNearlyEqual(Layers[0]->GetAlphaForTargetType(ELandscapeToolTargetType::Heightmap),1.0f))
+        return Patch.Fail(TEXT("EDIT_LAYER_CONTRACT"),TEXT("One explicitly identified visible unlocked editable height layer with alpha 1 required"));
+    int32 A=0,B=0,C=0,D=0;
+    if(!Info->GetLandscapeExtent(A,B,C,D)||X1<A||Y1<B||X2>C||Y2>D||X1>X2||Y1>Y2||X2-X1<2||Y2-Y1<2||
+        int64(X2-X1+1)*(Y2-Y1+1)>1025*1025||ExpectedCount!=int64(X2-X1+1)*(Y2-Y1+1)||
+        ReplacementCount!=ExpectedCount)return Patch.Fail(TEXT("PATCH_EXTENT_AND_COUNT"),TEXT("Patch extent or sample count invalid"));
+    return FString();
+}
+
+FString PrepareTerrainPatch(AActor* Actor,const FString& LayerGuid,
+    int32 X1,int32 Y1,int32 X2,int32 Y2,const TArray<int32>& ExpectedBefore,
+    const TArray<int32>& Replacement,bool bRequireWrite,FCapitalTerrainPatch& Patch)
+{
+    const FString Error=CheckTerrainContext(Actor,LayerGuid,X1,Y1,X2,Y2,
+        ExpectedBefore.Num(),Replacement.Num(),bRequireWrite,Patch);
+    if(!Error.IsEmpty())return Error;
+    auto* Info=Patch.Info;auto* Landscape=Patch.Landscape;const FGuid& Guid=Patch.Guid;
+    const TArray<uint16> Before=ReadHeights(Info,Guid,X1,Y1,X2,Y2);
+    Patch.PreLayerCount=Before.Num();
+    // Preserve the former short circuit: do not read final heights when the layer count fails.
+    TArray<uint16> BeforeFinal;
+    if(Before.Num()==ExpectedBefore.Num())
+    {
+        BeforeFinal=ReadHeights(Info,FGuid(),X1,Y1,X2,Y2);Patch.PreFinalCount=BeforeFinal.Num();
+    }
+    if(Before.Num()!=ExpectedBefore.Num()||Before!=BeforeFinal)
+        return Patch.Fail(TEXT("PREWRITE_LAYER_FINAL_AGREEMENT"),TEXT("Editable layer differs from final heightfield; blend-aware recipe required"));
+    auto& Heights=Patch.Heights;Heights.Reserve(Replacement.Num());bool Changed=false;
+    const FTransform T=Landscape->LandscapeActorToWorld();
+    if(!T.GetRotation().GetAxisZ().Equals(FVector::UpVector,1.e-6))
+        return Patch.Fail(TEXT("UPRIGHT_HEIGHTFIELD"),TEXT("Terrain patch requires an upright heightfield"));
+    const FVector DX=T.TransformVector(FVector::ForwardVector),DY=T.TransformVector(FVector::RightVector);
+    const double MarginX=FMath::Abs(DX.X)+FMath::Abs(DY.X),MarginY=FMath::Abs(DX.Y)+FMath::Abs(DY.Y);
+    for(int32 I=0;I<Replacement.Num();++I)
+    {
+        if(ExpectedBefore[I]!=Before[I]||Replacement[I]<0||Replacement[I]>65535)
+            return Patch.Fail(TEXT("EXPECTED_HEIGHT_AND_UINT16"),TEXT("Expected native height changed or new value is outside uint16"));
+        const int32 X=X1+I%(X2-X1+1),Y=Y1+I/(X2-X1+1);
+        if(Replacement[I]!=Before[I])
+        {
+            if(X==X1||X==X2||Y==Y1||Y==Y2)return Patch.Fail(TEXT("UNCHANGED_PERIMETER"),TEXT("Patch perimeter must remain unchanged"));
+            const FVector P=T.TransformPosition(FVector(X,Y,0));
+            if(P.X>=-3000-MarginX&&P.X<=600+MarginX&&P.Y>=-11800-MarginY&&P.Y<=-7900+MarginY)
+                return Patch.Fail(TEXT("PROTECTED_TRAINING_GROUND"),TEXT("Protected training ground and approach margin cannot be reshaped"));
+            Changed=true;
+            ++Patch.ChangedSamples;
+        }
+        Heights.Add(uint16(Replacement[I]));
+    }
+    if(!Changed)return Patch.Fail(TEXT("NONEMPTY_CHANGE"),TEXT("No height changes requested"));
+    if(Stopped())return Patch.Fail(TEXT("STOP_BEFORE_WRITE"),TEXT("USER_STOPPED"));
+    return FString();
+}
+}
+
+FString UHCM5VS4R3Terrain::ValidateCapitalTerrainPatch(AActor* Actor,const FString& LayerGuid,
+    int32 X1,int32 Y1,int32 X2,int32 Y2,const TArray<int32>& ExpectedBefore,const TArray<int32>& Replacement)
+{
+    FCapitalTerrainPatch Patch;
+    const FString Error=PrepareTerrainPatch(Actor,LayerGuid,X1,Y1,X2,Y2,ExpectedBefore,Replacement,false,Patch);
+    if(Error.IsEmpty())Patch.Report(TEXT("PREWRITE_COMPLETE"),TEXT("Read-only prewrite checks passed; Apply not run"),true);
+    return Error;
+}
+
+FString UHCM5VS4R3Terrain::ApplyCapitalTerrainPatch(AActor* Actor,const FString& LayerGuid,
+    int32 X1,int32 Y1,int32 X2,int32 Y2,const TArray<int32>& ExpectedBefore,const TArray<int32>& Replacement)
+{
+    FCapitalTerrainPatch Patch;
+    const FString Error=PrepareTerrainPatch(Actor,LayerGuid,X1,Y1,X2,Y2,ExpectedBefore,Replacement,true,Patch);
+    if(!Error.IsEmpty())return Error;
+    auto* Landscape=Patch.Landscape;auto* Info=Patch.Info;const FGuid& Guid=Patch.Guid;
+    const auto& Heights=Patch.Heights;
+    Patch.Phase=TEXT("TRANSACTION_BEGIN");
+    const FScopedTransaction Transaction(NSLOCTEXT("HarborCity","R3TerrainPatch","R3 local terrain patch"));
+    Landscape->Modify();
+    {
+        // Same height edit interface as the landscape tool, without foliage snapping.
+        FLandscapeEditDataInterface Edit(Info,Guid);
+        TSet<ULandscapeComponent*> Components;
+        Edit.GetComponentsInRegion(X1,Y1,X2,Y2,&Components);
+        for(auto* Component:Components)Component->Modify();
+        Patch.Phase=TEXT("HEIGHT_WRITE_DISPATCHED");
+        Edit.SetHeightData(X1,Y1,X2,Y2,Heights.GetData(),0,false);
+        Patch.bHeightWriteReturned=true;Patch.Phase=TEXT("HEIGHT_WRITE_RETURNED");
+        Edit.Flush();
+        for(auto* Component:Components)Component->RequestHeightmapUpdate(true,true,true);
+    }
+    Landscape->MarkPackageDirty();
+    const TArray<uint16> PostLayer=ReadHeights(Info,Guid,X1,Y1,X2,Y2);Patch.PostLayerCount=PostLayer.Num();
+    if(PostLayer!=Heights)
+        return Patch.Fail(TEXT("POSTWRITE_LAYER_READBACK"),TEXT("Native layer readback mismatch; retain unsaved transaction for recovery"));
+    Patch.Phase=TEXT("RAW_VERIFIED_UPDATE_QUEUED");
+    Patch.Report(TEXT("RAW_APPLY_COMPLETE"),TEXT("Poll Verify on later editor ticks; collision and fresh-editor gates remain required"),true);
+    return FString();
+}
+
+FString UHCM5VS4R3Terrain::VerifyCapitalTerrainPatch(AActor* Actor,const FString& LayerGuid,
+    int32 X1,int32 Y1,int32 X2,int32 Y2,const TArray<int32>& ExpectedAfter)
+{
+    FCapitalTerrainPatch Patch;Patch.Phase=TEXT("READONLY_VERIFY");
+    auto Result=MakeShared<FJsonObject>();
+    Result->SetStringField(TEXT("schema"),TEXT("R3_TERRAIN_PATCH_VERIFY_01"));
+    Result->SetStringField(TEXT("actor"),GetPathNameSafe(Actor));
+    Result->SetStringField(TEXT("layer_guid"),LayerGuid);
+    Result->SetArrayField(TEXT("rect_inclusive"),{MakeShared<FJsonValueNumber>(X1),MakeShared<FJsonValueNumber>(Y1),
+        MakeShared<FJsonValueNumber>(X2),MakeShared<FJsonValueNumber>(Y2)});
+    Result->SetNumberField(TEXT("expected_count"),ExpectedAfter.Num());
+    Result->SetNumberField(TEXT("tolerance_cm"),2.0);
+    auto Finish=[&](const TCHAR* Status,const TCHAR* Gate,const FString& Reason)
+    {
+        Result->SetStringField(TEXT("status"),Status);Result->SetStringField(TEXT("gate"),Gate);
+        Result->SetStringField(TEXT("reason"),Reason);
+        Result->SetNumberField(TEXT("raw_count"),Patch.PostLayerCount);
+        Result->SetNumberField(TEXT("final_count"),Patch.PostFinalCount);
+        Result->SetNumberField(TEXT("layers_up_to_date"),Patch.LayersUpToDate);
+        if(FCString::Strcmp(Status,TEXT("FAILED"))==0)Patch.Report(Gate,*Reason,false);
+        FString Text;FJsonSerializer::Serialize(Result,TJsonWriterFactory<>::Create(&Text));return Text;
+    };
+    const FString Error=CheckTerrainContext(Actor,LayerGuid,X1,Y1,X2,Y2,
+        ExpectedAfter.Num(),ExpectedAfter.Num(),false,Patch);
+    if(!Error.IsEmpty())return Finish(TEXT("FAILED"),TEXT("VERIFY_CONTEXT"),Error);
+    TArray<uint16> Expected;Expected.Reserve(ExpectedAfter.Num());
+    for(int32 Value:ExpectedAfter)
+    {
+        if(Value<0||Value>65535)return Finish(TEXT("FAILED"),TEXT("VERIFY_UINT16"),TEXT("Expected height outside uint16"));
+        Expected.Add(uint16(Value));
+    }
+    const FTransform Transform=Patch.Landscape->LandscapeActorToWorld();
+    if(!Transform.IsValid()||!Transform.GetRotation().GetAxisZ().Equals(FVector::UpVector,1.e-6))
+        return Finish(TEXT("FAILED"),TEXT("UPRIGHT_HEIGHTFIELD"),TEXT("Terrain verification requires a finite upright heightfield"));
+    const TArray<uint16> Raw=ReadHeights(Patch.Info,Patch.Guid,X1,Y1,X2,Y2);Patch.PostLayerCount=Raw.Num();
+    if(Raw!=Expected)return Finish(TEXT("FAILED"),TEXT("VERIFY_RAW_HEIGHTS"),TEXT("Raw height samples differ from requested write"));
+    Patch.LayersUpToDate=Patch.Landscape->IsUpToDate()?1:0;
+    if(Patch.LayersUpToDate!=1)return Finish(TEXT("PENDING"),TEXT("MERGE_PENDING"),TEXT("Allow later editor ticks; no merge was forced by this read"));
+    const TArray<uint16> Final=ReadHeights(Patch.Info,FGuid(),X1,Y1,X2,Y2);Patch.PostFinalCount=Final.Num();
+    if(Final.Num()!=Expected.Num())return Finish(TEXT("FAILED"),TEXT("VERIFY_FINAL_COVERAGE"),TEXT("Final height sample coverage incomplete"));
+    double MaxErrorCm=0;
+    const double CmPerHeightUnit=FMath::Abs(Transform.GetScale3D().Z)*LANDSCAPE_ZSCALE;
+    if(!FMath::IsFinite(CmPerHeightUnit)||CmPerHeightUnit<=0)
+        return Finish(TEXT("FAILED"),TEXT("VERIFY_HEIGHT_SCALE"),TEXT("Landscape world height scale must be finite and nonzero"));
+    for(int32 I=0;I<Final.Num();++I)MaxErrorCm=FMath::Max(MaxErrorCm,FMath::Abs(int32(Final[I])-int32(Expected[I]))*CmPerHeightUnit);
+    Result->SetNumberField(TEXT("max_final_error_cm"),MaxErrorCm);
+    if(!FMath::IsFinite(MaxErrorCm)||MaxErrorCm>2.0)
+        return Finish(TEXT("FAILED"),TEXT("VERIFY_FINAL_HEIGHTS"),TEXT("Final merged world height differs by more than 2 cm"));
+    return Finish(TEXT("COMPLETE"),TEXT("FINAL_HEIGHTS_VERIFIED"),TEXT("Read-only final-height verification complete; caller collision and reload gates remain required"));
+}
