+FString UHCM5VS4R3Terrain::ReadCapitalTerrainCollision(AActor* Actor,const TArray<FVector>& WorldSamples)
+{
+    auto Result=MakeShared<FJsonObject>();Result->SetStringField(TEXT("status"),TEXT("NOT_RUN"));
+    auto* Landscape=CapitalLandscape(Actor);
+    auto* Info=Landscape?Landscape->GetLandscapeInfo():nullptr;
+    if(Info&&!Stopped()&&WorldSamples.Num()>0&&WorldSamples.Num()<=16384)
+    {
+        TArray<TSharedPtr<FJsonValue>> Rows;
+        FCollisionQueryParams Query(SCENE_QUERY_STAT(R3TerrainCollisionReadback),true);
+        for(const FVector& P:WorldSamples)
+        {
+            if(P.ContainsNaN()||Stopped())return TEXT("{\"status\":\"INVALID_OR_STOPPED\"}");
+            FHitResult Nearest;bool Found=false;
+            TArray<TSharedPtr<FJsonValue>> DirectComponents;
+            int32 DirectObserved=0,DirectUnknown=0,DirectCells=0,DirectHoles=0,DirectTested=0,DirectHits=0;
+            TSharedPtr<FJsonObject> DirectNearest;
+            for(const auto& Pair:Info->XYtoComponentMap)
+            {
+                auto* Component=Pair.Value;
+                auto* Collision=Component?Component->GetCollisionComponent():nullptr;
+                if(!Collision||Collision->GetCollisionEnabled()==ECollisionEnabled::NoCollision)continue;
+                const FBox Box=Collision->Bounds.GetBox();
+                if(P.X<Box.Min.X-.01||P.X>Box.Max.X+.01||P.Y<Box.Min.Y-.01||P.Y>Box.Max.Y+.01)continue;
+                FHitResult Hit;
+                if(Collision->LineTraceComponent(Hit,P+FVector(0,0,10000),P-FVector(0,0,10000),Query)&&
+                    (!Found||Hit.Distance<Nearest.Distance)){Nearest=Hit;Found=true;}
+                auto Direct=ReadDirectTerrainTriangles(Collision,P+FVector(0,0,10000),P-FVector(0,0,10000));
+                DirectComponents.Add(MakeShared<FJsonValueObject>(Direct));
+                if(Direct->GetStringField(TEXT("status"))==TEXT("OBSERVED_NATIVE_TRIANGLES_ONLY"))
+                {
+                    ++DirectObserved;DirectCells+=int32(Direct->GetNumberField(TEXT("valid_cells")));
+                    DirectHoles+=int32(Direct->GetNumberField(TEXT("hole_cells")));DirectTested+=int32(Direct->GetNumberField(TEXT("tested_triangles")));
+                    DirectHits+=int32(Direct->GetNumberField(TEXT("intersected_triangles")));
+                    if(Direct->GetBoolField(TEXT("hit"))&&(!DirectNearest.IsValid()||
+                        Direct->GetNumberField(TEXT("nearest_fraction"))<DirectNearest->GetNumberField(TEXT("nearest_fraction"))))DirectNearest=Direct;
+                }
+                else ++DirectUnknown;
+            }
+            auto Row=MakeShared<FJsonObject>();Row->SetBoolField(TEXT("hit"),Found);
+            Row->SetNumberField(TEXT("sample_x_cm"),P.X);Row->SetNumberField(TEXT("sample_y_cm"),P.Y);
+            Row->SetNumberField(TEXT("expected_z_cm"),P.Z);
+            if(Found)
+            {
+                Row->SetNumberField(TEXT("collision_z_cm"),Nearest.ImpactPoint.Z);
+                Row->SetNumberField(TEXT("absolute_error_cm"),FMath::Abs(Nearest.ImpactPoint.Z-P.Z));
+                Row->SetStringField(TEXT("component"),GetPathNameSafe(Nearest.GetComponent()));
+            }
+            auto Direct=MakeShared<FJsonObject>();
+            Direct->SetStringField(TEXT("status"),DirectObserved>0&&DirectUnknown==0?TEXT("OBSERVED_NATIVE_TRIANGLES_ONLY"):TEXT("NOT_RUN_INCOMPLETE_COMPONENT_COVERAGE"));
+            Direct->SetStringField(TEXT("scope"),TEXT("Independent same-segment diagnosis; main hit, owner and height acceptance unchanged"));
+            Direct->SetNumberField(TEXT("observed_components"),DirectObserved);Direct->SetNumberField(TEXT("not_run_components"),DirectUnknown);
+            Direct->SetNumberField(TEXT("valid_cells"),DirectCells);Direct->SetNumberField(TEXT("hole_cells"),DirectHoles);
+            Direct->SetNumberField(TEXT("tested_triangles"),DirectTested);Direct->SetNumberField(TEXT("intersected_triangles"),DirectHits);
+            Direct->SetBoolField(TEXT("observed_hit"),DirectNearest.IsValid());Direct->SetArrayField(TEXT("component_observations"),DirectComponents);
+            if(DirectNearest.IsValid())Direct->SetObjectField(TEXT("nearest_component_result"),DirectNearest);
+            Row->SetObjectField(TEXT("direct_triangle_diagnostic"),Direct);
+            Rows.Add(MakeShared<FJsonValueObject>(Row));
+        }
+        Result->SetStringField(TEXT("status"),TEXT("OBSERVED_READ_ONLY"));
+        Result->SetStringField(TEXT("scope"),TEXT("Complex native Landscape collision component traces only; no changes, other scene geometry is excluded"));
+        Result->SetBoolField(TEXT("layers_up_to_date"),Landscape->IsUpToDate());
+        Result->SetArrayField(TEXT("samples"),Rows);
+    }
+    FString Text;FJsonSerializer::Serialize(Result,TJsonWriterFactory<>::Create(&Text));return Text;
+}
