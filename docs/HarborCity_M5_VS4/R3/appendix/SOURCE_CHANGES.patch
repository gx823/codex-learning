+#include "HCM5VS4WindmillSail.h"
+#include "Components/SceneComponent.h"
+#include "Components/StaticMeshComponent.h"
+#include "Engine/StaticMesh.h"
+
+AHCM5VS4WindmillSail::AHCM5VS4WindmillSail()
+{
+    PrimaryActorTick.bCanEverTick = true;
+    SetRootComponent(CreateDefaultSubobject<USceneComponent>(TEXT("Root")));
+    Pivot = CreateDefaultSubobject<USceneComponent>(TEXT("Pivot"));
+    Pivot->SetupAttachment(GetRootComponent());
+    Sail = CreateDefaultSubobject<UStaticMeshComponent>(TEXT("Sail"));
+    Sail->SetupAttachment(Pivot);
+    Sail->SetMobility(EComponentMobility::Movable);
+    Sail->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    Sail->SetCanEverAffectNavigation(false);
+}
+
+void AHCM5VS4WindmillSail::ConfigureSail(UStaticMesh* Mesh)
+{
+    Sail->SetStaticMesh(Mesh);
+    // The inspected Village sail has its hub at the asset origin, shaft on +Y.
+    // The bounds centre is offset by the shaft and is not the authored pivot.
+    Pivot->SetRelativeLocation(FVector::ZeroVector);
+    Pivot->SetRelativeRotation(FRotator::ZeroRotator);
+    Sail->SetRelativeLocation(FVector::ZeroVector);
+    Sail->SetRelativeRotation(FRotator::ZeroRotator);
+    AngleDegrees = 0.;
+}
+
+void AHCM5VS4WindmillSail::BeginPlay()
+{
+    Super::BeginPlay();
+    ConfigureSail(Sail->GetStaticMesh());
+}
+
+void AHCM5VS4WindmillSail::Tick(float DeltaSeconds)
+{
+    Super::Tick(DeltaSeconds);
+    AngleDegrees = FMath::Fmod(AngleDegrees + double(DegreesPerSecond) * DeltaSeconds, 360.);
+    Pivot->SetRelativeRotation(FQuat(FVector(0., 1., 0.), FMath::DegreesToRadians(AngleDegrees)));
+}
