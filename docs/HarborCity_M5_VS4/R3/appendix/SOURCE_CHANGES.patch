+void FHCM5VS4R3Telemetry::FinishDepth(FDepthBatch& Batch)
+{
+    const auto Result = Batch.Result;
+    if (!Batch.Valid)
+    {
+        Result->SetStringField(TEXT("status"), TEXT("INVALID_GPU_READBACK"));
+        return;
+    }
+    const auto& View = Batch.View;
+    const auto& Full = Batch.Pixels[0];
+    const auto& Body = Batch.Pixels[1];
+    const auto& Environment = Batch.Pixels[2];
+    const FVector Forward = View.Rotation.Vector();
+    const FRotationMatrix Rotation(View.Rotation);
+    const FVector Right = Rotation.GetUnitAxis(EAxis::Y), Up = Rotation.GetUnitAxis(EAxis::Z);
+    const double TanH = FMath::Tan(FMath::DegreesToRadians(View.FOV * .5));
+    const double TanV = TanH * Height / Width;
+    const FVector Player = Batch.Player;
+    const double HeroDepth = FVector::DotProduct(Player - View.Location, Forward);
+    const double FeetZ = Batch.FeetZ;
+    int32 Near = 0, Middle = 0, HeroPixels = 0, Visible = 0, Invalid = 0;
+    for (int32 Y = 0; Y < Height; ++Y) for (int32 X = 0; X < Width; ++X)
+    {
+        const int32 I = Y * Width + X;
+        const double D = float(Environment[I].R), B = float(Body[I].R), F = float(Full[I].R);
+        if (FMath::IsFinite(B) && B > 0 && B < 65000)
+        {
+            ++HeroPixels;
+            Visible += FMath::IsFinite(F) && FMath::Abs(F - B) <= .5;
+        }
+        // Infinity is the scene-depth clear/sky value, not a near occluder.
+        if (FMath::IsNaN(D) || D < 0) { ++Invalid; continue; }
+        if (!FMath::IsFinite(D) || D >= 65000) continue;
+        Near += D < 100;
+        const double U = 2.0 * (X + .5) / Width - 1;
+        const double V = 1 - 2.0 * (Y + .5) / Height;
+        const FVector World = View.Location + D * (Forward + U * TanH * Right + V * TanV * Up);
+        Middle += FMath::Abs(U) <= .6 && FMath::Abs(V) <= .7 && D < HeroDepth - 100 && World.Z > FeetZ + 30;
+    }
+    Result->SetStringField(TEXT("status"), Invalid == 0 && HeroPixels >= 20 ? TEXT("MEASURED") : TEXT("INVALID_DEPTH_OR_HERO_REFERENCE"));
+    Result->SetNumberField(TEXT("width"), Width); Result->SetNumberField(TEXT("height"), Height);
+    Result->SetNumberField(TEXT("near_pixels"), Near); Result->SetNumberField(TEXT("middle_pixels"), Middle);
+    Result->SetNumberField(TEXT("near_fraction"), double(Near) / (Width * Height));
+    Result->SetNumberField(TEXT("middle_fraction"), double(Middle) / (Width * Height));
+    Result->SetNumberField(TEXT("hero_reference_pixels"), HeroPixels);
+    Result->SetNumberField(TEXT("hero_visible_pixels"), Visible);
+    Result->SetNumberField(TEXT("hero_visible_fraction"), HeroPixels > 0 ? double(Visible) / HeroPixels : -1);
+    Result->SetNumberField(TEXT("invalid_pixels"), Invalid);
+    Result->SetNumberField(TEXT("hero_forward_depth_cm"), HeroDepth);
+    Result->SetStringField(TEXT("scope"), TEXT("Same native capture game frame; three main-renderer depth passes with separate targets; GPU copies at native render-frame end, asynchronous read without retiming. Full, body-only and world with hero and attached actors hidden. No MP4 inference."));
+    Result->SetNumberField(TEXT("copy_render_frame"), Batch.CopyRenderFrame);
+    Result->SetNumberField(TEXT("readback_completed_engine_frame"), double(GFrameCounter));
+}
