+        S->Ready=true;
+        FFileHelper::SaveStringToFile(FString::Printf(TEXT("private_route=%s\nsha256=%s\nsetup=one start placement per independent direction; no endpoint placement\npickup=separate unchanged m5_vs3_ride_probe; this case does not complete quests\n"),*Canonical,*RouteHash),*(RunDirectory/TEXT("R3_BRIDGE_SOURCE.txt")));
+    });
+    auto Fail=[this,S](const FString& Reason)
