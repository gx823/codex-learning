+            }
+            RequireCamera(Name+TEXT(" actual leaf state"),Door&&Door->IsOpenRequested()==Open&&!Door->IsDoorMoving()
+                &&FMath::IsNearlyEqual(Door->GetOpenFraction(),Open?1.f:0.f,.001f),
+                Open?TEXT("E opened original owned leaf"):TEXT("E closed original owned leaf"),
+                Door?FString::SanitizeFloat(Door->GetOpenFraction()):TEXT("missing"),TEXT("B no direct state setter"));
+        });
+    };
+    for(const auto& Room:Rooms)
+    {
+        AddStep(Room.Id+TEXT(" initial outside setup"),2,[this,S,Room,Observe,bEight,bB019,bThrone]
+        {
+            S->Door.Reset();S->Doors.Reset();int32 Matches=0;bool AllLeavesUnique=true;
+            for(const FName Id:Room.DoorIds)
+            {
+                TWeakObjectPtr<AHCM5VS4R3Door> Leaf;int32 LeafMatches=0;
+                for(TActorIterator<AHCM5VS4R3Door>I(GetWorld());I;++I)if(I->StableId==Id){Leaf=*I;++LeafMatches;}
+                AllLeavesUnique&=LeafMatches==1;S->Doors.Add(Leaf);
+                if(Id==Room.DoorId){S->Door=Leaf;Matches=LeafMatches;}
+            }
+            bool RootFound=false;for(TActorIterator<AActor>I(GetWorld());I;++I)RootFound|=I->GetPathName()==Room.Root;
+            if(bB019)
+            {
+                bool FloorOwnerFound=false;
+                for(TActorIterator<AActor>I(GetWorld());I;++I)if(I->GetPathName()==Room.Root)
+                {
+                    TInlineComponentArray<UInstancedStaticMeshComponent*> Components;I->GetComponents(Components);
+                    for(auto* Component:Components)FloorOwnerFound|=Component&&Component->GetPathName()==Room.SharedFloorComponent
+                        &&Component->GetStaticMesh()!=nullptr&&Component->GetInstanceCount()>0;
+                }
+                RootFound=RootFound&&FloorOwnerFound;
+            }
+            if(bThrone)
+            {
+                const bool SavedDoor=Matches==1&&S->Door.IsValid()&&S->Door->GetPathName()==Room.SavedDoorActor
+                    &&S->Door->DoorLeaf&&S->Door->DoorLeaf->GetPathName()==Room.SavedDoorComponent
+                    &&AllLeavesUnique&&InteriorLeavesInState(S->Doors,false);
+                if(!RequireCamera(Room.Id+TEXT(" exact saved fresh leaf"),SavedDoor,
+                    TEXT("same saved actor/component and one unpaired initially closed complete leaf"),
+                    GetPathNameSafe(S->Door.Get()),TEXT("A saved binding")))return;
+                for(const auto& Support:Room.FloorSupports)
+                {
+                    UStaticMeshComponent* FloorComponent=nullptr;int32 FloorOwnerMatches=0;
+                    for(TActorIterator<AActor>I(GetWorld());I;++I)if(I->GetPathName()==Support.Owner)
+                    {
+                        TInlineComponentArray<UStaticMeshComponent*> Components;I->GetComponents(Components);
+                        for(auto* Component:Components)if(Component&&Component->GetPathName()==Support.Component)
+                        {
+                            ++FloorOwnerMatches;FloorComponent=Component;
+                        }
+                    }
+                    FHitResult FloorHit;FCollisionQueryParams FloorQuery(SCENE_QUERY_STAT(R3ThroneSupport),false,Character);
+                    for(TActorIterator<APawn>I(GetWorld());I;++I)FloorQuery.AddIgnoredActor(*I);
+                    const bool FloorHitValid=GetWorld()->LineTraceSingleByChannel(FloorHit,Support.Point+FVector(0,0,120),
+                        Support.Point-FVector(0,0,180),ECC_WorldStatic,FloorQuery)&&!FloorHit.bStartPenetrating;
+                    const bool FloorBound=FloorOwnerMatches==1&&FloorComponent&&FloorComponent->GetStaticMesh()
+                        &&FloorComponent->GetStaticMesh()->GetPathName()==Support.Mesh&&FloorHitValid
+                        &&FloorHit.GetComponent()==FloorComponent&&FMath::Abs(FloorHit.ImpactPoint.Z-Support.Point.Z)<=2;
+                    if(!RequireCamera(Room.Id+TEXT(" retained original floor ")+Support.Component,FloorBound,
+                        TEXT("saved owner/mesh and actual original three-point collision floor within2cm"),
+                        FString::Printf(TEXT("matches=%d expected=%s actual=%s z=%.6f expected_z=%.6f"),FloorOwnerMatches,
+                            *Support.Component,*GetPathNameSafe(FloorHit.GetComponent()),FloorHit.ImpactPoint.Z,Support.Point.Z),
+                        TEXT("A original supports")))return;
+                }
+            }
+            if(!RequireCamera(Room.Id+TEXT(" saved door/root"),Matches==1&&RootFound&&S->Door->IsDoorConfigured()
+                &&!S->Door->IsOpenRequested()&&S->Door->GetOpenFraction()==0
+                &&(!bEight||(AllLeavesUnique&&InteriorLeavesInState(S->Doors,false))),
+                bEight?TEXT("exact one saved initially closed primary door and retained source room; eight-room leaves unique and paired"):
+                    TEXT("exact one saved initially closed door and retained source room"),
+                FString::Printf(TEXT("door_matches=%d root=%d"),Matches,RootFound),TEXT("A")))return;
+            FHitResult Floor;FCollisionQueryParams Q(SCENE_QUERY_STAT(R3InteriorStart),false,Character);
+            for(TActorIterator<APawn>I(GetWorld());I;++I)Q.AddIgnoredActor(*I);
+            const bool Ground=GetWorld()->LineTraceSingleByChannel(Floor,Room.Outside+FVector(0,0,120),Room.Outside-FVector(0,0,180),ECC_WorldStatic,Q)
+                &&!Floor.bStartPenetrating;
+            if(!RequireCamera(Room.Id+TEXT(" real outside floor"),Ground,TEXT("actual collision at independent room test start"),
+                GetPathNameSafe(Floor.GetComponent()),TEXT("A setup only")))return;
+            PlaceCharacter(Floor.ImpactPoint+FVector(0,0,Character->GetCapsuleComponent()->GetScaledCapsuleHalfHeight()+3),
+                (Room.Inside-Room.Outside).Rotation().Yaw);
+            PC->SetViewTarget(Character);Observe(TEXT("initial_outside_setup"));
+        });
+        AddToggle(Room.Id+TEXT(" outside open"),true);
+        if(bThrone)AddCrossing(Room.Id+TEXT(" original entry inward"),Room.Entry);
+        AddCrossing(Room.Id+TEXT(" enter"),Room.Inside);
+        // Bar01's normal room destination is beyond the 240 cm E range.
+        // Walk back inside the doorway; retain the full room traversal above.
+        if(bBar01)AddCrossing(Room.Id+TEXT(" approach door from inside"),FMath::Lerp(Room.Outside,Room.Inside,.55));
+        AddToggle(Room.Id+TEXT(" inside close"),false);
+        AddStep(Room.Id+TEXT(" actual indoor F"),.12,[this,Room,Observe]
+        {
+            auto* Flight=PC->GetFlightComponent();auto* Combat=Character->GetCombatComponent();bool InRegion=false,InNoFlight=false;
+            for(TActorIterator<AHCM3NavRegion>I(GetWorld());I;++I)
+                if(Room.RegionIds.Contains(I->StableId)&&I->ContainsPoint(Character->GetActorLocation()))InRegion=true;
+            if(Flight&&Flight->GetFlightBounds())for(const FBox& Box:Flight->GetFlightBounds()->NoTakeoffVolumes)
+                InNoFlight|=Box.IsValid&&Box.IsInsideOrOn(Character->GetActorLocation());
+            const bool Ready=InRegion&&InNoFlight&&Flight&&Flight->IsFlightAvailable()&&!Flight->IsFlying()
+                &&Flight->GetStamina()>=30&&Character->GetCharacterMovement()->IsMovingOnGround()
+                &&Combat&&Combat->GetPlayerHealth()>0&&!Combat->IsAttacking()&&!Combat->IsReloading();
+            if(!RequireCamera(Room.Id+TEXT(" indoor flight input readiness"),Ready,
+                TEXT("walked into real room, saved volume, grounded, normal living flight-ready state; no stamina/health writes"),
+                Flight?Flight->GetFlightDiagnostics():TEXT("missing flight"),TEXT("A")))return;
+            Observe(TEXT("inside_before_F"));Hold(TEXT("FlightToggle"),FInputActionValue(true));
+        },[this]{Release(TEXT("FlightToggle"));});
+        AddStep(Room.Id+TEXT(" indoor rejection settle"),.3,[]{},[this,Room,Observe]
+        {
+            auto* Flight=PC->GetFlightComponent();Observe(TEXT("inside_after_F"));
+            RequireCamera(Room.Id+TEXT(" ordinary F rejects indoor takeoff"),Flight&&!Flight->IsFlying()
+                &&PC->GetStatusMessage()==TEXT("\u5ba4\u5185\u65e0\u6cd5\u8d77\u98de\uff0c\u8bf7\u5148\u5230\u5ba4\u5916\u3002"),
+                TEXT("exact existing indoor rejection after actual F"),PC->GetStatusMessage(),TEXT("B actual input, not volume-only acceptance"));
+        });
+        AddToggle(Room.Id+TEXT(" inside open"),true);
+        if(bThrone)AddCrossing(Room.Id+TEXT(" original entry outward"),Room.Entry);
+        AddCrossing(Room.Id+TEXT(" exit"),Room.Outside);
+        AddToggle(Room.Id+TEXT(" outside close"),false);
+    }
+    AddStep(TEXT("R3 interior input cleanup"),.1,Cleanup);
+    return true;
+}
