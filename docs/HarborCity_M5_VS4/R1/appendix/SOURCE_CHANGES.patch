+void UHCM5VS3Abilities::CaptureStarBowSourceHands(UPoseableMeshComponent* Mesh)
+{
+    if(!SourceReview()||!Mesh)return;
+    const FHCStarBowClip C=GetStarBowClip();const float Alpha=FMath::Clamp(StarBow.BlendAge/.08f,0.f,1.f);
+    auto Source=[this](const FString& Name)->UAnimSequence*{
+        const FString Path=TEXT("/Game/HarborCity/M5VS4/Bow/Native/Arms/Animations/A_FP_")+Name;
+        auto& Seq=BowSequences.FindOrAdd(Path);if(!Seq)Seq=LoadObject<UAnimSequence>(nullptr,*Path);return Seq;
+    };
+    auto* A=Source(C.Name);auto* B=C.Secondary.IsEmpty()?nullptr:Source(C.Secondary);
+    auto* Prev=Alpha<1?Source(StarBow.Previous.Name):nullptr;
+    auto* PrevB=Prev&&!StarBow.Previous.Secondary.IsEmpty()?Source(StarBow.Previous.Secondary):nullptr;
+    if(!A){StarBowSourceError=FVector(-1);return;}
+    auto Position=[&](FName Bone){
+        FTransform Pose=SampleCS(A,Bone,C.Time);
+        if(B)Pose=Mix(Pose,SampleCS(B,Bone,C.SecondaryTime),C.SecondaryWeight);
+        if(Prev){FTransform Old=SampleCS(Prev,Bone,StarBow.Previous.Time);if(PrevB)Old=Mix(Old,SampleCS(PrevB,Bone,StarBow.Previous.SecondaryTime),StarBow.Previous.SecondaryWeight);Pose=Mix(Old,Pose,Alpha);}
+        return Pose.GetLocation();
+    };
+    FTransform SourceMount=Mesh->GetComponentTransform();SourceMount.SetScale3D(FVector::OneVector);
+    FVector Errors=FVector::ZeroVector;
+    for(int32 Side=0;Side<2;++Side)
+    {
+        const TCHAR* S=Side?TEXT("r"):TEXT("l"),*T=Side?TEXT("R"):TEXT("L");
+        const FName Hand(*FString::Printf(TEXT("Hand_%s"),T)),Original(*FString::Printf(TEXT("hand_%s"),S));
+        const FName Middle(*FString::Printf(TEXT("MiddleProximal_%s"),T)),SourceMiddle(*FString::Printf(TEXT("middle_01_%s"),S));
+        const FVector Palm=FMath::Lerp(Mesh->GetSocketLocation(Hand),Mesh->GetSocketLocation(Middle),.7);
+        Errors[Side]=FVector::Dist(Palm,SourceMount.TransformPosition(FMath::Lerp(Position(Original),Position(SourceMiddle),.7)));
+        const TCHAR* Stems[]={TEXT("thumb"),TEXT("index"),TEXT("middle"),TEXT("ring"),TEXT("pinky")};
+        const TCHAR* Targets[]={TEXT("Thumb"),TEXT("Index"),TEXT("Middle"),TEXT("Ring"),TEXT("Little")};
+        const TCHAR* Joints[]={TEXT("Proximal"),TEXT("Intermediate"),TEXT("Distal")};
+        for(int32 Finger=0;Finger<5;++Finger)for(int32 Joint=0;Joint<3;++Joint)
+        {
+            const FName From(*FString::Printf(TEXT("%s_%02d_%s"),Stems[Finger],Joint+1,S));
+            const FName To(*FString::Printf(TEXT("%s%s_%s"),Targets[Finger],Joints[Joint],T));
+            Errors.Z=FMath::Max(Errors.Z,FVector::Dist(Mesh->GetSocketLocation(To),SourceMount.TransformPosition(Position(From))));
+        }
+    }
+    StarBowSourceError=Errors;
+    StarBowSourceRow=FString::Printf(TEXT("%.6f,%llu,%s,%.6f,%s,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f\n"),GetWorld()->GetTimeSeconds(),GFrameCounter,*C.Name,C.Time,*C.Secondary,C.SecondaryWeight,Alpha,FMath::RadiansToDegrees(StarBow.AimCorrection.GetAngle()),Errors.X,Errors.Y,Errors.Z);
+}
