+OUT=Path(m[1] or m[2]); R=dict(status='RUNNING',materials=[],runtime='NOT_RUN')
+done={}
+
+def fade(source):
+    key=source.get_path_name()
+    if key in done:return done[key]
+    name='M_'+hashlib.md5(key.encode('ascii')).hexdigest()
+    path=ROOT+'/'+name
+    result=A.load_asset(path) if A.does_asset_exist(path) else A.duplicate_asset(key.split('.')[0],path)
+    assert result,key
+    if A.get_metadata_tag(result,'VS4CameraFadeComplete')=='1':
+        if isinstance(result,U.Material):
+            E.set_material_usage(result,U.MaterialUsage.MATUSAGE_SKELETAL_MESH)
+            E.recompile_material(result);assert A.save_loaded_asset(result,False)
+        elif isinstance(result,U.MaterialInstanceConstant):fade(source.get_editor_property('parent'))
+        done[key]=result;return result
+    done[key]=result
+    if isinstance(result,U.MaterialInstanceConstant):
+        E.set_material_instance_parent(result,fade(source.get_editor_property('parent')))
+        overrides=result.get_editor_property('base_property_overrides')
+        overrides.set_editor_property('override_blend_mode',False)
+        result.set_editor_property('base_property_overrides',overrides)
+        E.update_material_instance(result)
+    else:
+        assert isinstance(result,U.Material),key
+        attributes=result.get_editor_property('use_material_attributes')
+        mode=result.get_editor_property('blend_mode')
+        masked=mode in (U.BlendMode.BLEND_OPAQUE,U.BlendMode.BLEND_MASKED)
+        prop=U.MaterialProperty.MP_OPACITY_MASK if masked else U.MaterialProperty.MP_OPACITY
+        old=E.get_material_property_input_node(result,prop)
+        output=E.get_material_property_input_node_output_name(result,prop) if old else ''
+        original_attributes=None
+        if attributes:
+            original_attributes=E.get_material_property_input_node(result,U.MaterialProperty.MP_MATERIAL_ATTRIBUTES)
+            attribute_output=E.get_material_property_input_node_output_name(result,U.MaterialProperty.MP_MATERIAL_ATTRIBUTES)
+            assert original_attributes,key
+            old=E.create_material_expression(result,U.MaterialExpressionBreakMaterialAttributes)
+            assert E.connect_material_expressions(original_attributes,attribute_output,old,'Attr')
+            output='OpacityMask' if masked else 'Opacity'
+        parameter=E.create_material_expression(result,U.MaterialExpressionScalarParameter)
+        parameter.set_editor_property('parameter_name','HCCameraFadeAmount')
+        parameter.set_editor_property('default_value',0.)
+        parameter.set_editor_property('use_custom_primitive_data',True)
+        parameter.set_editor_property('primitive_data_index',24)
+        inverse=E.create_material_expression(result,U.MaterialExpressionOneMinus)
+        assert E.connect_material_expressions(parameter,'',inverse,str(E.get_material_expression_input_names(inverse)[0]))
+        alpha=inverse
+        if masked:
+            dither=E.create_material_expression(result,U.MaterialExpressionMaterialFunctionCall)
+            dither.set_editor_property('material_function',U.load_asset('/Engine/Functions/Engine_MaterialFunctions02/Utility/DitherTemporalAA'))
+            assert E.connect_material_expressions(alpha,'',dither,'Alpha Threshold')
+            alpha=dither;result.set_editor_property('blend_mode',U.BlendMode.BLEND_MASKED)
+        if old:
+            multiply=E.create_material_expression(result,U.MaterialExpressionMultiply)
+            assert E.connect_material_expressions(old,output,multiply,'A')
+            assert E.connect_material_expressions(alpha,'',multiply,'B')
+            alpha=multiply
+        if attributes:
+            setter=E.create_material_expression(result,U.MaterialExpressionSetMaterialAttributes)
+            assert U.HCM5VS4BowAuthoring.configure_camera_fade_attribute_setter(setter,masked)
+            assert E.connect_material_expressions(original_attributes,attribute_output,setter,'MaterialAttributes')
