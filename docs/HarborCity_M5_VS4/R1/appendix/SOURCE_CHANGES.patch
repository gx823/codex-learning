+FTransform LocalPose(UAnimSequence* Sequence,FName Bone,float Time,const FTransform& Fallback)
+{
+    if(!Sequence)return Fallback;
+    const int32 Index=Sequence->GetSkeleton()->GetReferenceSkeleton().FindBoneIndex(Bone);
+    FTransform T=Fallback;if(Index!=INDEX_NONE)Sequence->GetBoneTransform(T,FSkeletonPoseBoneIndex(Index),FAnimExtractContext(double(Time)),false);return T;
+}
+FTransform Mix(const FTransform& A,const FTransform& B,float Alpha)
+{
+    FTransform T;T.Blend(A,B,FMath::Clamp(Alpha,0.f,1.f));return T;
+}
+FTransform SampleCS(UAnimSequence* Seq,FName Bone,float Time)
