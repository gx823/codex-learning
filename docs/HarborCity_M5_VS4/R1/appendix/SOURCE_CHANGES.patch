+O=Path('D:/科研学习/codex学习/docs/HarborCity_M5_VS4/R1/appendix')
+normalize=lambda v:v/np.linalg.norm(v)
+screen=lambda p,fov:np.array([960+960*p[1]/p[0]/math.tan(math.radians(fov/2)),540-960*p[2]/p[0]/math.tan(math.radians(fov/2))])
+R=dict(layer='LOGIC_ONLY',status='RUNNING',assumption='Synthetic shaft already aligned to camera aim; does not validate current authored alignment or renderer clipping.',cases=[])
+for distance in (500,1000,2000,4000):
+    for world_fov in (90,math.degrees(2*math.atan(1/1.6))):
+        tail=np.array([6.1829,-2.3639,-17.8058]);aim=np.array([distance,0,0]);axis=normalize(aim-tail);length=51.44383;tip=tail+axis*length
+        ratio=math.tan(math.radians(world_fov/2))/math.tan(math.radians(95/2))
+        a=np.array([1,tip[1]/tip[0]*ratio,tip[2]/tip[0]*ratio]);b=np.array([1,tail[1]/tail[0]*ratio,tail[2]/tail[0]*ratio]);aa=a@a;bb=b@b;ab=a@b;denom=aa*bb-ab*ab
+        direction=axis.copy()
+        def fit(d):
+            delta=d*length;t=((a@delta)*bb-ab*(b@delta))/denom
+            return a*t-delta
+        for _ in range(6):
+            flying_tail=fit(direction);direction=normalize(aim-flying_tail)
+        flying_tail=fit(direction);flying_tip=flying_tail+direction*length
+        error=max(np.linalg.norm(screen(tail,95)-screen(flying_tail,world_fov)),np.linalg.norm(screen(tip,95)-screen(flying_tip,world_fov)))
+        angle=math.degrees(math.acos(np.clip(axis@direction,-1,1)))
