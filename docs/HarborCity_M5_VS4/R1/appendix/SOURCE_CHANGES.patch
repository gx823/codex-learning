+    inputs=U.IKRetargetBatchOperationInputs()
+    for k,v in dict(assets_to_retarget=[A.find_asset_data(a.get_path_name()) for a in higher],source_mesh=source,target_mesh=target,ik_retarget_asset=rt,target_path=ROOT+'/FP96',use_source_path=False,include_referenced_assets=False,overwrite_existing_files=False,retain_additive_flags=True).items():inputs.set_editor_property(k,v)
+    outputs=[r.get_asset() for r in U.IKRetargetBatchOperation.run_batch_retarget(inputs)];assert len(outputs)==28
+    pairs=[]
