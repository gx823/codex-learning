+        const double Tan=FMath::Tan(FMath::DegreesToRadians((FirstPerson?View.FirstPersonFOV:View.FOV)*.5));
+        const double Depth=FMath::Max(.001,P.X);
+        return FVector2D(Width*.5*(1+P.Y/(Depth*Tan)),Height*.5-Width*.5*P.Z/(Depth*Tan));
+    }
+
+    // Fit the same two visible shaft points to world-projection rays. Scale is
+    // unchanged; only translation is solved. Unlike a chosen fixed depth, this
+    // preserves both shaft endpoints when the arrow points along the aim plane.
+    inline bool FitTranslation(const FMinimalViewInfo& View,const FTransform& Visible,
+        const FTransform& Flying,const FVector& TailLocal,const FVector& TipLocal,FVector& Location)
+    {
+        const double Ratio=FMath::Tan(FMath::DegreesToRadians(View.FOV*.5))/FMath::Tan(FMath::DegreesToRadians(View.FirstPersonFOV*.5));
+        const auto Ray=[&](const FVector& P)
+        {
+            FVector V=View.Rotation.UnrotateVector(Visible.TransformPosition(P)-View.Location);
+            if(V.X<=.001)return FVector::ZeroVector;
+            return FVector(1,V.Y/V.X*Ratio,V.Z/V.X*Ratio);
+        };
+        const FVector A=Ray(TipLocal),B=Ray(TailLocal);
+        if(A.IsNearlyZero()||B.IsNearlyZero())return false;
+        const FVector D=View.Rotation.UnrotateVector(Flying.TransformVector(TipLocal-TailLocal));
+        const double AA=A.SizeSquared(),BB=B.SizeSquared(),AB=A|B,Denom=AA*BB-AB*AB;
+        if(Denom<1.e-10)return false;
+        const double TipDepth=((A|D)*BB-AB*(B|D))/Denom;
+        const double TailDepth=(AB*(A|D)-AA*(B|D))/Denom;
+        if(TipDepth<=3 || TailDepth<=.1)return false;
+        const FVector TipWorld=View.Location+View.Rotation.RotateVector(A*TipDepth);
+        Location=TipWorld-Flying.TransformVector(TipLocal);
+        return !Location.ContainsNaN();
+    }
+
+    inline bool Handoff(const FMinimalViewInfo& View,const FTransform& Visible,
+        const FVector& TailLocal,const FVector& TipLocal,FTransform& Flying)
+    {
+        Flying=Visible;
+        const double Ratio=FMath::Tan(FMath::DegreesToRadians(View.FOV*.5))/FMath::Tan(FMath::DegreesToRadians(View.FirstPersonFOV*.5));
+        const auto Ray=[&](const FVector& P){FVector V=View.Rotation.UnrotateVector(Visible.TransformPosition(P)-View.Location);V.Y*=Ratio;V.Z*=Ratio;return V.GetSafeNormal();};
+        const FVector Normal=FVector::CrossProduct(Ray(TailLocal),Ray(TipLocal)).GetSafeNormal();
+        if(Normal.IsNearlyZero())return false;
+        const FVector Axis=View.Rotation.UnrotateVector(Flying.TransformVector(TipLocal-TailLocal)).GetSafeNormal();
+        const FVector InPlane=(Axis-Normal*FVector::DotProduct(Axis,Normal)).GetSafeNormal();
+        const FQuat ViewQ=View.Rotation.Quaternion();
+        // Minimal plane correction preserves both visible endpoints. A separate
+        // velocity points at the aim target; it must not displace the launch image.
+        Flying.SetRotation((ViewQ*FQuat::FindBetweenNormals(Axis,InPlane)*ViewQ.Inverse()*Flying.GetRotation()).GetNormalized());
+        FVector Location;
+        if(!FitTranslation(View,Visible,Flying,TailLocal,TipLocal,Location))return false;
+        Flying.SetLocation(Location);
+        return true;
+    }
+}
