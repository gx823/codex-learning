+#include "HCM5VS4CameraFade.h"
+#include "Components/MeshComponent.h"
+#include "Materials/MaterialInstanceDynamic.h"
+#include "Misc/SecureHash.h"
+
+UMaterialInterface* HCVS4CameraFade::Variant(UMaterialInterface* Original)
+{
+    if(!Original)return nullptr;
+    const FString Source=Original->GetPathName();
+    if(Source.StartsWith(TEXT("/Game/HarborCity/M5VS4/Camera/")))return Original;
+    static TSet<FString> Missing;
+    if(Missing.Contains(Source))return nullptr;
+    const FString Name=TEXT("M_")+FMD5::HashAnsiString(*Source);
+    const FString Path=TEXT("/Game/HarborCity/M5VS4/Camera/")+Name+TEXT(".")+Name;
+    auto* Result=LoadObject<UMaterialInterface>(nullptr,*Path,nullptr,LOAD_NoWarn|LOAD_Quiet);
+    if(!Result)Missing.Add(Source);
+    return Result;
+}
+
+void HCVS4CameraFade::Apply(UMeshComponent* Mesh,float Amount)
+{
+    if(!Mesh)return;
+    if(Amount>0)
+    {
+        for(int32 I=0;I<Mesh->GetNumMaterials();++I)
+        {
+            auto* Original=Mesh->GetMaterial(I);
+            if(!Original||Original->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Camera/")))continue;
+            // Weapon dynamic instances already use the authored fade parent, so
+            // charge glow and other live parameters keep their original owner.
+            if(auto* Dynamic=Cast<UMaterialInstanceDynamic>(Original))
+            {if(Dynamic->Parent&&Dynamic->Parent->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Camera/")))continue;}
+            if(auto* Replacement=Variant(Original))Mesh->SetMaterial(I,Replacement);
+        }
+    }
+    Mesh->SetCustomPrimitiveDataFloat(24,FMath::Clamp(Amount,0.f,.65f));
+}
