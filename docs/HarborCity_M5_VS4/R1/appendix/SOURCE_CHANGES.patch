+"""Round-trip baked animation and report positional errors against fresh originals."""
+from pathlib import Path
+import bpy,json,math
+from mathutils import Matrix,Vector
+P=Path('E:/GameDev/Assets/HarborCity/M5_VS3_R6/Purchased/Exouch_FPBow')
+O=Path('E:/GameDev/Assets/HarborCity/M5_VS4/Derived/Bow/ExportV1')
+M=json.loads((O/'manifest.json').read_text());R=dict(status='RUNNING',clips=[]);reflection=Matrix.Diagonal((-1,1,1,1))
+for name in ('Draw','Draw.Idle','Release','ReloadFromRelease','Idle','EmptyIdle','Equip'):
+    row=next(r for r in M['actions'] if r['source']==name)
+    bpy.ops.wm.open_mainfile(filepath=str(P/'bowanimations.blend'),load_ui=False,use_scripts=False)
+    S=bpy.context.scene;rig=bpy.data.objects['rig'];bow=bpy.data.objects['Bow'];action=bpy.data.actions[name]
+    for ob,slot in ((rig,'OBCharacter'),(bow,'OBBow')):
+        for tr in ob.animation_data.nla_tracks:tr.mute=True
+        ob.animation_data.action=action;ob.animation_data.action_slot=next(s for s in action.slots if s.identifier==slot)
+    expected=[]
+    for f in range(row['source_start'],row['source_end']+1):
+        S.frame_set(f);bpy.context.view_layer.update()
+        expected.append({key:reflection@ob.matrix_world@ob.pose.bones[bone].matrix.translation for key,ob,bone in [('hand_l',rig,'hand.r'),('hand_r',rig,'hand.l'),('Root',bow,'Root'),('String',bow,'String'),('Arrow',bow,'Arrow')]})
+    errors={}
+    for prefix,bones in [('A_FP_',('hand_l','hand_r')),('A_Bow_',('Root','String','Arrow'))]:
+        before=set(bpy.data.objects);bpy.ops.import_scene.fbx(filepath=str(O/(prefix+row['export']+'.fbx')))
+        imported=set(bpy.data.objects)-before;out=next(o for o in imported if o.type=='ARMATURE')
+        anim=out.animation_data.action;start,end=anim.frame_range
+        maxerr={n:0 for n in bones}
+        for i,pose in enumerate(expected):
+            S.frame_set(int(start+i));bpy.context.view_layer.update()
+            for n in bones:
+                actual=(out.matrix_world@out.pose.bones[n].matrix).translation
+                maxerr[n]=max(maxerr[n],(actual-pose[n]).length*100)
