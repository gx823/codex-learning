+#requires -Version 7.0
+$ErrorActionPreference='Stop'
+$root=[IO.Path]::GetFullPath((Join-Path (Split-Path $PSScriptRoot -Parent) 'docs/HarborCity_M5_VS4/R1'))
+$jobs=[Collections.Generic.List[object]]::new()
+foreach($manifest in @(Get-ChildItem -LiteralPath $root -Directory -Filter 'm5_*'|ForEach-Object {Join-Path $_.FullName 'review/stills.json'}|Where-Object {Test-Path -LiteralPath $_})){
+ $data=Get-Content -LiteralPath $manifest -Raw|ConvertFrom-Json
+ foreach($row in $data.stills){
+  $source=[IO.Path]::GetFullPath($row.source);$jpg=[IO.Path]::GetFullPath($row.jpg)
+  if(-not $source.StartsWith($root+'\',[StringComparison]::OrdinalIgnoreCase) -or $source -notmatch '[\\/]User[\\/]Saved[\\/]M5Tests[\\/]' -or [IO.Path]::GetExtension($source) -ne '.png'){throw 'Source escaped this review scope'}
+  if(-not $jpg.StartsWith($root+'\',[StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetExtension($jpg) -ne '.jpg'){throw 'Compressed review escaped scope'}
+  if(-not (Test-Path -LiteralPath $jpg -PathType Leaf) -or (Get-Item -LiteralPath $jpg).Length -gt 500000){throw 'Missing or oversized verified JPEG'}
+  if(Test-Path -LiteralPath $source -PathType Leaf){$jobs.Add([ordered]@{source=$source;review=$jpg;bytes=(Get-Item -LiteralPath $source).Length})}
+ }
+}
+# All resolved targets are checked before any deletion; no directories are removed.
+foreach($row in $jobs){Remove-Item -LiteralPath $row.source}
+@{status='TEMP_PNG_REMOVED_AFTER_JPEG_REVIEW';files=$jobs.ToArray();count=$jobs.Count}|ConvertTo-Json -Depth 5|Set-Content -LiteralPath (Join-Path $root ('appendix/STILL_CLEANUP_'+(Get-Date -Format 'yyyyMMdd_HHmmss')+'.json')) -Encoding utf8
+Write-Output ('Removed temporary PNG files: '+$jobs.Count)
