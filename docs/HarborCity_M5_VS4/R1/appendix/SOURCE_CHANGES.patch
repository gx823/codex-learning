+    return load(path)
+def skeletal(skeleton=None):
+    op=U.FbxImportUI()
+    for k,v in dict(automated_import_should_detect_type=False,import_as_skeletal=True,import_mesh=skeleton is None,import_animations=skeleton is not None,import_materials=False,import_textures=False,create_physics_asset=False,mesh_type_to_import=U.FBXImportType.FBXIT_ANIMATION if skeleton else U.FBXImportType.FBXIT_SKELETAL_MESH,original_import_type=U.FBXImportType.FBXIT_SKELETAL_MESH).items():op.set_editor_property(k,v)
+    if skeleton:op.set_editor_property('skeleton',skeleton)
+    op.anim_sequence_import_data.set_editor_property('animation_length',U.FBXAnimationLengthImportType.FBXALIT_EXPORTED_TIME)
+    op.anim_sequence_import_data.set_editor_property('use_default_sample_rate',False);op.anim_sequence_import_data.set_editor_property('custom_sample_rate',24)
+    return op
+try:
+    manifest=json.loads((SRC/'manifest.json').read_text());assert manifest['status']=='PASS'
+    arm=import_asset('SK_Exouch','Native/Arms',skeletal());bow=import_asset('SK_BowTracks','Native/BowTracks',skeletal())
+    for row in manifest['actions']:
+        for prefix,mesh,dest in [('A_FP_',arm,'Native/Arms/Animations'),('A_Bow_',bow,'Native/BowTracks/Animations')]:
+            seq=import_asset(prefix+row['export'],dest,skeletal(mesh.get_editor_property('skeleton')))
+            seq.set_editor_property('enable_root_motion',False);seq.set_editor_property('force_root_lock',False);save(seq)
+    op=U.FbxImportUI()
+    for k,v in dict(automated_import_should_detect_type=False,import_mesh=True,import_as_skeletal=False,import_materials=False,import_textures=False,mesh_type_to_import=U.FBXImportType.FBXIT_STATIC_MESH,original_import_type=U.FBXImportType.FBXIT_STATIC_MESH).items():op.set_editor_property(k,v)
+    arrow=import_asset('SM_ExouchArrow','Arrow',op)
+    colors=[(.4,.49,.62),(.55,.61,.7),(.15,.2,.29),(.1,.14,.21),(.72,.82,.9),(.45,.72,.85)]
+    for i,slot in enumerate(arrow.get_editor_property('static_materials')):
+        name='M_Arrow_'+str(i);p=ROOT+'/Arrow/'+name
+        mat=load(p) if A.does_asset_exist(p) else AT.create_asset(name,ROOT+'/Arrow',U.Material,U.MaterialFactoryNew())
+        ME.delete_all_material_expressions(mat);node=ME.create_material_expression(mat,U.MaterialExpressionConstant3Vector);node.set_editor_property('constant',U.LinearColor(*colors[i%len(colors)],1));ME.connect_material_property(node,'',U.MaterialProperty.MP_BASE_COLOR)
+        rough=ME.create_material_expression(mat,U.MaterialExpressionConstant);rough.set_editor_property('r',.35);ME.connect_material_property(rough,'',U.MaterialProperty.MP_ROUGHNESS)
+        alpha=ME.create_material_expression(mat,U.MaterialExpressionScalarParameter);alpha.set_editor_property('parameter_name','ArrowOpacity');alpha.set_editor_property('default_value',1.0)
+        dither=ME.create_material_expression(mat,U.MaterialExpressionMaterialFunctionCall);dither.set_editor_property('material_function',load('/Engine/Functions/Engine_MaterialFunctions02/Utility/DitherTemporalAA'))
+        assert ME.connect_material_expressions(alpha,'',dither,'Alpha Threshold');assert ME.connect_material_property(dither,'',U.MaterialProperty.MP_OPACITY_MASK)
+        mat.set_editor_property('blend_mode',U.BlendMode.BLEND_MASKED)
+        ME.recompile_material(mat);save(mat);arrow.set_material(i,mat)
+    save(arrow)
+    name='M_Ventyra';p=ROOT+'/Ventyra/'+name
+    mat=load(p) if A.does_asset_exist(p) else AT.create_asset(name,ROOT+'/Ventyra',U.Material,U.MaterialFactoryNew())
+    ME.delete_all_material_expressions(mat)
+    for key,prop in {'BaseColor':U.MaterialProperty.MP_BASE_COLOR,'Metallic':U.MaterialProperty.MP_METALLIC,'Roughness':U.MaterialProperty.MP_ROUGHNESS,'Emissive':U.MaterialProperty.MP_EMISSIVE_COLOR,'Normal':U.MaterialProperty.MP_NORMAL}.items():
