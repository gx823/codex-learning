+    z=3.4+32*math.exp(-((x+17)/83)**2-((y+142)/68)**2)+1.2*math.sin(x/63)*math.cos(y/52)
+    for cx,cy,r,h in ((-10,0,25,5),(-17,-147,30,34),(-12,-97,21,27),(174,62,27,1.8)):
+        blend=1-smooth((math.hypot(x-cx,y-cy)-r)/18)
