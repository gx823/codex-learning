+        elif key in ('Metallic','Roughness'):node.set_editor_property('sampler_type',U.MaterialSamplerType.SAMPLERTYPE_LINEAR_COLOR)
+        if key=='Emissive':
+            gain=ME.create_material_expression(mat,U.MaterialExpressionScalarParameter);gain.set_editor_property('parameter_name','BowGlow');gain.set_editor_property('default_value',1.0)
+            mul=ME.create_material_expression(mat,U.MaterialExpressionMultiply);ME.connect_material_expressions(node,'RGB',mul,'A');ME.connect_material_expressions(gain,'',mul,'B');ME.connect_material_property(mul,'',prop)
