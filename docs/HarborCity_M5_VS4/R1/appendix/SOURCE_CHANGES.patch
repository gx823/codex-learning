+void UHCM5VS3Abilities::SampleStarBowPose(UPoseableMeshComponent* Mesh,bool Tracks)
+{
+    if(!Mesh||!Mesh->GetSkinnedAsset())return;
+    const auto& Ref=CastChecked<USkeletalMesh>(Mesh->GetSkinnedAsset())->GetRefSkeleton();
+    const FHCStarBowClip C=GetStarBowClip();const float Alpha=FMath::Clamp(StarBow.BlendAge/.08f,0.f,1.f);
+    auto* A=StarBowSequence(C.Name,Tracks);auto* B=C.Secondary.IsEmpty()?nullptr:StarBowSequence(C.Secondary,Tracks);
+    auto* Prev=Alpha<1?StarBowSequence(StarBow.Previous.Name,Tracks):nullptr;
+    auto* PrevB=Prev&&!StarBow.Previous.Secondary.IsEmpty()?StarBowSequence(StarBow.Previous.Secondary,Tracks):nullptr;
+    auto Layer=[&](UAnimSequence* Seq,float Time){
+        TArray<FTransform> Pose;Pose.SetNum(Ref.GetNum());
+        for(int32 I=0;I<Ref.GetNum();++I){Pose[I]=LocalPose(Seq,Ref.GetBoneName(I),Time,Ref.GetRefBonePose()[I]);const int32 Parent=Ref.GetParentIndex(I);if(Parent!=INDEX_NONE)Pose[I]=Pose[I]*Pose[Parent];}
+        return Pose;
+    };
+    auto Current=Layer(A,C.Time);const auto Second=B?Layer(B,C.SecondaryTime):TArray<FTransform>();
+    const auto Old=Prev?Layer(Prev,StarBow.Previous.Time):TArray<FTransform>();const auto OldSecond=PrevB?Layer(PrevB,StarBow.Previous.SecondaryTime):TArray<FTransform>();
