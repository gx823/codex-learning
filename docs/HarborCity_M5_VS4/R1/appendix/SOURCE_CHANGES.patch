+#include "HCM5VS4BowAuthoring.h"
+#if WITH_EDITOR
+#include "Rig/IKRigDefinition.h"
+#include "Rig/Solvers/IKRigStretchLimb.h"
+#include "RigEditor/IKRigController.h"
+#include "Materials/MaterialExpressionSetMaterialAttributes.h"
