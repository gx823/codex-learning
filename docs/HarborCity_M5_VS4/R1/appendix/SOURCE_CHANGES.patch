+
+using Phase=EHCStarBowPhase;
+
+UAnimSequence* UHCM5VS3Abilities::StarBowSequence(const FString& Name,bool Tracks)
+{
+    const FString Prefix=Tracks?TEXT("/Game/HarborCity/M5VS4/Bow/Native/BowTracks/Animations/A_Bow_"):TEXT("/Game/HarborCity/M5VS4/Bow/FP96/A_FP_");
+    const FString Path=Prefix+Name;auto& Seq=BowSequences.FindOrAdd(Path);
+    if(!Seq)Seq=LoadObject<UAnimSequence>(nullptr,*(Path+TEXT(".")+FPackageName::GetShortName(Path)));
+    return Seq;
+}
+
+FHCStarBowClip UHCM5VS3Abilities::GetStarBowClip()
+{
+    FHCStarBowClip C;
+    switch(StarBow.Phase)
+    {
+    case Phase::Equip:C.Name=StarBow.Empty?TEXT("Equip_Empty"):TEXT("Equip");break;
+    case Phase::Drawing:C.Name=TEXT("Draw");break;
+    case Phase::Holding:C.Name=TEXT("Draw_Idle");break;
+    case Phase::Cancel:C.Name=TEXT("Draw_Cancel");break;
+    case Phase::Release:C.Name=TEXT("Release");break;
+    case Phase::Reload:C.Name=TEXT("ReloadFromRelease");break;
+    case Phase::EmptyRelease:C.Name=TEXT("EmptyFromRelease");break;
+    case Phase::Empty:C.Name=TEXT("EmptyIdle");break;
+    case Phase::ReloadEmpty:C.Name=TEXT("ReloadFromEmpty");break;
+    case Phase::Unequip:C.Name=TEXT("Unequip");break;
+    default:break;
+    }
+    const auto* Sequence=StarBowSequence(C.Name);const float Len=Sequence?Sequence->GetPlayLength():1.f;
+    if(StarBow.Phase==Phase::Drawing)C.Time=GetBowCharge()*Len;
+    else if(StarBow.Phase==Phase::Holding||StarBow.Phase==Phase::Loaded||StarBow.Phase==Phase::Empty)C.Time=FMath::Fmod(StarBow.Age,FMath::Max(.001f,Len));
+    else if(StarBow.Phase==Phase::Cancel)C.Time=FMath::Min(Len,StarBow.CancelStart+StarBow.Age*2);
+    else C.Time=FMath::Min(Len,StarBow.Age*2);
+    if(StarBow.Phase==Phase::Loaded && Hero->GetVelocity().Size2D()>15)
+    {
+        const FVector V=FRotator(0,Hero->GetControlRotation().Yaw,0).UnrotateVector(Hero->GetVelocity());
+        float Angle=FMath::Atan2(V.Y,V.X)/(PI*.5f);if(Angle<0)Angle+=4;
+        const int32 I=FMath::FloorToInt(Angle)%4;const TCHAR* Directions[]={TEXT("Fw"),TEXT("R"),TEXT("Bw"),TEXT("L")};
+        const FString Stem=Hero->IsSprintRequested()?TEXT("Walk_Sprint_"):TEXT("Walk_");
+        C.Name=Stem+Directions[I];C.Secondary=Stem+Directions[(I+1)%4];C.SecondaryWeight=FMath::Frac(Angle);
+        const auto* A=StarBowSequence(C.Name);const auto* B=StarBowSequence(C.Secondary);
+        C.Time=StarBow.Cycle*(A?A->GetPlayLength():1);C.SecondaryTime=StarBow.Cycle*(B?B->GetPlayLength():1);
+    }
+    return C;
+}
+
+void UHCM5VS3Abilities::SetStarBowPhase(Phase Next,float Duration)
+{
+    StarBow.Previous=GetStarBowClip();StarBow.BlendAge=0;StarBow.Phase=Next;StarBow.Age=0;StarBow.Duration=Duration;StarBow.ThirdPersonPose.Reset();
+    UE_LOG(LogTemp,Display,TEXT("VS4_BOW_STATE phase=%d empty=%d duration=%.4f"),int32(Next),StarBow.Empty,Duration);
+}
+
+void UHCM5VS3Abilities::EquipStarBow()
+{
+    StarBow.SwitchPending=false;StarBow.SwitchReady=false;StarBow.QueuedDraw=false;StarBow.AimCorrection=FQuat::Identity;
+    const auto* Seq=StarBowSequence(StarBow.Empty?TEXT("Equip_Empty"):TEXT("Equip"));
+    SetStarBowPhase(Phase::Equip,Seq?Seq->GetPlayLength()*.5f:.52f);
+}
+
+bool UHCM5VS3Abilities::IsStarBowBusy() const
+{
+    if(!IsBowEquipped())return false;
+    return StarBow.Phase!=Phase::Loaded&&StarBow.Phase!=Phase::Empty&&StarBow.Phase!=Phase::Unequipped;
+}
+
+bool UHCM5VS3Abilities::PressStarBow()
+{
+    if(!Combat->CanUseCombat()||CastKind>=0||bBowHeld||StarBow.SwitchPending)return false;
+    if(StarBow.Phase!=Phase::Loaded&&StarBow.Phase!=Phase::Empty)return false;
+    bBowHeld=true;BowHold=0;IdleMP=0;StarBow.QueuedDraw=true;
+    Hero->FaceBodyYawOnce(Hero->GetControlRotation().Yaw,.12f);
+    if(StarBow.Empty){const auto* Seq=StarBowSequence(TEXT("ReloadFromEmpty"));SetStarBowPhase(Phase::ReloadEmpty,Seq?Seq->GetPlayLength()*.5f:.5f);}
+    else SetStarBowPhase(Phase::Drawing,.8f);
+    return true;
+}
+
+bool UHCM5VS3Abilities::CancelStarBow()
+{
+    StarBow.QueuedDraw=false;
+    if(StarBow.Phase!=Phase::Drawing&&StarBow.Phase!=Phase::Holding){bBowHeld=false;return false;}
+    const auto* Seq=StarBowSequence(TEXT("Draw_Cancel"));const float Len=Seq?Seq->GetPlayLength():.5f;
+    const float Start=(1-GetBowCharge())*Len;
+    SetStarBowPhase(Phase::Cancel,FMath::Max(.04f,(Len-Start)*.5f));StarBow.CancelStart=Start;
+    bBowHeld=false;BowHold=0;return true;
+}
+
+bool UHCM5VS3Abilities::BeginStarBowUnequip()
+{
+    if(StarBow.SwitchReady)return false;
+    if(StarBow.SwitchPending)return true;
+    StarBow.SwitchPending=true;StarBow.QueuedDraw=false;
+    if(CancelStarBow())StarBow.Duration=.04f;
+    else {bBowHeld=false;const auto* Seq=StarBowSequence(TEXT("Unequip"));SetStarBowPhase(Phase::Unequip,Seq?Seq->GetPlayLength()*.5f:.52f);}
+    return true;
+}
+
+void UHCM5VS3Abilities::ReleaseStarBow()
+{
+    StarBow.QueuedDraw=false;
+    if(!bBowHeld)return;
+    if(StarBow.Phase!=Phase::Drawing&&StarBow.Phase!=Phase::Holding){bBowHeld=false;return;}
+    if(!Combat->CanUseCombat()){CancelStarBow();return;}
+    auto* PC=Cast<AHCM1PlayerController>(Hero->GetController());if(!PC||!PC->PlayerCameraManager)return;
+    UpdateBowPresentation();if(!NockedArrow||!NockedArrow->IsVisible()){CancelStarBow();return;}
+    const bool Charged=BowHold>=.8f,FP=PC->IsFirstPersonPerspective();
+    const FMinimalViewInfo& View=PC->PlayerCameraManager->GetCameraCacheView();
+    FCollisionQueryParams Q(SCENE_QUERY_STAT(VS4BowAim),false,Hero);FHitResult Hit;
+    FVector Aim=View.Location+View.Rotation.Vector()*6000;
+    if(GetWorld()->LineTraceSingleByChannel(Hit,View.Location,Aim,ECC_Visibility,Q))Aim=Hit.ImpactPoint;
+    if(!Charged){const float Distance=FVector::Dist(View.Location,Aim);Aim=View.Location+FMath::VRandCone((Aim-View.Location).GetSafeNormal(),FMath::DegreesToRadians(Combat->GetCurrentSpreadDegrees()))*Distance;}
+    const FTransform Visible=NockedArrow->GetComponentTransform();FTransform Flight=Visible;
+    if(FP&&!HCStarBowProjection::Handoff(View,Visible,FVector::ZeroVector,AHCM5VS4Arrow::TipLocal(),Flight))
+    {UE_LOG(LogTemp,Error,TEXT("VS4_BOW_HANDOFF failed=1"));CancelStarBow();return;}
+    if(!AHCM5VS4Arrow::Spawn(Hero,Flight,Aim,Charged,!Charged)){CancelStarBow();return;}
+    const double Angle=FMath::RadiansToDegrees(FMath::Acos(FMath::Clamp(FVector::DotProduct(Visible.TransformVectorNoScale(AHCM5VS4Arrow::ShaftAxisLocal()).GetSafeNormal(),Flight.TransformVectorNoScale(AHCM5VS4Arrow::ShaftAxisLocal()).GetSafeNormal()),-1.,1.)));
+    const double Pixels=FMath::Max((HCStarBowProjection::Screen(View,Visible.GetLocation(),FP)-HCStarBowProjection::Screen(View,Flight.GetLocation(),false)).Size(),(HCStarBowProjection::Screen(View,Visible.TransformPosition(AHCM5VS4Arrow::TipLocal()),FP)-HCStarBowProjection::Screen(View,Flight.TransformPosition(AHCM5VS4Arrow::TipLocal()),false)).Size());
+    StarBow.HandoffPixels=Pixels;StarBow.HandoffAngle=Angle;StarBow.HandoffDistance=FVector::Dist(Visible.GetLocation(),Flight.GetLocation());
+    UE_LOG(LogTemp,Display,TEXT("VS4_BOW_RELEASE fp=%d charged=%d draw=%.4f handoff_cm=%.5f handoff_px=%.5f orientation_deg=%.5f depth_cm=%.3f"),FP,Charged,BowHold,FVector::Dist(Visible.GetLocation(),Flight.GetLocation()),Pixels,Angle,View.Rotation.UnrotateVector(Flight.GetLocation()-View.Location).X);
+    if(auto* V=UHCM5VS3VFX::Get(Hero)){V->Spawn(TEXT("Arrow_Cast"),Flight.GetLocation(),(Aim-Flight.GetLocation()).Rotation(),FP?.07f:.24f,FLinearColor(.08,.48,1),.5f);V->Sound(TEXT("ArrowShot_Cast"),Flight.GetLocation(),.45f,Charged?.9f:1.05f);}
+    LastBowShot=GetWorld()->GetTimeSeconds();StarBow.Empty=true;bBowHeld=false;BowHold=0;
+    SetStarBowPhase(Hero->IsSprintRequested()?Phase::EmptyRelease:Phase::Release,.13f);
+}
+
+void UHCM5VS3Abilities::UpdateStarBow(float Dt)
+{
+    if(StarBow.Phase==Phase::Unequipped&&!StarBow.SwitchReady)EquipStarBow();
+    StarBow.Age+=Dt;StarBow.BlendAge+=Dt;StarBow.Cycle=FMath::Fmod(StarBow.Cycle+Dt,1.f);
+    if(StarBow.Phase==Phase::Drawing){BowHold=FMath::Min(.8f,BowHold+Dt);if(BowHold>=.8f)SetStarBowPhase(Phase::Holding);}
+    else if(StarBow.Phase==Phase::Holding)BowHold=FMath::Min(1.5f,BowHold+Dt);
+    else if(StarBow.Duration>0&&StarBow.Age>=StarBow.Duration)
+    {
+        switch(StarBow.Phase)
+        {
+        case Phase::Release:{const auto* Seq=StarBowSequence(TEXT("ReloadFromRelease"));SetStarBowPhase(Phase::Reload,Seq?Seq->GetPlayLength()*.5f:.42f);break;}
+        case Phase::EmptyRelease:SetStarBowPhase(Phase::Empty);break;
+        case Phase::Reload:case Phase::ReloadEmpty:StarBow.Empty=false;SetStarBowPhase(StarBow.QueuedDraw&&bBowHeld?Phase::Drawing:Phase::Loaded,.8f);if(StarBow.Phase==Phase::Loaded)StarBow.Duration=0;break;
+        case Phase::Cancel:
+            if(StarBow.SwitchPending){const auto* Seq=StarBowSequence(TEXT("Unequip"));SetStarBowPhase(Phase::Unequip,Seq?Seq->GetPlayLength()*.5f:.52f);}else SetStarBowPhase(Phase::Loaded);
+            break;
+        case Phase::Equip:SetStarBowPhase(StarBow.Empty?Phase::Empty:Phase::Loaded);break;
+        case Phase::Unequip:StarBow.SwitchReady=true;SetStarBowPhase(Phase::Unequipped);break;
+        default:break;
+        }
+    }
+    if(StarBow.Phase==Phase::Empty&&!Hero->IsSprintRequested()){
+        const auto* Seq=StarBowSequence(TEXT("ReloadFromEmpty"));SetStarBowPhase(Phase::ReloadEmpty,Seq?Seq->GetPlayLength()*.5f:.5f);
+    }
+    FString TP=TEXT("A_BowIdle");float Duration=0;bool Loop=true;
+    switch(StarBow.Phase){
+    case Phase::Equip:TP=TEXT("A_BowEquip");break;
+    case Phase::Unequip:TP=TEXT("A_BowUnequip");break;
+    case Phase::Reload:case Phase::ReloadEmpty:TP=TEXT("A_BowReload");break;
+    case Phase::Release:case Phase::EmptyRelease:TP=TEXT("A_BowRelease");break;
+    case Phase::Drawing:case Phase::Holding:TP=TEXT("A_BowAim");break;
+    default:break;
+    }
+    if(StarBow.Phase==Phase::Holding&&Hero->GetVelocity().Size2D()>15){const FVector V=FRotator(0,Hero->GetControlRotation().Yaw,0).UnrotateVector(Hero->GetVelocity());TP=FMath::Abs(V.X)>FMath::Abs(V.Y)?(V.X>0?TEXT("A_BowAimWalk_Fw"):TEXT("A_BowAimWalk_Bw")):(V.Y>0?TEXT("A_BowAimWalk_R"):TEXT("A_BowAimWalk_L"));}
+    if(TP!=TEXT("A_BowIdle")&&TP!=TEXT("A_BowAim")&&!TP.StartsWith(TEXT("A_BowAimWalk"))){Duration=StarBow.Duration;Loop=false;}
+    if(TP!=StarBow.ThirdPersonPose&&StarBow.Phase!=Phase::Unequipped){PlayPose(*TP,Duration,true,Loop);StarBow.ThirdPersonPose=TP;}
+}
