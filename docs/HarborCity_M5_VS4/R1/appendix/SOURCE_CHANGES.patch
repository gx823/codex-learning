diff --git a/tools/ue_m5_vs4_bow_interpolation_audit.py b/tools/ue_m5_vs4_bow_interpolation_audit.py
--- /dev/null
+++ b/tools/ue_m5_vs4_bow_interpolation_audit.py
@@ -0,0 +1,34 @@
+"""Read-only subframe comparison of local versus component-space pose interpolation."""
+from pathlib import Path
+import json,math,re,traceback
+import unreal as U
+ROOT='/Game/HarborCity/M5VS4/Bow'
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line());O=Path(m[1] or m[2])
+R=dict(status='RUNNING',scope='Read-only animation interpolation; no assets saved and no runtime acceptance',clips=[])
+P=U.AnimPoseExtensions
+try:
+    src=U.load_asset(ROOT+'/Native/Arms/SK_Exouch');dst=U.load_asset('/Game/HarborCity/M5VS1/HeroSelestia/SKM_Selestia')
+    pairs=[]
+    for side,s in [('L','l'),('R','r')]:
+        pairs.append(('hand_'+s,'Hand_'+side))
+        for finger,target in [('thumb','Thumb'),('index','Index'),('middle','Middle'),('ring','Ring'),('pinky','Little')]:
+            for i,j in enumerate(('Proximal','Intermediate','Distal'),1):pairs.append((f'{finger}_{i:02}_{s}',target+j+'_'+side))
+    def points(seq,mesh,time,names):
+        opt=U.AnimPoseEvaluationOptions();opt.set_editor_property('optional_skeletal_mesh',mesh);opt.set_editor_property('evaluation_type',U.AnimDataEvalType.RAW);opt.set_editor_property('extract_root_motion',False);opt.set_editor_property('incorporate_root_motion_into_pose',True)
+        pose=P.get_anim_pose_at_time(seq,time,opt)
+        return [P.get_bone_pose(pose,name,U.AnimPoseSpaces.WORLD).translation for name in names]
+    for clip in ('Draw','Draw_Idle','Draw_Cancel','Release','ReloadFromRelease','Walk_Fw','Walk_Sprint_Fw','Equip','Unequip','Equip_Empty','ReloadFromEmpty','EmptyIdle'):
+        a=U.load_asset(ROOT+'/Native/Arms/Animations/A_FP_'+clip);b=U.load_asset(ROOT+'/FP/A_FP_'+clip);assert a and b
+        n=max(1,round(a.get_play_length()*24));local_max=cs_max=0.;samples=0
+        for frame in range(n):
+            before=points(b,dst,frame/24,[x[1] for x in pairs]);after=points(b,dst,(frame+1)/24,[x[1] for x in pairs])
+            for alpha in (.25,.5,.75):
+                t=(frame+alpha)/24;original=points(a,src,t,[x[0] for x in pairs]);actual=points(b,dst,t,[x[1] for x in pairs])
+                for i,pos in enumerate(original):
+                    local_max=max(local_max,(pos-actual[i]*1.25).length())
+                    cs_max=max(cs_max,(pos-(before[i]*(1-alpha)+after[i]*alpha)*1.25).length())
+                samples+=1
+        R['clips'].append(dict(clip=clip,samples=samples,current_local_max_cm=local_max,component_interpolation_max_cm=cs_max))
+    R.update(status='PASS',proposed_limit_pass=all(r['component_interpolation_max_cm']<=1.5 for r in R['clips']))
+except Exception:R.update(status='FAIL',error=traceback.format_exc());U.log_error(R['error'])
+finally:(O/'author_result.json').write_text(json.dumps(R,indent=2),'utf-8')
