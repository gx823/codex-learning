+AHCM5VS4Arrow::AHCM5VS4Arrow()
+{
+    PrimaryActorTick.bCanEverTick=true;
+    Mesh=CreateDefaultSubobject<UStaticMeshComponent>(TEXT("OriginalExouchArrow"));
+    SetRootComponent(Mesh);Mesh->SetCollisionEnabled(ECollisionEnabled::NoCollision);Mesh->SetCollisionResponseToAllChannels(ECR_Ignore);
+    Mesh->SetCanEverAffectNavigation(false);Mesh->SetCastShadow(false);
+}
+
+AHCM5VS4Arrow* AHCM5VS4Arrow::Spawn(AHCM1Character* Hero,const FTransform& Transform,
+    const FVector& Aim,bool Charged,bool ShortDraw)
+{
+    if(!Hero)return nullptr;
+    FActorSpawnParameters Params;Params.Owner=Hero;
+    Params.SpawnCollisionHandlingOverride=ESpawnActorCollisionHandlingMethod::AlwaysSpawn;
+    auto* Arrow=Hero->GetWorld()->SpawnActor<AHCM5VS4Arrow>(StaticClass(),Transform,Params);
+    if(!Arrow)return nullptr;
+    Arrow->Source=Hero;Arrow->bCharged=Charged;Arrow->bShortDraw=ShortDraw;
+    Arrow->Mesh->SetStaticMesh(LoadObject<UStaticMesh>(nullptr,TEXT("/Game/HarborCity/M5VS4/Bow/Arrow/SM_ExouchArrow.SM_ExouchArrow")));
+    Arrow->Velocity=(Aim-Transform.GetLocation()).GetSafeNormal()*5000;
+    Arrow->LaunchAim=Aim;
+    if(auto* PC=Cast<AHCM1PlayerController>(Hero->GetController()))
+    {
+        const auto& View=PC->PlayerCameraManager->GetCameraCacheView();
+        Arrow->LaunchRight=View.Rotation.RotateVector(FVector::RightVector);Arrow->LaunchUp=View.Rotation.RotateVector(FVector::UpVector);
+        FHitResult Surface;FCollisionQueryParams Query(SCENE_QUERY_STAT(VS4ArrowLaunchSurface),false,Hero);
+        if(Hero->GetWorld()->LineTraceSingleByChannel(Surface,View.Location,View.Location+View.Rotation.Vector()*6000,ECC_Visibility,Query)&&Surface.GetComponent())
+        {Arrow->AimSurface=Surface.GetComponent();Arrow->LaunchSurfaceLocal=Surface.GetComponent()->GetComponentTransform().InverseTransformPosition(Aim);}
+    }
+    Arrow->InitialRotation=Transform.GetRotation();
+    Arrow->FlightRotation=(FQuat::FindBetweenNormals(Transform.TransformVector(ShaftAxisLocal()).GetSafeNormal(),Arrow->Velocity.GetSafeNormal())*Transform.GetRotation()).GetNormalized();
+    for(int32 I=0;I<Arrow->Mesh->GetNumMaterials();++I)
+        if(auto* Material=Arrow->Mesh->CreateDynamicMaterialInstance(I))Arrow->Materials.Add(Material);
+    if(auto* FX=UHCM5VS3VFX::Get(Hero))
+        Arrow->Trail=FX->Spawn(TEXT("Arrow_Projectile"),Arrow->GetTip(),Arrow->Velocity.Rotation(),Charged?.13f:.085f,FLinearColor(.15f,.62f,1.f),1.35f,Arrow);
+    return Arrow;
+}
+
+FVector AHCM5VS4Arrow::GetTip() const{return Mesh->GetComponentTransform().TransformPosition(TipLocal());}
+
+void AHCM5VS4Arrow::Tick(float Dt)
+{
+    Super::Tick(Dt);
+    if(!Source.IsValid()){Destroy();return;}
+    // Keep an observable launch frame before integrating the first travel step.
+    if(bFirstFrame){bFirstFrame=false;return;}
+    Age+=Dt;
+    if(bStuck)
+    {
+        StuckAge+=Dt;
+        const float Opacity=1-FMath::Clamp((StuckAge-2.6f)/.4f,0.f,1.f);
+        for(const auto& M:Materials)if(M)M->SetScalarParameterValue(TEXT("ArrowOpacity"),Opacity);
+        if(StuckAge>=3)Destroy();
+        return;
+    }
+    SetActorRotation(bShortDraw?FQuat::Slerp(InitialRotation,FlightRotation,FMath::Clamp(Age/.05f,0.f,1.f)):FlightRotation);
+    const FVector Start=GetTip();
+    const float Step=FMath::Min(5000*Dt,6000-Travelled);
+    if(Step<=0){Destroy();return;}
+    const FVector End=Start+Velocity.GetSafeNormal()*Step;
+    FHitResult Impact;FCollisionQueryParams Q(SCENE_QUERY_STAT(VS4OriginalArrow),false,Source.Get());Q.AddIgnoredActor(this);
+    // Use the same visible surface as the reticle, not the NPC's wider
+    // movement/selection capsule. Sweep the actual shaft tip across the step.
+    const bool Found=GetWorld()->LineTraceSingleByChannel(Impact,Start,End,ECC_Visibility,Q);
+    if(Found){Hit(Impact);return;}
+    SetActorLocation(GetActorLocation()+Velocity.GetSafeNormal()*Step);
+    Travelled+=Step;
+}
+
+void AHCM5VS4Arrow::Hit(const FHitResult& Impact)
+{
+    auto* Hero=Source.Get();auto* NPC=Cast<AHCM3NPC>(Impact.GetActor());
+    const float Damage=bCharged?54.4f:34.f,Before=NPC?NPC->GetHealth():0;
+    UGameplayStatics::ApplyPointDamage(Impact.GetActor(),Damage,Velocity.GetSafeNormal(),Impact,Hero->GetController(),Hero,UHCM4PistolDamageType::StaticClass());
+    if(NPC)AHCM5VS3SpellFX::SpawnNumber(Hero,NPC->GetActorLocation()+FVector(0,0,120),FMath::RoundToInt(Before-NPC->GetHealth()),false);
+    if(bCharged)
+    {
+        FCollisionQueryParams Q(SCENE_QUERY_STAT(VS4ArrowSplash),false,Hero);Q.AddIgnoredActor(this);
+        FCollisionObjectQueryParams Objects;Objects.AddObjectTypesToQuery(ECC_WorldStatic);
+        for(TActorIterator<AHCM3NPC> I(GetWorld());I;++I)
+            if(*I!=NPC&&I->IsCombatEnabled()&&!I->IsHidden()&&FVector::DistSquared(I->GetActorLocation(),Impact.ImpactPoint)<40000)
+            {
+                FHitResult Wall;
+                if(!GetWorld()->LineTraceSingleByObjectType(Wall,Impact.ImpactPoint+FVector(0,0,5),I->GetActorLocation(),Objects,Q))
+                    UGameplayStatics::ApplyDamage(*I,Damage,Hero->GetController(),Hero,UHCM4PistolDamageType::StaticClass());
+            }
+    }
+    if(auto* FX=UHCM5VS3VFX::Get(Hero))
+    {
+        const auto* PC=Cast<AHCM1PlayerController>(Hero->GetController());
+        FX->Spawn(TEXT("Arrow_Hit"),Impact.ImpactPoint,FRotator::ZeroRotator,(PC&&PC->IsFirstPersonPerspective()?.18f:.35f)*(bCharged?1.5f:1.f),FLinearColor(.15f,.62f,1.f));
+        FX->Sound(TEXT("ArrowShot_Hit"),Impact.ImpactPoint,.45f);
+    }
+    if(Trail)Trail->DeactivateImmediate();
+    const FVector Error=Impact.ImpactPoint-LaunchAim;
+    const FVector Components(Error.Dot(LaunchRight),Error.Dot(LaunchUp),Error.Dot(Velocity.GetSafeNormal()));
+    const FVector SurfaceDelta=AimSurface.IsValid()?AimSurface->GetComponentTransform().TransformPosition(LaunchSurfaceLocal)-LaunchAim:FVector(BIG_NUMBER);
+    const double AimError=Error.Size();Hero->GetAbilities()->RecordStarBowImpact(AimError,Components,SurfaceDelta);
+    UE_LOG(LogTemp,Display,TEXT("VS4_BOW_SURFACE launch=%s impact=%s surface_delta=%s horizontal_cm=%.6f vertical_cm=%.6f longitudinal_cm=%.6f same_component=%d"),*LaunchAim.ToString(),*Impact.ImpactPoint.ToString(),*SurfaceDelta.ToString(),Components.X,Components.Y,Components.Z,AimSurface.Get()==Impact.GetComponent());
+    UE_LOG(LogTemp,Display,TEXT("VS4_BOW_HIT charged=%d actor=%s npc=%d damage=%.2f point=%s travelled=%.2f aim_error_cm=%.5f cross_track_cm=%.5f along_track_cm=%.5f launch_aim=%s bone=%s"),bCharged,*GetNameSafe(Impact.GetActor()),NPC!=nullptr,NPC?Before-NPC->GetHealth():0,*Impact.ImpactPoint.ToString(),Travelled,AimError,FVector::CrossProduct(Impact.ImpactPoint-LaunchAim,Velocity.GetSafeNormal()).Size(),FVector::DotProduct(Impact.ImpactPoint-LaunchAim,Velocity.GetSafeNormal()),*LaunchAim.ToString(),*Impact.BoneName.ToString());
+    if(NPC || !Impact.GetComponent() || Impact.GetComponent()->Mobility!=EComponentMobility::Static){Destroy();return;}
+    SetActorLocation(Impact.ImpactPoint+Velocity.GetSafeNormal()*6-Mesh->GetComponentTransform().TransformVector(TipLocal()));
+    bStuck=true;StuckAge=0;
+}
+
+void AHCM5VS4Arrow::EndPlay(const EEndPlayReason::Type Reason)
+{
+    if(Trail)Trail->DeactivateImmediate();
+    Super::EndPlay(Reason);
+}
