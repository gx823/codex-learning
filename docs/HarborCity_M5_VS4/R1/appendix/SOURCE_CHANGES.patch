+    R['sequences']=[dict(path=p,seconds=a.get_play_length()) for p in A.list_assets(ROOT,True,False) if isinstance(a:=A.load_asset(p),U.AnimSequence)]
+    assert sum('/Native/Arms/Animations/' in r['path'] or '/Native/BowTracks/Animations/' in r['path'] for r in R['sequences'])==56
