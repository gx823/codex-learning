+"""Import private authored VS4 bow assets without changing accepted R6 assets."""
+from pathlib import Path
+import json,re,traceback
+import unreal as U
+ROOT='/Game/HarborCity/M5VS4/Bow';SRC=Path('E:/GameDev/Assets/HarborCity/M5_VS4/Derived/Bow/ExportV1')
+A=U.EditorAssetLibrary;AT=U.AssetToolsHelpers.get_asset_tools();ME=U.MaterialEditingLibrary
+m=re.search(r'-M5EvidenceDir=(?:"([^"]+)"|(\S+))',U.SystemLibrary.get_command_line());O=Path(m[1] or m[2]);R=dict(status='RUNNING',assets=[],visual='NOT_RUN')
