+
+AActor* UHCM5VS4WorldAuthoring::CreateCapitalLandscape(UObject* EditorWorld,UMaterialInterface* Material,const TArray<int32>& Heights)
+{
+#if WITH_EDITOR
+    auto* World=Cast<UWorld>(EditorWorld);
+    if(!World||World->IsGameWorld()||!World->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Capital/"))||!Material||Heights.Num()!=505*505)return nullptr;
+    TArray<uint16> Samples;Samples.Reserve(Heights.Num());
+    for(int32 Value:Heights){if(Value<0||Value>65535)return nullptr;Samples.Add(uint16(Value));}
+    auto* Landscape=World->SpawnActor<ALandscape>(FVector(-25000,-22500,0),FRotator::ZeroRotator);
+    if(!Landscape)return nullptr;
