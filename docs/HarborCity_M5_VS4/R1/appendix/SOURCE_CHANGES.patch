+pairs=[('HarborCity/Source/'+rel,before/rel,source/rel) for rel in files]
+for name in ('DefaultGame.ini','DefaultEngine.ini'):
+    pairs.append(('HarborCity/Config/'+name,R/'local_baseline/Config'/name,W/'HarborCity/Config'/name))
+pairs.extend(('tools/'+p.name,Path('__vs4_new_file__'),p) for p in sorted((W/'tools').glob('*vs4*')) if p.is_file() and p.suffix in ('.py','.ps1'))
