+    for(int32 I=0;I<Ref.GetNum();++I)
+    {
+        if(B)Current[I]=Mix(Current[I],Second[I],C.SecondaryWeight);
+        if(Prev){FTransform Before=Old[I];if(PrevB)Before=Mix(Before,OldSecond[I],StarBow.Previous.SecondaryWeight);Current[I]=Mix(Before,Current[I],Alpha);}
+    }
+    Mesh->BoneSpaceTransforms.SetNum(Ref.GetNum());
+    for(int32 I=0;I<Ref.GetNum();++I){const int32 Parent=Ref.GetParentIndex(I);Mesh->BoneSpaceTransforms[I]=Parent==INDEX_NONE?Current[I]:Current[I].GetRelativeTransform(Current[Parent]);}
+    Mesh->RefreshBoneTransforms();
+}
