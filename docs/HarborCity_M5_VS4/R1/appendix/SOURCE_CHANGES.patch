+"""Native, private camera-fade derivatives. Original material graphs remain intact."""
+from pathlib import Path
+import hashlib,json,re,traceback
+import unreal as U
+
+A=U.EditorAssetLibrary; E=U.MaterialEditingLibrary
+ROOT='/Game/HarborCity/M5VS4/Camera'
