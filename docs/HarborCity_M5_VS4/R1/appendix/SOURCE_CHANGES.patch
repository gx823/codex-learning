+
+bool UHCM5VS4BowAuthoring::ConfigureAuthoredHandReach(UObject* RigAsset)
+{
+#if WITH_EDITOR
+    auto* Rig=Cast<UIKRigDefinition>(RigAsset);
+    if(!Rig || !Rig->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Bow/Rigs/")))return false;
+    auto* Controller=UIKRigController::GetController(Rig);
+    Rig->Modify();
+    int32 Configured=0;
+    for(int32 I=0;I<Controller->GetNumSolvers();++I)
+    {
+        auto* Solver=Controller->GetSolverAtIndex(I);
+        if(Solver->GetSolverSettingsType()!=FIKRigStretchLimbSettings::StaticStruct())continue;
+        auto* Settings=static_cast<FIKRigStretchLimbSettings*>(Solver->GetSolverSettings());
+        Settings->bEnableStretching=true;
+        Settings->MaximumStretchDistance=1.6;
+        Settings->StretchStartPercent=1.0;
+        Settings->Iterations=20;
+        Settings->SquashStrength=0;
+        ++Configured;
+    }
+    Rig->PostEditChange();
+    Rig->MarkPackageDirty();
+    return Configured==2;
+#else
+    return false;
+#endif
+}
+
+bool UHCM5VS4BowAuthoring::ResampleAuthoredSource(UObject* SourceAsset,UObject* TargetAsset)
+{
+#if WITH_EDITOR
+    auto* Source=Cast<UAnimSequence>(SourceAsset);auto* Target=Cast<UAnimSequence>(TargetAsset);
+    if(!Source||!Target||Source==Target||!Source->GetSkeleton()||Source->GetSkeleton()!=Target->GetSkeleton()
+        ||!Source->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Bow/Native/Arms/Animations/"))
+        ||!Target->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Bow/Native/Arms96/Animations/")))return false;
+    Source->WaitOnExistingCompression();
+    const int32 Count=FMath::Max(1,FMath::RoundToInt(Source->GetPlayLength()*96));
+    const auto& Ref=Source->GetSkeleton()->GetReferenceSkeleton();
+    auto& C=Target->GetController();Target->Modify();C.OpenBracket(FText::FromString(TEXT("VS4 source-preserving 96Hz retarget sampling")),false);
+    C.SetFrameRate(FFrameRate(96,1),false);C.SetNumberOfFrames(FFrameNumber(Count),false);bool OK=true;
+    for(int32 Bone=0;Bone<Ref.GetNum();++Bone)
+    {
+        const FName Name=Ref.GetBoneName(Bone);TArray<FVector3f> P,S;TArray<FQuat4f> Q;
+        for(int32 Frame=0;Frame<=Count;++Frame)
+        {
+            FTransform T=Ref.GetRefBonePose()[Bone];Source->GetBoneTransform(T,FSkeletonPoseBoneIndex(Bone),FAnimExtractContext(FMath::Min(double(Source->GetPlayLength()),Frame/96.)),false);
+            P.Add(FVector3f(T.GetLocation()));Q.Add(FQuat4f(T.GetRotation()));S.Add(FVector3f(T.GetScale3D()));
+        }
+        if(!Target->GetDataModel()->IsValidBoneTrackName(Name))OK&=C.AddBoneCurve(Name,false);
+        OK&=C.SetBoneTrackKeys(Name,P,Q,S,false);
+        OK&=C.UpdateBoneTrackKeys(Name,FInt32Range(0,Count+1),P,Q,S,false);
+    }
+    C.NotifyPopulated();C.CloseBracket(false);Target->bEnableRootMotion=false;Target->bForceRootLock=false;
+    Target->RefreshCacheData();Target->MarkPackageDirty();return OK;
+#else
+    return false;
+#endif
+}
+
+bool UHCM5VS4BowAuthoring::ConfigureCameraFadeAttributeSetter(UObject* Expression,bool Masked)
+{
+#if WITH_EDITOR
+    auto* Node=Cast<UMaterialExpressionSetMaterialAttributes>(Expression);
+    if(!Node||!Node->GetPathName().StartsWith(TEXT("/Game/HarborCity/M5VS4/Camera/")))return false;
+    Node->CreateOrGetInputAttribute(Masked?MP_OpacityMask:MP_Opacity);
+    return Node->GetInput(1)!=nullptr;
+#else
+    return false;
+#endif
+}
