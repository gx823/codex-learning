+"""Select matching recorded/source instants for the nine requested bow actions."""
+from pathlib import Path
+from PIL import Image, ImageDraw, ImageFont
+import argparse
+import csv
+import json
+import re
+import subprocess
+
+W=Path('D:/科研学习/codex学习');R=W/'docs/HarborCity_M5_VS4/R1'
+p=argparse.ArgumentParser();p.add_argument('run',type=Path);p.add_argument('--assemble',action='store_true');a=p.parse_args()
+run=a.run.resolve();assert run.is_relative_to(R.resolve())
+out=run/'source_comparison';out.mkdir(exist_ok=True)
+plan_path=out/'matched_plan.json'
+font=ImageFont.truetype('C:/Windows/Fonts/consola.ttf',18,layout_engine=ImageFont.Layout.BASIC)
+
+def jpg(im,path):
+    for q in (90,85,80,75,65,50):
+        im.convert('RGB').save(path,quality=q,optimize=True)
+        if path.stat().st_size<=500000:return
+    raise ValueError('JPG exceeds public limit')
+
+if a.assemble:
+    plan=json.loads(plan_path.read_text('utf-8'))
+    for row in plan['frames']:
+        author=out/('AUTHOR_EVALUATED_'+re.sub(r'\W+','_',row['action'])+'.jpg');game=Path(row['game_image'])
+        canvas=Image.new('RGB',(1280,400),(24,27,30))
+        for i,path in enumerate((author,game)):
+            im=Image.open(path).convert('RGB');im.thumbnail((640,360));canvas.paste(im,(i*640,40))
+        d=ImageDraw.Draw(canvas)
+        for i,label in enumerate(('AUTHOR / ','GAME / ')):d.text((i*640+8,9),label+row['clip'],font=font,fill='white')
+        jpg(canvas,out/('MATCH_'+row['clip']+'.jpg'))
+    print(json.dumps(dict(pairs=len(plan['frames']),scope=plan['kind'],directory=str(out))))
+else:
+    launch=json.loads((run/'launch.json').read_text('utf-8-sig'))
+    assert '-R4Case=vs4bowreference' in launch['arguments']
+    bindings=[b for b in (R/'recordings').glob('*/run_binding.json') if json.loads(b.read_text('utf-8-sig'))['started']==launch['started']]
+    assert len(bindings)==1
+    binding=json.loads(bindings[0].read_text('utf-8-sig'));video=Path(binding['video'])
+    assert Path(binding['executable']).resolve()==Path(launch['executable']).resolve()
+    capture=json.loads(video.with_name('capture.json').read_text('utf-8-sig'))
+    qa=json.loads(video.with_suffix('.qa.json').read_text('utf-8'))
+    assert qa['decode_validation']=='PASS_FULL_VIDEO_AND_AUDIO_DECODE'
+    assert qa['capture_completeness']=='COMPLETE'
+    frames=capture['frames'][int(qa['leading_trim']['count']):]
+    stream=next(s for s in qa['probe']['streams'] if s['codec_type']=='video')
+    assert int(stream['nb_frames'])==len(frames),'Encoded frames do not match capture metadata'
+    captured={int(f['engine_frame']):i for i,f in enumerate(frames)}
+    assert len(captured)==len(frames),'Ambiguous engine-frame association'
+    csvs=list((run/'User/Saved/M5Tests').glob('*/VS4_BOW_SOURCE_HANDS.csv'));assert len(csvs)==1
+    rows=list({r['world_time']:r for r in csv.DictReader(csvs[0].open(encoding='utf-8-sig',newline=''))}.values())
+    manifest=json.loads(Path('E:/GameDev/Assets/HarborCity/M5_VS4/Derived/Bow/ExportV1/manifest.json').read_text('utf-8'))
+    source={r['export']:r for r in manifest['actions']}
+    ff=W/'video_build/manga_mad_project_20260827/qa_tools/ffmpeg-master-latest-win64-gpl-shared/bin/ffmpeg.exe'
+    selected=[]
+    for clip in ('Draw','Draw_Idle','Draw_Cancel','Release','ReloadFromRelease','Walk_Fw','Walk_Sprint_Fw','Equip','Unequip'):
+        candidates=[r for r in rows if r['clip']==clip and int(r['engine_frame']) in captured and float(r['correction_deg'])<.0001 and float(r['secondary_weight'])<.01 and float(r['blend_alpha'])>=.999]
+        assert candidates,'No unblended observed primary sample for '+clip
+        ordered=sorted(candidates,key=lambda r:float(r['clip_time']));row=ordered[len(ordered)//2]
+        # These are game-thread capture request stamps, not display timestamps.
+        index=captured[int(row['engine_frame'])]
+        frame=frames[index];delta=abs(float(frame['world_seconds'])-float(row['world_time']))
+        assert delta<=.05,(clip,delta)
+        dest=out/('GAME_'+clip+'.jpg')
+        subprocess.run([str(ff),'-hide_banner','-nostdin','-v','error','-i',str(video),'-vf',f'select=eq(n\\,{index})','-frames:v','1','-q:v','3',str(dest)],check=True)
+        jpg(Image.open(dest),dest)
+        selected.append(dict(clip=clip,action=source[clip]['source'],source_frame=source[clip]['source_start']+float(row['clip_time'])*manifest['fps'],clip_seconds=float(row['clip_time']),game_world_seconds=float(row['world_time']),capture_world_seconds=float(frame['world_seconds']),time_delta_seconds=delta,video=str(video),encoded_frame_index=index,game_image=str(dest)))
+    plan=dict(kind=launch['kind'],run=str(run),author_output=str(out),frames=selected,alignment='Same engine-frame capture request and source-pose sample; world-time mismatch bounded to 50ms. Not precise presentation timestamps or pixel-identical skin proof. Quantitative hand positions use sampled source transforms separately.')
+    plan_path.write_text(json.dumps(plan,ensure_ascii=False,indent=2)+'\n','utf-8')
+    print(str(plan_path))
