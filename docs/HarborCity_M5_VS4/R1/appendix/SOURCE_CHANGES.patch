+#requires -Version 7.0
+$ErrorActionPreference='Stop'
+$root=[IO.Path]::GetFullPath((Join-Path (Split-Path $PSScriptRoot -Parent) 'docs/HarborCity_M5_VS4/R1'))
+function Read-Json([string]$p) { Get-Content -LiteralPath $p -Raw | ConvertFrom-Json }
+$media=Read-Json (Join-Path $root 'appendix/FINAL_MEDIA.json')
+if($media.files.Count -ne 5){throw 'Expected all five final movies'}
+foreach($m in $media.files){
+ if($m.decode -ne 'PASS' -or $m.audio_status -ne 'PASS' -or $m.fps_status -ne 'PASS'){throw 'Final movie QA incomplete'}
+ if((Get-FileHash -LiteralPath $m.path -Algorithm SHA256).Hash -ne $m.sha256){throw 'Final movie changed'}
+ $qa=Read-Json ([IO.Path]::ChangeExtension($m.path,'.qa.json'))
+ $v=@($qa.probe.streams|Where-Object codec_type -eq 'video')[0]
+ $a=@($qa.probe.streams|Where-Object codec_type -eq 'audio')[0]
+ if($v.width -ne 1920 -or $v.height -ne 1080 -or $v.codec_name -ne 'h264' -or $a.codec_name -ne 'aac' -or $a.sample_rate -ne '48000' -or $a.channels -ne 2){throw 'Unexpected media format'}
+}
+$source=Join-Path $root 'm5_vs3_r3_b_20261001_222222'
+$comparison=Join-Path $source 'source_comparison'
+$plan=Read-Json (Join-Path $comparison 'matched_plan.json')
+if($plan.frames.Count -ne 9){throw 'Nine source comparisons required'}
+$deletions=[Collections.Generic.List[object]]::new()
+foreach($frame in $plan.frames){
+ if($frame.clip -notmatch '^[A-Za-z_]+$'){throw 'Invalid clip name'}
+ $match=Join-Path $comparison ('MATCH_'+$frame.clip+'.jpg')
+ $review=Join-Path $root ('review_repair1/VS4_AUTHOR_MATCH_'+$frame.clip+'.jpg')
+ if(-not (Test-Path -LiteralPath $match -PathType Leaf) -or -not (Test-Path -LiteralPath $review -PathType Leaf)){throw 'Verified paired still missing'}
+ foreach($prefix in 'GAME_','AUTHOR_EVALUATED_'){
+  $target=[IO.Path]::GetFullPath((Join-Path $comparison ($prefix+$frame.clip+'.jpg')))
+  if([IO.Path]::GetDirectoryName($target) -ne $comparison -or -not $target.StartsWith($root+'\',[StringComparison]::OrdinalIgnoreCase)){throw 'Cleanup escaped exact source-comparison directory'}
+  if(Test-Path -LiteralPath $target -PathType Leaf){$deletions.Add([ordered]@{path=$target;bytes=(Get-Item -LiteralPath $target).Length})}
+ }
+}
+# Validate every absolute target before removing only these 18 redundant input stills.
+foreach($row in $deletions){Remove-Item -LiteralPath $row.path}
+$sourceVideoFrames=@(Get-ChildItem -LiteralPath (Join-Path $source 'source_video') -File|Where-Object Extension -in '.jpg','.png','.ppm','.bmp','.tga')
+if($sourceVideoFrames.Count){throw 'Temporary source-video sequence remains'}
+$captures=@(Get-ChildItem -LiteralPath (Join-Path $root 'recordings') -Directory|Where-Object Name -ge '20261001_214751')
+$captureAudit=foreach($dir in $captures){
+ $cleanup=Read-Json (Join-Path $dir.FullName 'frame_cleanup.json')
+ $files=@(Get-ChildItem -LiteralPath $dir.FullName -File -Recurse)
+ $keys=@($files|Where-Object Extension -in '.jpg','.png')
+ if(@($files|Where-Object Extension -in '.ppm','.bmp','.tga').Count -or $keys.Count -gt 8){throw 'Unexpected raw frames or uncleaned sequence'}
+ [ordered]@{capture=$dir.Name;retained_keyframes=$keys.Count;removed_frames=$cleanup.frames;removed_bytes=$cleanup.bytes;status=$cleanup.status}
+}
+$package=Read-Json (Join-Path $root 'appendix/FINAL_PACKAGE.json')
+$candidate=[IO.Path]::GetFullPath($package.candidate)
+$raw=@(Get-ChildItem -LiteralPath $candidate -File -Recurse|Where-Object {$_.Extension -in '.ppm','.bmp','.tga' -or $_.Name -match '^frame_\d+\.(png|jpg)$'})
+if($raw.Count){throw 'Frames found in candidate'}
+$processes=@(Get-Process -ErrorAction SilentlyContinue|Where-Object ProcessName -match '^HarborCity|^UnrealEditor|^ffmpeg$|^blender$')
+if($processes.Count){throw 'Native task processes still running'}
+$result=[ordered]@{status='PASS';time=(Get-Date).ToString('o');movies=5;source_pairs=9;review_images=27;source_video_temporary_frames=0;candidate_frames=0;native_task_processes=0;deleted_input_stills=$deletions.ToArray();captures=$captureAudit;scope='Offline format/hash and bounded frame-cleanup checks; not another game test or visual approval. Launcher and VFXStaging were not inspected.'}
+$result|ConvertTo-Json -Depth 8|Set-Content -LiteralPath (Join-Path $root 'appendix/REPAIR1_OFFLINE_AUDIT.json') -Encoding utf8
+[pscustomobject]@{status='PASS';movies=5;deleted_input_stills=$deletions.Count;captures=$captures.Count;candidate_frames=0;native_task_processes=0}|ConvertTo-Json
