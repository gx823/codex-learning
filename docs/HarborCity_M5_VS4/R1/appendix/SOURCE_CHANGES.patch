+qa=dict(source=str(a.input),output=str(a.output),decode='PASS',probe=probe,integrated_lufs=None if silent else float(z['input_i']),true_peak_db=None if silent else float(z['input_tp']),audio_status='FAIL_SILENT_NATIVE_CAPTURE' if silent else ('PASS' if -20<=float(z['input_i'])<=-16 and float(z['input_tp'])<=-1 else 'FAIL'),timing='Native timestamps preserved; no interpolation or FPS conversion. Slow footage already used actual game time dilation, overlay only.',trim_start=a.start,trim_duration=a.duration)
