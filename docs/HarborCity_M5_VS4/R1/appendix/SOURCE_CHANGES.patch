+    if public:
+        v=next(x for x in q['probe']['streams'] if x['codec_type']=='video');n,d=map(float,v['avg_frame_rate'].split('/'));fps=n/d
+        files.append(dict(name=out.name,path=str(out),size=out.stat().st_size,sha256=sha(out),decode=q['decode'],duration=float(q['probe']['format']['duration']),average_fps=fps,fps_status='PASS' if fps>=29.5 else 'FAIL',audio_status=q['audio_status'],integrated_lufs=q['integrated_lufs'],true_peak_db=q['true_peak_db'],exe_sha256=pkg['actual_executable_sha256']))
