diff --git a/tools/hc_vs4_final_queue.ps1 b/tools/hc_vs4_final_queue.ps1
--- /dev/null
+++ b/tools/hc_vs4_final_queue.ps1
@@ -0,0 +1,74 @@
+#requires -Version 7.0
+param([Parameter(Mandatory=$true)][string]$Executable,[string]$ResumeBatch='',[ValidateSet('functional','media','sprintfresh','fullrepair','performance')][string]$Group='functional',[switch]$Repair1)
+$ErrorActionPreference='Stop'
+$doc=Join-Path (Split-Path $PSScriptRoot -Parent) 'docs/HarborCity_M5_VS4/R1'
+$batch=if($ResumeBatch){[IO.Path]::GetFullPath($ResumeBatch)}else{Join-Path $doc ('final_'+$Group+'_'+(Get-Date -Format 'yyyyMMdd_HHmmss'))}
+if(-not $batch.StartsWith(([IO.Path]::GetFullPath($doc)+'\'),[StringComparison]::OrdinalIgnoreCase)){throw 'Invalid batch'}
+New-Item -ItemType Directory -Path $batch -Force|Out-Null
+$jobs=switch($Group){
+ 'fullrepair' {if(-not $Repair1){throw 'The additional full regression requires the explicit Repair1 authorization'};@(@{name='full_once';Mode='m5_full'})}
+ 'performance' {@(@{name='old_perf_high';Mode='perf';Quality='High'},@{name='old_perf_epic';Mode='perf';Quality='Epic'})}
+ 'functional' {@(
+  @{name='full_once';Mode='m5_full'},
+  @{name='A6_starbow';R4Case='vs4bowfinal'},
+  @{name='arcane_ads_charge';BowFinal=$true},
+  @{name='C2_arcane_peak';R4Case='vs4arcanepeak'},
+  @{name='R5_movement_regression';R4Case='r6regression'},
+  @{name='sword_matrix';Mode='m5_vs3_r2_matrix';MatrixCaps='20,30,60'},
+  @{name='preview_roundtrip';R4Case='vs4previewtravel'},
+  @{name='capital_views';R4Case='vs4capital';CapitalPreview=$true},
+  @{name='old_views';R4Case='vs4oldviews'},
+  @{name='old_perf_high';Mode='perf';Quality='High'},
+  @{name='old_perf_epic';Mode='perf';Quality='Epic'}
+ )}
+ 'media' {@(
+  @{name='bow_matching_r6_views';R4Case='vs4bowpilot'},
+  @{name='bow_fp';R4Case='vs4bowfilmfp';RecordSeconds=42},
+  @{name='bow_tp';R4Case='vs4bowfilmtp';RecordSeconds=42},
+  @{name='bow_slow_fp';R4Case='vs4bowslowfp';RecordSeconds=25},
+  @{name='bow_slow_tp';R4Case='vs4bowslowtp';RecordSeconds=25},
+  @{name='capital_flight_1';R4Case='vs4capitalflight1';CapitalPreview=$true;RecordSeconds=30},
+  @{name='capital_flight_2';R4Case='vs4capitalflight2';CapitalPreview=$true;RecordSeconds=30},
+  @{name='capital_flight_3';R4Case='vs4capitalflight3';CapitalPreview=$true;RecordSeconds=30},
+  @{name='capital_flight_4';R4Case='vs4capitalflight4';CapitalPreview=$true;RecordSeconds=30},
+  @{name='old_town_review';R4Case='r6review';RecordSeconds=240},
+  @{name='old_cafe_camera';R4Case='r6cafe';RecordSeconds=30}
+ )}
+ 'sprintfresh' {@(1..10|ForEach-Object{@{name=('sprint_fresh_'+$_.ToString('00'));R4Case='r6apilot'}})}
+}
+if($Repair1 -and $Group -eq 'functional'){
+ $jobs=@($jobs|Where-Object {$_.name -notin @('full_once','R5_movement_regression','capital_views','old_views','old_perf_high','old_perf_epic')})
+ $jobs+=@{name='source_hands';R4Case='vs4bowreference';RecordSeconds=42}
+}
+if($Repair1 -and $Group -eq 'media'){$jobs=@($jobs|Where-Object {$_.name -in @('bow_matching_r6_views','bow_fp','bow_tp','bow_slow_fp','bow_slow_tp')})}
+$rows=[Collections.Generic.List[object]]::new()
+if(Test-Path -LiteralPath (Join-Path $batch 'results.json')){foreach($row in @(Get-Content -LiteralPath (Join-Path $batch 'results.json') -Raw|ConvertFrom-Json)){$rows.Add($row)}}
+foreach($job in $jobs){
+ if(@($rows|Where-Object job -eq $job.name).Count){continue}
+ if($job.name -eq 'full_once'){
+  $latch=Join-Path $doc $(if($Repair1){'FULL_REGRESSION_REPAIR1_START.json'}else{'FULL_REGRESSION_START.json'})
+  if(Test-Path -LiteralPath $latch){throw 'Full regression already initiated; never rerun silently.'}
+  if($Repair1){
+   $prior=Get-Content -LiteralPath (Join-Path $doc 'FULL_REGRESSION_START.json') -Raw|ConvertFrom-Json
+   if($prior.executable -eq $Executable){throw 'Repair regression must use a new candidate'}
+   if(-not (Test-Path -LiteralPath (Join-Path $doc 'REPAIR_AUTHORIZATION.md'))){throw 'Missing explicit repair authorization receipt'}
+  }
+  $hostCheck=& (Join-Path $PSScriptRoot 'hc_r5_host_status.ps1')|ConvertFrom-Json
+  if($hostCheck.ac_line -ne 1 -or -not $hostCheck.input_desktop.available -or (Test-Path -LiteralPath (Join-Path $doc 'STOP_DESKTOP_CHAIN'))){throw 'Host/stop preflight failed before consuming the full-run allowance'}
+  @{time=(Get-Date -Format o);batch=$batch;executable=$Executable;sha256=(Get-FileHash -LiteralPath $Executable).Hash;authorization=$(if($Repair1){'REPAIR_AUTHORIZATION.md: exactly one additional full regression'}else{'REQUEST.md: original single full regression'})}|ConvertTo-Json|Set-Content -LiteralPath $latch -Encoding utf8
+ }
+ @{job=$job.name;batch=$batch;time=(Get-Date -Format o)}|ConvertTo-Json|Set-Content -LiteralPath (Join-Path $doc 'FINAL_QUEUE_ACTIVE.json') -Encoding utf8
+ $params=@{Executable=$Executable};foreach($key in $job.Keys){if($key -ne 'name'){$params[$key]=$job[$key]}}
+ & (Join-Path $PSScriptRoot 'run_m5_vs4.ps1') @params *> (Join-Path $batch ($job.name+'.log'))
+ $active=Get-Content -LiteralPath (Join-Path $doc 'ACTIVE_RUN.json') -Raw|ConvertFrom-Json
+ if($active.status -ne 'EXITED' -or $active.exit_code -ne 0){throw ('Stop queue after '+$job.name+': '+$active.status)}
+ $files=@(Get-ChildItem -LiteralPath (Join-Path $active.run 'User/Saved') -Recurse -File -Filter results.json)
+ if($files.Count -ne $(if($job.name -eq 'preview_roundtrip'){3}else{1})){throw 'Unexpected result count; inspect before continuing.'}
+ $parts=@($files|ForEach-Object{$r=Get-Content -LiteralPath $_.FullName -Raw|ConvertFrom-Json;[ordered]@{file=$_.FullName;status=$r.status;checks=@($r.checks).Count;failures=$r.failures}})
+ $failureTotal=0;foreach($part in $parts){$failureTotal+=[int]$part.failures}
+ $rows.Add([ordered]@{job=$job.name;run=$active.run;parts=$parts;failures=$failureTotal})
+ $rows|ConvertTo-Json -Depth 6|Set-Content -LiteralPath (Join-Path $batch 'results.json') -Encoding utf8
+ Write-Output ($job.name+': '+$rows[-1].failures+' failures recorded')
+ if(@($parts|Where-Object status -ne 'COMPLETE').Count){throw ('Incomplete '+$job.name)}
+}
+Write-Output $batch
diff --git a/tools/hc_vs4_match_source_frames.py b/tools/hc_vs4_match_source_frames.py
