+"""Export bounded public package facts, without encryption keys or asset data."""
+from pathlib import Path
+import argparse,hashlib,json
+p=argparse.ArgumentParser();p.add_argument('package',type=Path);p.add_argument('verification',type=Path,nargs='+');p.add_argument('--repair1',action='store_true');a=p.parse_args()
+W=Path('D:/科研学习/codex学习');R=W/'docs/HarborCity_M5_VS4/R1';A=R/'appendix'
+def read(p):return json.loads(p.read_text('utf-8-sig'))
+def sha(p):
+    with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
+def save(name,v):(A/name).write_text(json.dumps(v,ensure_ascii=False,indent=2)+'\n','utf-8')
+pkg=read(a.package);assert pkg['status']=='PASS';exe=Path(pkg['actual_executable']);assert sha(exe).lower()==pkg['actual_executable_sha256'].lower()
+inventory=read(Path(pkg['source_inventory']))
+for row in inventory:
+    path=(W/'HarborCity'/row['path']).resolve();assert path.is_relative_to((W/'HarborCity').resolve())
+    assert path.stat().st_size==row['bytes'] and sha(path).lower()==row['sha256'].lower(),row['path']
+proof=[]
+for path in a.verification:
+    wrapper=read(path);private=read(Path(wrapper['private_report']))
+    assert private['status']=='PASS_BOUNDED_DIRECT_EXTRACTION_CHECK' and sha(Path(wrapper['private_report']))==wrapper['report_sha256']
+    assert private['exe_sha256'].lower()==pkg['actual_executable_sha256'].lower()
+    proof.append(dict(status=private['status'],target=private['target'],claim_scope=private['claim_scope'],private_report_sha256=wrapper['report_sha256'],native_calls=[{k:c[k] for k in ('label','exit_code','redacted_native_log_sha256')} for c in private['calls']],targets=[{k:x[k] for k in ('filename','chunk_type','bytes','with_key','without_key')} for x in private['targets']]))
+if a.repair1:
+    targets={r['target'] for r in proof}
+    required={'/Game/HarborCity/M5VS2/HeroSelestia/Animation/GASMotion/Batch_1d6685a10359/SKM_Selestia_Warp','/Game/HarborCity/M5VS4/Bow/Arrow/SM_ExouchArrow','/Game/HarborCity/M5VS4/Bow/FP96/A_FP_Draw_Idle','/Game/HarborCity/M5VS4/Bow/Native/Arms/Animations/A_FP_Draw_Idle','/Game/HarborCity/M5VS4/Bow/Native/BowTracks/Animations/A_Bow_Draw_Idle'}
