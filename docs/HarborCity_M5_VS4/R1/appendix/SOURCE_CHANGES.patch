+    originals=[a for path in A.list_assets(ROOT+'/Native/Arms/Animations') if isinstance(a:=A.load_asset(path),U.AnimSequence)];assert len(originals)==28
+    higher=[]
+    for original in originals:
+        path=ROOT+'/Native/Arms96/Animations/'+original.get_name()
+        seq=load(path) if A.does_asset_exist(path) else A.duplicate_asset(original.get_path_name(),path)
